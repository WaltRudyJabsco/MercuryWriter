#!/usr/bin/env python3
"""Launch the local JEV-1 worker on the best device available to this node."""
import os, subprocess, sys
from pathlib import Path
root=Path.home()/'.local/share/open-jev'
python=root/'.venv/bin/python'
checkpoint=root/'models/Open-Jev-2B/package/checkpoint'
if not python.exists() or not checkpoint.exists():
    raise SystemExit('JEV-1 unavailable: OpenJev runtime/checkpoint not installed')
probe='''import torch\nif torch.cuda.is_available(): print("cuda:0")\nelif hasattr(torch.backends,"mps") and torch.backends.mps.is_available(): print("mps")\nelse: print("cpu")'''
try:
    device=subprocess.check_output([str(python),'-c',probe],text=True,timeout=12).strip() or 'cpu'
except Exception:
    device='cpu'
os.execv(str(python),[str(python),'-m','jev.server','--checkpoint',str(checkpoint),'--device',device,'--max-length','4096','--batch-size','1','--no-prefix-cache','--host','127.0.0.1','--port','8791'])
