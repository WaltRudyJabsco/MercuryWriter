    rows=payload.get("outputs") or []
    print(f"FABRIC MEDIA OUTPUTS · {len(rows)}")
    for row in rows:
        mark="●" if row.get("available") else "○"
        active=f" · {row.get('state')}" if row.get("active") else ""
        print(f"  {mark} {str(row.get('node') or '?'):<20} {str(row.get('output_id') or 'default')}{active}")
