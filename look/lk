def _looks_like_shell_file_discovery(command):
    """Guard the dedicated file-search edge from shell fallbacks.

    Parse command words conservatively; execution commands such as `asciiquarium`
    must never trip this guard merely because arbitrary arguments contain words
    like find/search.
    """
    text=str(command or "").strip()
    if not text: return False
    # Check each shell pipeline/sequence head, not arbitrary argument text.
    for segment in re.split(r"(?:&&|\|\||[;|])",text):
        try:
            parts=shlex.split(segment.strip())
        except ValueError:
            parts=segment.strip().split()
        if not parts: continue
        i=0
        while i < len(parts) and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*",parts[i]): i+=1
        if i>=len(parts): continue
        base=Path(parts[i]).name.casefold()
        if base in {"find","mdfind","fd","fdfind","locate","plocate"}: return True
        if base in {"rg","grep","egrep","fgrep"} and any(p in {"-l","--files","--files-with-matches"} for p in parts[i+1:]): return True
    return False


