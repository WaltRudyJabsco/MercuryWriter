def _memory_worker():
    """Drain queued memory jobs serially, then exit. Safe across lo sessions."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)

    # Atomic lock creation gives us one worker without a daemon or dependency.
    try:
        fd=os.open(MEMORY_WORKER_LOCK, os.O_CREAT|os.O_EXCL|os.O_WRONLY, 0o600)
    except FileExistsError:
        return 0
    try:
        os.write(fd, str(os.getpid()).encode())
    finally:
        os.close(fd)

    try:
        while True:
            jobs=_memory_job_files()
            if not jobs:
                break

            job_path=jobs[0]
            try:
                job=json.loads(job_path.read_text(encoding="utf-8"))
                base=job.get("base","http://127.0.0.1:11434")
                _ollama_tags(base)  # do not consume durable memory work while inference is unavailable
                memory=_load_memory()
                _remember_exchange(
                    base,
                    job.get("model") or _active_ollama_model(),
                    memory,
                    str(job.get("user","")),
                    str(job.get("assistant","")),
                    str(job.get("profile","workspace")),
                    job.get("cognition") if isinstance(job.get("cognition"),dict) else None,
                )
                job_path.unlink()
            except Exception:
                # Leave the job for a future worker rather than losing memory.
                break
    finally:
        try:
            MEMORY_WORKER_LOCK.unlink()
        except OSError:
            pass

    # Close the tiny shutdown race: if a job arrived while we released the lock,
    # launch one fresh worker to pick it up.
    if _memory_job_files():
        _start_memory_worker()
    return 0



