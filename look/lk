def _power_command_risk(command):
    """Classify shell authority at the host edge; models never decide this policy."""
    words=_command_words(command)
    if not words:
        return "hazardous"
    text=str(command or "")
    exe=Path(words[0]).name.casefold()
    # Composition/redirection makes a command materially harder to bound.
    if re.search(r"[;&|><`]",text):
        return "hazardous"
    hazardous={
        "sudo","doas","su","rm","rmdir","dd","mkfs","diskutil","fdisk","parted",
        "shutdown","reboot","halt","poweroff","kill","killall","pkill",
        "chmod","chown","chgrp","chflags","launchctl","systemctl","service",
        "iptables","nft","pfctl","ifconfig","route","networksetup","csrutil","nvram",
    }
    if exe in hazardous:
        return "hazardous"
    if exe in {"bash","sh","zsh","fish","dash"} and any(w in {"-c","-lc"} for w in words[1:]):
        return "hazardous"
    if exe=="git" and len(words)>=2 and words[1].casefold() in {"push","clean","reset","rebase","filter-branch"}:
        return "hazardous"
    if exe in {"brew","apt","apt-get","dnf","yum","pacman","zypper"} and len(words)>=2 and words[1].casefold() in {"remove","uninstall","autoremove","upgrade","full-upgrade"}:
        return "hazardous"
    return "ordinary"


def _launch_command_new_terminal(command,cwd,shell,args=None):
    """Dispatch a command and attach a typed handle to the created terminal object."""
    args=args if isinstance(args,dict) else {}
    ref_id="term_"+uuid.uuid4().hex[:12]
    try:
        if sys.platform=="darwin":
            script=(
                'on run argv\n'
                'tell application "Terminal"\n'
                'activate\n'
                'do script (item 1 of argv)\n'
                'delay 0.1\n'
                'return id of front window\n'
                'end tell\n'
                'end run'
            )
            shell_line=f"cd {shlex.quote(str(cwd))} && {command}"
            proc=subprocess.run(
                ["osascript","-e",script,shell_line],
                stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=8,
            )
            if proc.returncode!=0:
                detail=(proc.stdout or "").strip()
                return f"New terminal dispatch failed: {detail or 'osascript exit '+str(proc.returncode)}"
            window_id=(proc.stdout or "").strip().splitlines()[-1].strip() if (proc.stdout or "").strip() else ""
            args["_referent"]={"id":ref_id,"kind":"terminal_window","platform":"darwin","os_window_id":window_id,"command":command,"status":"open","created_at":time.time()}
            return "new terminal dispatch ok · command launched"

        if sys.platform.startswith("linux"):
            candidates=(
                ("x-terminal-emulator",lambda exe:[exe,"-e",shell,"-lc",command]),
                ("gnome-terminal",lambda exe:[exe,"--",shell,"-lc",command]),
                ("konsole",lambda exe:[exe,"-e",shell,"-lc",command]),
                ("kitty",lambda exe:[exe,shell,"-lc",command]),
                ("alacritty",lambda exe:[exe,"-e",shell,"-lc",command]),
                ("wezterm",lambda exe:[exe,"start","--cwd",str(cwd),"--",shell,"-lc",command]),
            )
            handle_dir=STATE_DIR/"terminal_handles"; handle_dir.mkdir(parents=True,exist_ok=True)
            pid_file=handle_dir/f"{ref_id}.pid"
            control_fifo=handle_dir/f"{ref_id}.ctl"
            try:
                if control_fifo.exists(): control_fifo.unlink()
                os.mkfifo(control_fifo,0o600)
            except OSError:
                control_fifo=None
            window_token=f"LOOK-{ref_id}"
            controller=""
            if control_fifo is not None:
                qfifo=shlex.quote(str(control_fifo))
                controller=("(while :; do if IFS= read -r op < "+qfifo+"; then case \"$op\" in "
                            "maximize) printf '\\033[9;1t' > /dev/tty ;; "
                            "fullscreen) printf '\\033[10;1t' > /dev/tty ;; "
                            "minimize) printf '\\033[2t' > /dev/tty ;; "
                            "focus) printf '\\033[5t' > /dev/tty ;; esac; fi; done) & ")
            wrapped=(controller+f"printf '%s\\n' $$ > {shlex.quote(str(pid_file))}; "
                     f"printf '\033]0;{window_token}\007'; "
                     f"exec {shlex.quote(shell)} -lc {shlex.quote(command)}")
            for name,build in candidates:
                exe=shutil.which(name)
                if not exe: continue
                proc=subprocess.Popen(build(exe)[:-1]+[wrapped],cwd=str(cwd),stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,
                                 start_new_session=True)
                args["_referent"]={"id":ref_id,"kind":"terminal_window","platform":"linux","pid_file":str(pid_file),"launcher_pid":int(getattr(proc,"pid",0) or 0),"window_token":window_token,"control_fifo":str(control_fifo) if control_fifo is not None else "","command":command,"status":"open","created_at":time.time()}
                return f"new terminal dispatch ok · command launched via {name}"
            return "New terminal dispatch failed: no supported terminal launcher found"

        return f"New terminal dispatch failed: unsupported platform {sys.platform}"
    except (OSError,subprocess.SubprocessError) as exc:
        return f"New terminal dispatch failed: {exc}"



def _lo_recent_referents(last_action=None,limit=24):
    """Live typed objects available for deictic follow-up, newest/salient first."""
    out=[]; seen=set(); live_refs=_live_state_referents()
    observed_current=next((r for r in live_refs if r.get("_current")),None)
    if last_action:
        ref=(last_action.get("args") or {}).get("_referent")
        if isinstance(ref,dict):
            key=str(ref.get("id") or ref.get("os_window_id") or ref.get("pid") or ref)
            item=dict(ref)
            current_key=str((observed_current or {}).get("id") or "")
            if not current_key or current_key==key: item["_salient"]=True
            seen.add(key); out.append(item)
    # Present observation outranks durable action history when focus changed.
    for ref in live_refs:
        key=str(ref.get("id") or ref.get("os_window_id") or ref.get("pid") or ref)
        if key in seen: continue
        seen.add(key); out.append(dict(ref))
    return out[:max(1,int(limit))]


