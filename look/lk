def _skills_metadata(text):
    schema=re.search(r"<!--\s*schema:\s*(\d+)\s*-->",str(text or ""),re.I)
    bundled=re.search(r"<!--\s*bundled-version:\s*(\d+)\s*-->",str(text or ""),re.I)
    return {"schema":int(schema.group(1)) if schema else 0,
            "bundled_version":int(bundled.group(1)) if bundled else 0}


def _split_skills(text):
    marker="## Learned"
    text=str(text or "")
    if marker in text:
        head,tail=text.split(marker,1)
        return head.rstrip(),tail.strip()
    return text.rstrip(),""


def _merge_skills_pack(existing, pack):
    meta=_skills_metadata(pack)
    if meta["schema"] not in {0,SKILLS_SCHEMA_VERSION}:
        raise ValueError(f"unsupported skills schema: {meta['schema']}")
    pack_head,_=_split_skills(pack)
    _,learned=_split_skills(existing)
    out=pack_head.rstrip()+"\n\n## Learned\n\n"
    if learned:
        out+=learned.rstrip()+"\n"
    return out


def _sync_bundled_skills(pack_text=None):
    STATE_DIR.mkdir(parents=True,exist_ok=True)
    pack_text=pack_text or DEFAULT_SKILLS
    try:
        existing=SKILLS_FILE.read_text(encoding="utf-8") if SKILLS_FILE.exists() else ""
        SKILLS_FILE.write_text(_merge_skills_pack(existing,pack_text),encoding="utf-8")
        return True
    except (OSError,ValueError):
        return False


def _ensure_intelligence_files():
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        if not CORE_FILE.exists():
            CORE_FILE.write_text(DEFAULT_CORE, encoding="utf-8")
        if not SKILLS_FILE.exists():
            SKILLS_FILE.write_text(DEFAULT_SKILLS, encoding="utf-8")
        else:
            try:
                current=SKILLS_FILE.read_text(encoding="utf-8")
                installed=_skills_metadata(current)
                available=_skills_metadata(DEFAULT_SKILLS)
                if installed["bundled_version"] < available["bundled_version"] or installed["schema"] == 0:
                    SKILLS_FILE.write_text(_merge_skills_pack(current,DEFAULT_SKILLS),encoding="utf-8")
            except (OSError,ValueError):
                pass
        if not MEMORY_FILE.exists():
            MEMORY_FILE.write_text(json.dumps(_empty_memory(), indent=2) + "\n", encoding="utf-8")
            os.chmod(MEMORY_FILE, 0o600)
        return True
    except OSError:
        return False


def _ensure_memory_file():
    return _ensure_intelligence_files()


def _migrate_old_memory(data):
    """One-way, loss-minimizing migration from LOOK 3.3 fixed slots."""
    if "memories" in data:
        return data
    memories=[]
    for note in data.get("recent", []):
        text=" ".join(str(note).split()).strip()
        if text:
            memories.append({"text": text[:900], "importance": 60, "uses": 0})
    summary=str(data.get("long", "")).strip()[:3000]
    return {
        "schema_version": MEMORY_SCHEMA_VERSION,
        "summary": "",
        "legacy_summary": summary,
        "core_summary": "",
        "domain_summaries": {},
        "durable": [],
        "memories": memories[-MEMORY_CANDIDATE_LIMIT:],
        "atoms": [],
        "maintenance_cycles": 0,
    }


def _load_memory():
    if not _ensure_memory_file():
        return _empty_memory()
    try:
        data=json.loads(MEMORY_FILE.read_text(encoding="utf-8"))
        source_schema=int(data.get("schema_version",0) or 0) if isinstance(data,dict) else 0
        data=_migrate_old_memory(data if isinstance(data, dict) else {})
        cleaned=[]
        for item in data.get("memories", []):
            if isinstance(item, str):
                item={"text": item, "importance": 50, "uses": 0}
            text=" ".join(str(item.get("text","")).split()).strip()
            if not text:
                continue
            now=time.time()
            cleaned.append({
                "text": text[:900],
                "importance": max(0, min(100, int(item.get("importance",50)))),
                "uses": max(0, int(item.get("uses",0))),
                "created_at": float(item.get("created_at",item.get("last_reinforced",now)) or now),
                "last_reinforced": float(item.get("last_reinforced",item.get("created_at",now)) or now),
            })
        cleaned.sort(key=lambda x:x["importance"], reverse=True)
        durable=[]
        now=time.time()
        for item in data.get("durable",[]):
            if not isinstance(item,dict): continue
            text=_sanitize_memory_text(item.get("text",""))
            if not text: continue
            domain=str(item.get("domain","general"))
            if domain not in MEMORY_DOMAINS: domain="general"
            durable.append({
                "text":text[:700],"domain":domain,
