def _fabric_web_search(query, limit=8):
    """Search through Fabric's accountless SearXNG edge.

    Web search is a Fabric capability, not an Ollama-account feature. The local
    node may satisfy it itself or route it to another node advertising web.search.
    """
    import json
    import urllib.parse
    import urllib.request
    query=str(query or "").strip()
    if not query:
        raise RuntimeError("web search query required")
    params=urllib.parse.urlencode({"q":query,"limit":max(1,min(int(limit or 8),20))})
    with urllib.request.urlopen("http://127.0.0.1:7332/v1/web/search?"+params,timeout=12) as response:
        data=json.load(response)
    if data.get("error") and not data.get("results"):
        raise RuntimeError(str(data.get("error")))
    return data

def _direct_searxng_search(query, limit=8):
    """Use this machine's SearXNG directly when the node search edge is unhealthy.

    The node route remains canonical because it can float to another Fabric provider.
    This local fallback keeps a transient/control-plane problem from making LO blind on
    a machine that plainly has a working accountless search service.
    """
    import json
    import urllib.parse
    import urllib.request
    base=os.environ.get("FCL_SEARXNG_URL","http://127.0.0.1:8888").rstrip("/")
    query=str(query or "").strip()
    if not query:
        raise RuntimeError("web search query required")
    params=urllib.parse.urlencode({"q":query,"format":"json"})
    request=urllib.request.Request(base+"/search?"+params,headers={
        "Accept":"application/json",
        "User-Agent":"Future-Crash-Fabric/8.7.0",
    })
    with urllib.request.urlopen(request,timeout=12) as response:
        data=json.load(response)
    rows=[]
    for item in (data.get("results") or [])[:max(1,min(int(limit or 8),20))]:
        if not isinstance(item,dict):
            continue
        rows.append({
            "title":str(item.get("title") or "").strip(),
            "url":str(item.get("url") or "").strip(),
            "content":" ".join(str(item.get("content") or "").split())[:1600],
        })
    return {"schema":"fabric-web-search-v1","provider":"searxng-direct",
            "query":query,"results":rows,"count":len(rows)}


def _search_web(query):
    """Prefer Fabric search, then local SearXNG, then the optional hosted edge."""
    errors=[]
    try:
        return _fabric_web_search(query)
    except Exception as exc:
        errors.append(f"fabric: {exc}")
    try:
        return _direct_searxng_search(query)
    except Exception as exc:
        errors.append(f"local searxng: {exc}")
    if os.environ.get("OLLAMA_API_KEY"):
        try:
            return _ollama_web_search(query)
        except Exception as exc:
            errors.append(f"hosted: {exc}")
    raise RuntimeError("web search unavailable · "+" · ".join(errors))


def _ollama_web_search(query):
    """Search via Ollama's hosted web API using the inherited API key."""
    import json
    import urllib.request

    key = os.environ.get("OLLAMA_API_KEY")
    if not key:
        raise RuntimeError("OLLAMA_API_KEY is not set")

    payload = json.dumps({"query": query}).encode()
    request = urllib.request.Request(
        "https://ollama.com/api/web_search",
        data=payload,
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.load(response)


def _web_resource_type(url):
    """Cheap structural typing for web candidates; deterministic before model ranking."""
    try:
        parsed=urllib.parse.urlparse(str(url or ""))
        host=parsed.netloc.casefold().removeprefix("www.")
        path=parsed.path.casefold()
        query=urllib.parse.parse_qs(parsed.query)
    except Exception:
        return "page"
    if host in {"youtube.com","m.youtube.com","youtu.be"}:
        if host=="youtu.be" and path.strip("/"): return "video"
        if path=="/watch" and query.get("v"): return "video"
        if path.startswith("/shorts/"): return "video"
        if path.startswith(("/channel/","/@","/c/","/user/")): return "channel"
        if path=="/playlist": return "playlist"
        if path.startswith("/results"): return "search"
        return "youtube-page"
    return "page"

