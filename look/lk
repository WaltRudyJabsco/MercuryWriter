def _ordinary_user_path(target):
    target=Path(target).resolve()
    return any(_path_within(target,root) for root in _ordinary_user_roots())

def _path_access_allowed(workspace,target,capability):
    """Workspace supplies context. Profile supplies authority."""
    target=Path(target).resolve()
    profile=str(_FILESYSTEM_ACCESS_PROFILE or "workspace").casefold()
    # CONSERVATIVE is workspace/grant scoped. WORKSPACE is the ordinary
    # personal-file tier; POWER/UNSAFE are current-user machine tiers.
    if capability=="read" and profile in {"workspace","power","unsafe"} and _ordinary_user_path(target): return True
    if capability=="write" and profile=="workspace" and _ordinary_user_path(target): return True
    if profile in {"power","unsafe"}: return True
    if _path_within(target,workspace): return True
    for rule in _ONCE_PATH_GRANTS:
        if _grant_covers(rule,target,capability): return True
    for rule in _SESSION_PATH_GRANTS:
        if _grant_covers(rule,target,capability): return True
    return any(_grant_covers(rule,target,capability) for rule in _load_path_access())


def _consume_once_grant(target,capability):
    for i,rule in enumerate(list(_ONCE_PATH_GRANTS)):
        if _grant_covers(rule,target,capability):
            _ONCE_PATH_GRANTS.pop(i)
            return


def _permission_scope_path(target):
    target=Path(target).resolve()
    # Existing directories are natural grant roots. For files/new paths, grant
    # their parent so "always allow Downloads" behaves as the user expects.
    return target if target.exists() and target.is_dir() else target.parent


def _prompt_path_access(workspace,target,capability):
    """Ask locally; the model never decides or fabricates filesystem permission."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    target=Path(target).resolve()
    scope=_permission_scope_path(target)
    print()
    print(f"{_c('LO FILE ACCESS','1;36')}")
    print(f"  wants {capability.upper():<6} {target}")
    print(f"  workspace   {Path(workspace).resolve()}")
    print(f"  grant root  {scope}")
    print()
    try:
        answer=input("  [A] once · [S] session · [P] always · [H] personal folders · Enter/Esc cancel › ").strip().casefold()
    except (EOFError,KeyboardInterrupt):
        print("\n  · cancelled")
        return False
    caps=["read","write"] if capability=="write" else ["read"]
    if answer in {"a","once"}:
        _ONCE_PATH_GRANTS.append({"path":str(target),"capabilities":[capability]})
    elif answer in {"s","session"}:
        _SESSION_PATH_GRANTS.append({"path":str(scope),"capabilities":caps})
    elif answer in {"p","permanent","always"}:
        rules=_load_path_access()
        canonical=str(scope)
        existing=next((r for r in rules if str(Path(r["path"]).expanduser().resolve())==canonical),None)
        if existing:
            existing["capabilities"]=sorted(set(existing.get("capabilities",[]))|set(caps))
        else:
            rules.append({"path":canonical,"capabilities":caps,"created_at":time.time()})
        _save_path_access(rules)
    elif answer in {"h","home","personal"}:
        rules=_load_path_access()
        for p in (HOME/"Desktop",HOME/"Documents",HOME/"Downloads"):
            if not p.exists(): continue
            canonical=str(p.resolve())
            existing=next((r for r in rules if str(Path(r["path"]).expanduser().resolve())==canonical),None)
            if existing: existing["capabilities"]=sorted(set(existing.get("capabilities",[]))|{"read","write"})
            else: rules.append({"path":canonical,"capabilities":["read","write"],"created_at":time.time()})
        _save_path_access(rules)
        # The current target may not be one of the personal roots.
        if not _path_access_allowed(workspace,target,capability):
            print("  · personal folders allowed, but this requested path is still outside them")
            return False
    else:
        print("  · cancelled")
        return False
    print(f"  {_c('✓ access granted','32')} · {answer if answer else 'cancelled'}")
    return True


def _safe_workspace_path(workspace, raw_path=".", capability="read", prompt_access=True):
    """Resolve a path under the active LO filesystem capability profile."""
    workspace=Path(workspace).resolve()
    raw_path=raw_path or "."
    candidate=Path(raw_path).expanduser()
    if not candidate.is_absolute():
        candidate=workspace/candidate
    candidate=candidate.resolve()

    # UNSAFE is intentionally unrestricted for this LO session. The user has
    # already accepted the session-level warning; asking again for every path
    # creates a contradictory second permission system.
    if _FILESYSTEM_ACCESS_PROFILE in {"power","unsafe"}:
        return candidate
    if capability=="read" and _FILESYSTEM_ACCESS_PROFILE=="workspace" and _ordinary_user_path(candidate):
        return candidate

    if _path_access_allowed(workspace,candidate,capability):
        return candidate
    if prompt_access and _prompt_path_access(workspace,candidate,capability):
        # Consume once only after authorization has been used for this operation.
        allowed=_path_access_allowed(workspace,candidate,capability)
        if allowed:
            return candidate
    raise ValueError(
        f"path requires {capability} access outside the LOOK workspace: {candidate}"
    )


def _workspace_snapshot(workspace):
    """Small guaranteed folder context; deeper inspection is handled by tools."""
    workspace = Path(workspace).resolve()
    try:
        entries = sorted(workspace.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower()))[:120]
    except OSError as exc:
        return f"Current workspace: {workspace}\nDirectory listing unavailable: {exc}"
    shown=[]
    for item in entries:
        try:
            suffix="/" if item.is_dir() else ""
        except OSError:
            suffix=""
        shown.append(item.name + suffix)
    more="\n…listing truncated" if len(entries) == 120 else ""
    return (
        f"Current workspace: {workspace}\n"
        "Treat this as the user's CURRENT CONTEXT, not a filesystem sandbox. Prefer it for project-relative requests; ordinary personal-file discovery may search broadly according to the active access profile.\n"
        + _agent_tool_contract() +
        "Top-level contents:\n" + ("\n".join(shown) if shown else "(empty)") + more
    )


def _tool_list_files(workspace, path="."):
    """Bounded one-directory inspection. Discovery belongs to search_files."""
    target=_safe_workspace_path(workspace,path,"read")
    if not target.exists(): return f"Not found: {path}"
    if not target.is_dir(): return f"Not a directory: {path}"
    try:
        children=sorted(target.iterdir(),key=lambda p:(not p.is_dir(),p.name.casefold()))
    except (OSError,PermissionError) as exc:
        return f"Directory unreadable: {exc}"
    lines=[]
    for child in children[:120]:
        try: suffix="/" if child.is_dir() else ""
        except OSError: suffix=""
        lines.append(child.name+suffix)
    if len(children)>120: lines.append(f"… {len(children)-120} more; use search_files to find something")
    return "\n".join(lines) if lines else "(empty)"

def _tool_read_file(workspace, path, offset=0, max_chars=12000):
    target=_safe_workspace_path(workspace, path)
    if not target.exists():
        return f"Not found: {path}"
    if not target.is_file():
        return f"Not a file: {path}"

    suffix=target.suffix.lower()

    # Common document containers are typed resources, not invitations for the
    # model to improvise shell/Python extraction. Decode them deterministically
    # at the filesystem edge and return only bounded readable evidence.
    if suffix==".docx":
        try:
            import xml.etree.ElementTree as ET
            with zipfile.ZipFile(target) as archive:
                xml=archive.read("word/document.xml")
            root=ET.fromstring(xml)
            ns="{http://schemas.openxmlformats.org/wordprocessingml/2006/main}"
            paragraphs=[]
            for para in root.iter(ns+"p"):
                parts=[node.text or "" for node in para.iter(ns+"t")]
                if parts: paragraphs.append("".join(parts))
            text="\n".join(paragraphs).strip()
            if not text:
                return "DOCX contains no extractable text."
            offset=max(0,int(offset or 0)); limit=max(1000,min(int(max_chars or 12000),16000))
            chunk=text[offset:offset+limit]
            more=offset+len(chunk)<len(text)
            return f"READ RANGE · DOCX · chars {offset}-{offset+len(chunk)} of {len(text)}" + (" · more available" if more else " · end") + "\n" + chunk
        except (OSError,KeyError,zipfile.BadZipFile,ET.ParseError) as exc:
            return f"DOCX text extraction failed: {exc}"

    # PDF is a container format, not text. Extract deterministically at the
    # edge and give the model only readable text.
    if suffix==".pdf":
        pdftotext=shutil.which("pdftotext")
        if not pdftotext:
            return "PDF text extraction unavailable; install pdftotext (Poppler)."
        try:
            result=subprocess.run(
                [pdftotext,"-layout",str(target),"-"],
                capture_output=True,text=True,timeout=8
            )
            if result.returncode!=0:
                detail=result.stderr.strip()
                return "PDF text extraction failed." + (f" {detail[:300]}" if detail else "")
            text=result.stdout.strip()
            if not text:
                return "PDF contains no extractable text; it may be scanned/image-only."
            offset=max(0,int(offset or 0)); limit=max(1000,min(int(max_chars or 12000),16000))
            chunk=text[offset:offset+limit]
            more=offset+len(chunk)<len(text)
            return f"READ RANGE · chars {offset}-{offset+len(chunk)} of {len(text)}"+ (" · more available" if more else " · end") + "\n" + chunk
        except (OSError,subprocess.SubprocessError) as exc:
            return f"PDF text extraction failed: {exc}"

    try:
        if target.stat().st_size > 1_000_000:
            return "File is larger than the 1 MB read limit."
        data=target.read_bytes()
        if b"\x00" in data[:4096]:
            return "Binary file; text extraction unavailable for this format."
        text=data.decode("utf-8", errors="replace")
        offset=max(0,int(offset or 0)); limit=max(1000,min(int(max_chars or 12000),16000))
        chunk=text[offset:offset+limit]
        more=offset+len(chunk)<len(text)
        return f"READ RANGE · chars {offset}-{offset+len(chunk)} of {len(text)}"+ (" · more available" if more else " · end") + "\n" + chunk
    except OSError as exc:
        return f"Read failed: {exc}"


def _search_tokens(text):
    text=str(text or "").casefold().replace("_"," ").replace("-"," ")
    return [t for t in re.findall(r"\w+",text,flags=re.UNICODE) if len(t)>1]

def _locator_event(stage, detail="", started=None):
    elapsed=f"{int((time.monotonic()-started)*1000):>4} ms" if started is not None else ""
    msg=f"  locator · {stage:<12} {elapsed}"
    if detail: msg+=f" · {detail}"
    print(_c(msg,"2"),flush=True)

def _score_locate_candidate(p,strong,workspace):
    hay_tokens=set(_search_tokens(str(p)))
    matched=[t for t in strong if t in hay_tokens or any(t in h or h in t for h in hay_tokens if len(h)>2)]
    if not matched: return None
    score=(len(matched)/max(1,len(strong)))*100+len(matched)*8
    if p.suffix.casefold() in {".mp4",".mkv",".mov",".avi",".m4v",".webm",".mp3",".m4a",".flac",".wav",".ogg"}: score+=8
    if all(t in hay_tokens for t in matched): score+=4
    try: modified=p.stat().st_mtime
    except OSError: modified=0
    return score,modified,p

def _scan_locate_root(root,strong,workspace,max_depth=2,max_entries=12000,deadline=None):
    rows=[]; seen=0; root=Path(root)
    if not root.exists() or not root.is_dir(): return rows
    skip={"Library","node_modules","__pycache__",".git","Caches","cache",".Trash"}
    for current,dirs,files in os.walk(root):
        if deadline and time.monotonic()>=deadline: break
        cp=Path(current)
        try: depth=len(cp.relative_to(root).parts)
        except ValueError: continue
        dirs[:]=[d for d in dirs if not d.startswith(".") and d not in skip and depth<max_depth]
        for name in dirs+files:
            seen+=1
            if seen>max_entries: return rows
            scored=_score_locate_candidate(cp/name,strong,workspace)
            if scored: rows.append(scored)
    return rows

def _indexed_locate(query,strong,workspace,deadline):
    rows=[]
    if sys.platform=="darwin" and shutil.which("mdfind"):
        terms=[t for t in strong if len(t)>=2]
        expr=" && ".join([f"kMDItemFSName == '*{t.replace(chr(39), '')}*'cd" for t in terms[:4]])
        if not expr: return rows
        try:
            proc=subprocess.run(["mdfind",expr],capture_output=True,text=True,timeout=max(.25,deadline-time.monotonic()))
            paths=proc.stdout.splitlines()[:200]
        except (subprocess.TimeoutExpired,OSError): paths=[]
        for raw in paths:
            p=Path(raw)
            if _ordinary_user_path(p):
                scored=_score_locate_candidate(p,strong,workspace)
                if scored: rows.append(scored)
        return rows
    locator=shutil.which("plocate") or shutil.which("locate")
    if locator:
        seed=max(strong,key=len) if strong else str(query)
        try:
            proc=subprocess.run([locator,"-i","--",seed],capture_output=True,text=True,timeout=max(.25,deadline-time.monotonic()))
            paths=proc.stdout.splitlines()[:200]
        except (subprocess.TimeoutExpired,OSError): paths=[]
        for raw in paths:
            p=Path(raw)
            if _ordinary_user_path(p):
                scored=_score_locate_candidate(p,strong,workspace)
                if scored: rows.append(scored)
    return rows

def _tool_search_files(workspace,query,path="."):
    """Adaptive locator: nearby first, indexed broad discovery, bounded fallback."""
    qtokens=_search_tokens(query)
    if not qtokens: return "Search query is empty."
    weak={"find","file","files","movie","video","audio","open","play","please","the","a","an","my","can","you"}
    strong=[t for t in qtokens if t not in weak] or qtokens
    started=time.monotonic(); deadline=started+3.0; rows=[]; seen=set()
    def add(items):
        for row in items:
            key=str(row[2])
            if key not in seen: seen.add(key); rows.append(row)
    explicit=str(path or ".") not in {".","~",str(HOME)}
    if explicit:
        target=_safe_workspace_path(workspace,path,"read")
        _locator_event("explicit",str(target),started)
        add(_scan_locate_root(target,strong,workspace,4,20000,deadline))
    else:
        _locator_event("context",str(workspace),started)
        add(_scan_locate_root(workspace,strong,workspace,2,5000,started+.45))
        if not rows or max(r[0] for r in rows)<120:
            _locator_event("likely dirs","Movies · Downloads · Desktop · Documents",started)
            for likely in (HOME/"Movies",HOME/"Downloads",HOME/"Desktop",HOME/"Documents"):
                if time.monotonic()>=started+1.0: break
                add(_scan_locate_root(likely,strong,workspace,2,4000,started+1.0))
        if not rows or max(r[0] for r in rows)<120:
            _locator_event("LOOK catalog","metadata index",started)
            try:
                catalog_rows=file_catalog.search(FILE_CATALOG_DB,query,limit=80)
            except Exception:
                catalog_rows=[]
            scored=[]
            for item in catalog_rows:
                p=Path(str(item.get("path") or ""))
                if p.exists():
                    hit=_score_locate_candidate(p,strong,workspace)
                    if hit: scored.append(hit)
            add(scored)
        if not rows or max(r[0] for r in rows)<120:
            backend="Spotlight" if sys.platform=="darwin" else ("plocate/locate" if (shutil.which("plocate") or shutil.which("locate")) else "unavailable")
            _locator_event("OS index",backend,started)
            add(_indexed_locate(query,strong,workspace,deadline))
        if not rows and time.monotonic()<deadline:
            _locator_event("fallback","shallow home only",started)
            add(_scan_locate_root(HOME,strong,workspace,1,6000,deadline))
    _locator_event("done",f"{len(rows)} candidate(s)",started)
    if not rows: return f"No matches. · locator {int((time.monotonic()-started)*1000)} ms"
    rows.sort(key=lambda x:(x[0],x[1]),reverse=True)
    out=[]
    for score,_,p in rows[:20]:
        try: display=str(p.relative_to(workspace))
        except ValueError: display=str(p)
        out.append(f"{score:05.1f} · {display}{'/' if p.is_dir() else ''}")
    top=rows[0][0]; confidence="STRONG" if top>=120 else "PLAUSIBLE" if top>=60 else "WEAK"
    return f"MATCHES · {confidence} · locator {int((time.monotonic()-started)*1000)} ms\n" + "\n".join(out)

def _tool_search_content(workspace, query, path="."):
    """Explicit text-content search delegated to ripgrep; binary files stay binary."""
    target=_safe_workspace_path(workspace,path)
    if not target.exists() or not target.is_dir(): return f"Not a directory: {path}"
    needle=str(query or "").strip()
    if not needle: return "Search query is empty."
    rg=shutil.which("rg")
    if not rg: return "Content search requires ripgrep (rg)."
    proc=subprocess.run(
        [rg,"--line-number","--no-heading","--color","never","--smart-case",
         "--max-filesize","2M","--glob","!.*",needle,str(target)],
        capture_output=True,text=True,timeout=12
    )
    if proc.returncode not in (0,1): return f"Content search failed: {proc.stderr.strip()[:300]}"
    rows=proc.stdout.splitlines()[:100]
    return "\\n".join(rows) if rows else "No matches."

def _display_tool_path(workspace,path):
    path=Path(path).resolve()
    try: return str(path.relative_to(Path(workspace).resolve()))
    except ValueError: return str(path)


def _tool_write_file(workspace, path, content, overwrite=False):
    target=_safe_workspace_path(workspace, path, "write")
    if target.exists() and not overwrite:
        return f"Refusing to overwrite existing file: {path}. Set overwrite=true only when the user explicitly asked to replace it."
    if not target.parent.exists() or not target.parent.is_dir():
        return f"Parent directory does not exist: {_display_tool_path(workspace,target.parent)}"
    try:
        target.write_text(content, encoding="utf-8")
        return f"WRITE OK · {target.resolve()} · {len(content.encode('utf-8'))} bytes"
    except OSError as exc:
        return f"Write failed: {exc}"



def _tool_create_text_files(workspace, files):
    """Create several new text files atomically enough for chat use, with one undo record."""
    if not isinstance(files,list) or not files:
        return "Batch create refused: files must be a non-empty list."
    if len(files)>32:
        return "Batch create refused: maximum 32 files."

    root=Path(workspace).resolve()
    planned=[]
    seen=set()
    total_bytes=0
    for item in files:
        if not isinstance(item,dict):
            return "Batch create refused: every item needs path and content."
        raw=str(item.get("path","")).strip()
        content=str(item.get("content",""))
        if not raw:
            return "Batch create refused: empty path."
        target=_safe_workspace_path(workspace,raw,"write")
        key=str(target)
        if key in seen:
            return f"Batch create refused: duplicate path: {raw}"
        seen.add(key)
        if target.exists():
            return f"Batch create refused: path already exists: {raw}"
        if not target.parent.exists() or not target.parent.is_dir():
            return f"Batch create refused: parent directory does not exist: {_display_tool_path(workspace,target.parent)}"
        size=len(content.encode("utf-8"))
        total_bytes+=size
        if total_bytes>2_000_000:
            return "Batch create refused: combined text exceeds 2 MB."
        planned.append((target,content))

    created=[]
    try:
        for target,content in planned:
            target.write_text(content,encoding="utf-8")
            created.append({
                "kind":"create_text",
                "path":str(target),
                "sha256":_sha256_file(target),
            })
        _record_undo({"kind":"batch","items":created,"time":time.time()})
        shown=[str(Path(x["path"]).resolve()) for x in created[:6]]
        more=f"\n  +{len(created)-6} more" if len(created)>6 else ""
        paths="\n  ".join(shown)
        return f"CREATE FILES OK · {len(created)} files\n  {paths}{more}\n  undo available · lk undo"
    except OSError as exc:
        for item in reversed(created):
            try:
                p=Path(item["path"])
                if p.exists() and p.is_file() and _sha256_file(p)==item["sha256"]:
                    p.unlink()
            except OSError:
                pass
        return f"Batch create failed: {exc}"



def _sha256_file(path):
    digest=hashlib.sha256()
    with Path(path).open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024*1024), b""):
            digest.update(chunk)
    return digest.hexdigest()



def _load_undo():
    try:
        data=json.loads(UNDO_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, list) else []
    except (OSError, ValueError, json.JSONDecodeError):
        return []


def _save_undo(entries, trim=True):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    stored=entries[-UNDO_LIMIT:] if trim else entries
    UNDO_FILE.write_text(json.dumps(stored, indent=2), encoding="utf-8")
    try: os.chmod(UNDO_FILE, 0o600)
    except OSError: pass


def _record_undo(entry, batch_id=None):
    entry=dict(entry)
    if batch_id:
        entry["_batch_id"]=batch_id
    entries=_load_undo()
    entries.append(entry)

    # During a batch, keep every temporary transaction record even if the
    # normal undo ring is already full. `_batch_action` collapses them to one
    # public record and restores the normal cap at commit/rollback.
    if batch_id:
        _save_undo(entries, trim=False)
        return

    dropped=entries[:-UNDO_LIMIT]
    entries=entries[-UNDO_LIMIT:]
    _save_undo(entries)
    for old in dropped:
        trash=old.get("trash")
        if trash:
            try:
                p=Path(trash)
                if p.is_dir(): shutil.rmtree(p)
                elif p.exists(): p.unlink()
            except OSError:
                pass


def _undo_entry_label(entry):
    kind=str(entry.get("kind") or "unknown")
    if kind=="copy":
        return f"copy → {entry.get('destination','?')}"
    if kind=="move":
        return f"move {entry.get('destination','?')} → {entry.get('source','?')}"
    if kind=="remove":
        return f"remove {entry.get('source','?')}"
    if kind=="mkdir":
        return f"mkdir {entry.get('path','?')}"
    if kind=="touch":
        return f"create {entry.get('path','?')}"
    if kind=="batch":
        return f"batch · {len(entry.get('items',[]) or [])} items"
    return kind


def _undo_item_status(entry):
    """Classify whether an undo record is presently safe to execute."""
    kind=entry.get("kind")
    try:
        if kind=="copy":
            dst=Path(entry["destination"])
            if not dst.exists(): return "BLOCKED","copied destination no longer exists"
            expected=entry.get("sha256")
            if expected and dst.is_file() and _sha256_file(dst)!=expected:
                return "BLOCKED","copied file has changed"
            return "READY","copied destination still matches"
        if kind=="move":
            src=Path(entry["source"]); dst=Path(entry["destination"])
            if not dst.exists(): return "BLOCKED","moved path no longer exists"
            if src.exists(): return "BLOCKED","original location is occupied"
            return "READY","moved path can return to original location"
        if kind=="remove":
            original=Path(entry["source"]); trash=Path(entry["trash"])
            if original.exists(): return "BLOCKED","original location is occupied"
            if not trash.exists(): return "BLOCKED","recoverable item is no longer available"
            return "READY","recoverable item is available"
        if kind=="mkdir":
            path=Path(entry["path"])
            if not path.exists(): return "BLOCKED","directory no longer exists"
            if not path.is_dir() or any(path.iterdir()): return "BLOCKED","directory is no longer empty"
            return "READY","directory is empty"
        if kind=="touch":
            path=Path(entry["path"])
            if not path.exists() or not path.is_file(): return "BLOCKED","created file no longer exists"
            stat=path.stat()
            if stat.st_size!=0: return "BLOCKED","created file now contains data"
            expected=entry.get("mtime_ns")
            if expected is not None and stat.st_mtime_ns!=expected: return "BLOCKED","created file has changed"
            return "READY","created empty file is unchanged"
        if kind=="create_text":
            path=Path(entry["path"])
            if not path.exists() or not path.is_file(): return "BLOCKED","created file no longer exists"
            expected=entry.get("sha256")
            if expected and _sha256_file(path)!=expected: return "BLOCKED","created file has changed"
            return "READY","created text file still matches"
        if kind=="batch":
            items=entry.get("items",[]) or []
            for item in reversed(items):
                status,reason=_undo_item_status(item)
                if status!="READY":
                    return "BLOCKED",f"{Path(item.get('destination') or item.get('source') or item.get('path') or '?').name}: {reason}"
            return "READY",f"{len(items)} items can be reversed"
        return "BLOCKED","unknown undo record"
    except (OSError,KeyError,ValueError) as exc:
        return "BLOCKED",str(exc)


def _load_skipped_undo():
    try:
        data=json.loads(UNDO_SKIPPED_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data,list) else []
    except (OSError,ValueError,json.JSONDecodeError):
        return []


def _save_skipped_undo(entries):
    STATE_DIR.mkdir(parents=True,exist_ok=True)
    UNDO_SKIPPED_FILE.write_text(json.dumps(entries[-40:],indent=2),encoding="utf-8")
    try: os.chmod(UNDO_SKIPPED_FILE,0o600)
    except OSError: pass


def _undo_list():
    entries=_load_undo()
    skipped=_load_skipped_undo()
    _title("UNDO HISTORY","newest first")
    if not entries:
        print("  active       none")
    else:
        for n,entry in enumerate(reversed(entries),1):
            status,reason=_undo_item_status(entry)
            marker=_c("READY","32") if status=="READY" else _c("BLOCKED","33")
            age=_age_label(entry.get("time",0))
            print(f"  {n:>2}  {marker:<16} {_undo_entry_label(entry)}")
            print(f"      {_c(reason,'2')} · {age}")
    if skipped:
        print(f"\n  {_c('SKIPPED','2')} · recent abandoned records")
        for entry in reversed(skipped[-5:]):
            print(f"      {_undo_entry_label(entry)} · {_age_label(entry.get('skipped_at',0))}")
    print("\n  lk undo       reverse newest READY record")
    print("  lk undo skip  abandon newest BLOCKED record only")
    return 0


def _undo_skip():
    entries=_load_undo()
    if not entries:
        print("LOOK undo · nothing to skip")
        return 1
    entry=entries[-1]
    status,reason=_undo_item_status(entry)
    if status=="READY":
        print(f"{_c('✗','31')} LOOK undo · skip refused · newest record is still READY")
        print("  use `lk undo` to reverse it; skip is only for history that has diverged")
        return 1
    entries.pop()
    _save_undo(entries)
    archived=dict(entry)
    archived["skipped_at"]=time.time()
    archived["skip_reason"]=reason
    skipped=_load_skipped_undo(); skipped.append(archived); _save_skipped_undo(skipped)
    print(f"{_c('↷ SKIP','1;33')} · {entry.get('kind','unknown')}")
    print(f"  {_undo_entry_label(entry)}")
    print(f"  {reason}")
    print("  no filesystem change was made; older undo history is now reachable")
    return 0


def _undo_last():
    entries=_load_undo()
    if not entries:
        print("LOOK undo · nothing to undo")
        return 1
    entry=entries[-1]
    kind=entry.get("kind")
    try:
        if kind=="copy":
            dst=Path(entry["destination"])
            if not dst.exists():
                raise RuntimeError("copied destination no longer exists")
            expected=entry.get("sha256")
            if expected and dst.is_file() and _sha256_file(dst) != expected:
                raise RuntimeError("copied file has changed; refusing to remove it")
            if dst.is_dir(): shutil.rmtree(dst)
            else: dst.unlink()
            _cleanup_created_dirs(entry.get("created_dirs",[]))
            detail=f"removed copied {dst.name}"
        elif kind=="move":
            src=Path(entry["source"]); dst=Path(entry["destination"])
            if not dst.exists():
                raise RuntimeError("moved path no longer exists")
            if src.exists():
                raise RuntimeError("original location is occupied")
            shutil.move(str(dst), str(src))
            _cleanup_created_dirs(entry.get("created_dirs",[]))
            detail=f"{dst.name} → {src}"
        elif kind=="remove":
            original=Path(entry["source"]); trash=Path(entry["trash"])
            if original.exists():
                raise RuntimeError("original location is occupied")
            if not trash.exists():
                raise RuntimeError("recoverable item is no longer available")
            original.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(trash), str(original))
            detail=f"{original.name} restored"
        elif kind=="mkdir":
            path=Path(entry["path"])
            if not path.exists():
                raise RuntimeError("directory no longer exists")
            if not path.is_dir() or any(path.iterdir()):
                raise RuntimeError("directory is no longer empty; refusing to remove it")
            path.rmdir()
            _cleanup_created_dirs([p for p in entry.get("created_dirs",[]) if Path(p)!=path])
            detail=f"removed empty {path.name}/"
        elif kind=="touch":
            path=Path(entry["path"])
            if not path.exists():
                raise RuntimeError("created file no longer exists")
            if not path.is_file():
                raise RuntimeError("created path is no longer a regular file")
            stat=path.stat()
            if stat.st_size!=0:
                raise RuntimeError("created file now contains data; refusing to remove it")
            expected=entry.get("mtime_ns")
            if expected is not None and stat.st_mtime_ns!=expected:
                raise RuntimeError("created file has changed; refusing to remove it")
            path.unlink()
            _cleanup_created_dirs(entry.get("created_dirs",[]))
            detail=f"removed empty {path.name}"
        elif kind=="batch":
            items=entry.get("items",[])
            for item in reversed(items):
                ik=item.get("kind")
                if ik=="copy":
                    dst=Path(item["destination"])
                    if not dst.exists(): raise RuntimeError(f"{dst.name} no longer exists")
                    expected=item.get("sha256")
                    if expected and dst.is_file() and _sha256_file(dst)!=expected:
                        raise RuntimeError(f"{dst.name} changed; refusing batch undo")
                    if dst.is_dir(): shutil.rmtree(dst)
                    else: dst.unlink()
                    _cleanup_created_dirs(item.get("created_dirs",[]))
                elif ik=="move":
                    src=Path(item["source"]); dst=Path(item["destination"])
                    if not dst.exists(): raise RuntimeError(f"{dst.name} no longer exists")
                    if src.exists(): raise RuntimeError(f"{src} is occupied")
                    shutil.move(str(dst),str(src))
                    _cleanup_created_dirs(item.get("created_dirs",[]))
                elif ik=="remove":
                    original=Path(item["source"]); trash=Path(item["trash"])
                    if original.exists(): raise RuntimeError(f"{original} is occupied")
                    if not trash.exists(): raise RuntimeError(f"{original.name} is no longer recoverable")
                    original.parent.mkdir(parents=True,exist_ok=True)
                    shutil.move(str(trash),str(original))
                elif ik=="create_text":
                    path=Path(item["path"])
                    if not path.exists() or not path.is_file():
                        raise RuntimeError(f"{path.name} no longer exists")
                    expected=item.get("sha256")
                    if expected and _sha256_file(path)!=expected:
                        raise RuntimeError(f"{path.name} changed; refusing batch undo")
                    path.unlink()
            detail=f"{len(items)} items restored"
        else:
            raise RuntimeError("unknown undo record")
    except (OSError, RuntimeError) as exc:
        print(f"{_c('✗','31')} LOOK undo · refused · {exc}")
        return 1
    entries.pop()
    _save_undo(entries)
    print(f"{_c('↶ UNDO','1;32')} · {kind}")
    print(f"  {detail}")
    return 0





def _batch_action(kind, destination, paths):
    """Perform several LOOK mutations as one transaction, independent of undo-ring fullness."""
    if not paths:
        print(f"{_c('✗','31')} {kind.upper()} failed · no source paths")
        return 1

    txid=uuid.uuid4().hex
    results=[]
    failed_source=None
    try:
        if kind in {"copy","move"}:
            if len(paths)>1:
                raw=str(destination)
                if not raw.endswith(("/",os.sep)):
                    raw+=os.sep
                destination=raw

            for index,raw in enumerate(paths,1):
                failed_source=str(raw)
                result=_interactive_file_action(kind,raw,destination,batch_id=txid)
                if not result.startswith(("COPY OK","MOVE OK")):
                    raise RuntimeError(result)
                results.append(result)

        elif kind=="remove":
            for index,raw in enumerate(paths,1):
                failed_source=str(raw)
                result=_journal_remove(raw,batch_id=txid)
                if not result.startswith("REMOVE OK"):
                    raise RuntimeError(result)
                results.append(result)
        else:
            raise RuntimeError("unknown batch action")

        # Extract our records by transaction id, not journal length. This still
        # works when the bounded undo ring was already full before the batch.
        journal=_load_undo()
        created=[entry for entry in journal if entry.get("_batch_id")==txid]
        if len(created)!=len(paths):
            raise RuntimeError(
                f"transaction record mismatch · expected {len(paths)} items, recorded {len(created)}"
            )

        # Remove temporary transaction tags before exposing the public undo record.
        clean=[]
        for entry in created:
            item=dict(entry)
            item.pop("_batch_id",None)
            clean.append(item)

        survivors=[entry for entry in journal if entry.get("_batch_id")!=txid]
        survivors.append({
            "kind":"batch",
            "items":clean,
            "time":time.time(),
            "action":kind,
        })
        _save_undo(survivors[-UNDO_LIMIT:])

        _feedback("complete",f"{kind} complete")
        print(f"{kind.upper()} OK · {len(paths)} item{'s' if len(paths)!=1 else ''} · undo available · lk undo")
        receipt_limit=12
        for raw,result in list(zip(paths,results))[:receipt_limit]:
            # Compact receipt: show exactly what succeeded without repeating hashes.
            detail=result.split(" · undo available",1)[0]
            print(f"  ✓ {detail}")
        if len(results)>receipt_limit:
            print(f"  … {len(results)-receipt_limit} more succeeded")
        return 0

    except RuntimeError as exc:
        # Roll back only entries tagged with this transaction. We cannot use
        # `_undo_last()` here because unrelated older records may surround a
        # capped journal and the batch must remain self-contained.
        journal=_load_undo()
        created=[entry for entry in journal if entry.get("_batch_id")==txid]
        rollback_errors=[]
        rolled_back=0

        for item in reversed(created):
            try:
                ik=item.get("kind")
                if ik=="copy":
                    dst=Path(item["destination"])
                    if dst.exists():
                        expected=item.get("sha256")
                        if expected and dst.is_file() and _sha256_file(dst)!=expected:
                            raise RuntimeError(f"{dst.name} changed")
                        if dst.is_dir(): shutil.rmtree(dst)
                        else: dst.unlink()
                    _cleanup_created_dirs(item.get("created_dirs",[]))
                elif ik=="move":
                    src=Path(item["source"]); dst=Path(item["destination"])
                    if dst.exists():
                        if src.exists():
                            raise RuntimeError(f"{src} is occupied")
                        shutil.move(str(dst),str(src))
                    _cleanup_created_dirs(item.get("created_dirs",[]))
                elif ik=="remove":
                    original=Path(item["source"]); trash=Path(item["trash"])
                    if trash.exists():
                        if original.exists():
                            raise RuntimeError(f"{original} is occupied")
                        original.parent.mkdir(parents=True,exist_ok=True)
                        shutil.move(str(trash),str(original))
                rolled_back+=1
            except (OSError,RuntimeError) as rollback_exc:
                rollback_errors.append(str(rollback_exc))

        survivors=[entry for entry in journal if entry.get("_batch_id")!=txid]
        _save_undo(survivors)

        _feedback("error",f"{kind} failed")
        print(f"{_c('✗','31')} {kind.upper()} failed")
        if failed_source:
            print(f"  at       {failed_source}")
        print(f"  reason   {exc}")
        if created:
            if rollback_errors:
                print(f"  rollback {rolled_back}/{len(created)} restored")
                for error in rollback_errors[:4]:
                    print(f"           {_c('!','33')} {error}")
            else:
                print(f"  rollback {rolled_back}/{len(created)} restored · no partial {kind} remains")
        return 1


def _interactive_file_action(kind, src, dest, batch_id=None):
    action=_journal_copy if kind=="copy" else _journal_move
    result=action(src,dest,batch_id=batch_id)
    if result.startswith("CREATE_DIR_REQUIRED · "):
        needed=result.split(" · ",1)[1]
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            return result
        try:
            answer,cancelled=_prompt_line(
                f"{needed} does not exist\nM create directory and continue · Esc/Enter cancel › "
            )
        except KeyboardInterrupt:
            return "· cancelled"
        if cancelled or answer.strip().lower()!="m":
            return "· cancelled"
        result=action(src,dest,create_missing=True,batch_id=batch_id)
    return result


def _prompt_line(prompt):
    """Read one short action value; bare Esc cancels without Ctrl-C."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        try:
            return input(prompt),False
        except (EOFError,KeyboardInterrupt):
            return '',True
    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    chars=[]
    try:
        tty.setcbreak(fd)
        sys.stdout.write(prompt); sys.stdout.flush()
        while True:
            ch=os.read(fd,1)
            if ch==b'\x1b':
                sys.stdout.write('\n'); sys.stdout.flush()
                return '',True
            if ch in {b'\r',b'\n'}:
                sys.stdout.write('\n'); sys.stdout.flush()
                return ''.join(chars),False
            if ch in {b'\x7f',b'\b'}:
                if chars:
                    chars.pop()
                    sys.stdout.write('\b \b'); sys.stdout.flush()
                continue
            if ch==b'\x03':
                raise KeyboardInterrupt
            text=ch.decode('utf-8','ignore')
            if text and text.isprintable():
                chars.append(text)
                sys.stdout.write(text); sys.stdout.flush()
    finally:
        termios.tcsetattr(fd,termios.TCSADRAIN,old)


def _action_result(text):
    """Color only the CLI presentation; tool/API text stays plain."""
    if not sys.stdout.isatty():
        return text
    success_prefixes=("COPY OK","MOVE OK","REMOVE OK","MKDIR OK","FILE OK")
    if text.startswith(success_prefixes):
        head, sep, tail=text.partition(" · ")
        return f"{_c('✓','32')} {_c(head,'1;32')}{sep}{tail}"
    if any(word in text.lower() for word in ("failed","refused","mismatch")):
        return f"{_c('✗','31')} {text}"
    return text


def _destination_plan(src, requested):
    raw=str(requested)
    req=Path(requested).expanduser().resolve()
    directory_intent=raw.endswith(("/", os.sep)) or (req.exists() and req.is_dir())
    dst=req/src.name if directory_intent else req
    needed_root=req if directory_intent else dst.parent
    return req,dst,directory_intent,needed_root


def _final_destination(src, requested_destination):
    """Resolve the actual child path produced by a copy/move destination."""
    return _destination_plan(Path(src).expanduser().resolve(), requested_destination)[1]


def _copy_variant(path):
    path=Path(path)
    if path.is_dir() or not path.suffix:
        base=path.name
        suffix=""
    else:
        base=path.stem
        suffix=path.suffix
    parent=path.parent
    candidate=parent/f"{base} copy{suffix}"
    number=2
    while candidate.exists():
        candidate=parent/f"{base} copy {number}{suffix}"
        number+=1
    return candidate


def _missing_directories(path):
    path=Path(path)
    missing=[]
    cursor=path
    while not cursor.exists():
        missing.append(cursor)
        parent=cursor.parent
        if parent==cursor:
            break
        cursor=parent
    return list(reversed(missing))


def _make_missing_directories(path):
    created=[]
    for folder in _missing_directories(path):
        folder.mkdir()
        created.append(str(folder))
    return created


def _cleanup_created_dirs(paths):
    for raw in reversed(paths or []):
        p=Path(raw)
        try:
            if p.is_dir() and not any(p.iterdir()):
                p.rmdir()
        except OSError:
            pass


def _journal_copy(src, requested_destination, create_missing=False, batch_id=None):
    src=Path(src).expanduser().resolve()
    req,dst,directory_intent,needed_root=_destination_plan(src, requested_destination)
    if not src.exists():
        return f"Copy failed: source not found: {src}"
    if dst==src and req.exists() and req.is_dir():
        dst=_copy_variant(src)
        needed_root=dst.parent
    elif dst.exists():
        return f"Copy refused: destination already exists: {dst}"
    missing=_missing_directories(needed_root)
    if missing and not create_missing:
        return f"CREATE_DIR_REQUIRED · {needed_root}"
    created=[]
    try:
        if missing:
            created=_make_missing_directories(needed_root)
        if src.is_dir():
            shutil.copytree(src,dst,copy_function=shutil.copy2)
            files=sum(1 for p in dst.rglob("*") if p.is_file())
            _record_undo({"kind":"copy","destination":str(dst),"created_dirs":created,"time":time.time()}, batch_id=batch_id)
            return f"COPY OK · {src.name} → {dst} · directory · {files} files · undo available · lk undo"
        shutil.copy2(src,dst)
        source_hash=_sha256_file(src); destination_hash=_sha256_file(dst)
        if source_hash != destination_hash:
            try: dst.unlink()
            except OSError: pass
            _cleanup_created_dirs(created)
            return "Copy verification failed: SHA-256 mismatch; destination was removed."
        _record_undo({"kind":"copy","destination":str(dst),"sha256":destination_hash,"created_dirs":created,"time":time.time()}, batch_id=batch_id)
        return f"COPY OK · {src.name} → {dst} · {src.stat().st_size} bytes · SHA-256 verified identical · undo available · lk undo"
    except OSError as exc:
        _cleanup_created_dirs(created)
        return f"Copy failed: {exc}"


def _journal_move(src, requested_destination, create_missing=False, batch_id=None):
    src=Path(src).expanduser().resolve()
    req,dst,directory_intent,needed_root=_destination_plan(src, requested_destination)
    if not src.exists():
        return f"Move failed: source not found: {src}"
    if dst.exists():
        return f"Move refused: destination already exists: {dst}"
    missing=_missing_directories(needed_root)
    if missing and not create_missing:
        return f"CREATE_DIR_REQUIRED · {needed_root}"
    created=[]
    try:
        if missing:
            created=_make_missing_directories(needed_root)
        shutil.move(str(src),str(dst))
        _record_undo({"kind":"move","source":str(src),"destination":str(dst),"created_dirs":created,"time":time.time()}, batch_id=batch_id)
        return f"MOVE OK · {src.name} → {dst} · undo available · lk undo"
    except OSError as exc:
        _cleanup_created_dirs(created)
        return f"Move failed: {exc}"



def _journal_remove(path, batch_id=None):
    target=Path(path).expanduser().resolve()
    if not target.exists():
        return f"Remove failed: not found: {target}"
    if target == Path(target.anchor):
        return "Remove refused: filesystem root cannot be removed."
    try:
        UNDO_TRASH.mkdir(parents=True,exist_ok=True)
        token=f"{int(time.time()*1000)}-{uuid.uuid4().hex[:8]}"
        stash=UNDO_TRASH/token
        shutil.move(str(target),str(stash))
        _record_undo({"kind":"remove","source":str(target),"trash":str(stash),"time":time.time()}, batch_id=batch_id)
        return f"REMOVE OK · {target.name} · recoverable · undo available · lk undo"
    except OSError as exc:
        return f"Remove failed: {exc}"


def _journal_mkdir(path):
    target=Path(path).expanduser().resolve()
    if target.exists():
        return f"Directory already exists: {target}" if target.is_dir() else f"Create directory failed: path exists as a file: {target}"
    missing=_missing_directories(target)
    try:
        target.mkdir(parents=True)
        created=[str(p) for p in missing]
        _record_undo({"kind":"mkdir","path":str(target),"created_dirs":created,"time":time.time()})
        return f"MKDIR OK · {target} · undo available · lk undo"
    except OSError as exc:
        return f"Create directory failed: {exc}"


def _journal_touch(path, create_missing=False):
    target=Path(path).expanduser().resolve()
    if target.exists():
        return f"Create file refused: path already exists: {target}"

    parent=target.parent
    missing=_missing_directories(parent)
    if missing and not create_missing:
        return f"CREATE_DIR_REQUIRED · {parent}"

    created=[]
    try:
        if missing:
            created=_make_missing_directories(parent)
        target.touch(exist_ok=False)
        stat=target.stat()
        _record_undo({
            "kind":"touch",
            "path":str(target),
            "created_dirs":created,
            "mtime_ns":stat.st_mtime_ns,
            "time":time.time(),
        })
        return f"FILE OK · {target} · undo available · lk undo"
    except OSError as exc:
        _cleanup_created_dirs(created)
        return f"Create file failed: {exc}"



def _tool_copy_path(workspace, source, destination):
    src=_safe_workspace_path(workspace,source,"read")
    raw=Path(destination).expanduser()
    requested=raw if raw.is_absolute() else Path(workspace).resolve()/raw
    dst=_safe_workspace_path(workspace,str(requested),"write")
    # Existing directory destination is allowed, but the resulting child must also remain inside workspace.
    final=_final_destination(src,dst)
    _safe_workspace_path(workspace,str(final),"write")
    return _journal_copy(src,dst)


def _tool_move_path(workspace, source, destination):
    src=_safe_workspace_path(workspace,source,"read")
    raw=Path(destination).expanduser()
    requested=raw if raw.is_absolute() else Path(workspace).resolve()/raw
    dst=_safe_workspace_path(workspace,str(requested),"write")
    final=_final_destination(src,dst)
    _safe_workspace_path(workspace,str(final),"write")
    return _journal_move(src,dst)


DESKTOP_APP_CATEGORIES=("browser","editor","image","pdf","video","audio")


def _load_apps():
    try:
        data=json.loads(APPS_FILE.read_text(encoding="utf-8"))
        if not isinstance(data,dict): return {}
        return {k:str(v) for k,v in data.items() if k in DESKTOP_APP_CATEGORIES and str(v).strip()}
    except (OSError,ValueError,json.JSONDecodeError):
        return {}


def _save_apps(apps):
    STATE_DIR.mkdir(parents=True,exist_ok=True)
    _atomic_json(APPS_FILE,{k:v for k,v in apps.items() if k in DESKTOP_APP_CATEGORIES and v})
    try: os.chmod(APPS_FILE,0o600)
    except OSError: pass


def _path_app_category(path):
    import mimetypes
    path=Path(path)
    suffix=path.suffix.casefold()
    mime,_=mimetypes.guess_type(str(path))
    if suffix in {".html",".htm",".xhtml"}: return "browser"
    if suffix==".pdf": return "pdf"
    if mime:
        if mime.startswith("image/"): return "image"
        if mime.startswith("video/"): return "video"
        if mime.startswith("audio/"): return "audio"
        if mime.startswith("text/"): return "editor"
    if suffix in {".md",".txt",".json",".yaml",".yml",".toml",".py",".js",".ts",".css",".csv",".xml",".ini",".conf",".zsh",".sh"}:
        return "editor"
    return ""


_GENERATED_PREVIEW_PATH = None
_GENERATED_PREVIEW_AT = 0.0
_GENERATED_PREVIEW_DEDUPE_SECONDS = 8.0

def _mark_generated_preview(path):
    """Remember the automatic generation preview so an agent retry cannot open it twice."""
    global _GENERATED_PREVIEW_PATH, _GENERATED_PREVIEW_AT
    try:
        _GENERATED_PREVIEW_PATH = str(Path(path).expanduser().resolve())
        _GENERATED_PREVIEW_AT = time.monotonic()
    except Exception:
        _GENERATED_PREVIEW_PATH = None
        _GENERATED_PREVIEW_AT = 0.0

def _desktop_launch(target, category="", preview=False):
    """Open/preview a local path outside the terminal using OS defaults or preferences."""
    target=Path(target).expanduser().resolve()
    if not target.exists():
        return f"{'Preview' if preview else 'Open'} failed: not found: {target}"
    category=category or _path_app_category(target)
    if (category == "image" and _GENERATED_PREVIEW_PATH == str(target)
            and time.monotonic() - _GENERATED_PREVIEW_AT < _GENERATED_PREVIEW_DEDUPE_SECONDS):
        action="PREVIEW" if preview else "OPEN"
        return f"{action} OK · {target} · image · generated image already auto-previewed"
    apps=_load_apps()
    preferred=apps.get(category,"system")
    system=platform.system()
    try:
        if preview and system=="Darwin" and shutil.which("qlmanage"):
            subprocess.Popen(["qlmanage","-p",str(target)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            return f"PREVIEW OK · {target} · Quick Look"
        if system=="Darwin":
            cmd=["open"]
            if preferred and preferred!="system":
                cmd.extend(["-a",preferred])
            cmd.append(str(target))
        elif system=="Windows":
            if preferred and preferred!="system":
                cmd=[preferred,str(target)]
            else:
                os.startfile(str(target))  # type: ignore[attr-defined]
                return f"{'PREVIEW' if preview else 'OPEN'} OK · {target} · system"
        else:
            if preferred and preferred!="system":
                binary=shutil.which(preferred) or (preferred if Path(preferred).exists() else None)
                if not binary:
                    return f"Open failed: preferred {category or 'app'} is unavailable: {active}"
                cmd=[binary,str(target)]
            else:
                opener=shutil.which("xdg-open")
                if not opener:
                    return "Open unavailable: xdg-open was not found."
                cmd=[opener,str(target)]
        subprocess.Popen(cmd,stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        action="PREVIEW" if preview else "OPEN"
        app=preferred if preferred!="system" else "system"
        return f"{action} OK · {target} · {category or 'file'} · {app}"
    except OSError as exc:
        return f"{'Preview' if preview else 'Open'} failed: {exc}"


