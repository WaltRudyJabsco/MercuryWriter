def settings(initial_query=""):
    """Search-first control room over LOOK's existing settings and actions."""
    rows=_settings_rows()
    if not (sys.stdin.isatty() and sys.stdout.isatty() and shutil.which("fzf")):
        _title("settings","control room")
        last_section=None
        for _,section,label,value,description,_ in rows:
            if section!=last_section:
                print(f"\n  {section}")
                last_section=section
            print(f"  {label:<24} {value}")
            print(f"    {_c(description,'2')}")
        print("\n  interactive search requires fzf + a TTY")
        return 0

    # The search box is the navigation model: users can type concepts rather
    # than remember taxonomy or command spellings. Hidden keywords make natural
    # searches such as "GPU", "video", "safe", or "downloads" land correctly.
    query=str(initial_query or "").strip()
    while True:
        rows=_settings_rows()
        strip=_settings_status_strip(rows)
        payload="\n".join(
            f"{key}\t{section:<8}\t{label}\t{value}\t{description}\t{keywords}"
            for key,section,label,value,description,keywords in rows
        )+"\n"

        preview=(
            r"""printf '\033[1;36m%s\033[0m  \033[2m%s\033[0m\n\n%s\n\n\033[2mCurrent\033[0m  %s\n' """
            r"""{3} {2} {5} {4}"""
        )
        fzf_args=[
            "fzf",
            "--prompt","⌕ settings › ",
            "--header",f"LOOK CONTROL ROOM  ·  {strip}\nType to search anything · Enter open/change · Ctrl-U clear · Esc leave",
            "--height","~82%","--reverse","--no-multi",
            "--border=rounded","--info=inline-right",
            "--pointer=▶","--marker=◆",
            "--delimiter","\t",
            "--nth","2,3,4,5,6",
            "--with-nth","2,3,4",
            "--preview",preview,
            "--preview-window","right,44%,wrap,border-left",
        ]
        if query:
            fzf_args.extend(["--query",query])
            query=""
        result=subprocess.run(fzf_args,input=payload,text=True,capture_output=True)
        if result.returncode!=0 or not result.stdout.strip():
            return 0
        key=result.stdout.split("\t",1)[0].strip()

        # Leave a clean frame for sub-surfaces, then return to a freshly
        # regenerated control room so changed values are visible immediately.
        print()
        _settings_action(key)
        print()


