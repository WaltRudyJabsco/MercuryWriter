class _RollingThinking:
    def __init__(self, mode):
        self.mode=mode
        self.lines=[]
        self.started=False
        self.buffer=""

    def feed(self,text):
        if not text or self.mode=="quiet": return
        self.buffer+=text
        # Promote readable clauses/chunks instead of repainting every token.
        while True:
            m=re.search(r"(.{35,160}?(?:[.!?]\s+|\n)|.{120,160}(?:\s+|$))",self.buffer,re.S)
            if not m: break
            chunk=" ".join(m.group(1).split()).strip()
            self.buffer=self.buffer[m.end():]
            if chunk: self._show(chunk)

    def _show(self,chunk):
        if self.mode=="full":
            if not self.started:
                print("\n"+_lo_label("thinking","2"))
                self.started=True
            print("  "+_c(chunk,"2"),flush=True)
            return
        previous_count=len(self.lines)
        self.lines=(self.lines+[chunk])[-3:]
        if not sys.stdout.isatty():
            print("THINKING  "+chunk,flush=True); return
        if self.started and previous_count:
            # Cursor sits immediately below the previous rolling window.
            sys.stdout.write(f"\033[{previous_count}A")
        else:
            print()
            self.started=True
        width=max(30,shutil.get_terminal_size((100,24)).columns-13)
        for line in self.lines:
            clipped=line if len(line)<=width else line[:max(1,width-1)]+"…"
            sys.stdout.write("\r\033[2K"+_lo_label("thinking","2")+"  "+_c(clipped,"2")+"\n")
        sys.stdout.flush()

    def finish(self):
        tail=" ".join(self.buffer.split()).strip()
        if tail and self.mode!="quiet": self._show(tail)
        if self.started: print()

def _ollama_payload_has_images(payload_obj):
    return any(bool(message.get("images")) for message in payload_obj.get("messages",[]) if isinstance(message,dict))


def _ollama_http_error(exc):
    """Preserve Ollama's JSON error body; urllib's default string throws away the useful part."""
    detail=""
    try:
        raw=exc.read().decode("utf-8","replace").strip()
        if raw:
            try:
                parsed=json.loads(raw)
                detail=str(parsed.get("error") or raw)
            except Exception:
                detail=raw
    except Exception:
        pass
    label=f"HTTP {getattr(exc,'code','?')} {getattr(exc,'reason','Bad Request')}"
    return f"{label} · {detail}" if detail else label


def _fabric_client_module():
    # Installed LOOK and source-tree LOOK both find the same tiny Fabric client.
    candidates=[Path.home()/".local/share/future-crash-look/core", ROOT.parent/"core"]
    for path in candidates:
        if (path/"fabric_client.py").exists() and str(path) not in sys.path:
            sys.path.insert(0,str(path))
    import fabric_client
    return fabric_client


def _fabric_stream_chat(payload_obj, events=None, route=None):
    """Yield Ollama-shaped events through Fabric, preserving LO's vision retries."""
    client=_fabric_client_module()
    try:
        from conductor import classify as _conductor_classify, last_user_text as _conductor_last_user
        _req=["text"]
        if payload_obj.get("tools"): _req.append("tools")
        if payload_obj.get("think"): _req.append("thinking")
        if _ollama_payload_has_images(payload_obj): _req.append("vision")
        work_class=_conductor_classify(_conductor_last_user(payload_obj.get("messages")), requires=_req,
                                       has_images=_ollama_payload_has_images(payload_obj),
                                       tool_count=len(payload_obj.get("tools") or [])).public()
        if events: events.emit("conductor", **work_class)
    except Exception:
        work_class={"tier":"balanced","reason":"classifier unavailable","latency_bias":True,"quality_bias":True}
    attempts=[dict(payload_obj)]
    if _ollama_payload_has_images(payload_obj):
        without_tools=dict(payload_obj); without_tools.pop("tools",None); attempts.append(without_tools)
        without_think=dict(without_tools); without_think.pop("think",None); attempts.append(without_think)
    last=None
    for index,current in enumerate(attempts):
        requires=["text"]
        if current.get("tools"): requires.append("tools")
        if current.get("think"): requires.append("thinking")
        if _ollama_payload_has_images(current): requires.append("vision")
        if events: events.emit("fabric_route", requires=requires, retry=index)
        try:
            announced=False
            for event in client.stream_infer(current,requires=requires,priority="interactive",timeout=OLLAMA_CHAT_TIMEOUT,owner="lo",route=route,work_class=work_class):
                if event.get("_fabric_meta") == "route":
                    if events and not announced:
                        events.emit("fabric_worker", node=event.get("_fabric_node"), model=event.get("_fabric_model")); announced=True
                    continue
                if events and event.get("_fabric_node") and not announced:
                    events.emit("fabric_worker", node=event.get("_fabric_node"), model=event.get("_fabric_model")); announced=True
                yield event
            return
        except RuntimeError as exc:
            last=str(exc)
            if index==len(attempts)-1: raise
            if events: events.emit("inference_retry", reason="vision_compatibility", attempt=index+1)
            continue
    raise RuntimeError(last or "Fabric inference failed")


def _ollama_stream_chat(base,payload_obj, events=None):
    """Yield Ollama chat events; vision gets a narrow compatibility retry on HTTP 400."""
    import json, urllib.request, urllib.error
    original=dict(payload_obj); original["stream"]=True
    attempts=[original]
    if _ollama_payload_has_images(original):
        # Some Ollama/model combinations advertise vision+tools but reject the combined
        # request. Preserve the image conversation and defer tools for this inference.
        without_tools=dict(original); without_tools.pop("tools",None)
        attempts.append(without_tools)
        # Older multimodal runners can also reject thinking controls on image turns.
        without_think=dict(without_tools); without_think.pop("think",None)
        attempts.append(without_think)
    last_error=None
    for index,current in enumerate(attempts):
        request=urllib.request.Request(
            base+"/api/chat",data=json.dumps(current).encode(),
            headers={"Content-Type":"application/json"},method="POST"
        )
        try:
            with urllib.request.urlopen(request, timeout=OLLAMA_CHAT_TIMEOUT) as response:
                if index:
                    note="tools deferred" if index==1 else "tools/thinking deferred"
                    print(f"{_ansi_label('vision ›','33')} compatibility retry · {note}")
                for raw in response:
                    if not raw.strip(): continue
                    yield json.loads(raw)
                return
        except urllib.error.HTTPError as exc:
            last_error=_ollama_http_error(exc)
            # Some model runners lose the user-query anchor after a tool result
            # (notably on long extracted document evidence). Re-anchor once,
            # preserving the tool result and original conversation instead of
            # failing an otherwise successful document read.
            if (getattr(exc,"code",None)==500 and "no user query found in messages" in last_error.casefold()
                    and not current.get("_look_reanchored")):
                retry=dict(current)
                retry.pop("_look_reanchored",None)
                prior_messages=list(current.get("messages",[]))
                latest_user=""
                for _m in reversed(prior_messages):
                    if _m.get("role")=="user" and str(_m.get("content","")).strip():
                        latest_user=str(_m.get("content","")).strip()
                        break
                anchor=("CURRENT USER TASK: "+latest_user+"\n"
                        if latest_user else "CURRENT USER TASK: answer the current resource request.\n")
                retry["messages"]=prior_messages+[{
                    "role":"user",
                    "content":anchor+"Use only the tool/resource evidence from this current task. "
                              "Do not resume or import subjects from historical conversation context. "
                              "If required resource evidence is unavailable, say so instead of guessing."
                }]
                request2=urllib.request.Request(
                    base+"/api/chat",data=json.dumps(retry).encode(),
                    headers={"Content-Type":"application/json"},method="POST"
                )
                try:
                    with urllib.request.urlopen(request2, timeout=OLLAMA_CHAT_TIMEOUT) as response:
                        if events: events.emit("inference_retry", reason="document_reanchor")
                        print(f"{_ansi_label('document ›','33')} model continuation re-anchored")
                        for raw in response:
                            if raw.strip(): yield json.loads(raw)
                        return
                except urllib.error.HTTPError as exc2:
                    raise RuntimeError(_ollama_http_error(exc2)) from None
            if getattr(exc,"code",None)!=400 or index==len(attempts)-1:
                raise RuntimeError(last_error) from None
            continue
    raise RuntimeError(last_error or "Ollama vision request failed")

def _answer_inspection_command(answer):
    """Recover a known-safe inspection command mentioned by a prose-only model answer."""
    text=str(answer or "")
    candidates=[]
    candidates.extend(re.findall(r"`([^`\n]{2,180})`",text))
    # Also catch common bare observational commands in prose.
    for pat in (
        r"\b(ollama\s+--version)\b",
        r"\b(git\s+--version)\b",
        r"\b(python3?\s+--version)\b",
        r"\b(nvidia-smi)\b",
    ):
        candidates.extend(re.findall(pat,text,re.I))
    for candidate in candidates:
        command=" ".join(str(candidate).split()).strip()
        if _inspection_command(command):
            return command
    return ""


def _looks_like_tool_refusal(answer):
    low=" ".join(str(answer or "").split()).casefold()
    patterns=(
        "i can't run","i cannot run","i don’t have permission","i don't have permission",
        "current toolset does not provide","run it in your terminal","run the command",
        "please run","you can run","execute it yourself","i can't check","i cannot check",
    )
    return any(p in low for p in patterns)


def _lo_repeat_intent(text):
    low=" ".join(str(text or "").casefold().split())
    if not low: return False
    exact={"again","again again","again again :)","do it again","play it again","play again",
           "open it again","open that again","show it again","run it again","try it again","that again","one more time"}
    return low in exact or bool(re.fullmatch(r"(please\s+)?(play|open|show|do)?\s*(it|that)?\s*again[!. :)]*",low))

def _lo_action_from_tool(name,args,result):
    """Compact ephemeral referent after an actionable host attempt."""
    if name=="run_command":
        command=str(args.get("command") or "").strip()
        return {"tool":name,"args":dict(args),"path":command} if command else None
    if name not in {"open_path","preview_path","reveal_path","open_url"}: return None
    if not str(result).startswith(("OPEN OK","DISPATCH OK","PREVIEW OK","REVEAL OK","URL OPEN OK")): return None
    path=str(args.get("path") or args.get("url") or "").strip()
    return {"tool":name,"args":dict(args),"path":path} if path else None

def ollama_chat(force_search=False, initial_prompt=None, allow_start=True, host_override=None, host_name=None, access_profile=None, selected_paths=None, workspace_override=None, one_shot=False, confirm_unsafe_override=False, events=None, conversation_history=None, interface_context=None):
    """Minimal local chat; optional first prompt and web-search mode."""
    import json
    import urllib.request

    # Normal LO belongs to Fabric. Explicit @host/--host and OLLAMA_HOST remain
    # deliberate compatibility/debug escape hatches to direct Ollama streaming.
    fabric_mode = not host_override and not os.environ.get("OLLAMA_HOST","").strip()
    base = _ollama_base(host_override) if not fabric_mode else LOCAL_OLLAMA_URL
    if events:
        events.emit("request_start")
        events.emit("endpoint_resolved", endpoint=("fabric://automatic" if fabric_mode else base),
                    host=("fabric" if fabric_mode else (host_name or _ollama_host_name(base))),
                    source=("fabric" if fabric_mode else ("override" if host_override else "environment")))
    profile=(access_profile or _load_lo_profile()).lower()
    if profile not in LO_PROFILES:
        print(f"LOOK OLLAMA · unknown access profile: {profile}")
        return 1
    if profile=="unsafe" and confirm_unsafe_override and not _confirm_unsafe_session():
        print("· cancelled")
        return 0

    if fabric_mode:
        # Model selection happens on the selected worker. Each node advertises its
        # machine-local preferred model; capability requirements filter first.
        running_names=[]; installed=[]; installed_names=[]
        model=""; resident=False; model_caps=None
        supports_thinking=True; supports_vision=True; supports_tools=True
        if events: events.emit("model_selected", model="fabric:auto")
    else:
        running = _ensure_ollama_server(base, allow_start=(allow_start and _is_local_ollama(base)))
        if running is None:
            if events:
                events.emit("error", stage="endpoint", error="server unavailable")
                events.emit("request_done", status="error")
            print("LOOK OLLAMA · server unavailable")
            return 1
        running_names = [(m.get("name") or m.get("model") or "").strip() for m in (running or [])]
        running_names = [name for name in running_names if name]
        try: installed = _ollama_tags(base)
        except Exception: installed = []
        installed_names = [(m.get("name") or m.get("model") or "").strip() for m in installed]
        installed_names = [name for name in installed_names if name]
        active = _preferred_model_for_base(base, installed=installed, running=running)
        if active in installed_names: model = active
        elif installed_names:
            print(f"LOOK OLLAMA · active model is not installed on this host: {active}")
            return 1
        else:
            print(f"LOOK OLLAMA · {_ollama_host_name(base)} is reachable, but has no models installed")
            return 1
        resident = model in running_names
        if events:
            events.emit("model_selected", model=model)
            events.emit("model_resident", model=model, resident=resident, running_models=running_names)
        model_caps=_ollama_capabilities(base, model)
        supports_thinking=bool(model_caps and "thinking" in model_caps)
        supports_vision=bool(model_caps and "vision" in model_caps)
        supports_tools=(model_caps is None or "tools" in model_caps)

    workspace = Path(workspace_override).expanduser().resolve() if workspace_override else _safe_cwd().resolve()
    selected_paths=[Path(p).expanduser().resolve() for p in (selected_paths or [])]
    resource_refs=_resource_refs(selected_paths,"LOOK selection")
    # Resource handles persist cheaply across the session; raw image payloads do not.
    resource_archive=list(resource_refs)
    observed_image_paths=set()
    fresh_image_paths={str(p) for p in _resource_image_paths(resource_refs)}

    has_web = True  # Fabric web.search is attempted first; provider failure is reported by the tool.
    mode = "LOOK OLLAMA SEARCH" if force_search else "LOOK OLLAMA"
    web_state = "required" if force_search else ("available" if has_web else "off")
    shown_host=("fabric:auto" if fabric_mode else (host_name or _ollama_host_name(base)))
    state=_c("●","32")
    title="LO SEARCH" if force_search else "LO"
    shown_model=("auto" if fabric_mode else model)
    print(f"{_c(title,'1;36')} · {shown_model} · {shown_host} {state}   {_c(profile.upper(),'2')} · {_load_thinking()}/{_load_think_display()}")
    pool=_load_ai_pool()
    fast_cfg=pool.get("roles",{}).get("fast",{})
    if fast_cfg.get("model"):
        print(_c(f"AI pool · primary {shown_host}/{model} · fast {fast_cfg.get('host','auto')}/{fast_cfg.get('model')}","2"))
    print(_c(str(workspace),"2"))
    extras=[]
