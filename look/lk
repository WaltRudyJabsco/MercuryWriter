def _reveal_host_path(path):
    """Reveal a path in the host file manager without mutating it."""
    target=Path(path).expanduser().resolve()
    if not target.exists():
        return f"Reveal failed: not found: {target}"
    try:
        system=platform.system()
        if system=="Darwin":
            subprocess.Popen(["open","-R",str(target)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        elif system=="Windows":
            if target.is_dir():
                subprocess.Popen(["explorer",str(target)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            else:
                subprocess.Popen(["explorer",f"/select,{target}"],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        else:
            opener=shutil.which("xdg-open")
            if not opener:
                return "Reveal unavailable: xdg-open was not found."
            # Freedesktop has no universal select-file verb; opening the parent
            # is the portable Linux behavior.
            shown=target if target.is_dir() else target.parent
            subprocess.Popen([opener,str(shown)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        return f"REVEAL OK · {target}"
    except OSError as exc:
        return f"Reveal failed: {exc}"


