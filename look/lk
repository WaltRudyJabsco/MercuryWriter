def _resolve_action_target(args):
    """Resolve one LK argument; multiple arguments remain literal CLI grammar."""
    target=Path(" ".join(args)).expanduser()
    if target.exists() or len(args)!=1:
        return target, []
    phrase=args[0].strip()
    try:
        matches=file_catalog.resolve_paths(FILE_CATALOG_DB,phrase)
    except (OSError,sqlite3.Error):
        matches=[]
    # Never launch a stale catalog entry.
    matches=[m for m in matches if Path(m["path"]).exists()]
    if len(matches)==1:
        return Path(matches[0]["path"]), matches
    if matches:
        best=matches[0]
        # A unique exact-basename match is deterministic even if weaker path matches exist.
        tied=[m for m in matches if m.get("score")==best.get("score")]
        if best.get("score",0)>=1000 and len(tied)==1:
            return Path(best["path"]), matches
    return target, matches


