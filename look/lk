def _extract_audio_pseudocall(text):
    """Recover a model-authored speech pseudo-call into a real host action.

    Tool syntax printed as prose is never a receipt.  This parser is deliberately
    narrow and exists only to repair the common audiospeak(...) failure once.
    """
    raw=str(text or "").strip()
    m=re.search(r"(?:audio_?speak|audiospeak)\s*\(\s*text\s*=\s*([\"'])(.*?)\1(?:\s*,\s*(?:voice_?profile|voiceprofile)\s*=\s*([\"'])(.*?)\3)?\s*\)",raw,re.I|re.S)
    if not m: return None
    spoken=" ".join(m.group(2).split())
    if not spoken or len(spoken)>1000: return None
    return {"text":spoken,"voice_profile":m.group(4) or "default"}

def _lo_requires_speech(prompt):
