def _when_label(ts):
    try: delta=float(ts)-time.time()
    except Exception: return "unknown"
    if delta<=0: return "due"
    if delta<60: return f"in {int(delta)}s"
    if delta<3600: return f"in {int(delta/60)}m"
    if delta<86400: return f"in {int(delta/3600)}h"
    return f"in {int(delta/86400)}d"


def _load_schedule():
    try:
        data=json.loads(SCHEDULE_FILE.read_text(encoding="utf-8"))
        if isinstance(data,list): return data
    except (OSError,ValueError,TypeError):
        pass
    return []


def _save_schedule(rows):
    STATE_DIR.mkdir(parents=True,exist_ok=True)
    _atomic_json(SCHEDULE_FILE,rows)
    try: os.chmod(SCHEDULE_FILE,0o600)
    except OSError: pass


def _parse_duration(text):
    m=re.fullmatch(r"\s*(\d+)\s*([smhdw])\s*",str(text or "").casefold())
    if not m: return None
    value=int(m.group(1)); unit=m.group(2)
    return value*{"s":1,"m":60,"h":3600,"d":86400,"w":604800}[unit]


def _next_daily(clock,after=None):
    import datetime
    after=datetime.datetime.fromtimestamp(after or time.time())
    try:
        hh,mm=(int(x) for x in clock.split(":",1))
    except Exception:
        return None
    if not (0<=hh<=23 and 0<=mm<=59): return None
    candidate=after.replace(hour=hh,minute=mm,second=0,microsecond=0)
    if candidate.timestamp()<=after.timestamp():
        candidate+=datetime.timedelta(days=1)
    return candidate.timestamp()


def _schedule_add(kind,spec,prompt,workspace=None,profile=None):
    rows=_load_schedule()
    now=time.time()
    job={
        "id":uuid.uuid4().hex[:8],
        "enabled":True,
        "kind":kind,
        "spec":str(spec),
        "prompt":str(prompt).strip(),
        "workspace":str(Path(workspace or _safe_cwd()).resolve()),
        "profile":profile or _load_lo_profile(),
        "created_at":now,
        "last_run":0,
        "next_run":0,
    }
    if kind=="in":
        seconds=_parse_duration(spec)
        if not seconds: raise ValueError("duration must look like 10m, 2h, 1d")
        job["next_run"]=now+seconds
    elif kind=="every":
        seconds=_parse_duration(spec)
        if not seconds: raise ValueError("interval must look like 10m, 2h, 1d")
        job["interval_s"]=seconds
        job["next_run"]=now+seconds
    elif kind=="daily":
        nxt=_next_daily(spec,now)
        if not nxt: raise ValueError("daily time must be HH:MM")
        job["next_run"]=nxt
    else:
        raise ValueError("unsupported schedule kind")
    rows.append(job)
    _save_schedule(rows)
    _ai_broker_wake("schedule")
    return job


def _schedule_due(now=None):
    now=now or time.time()
    return [j for j in _load_schedule() if j.get("enabled",True) and float(j.get("next_run",0) or 0)<=now and float(j.get("next_run",0) or 0)>0]


def _schedule_advance(job,now=None):
    now=now or time.time()
    kind=job.get("kind")
    if kind=="in":
        job["enabled"]=False
        job["next_run"]=0
    elif kind=="every":
        interval=max(60,int(job.get("interval_s") or _parse_duration(job.get("spec")) or 3600))
        nxt=float(job.get("next_run",now))
        while nxt<=now: nxt+=interval
        job["next_run"]=nxt
    elif kind=="daily":
        job["next_run"]=_next_daily(str(job.get("spec")),now) or 0
    job["last_run"]=now
    return job


def _schedule_dispatch_due():
    """Queue due schedules into the normal LO background-job machinery."""
    rows=_load_schedule()
    now=time.time()
    changed=False
    dispatched=0
    for job in rows:
        if not job.get("enabled",True): continue
        next_run=float(job.get("next_run",0) or 0)
        if not next_run or next_run>now: continue
        # Queue directly without printing; broker owns this call.
        LO_JOBS_DIR.mkdir(parents=True,exist_ok=True)
        job_id=uuid.uuid4().hex[:10]
        path=LO_JOBS_DIR/f"{job_id}.json"
        payload={
            "id":job_id,"status":"queued","prompt":job.get("prompt",""),
            "workspace":job.get("workspace") or str(HOME),
            "profile":job.get("profile") or "workspace",
            "created_at":now,"started_at":None,"finished_at":None,
            "scheduled_from":job.get("id"),
        }
        _atomic_json(path,payload)
        _schedule_advance(job,now)
        changed=True; dispatched+=1
    if changed:
        _save_schedule(rows)
    return dispatched


def schedule_command(args):
    rows=_load_schedule()
    if not args or args[0] in {"list","status"}:
        _title("LOOK SCHEDULE","persistent jobs")
        if not rows:
            print("  no scheduled jobs")
        for j in rows:
            state="on" if j.get("enabled",True) else "off"
            nxt=_when_label(j.get("next_run",0)) if j.get("next_run") else "done"
            print(f"  {j.get('id')}  {state:<3}  {j.get('kind')} {j.get('spec'):<8}  next {nxt:<14}  {str(j.get('prompt',''))[:72]}")
        print("\n  add: lk schedule in 30m PROMPT")
        print("       lk schedule every 2h PROMPT")
        print("       lk schedule daily 08:00 PROMPT")
        print("  manage: lk schedule pause|resume|remove ID")
        return 0
    action=args[0].casefold()
    if action in {"in","every","daily"}:
        if len(args)<3:
            print(f"usage: lk schedule {action} SPEC PROMPT"); return 2
        try:
            job=_schedule_add(action,args[1]," ".join(args[2:]))
        except ValueError as exc:
            print(f"LOOK schedule · {exc}"); return 2
        print(f"LOOK schedule · {job['id']} · {action} {job['spec']} · next {_when_label(job['next_run'])}")
        return 0
    if action in {"pause","resume","remove","run"} and len(args)>=2:
        target=args[1]
        found=False
        for j in list(rows):
            if str(j.get("id"))!=target: continue
            found=True
            if action=="pause": j["enabled"]=False
            elif action=="resume":
                j["enabled"]=True
                if not j.get("next_run"):
                    if j.get("kind")=="every": j["next_run"]=time.time()+int(j.get("interval_s",3600))
                    elif j.get("kind")=="daily": j["next_run"]=_next_daily(str(j.get("spec"))) or 0
            elif action=="remove": rows.remove(j)
            elif action=="run":
                j["next_run"]=time.time()
            break
        if not found:
            print(f"LOOK schedule · not found: {target}"); return 1
        _save_schedule(rows); _ai_broker_wake("schedule")
        print(f"LOOK schedule · {action} · {target}")
        return 0
    print("usage: lk schedule [list|in SPEC PROMPT|every SPEC PROMPT|daily HH:MM PROMPT|pause ID|resume ID|remove ID|run ID]")
    return 2


