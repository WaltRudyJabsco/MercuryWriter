def _media_on_command(args):
    if len(args)<2:
        print("usage: lk media on NODE play TARGET | toggle|next|prev|stop|state")
        return 2
    node=str(args[0]).strip()
    action=str(args[1]).casefold()
    try:
        if action=="play":
            if len(args)<3:
                print("usage: lk media on NODE play TARGET")
                return 2
            payload=_media_fabric_cli(["media-play","--node",node," ".join(args[2:])])
        elif action=="state":
            payload=_media_fabric_cli(["media-state","--node",node])
        elif action in {"toggle","playpause","pause","next","prev","previous","stop"}:
            mapped={"playpause":"toggle","previous":"prev"}.get(action,action)
            payload=_media_fabric_cli(["media-control","--node",node,mapped])
        else:
            print("usage: lk media on NODE play TARGET | toggle|next|prev|stop|state")
            return 2
    except RuntimeError as exc:
        print(f"LOOK media · {exc}")
        return 1
    if action=="state":
        print(json.dumps(payload,ensure_ascii=False,separators=(",",":")))
    else:
        msg=str(payload.get("message") or "").strip()
        print(msg or f"LOOK media · {action} · {node}")
    return 0

def media(args):
    raw=(args[0].lower() if args else "status")
    if raw in {"classics","classical"}:
        url="https://allclassical.streamguys1.com/ac128kmp3"
        session=media_core.new_session([{"title":"All Classical Radio","artist":"KQAC · Portland","path":url,"media_type":"audio/mpeg","kind":"audio","source_kind":"stream"}])
        return _media_launch_stream(url,"All Classical Radio",session=session)
    if raw in {"arts","showcase","classic-arts"}:
        # Easter egg: prefer reliability over a bespoke native-video path.
        # Albert still embeds/fits CAS; terminal LOOK opens the official feed.
        url="https://www.classicartsshowcase.org/watch-classic-arts-showcase/"
        result=_tool_open_url(url)
        ok=isinstance(result,str) and result.startswith("URL OPEN OK")
        print("LOOK media · Classic Arts Showcase · default browser" if ok else f"LOOK media · {result}")
        return 0 if ok else 1
    if raw=="add": return _media_add_command(args[1:])
    if raw=="info": return _media_info_command(args[1:])
    if raw in {"stream","open"}: return _media_stream_command(args[1:])
    if raw=="scan": return _media_scan_command(args[1:])
    if raw in {"library","lib"}: return _media_library_command()
    if raw in {"fabric","catalog"}: return _media_fabric_command()
    if raw in {"outputs","output"}: return _media_outputs_command()
    if raw=="on": return _media_on_command(args[1:])
    if raw=="mp": return media_mp(" ".join(args[1:]))
    if raw=="find": return _media_find_command(args[1:])
    if raw=="browse": return _media_browse_command(args[1:])
    if raw=="identify": return _media_identify_command(args[1:])
    if raw=="complete": return _media_complete_command(args[1:])
    if raw=="artists": return _media_group_command("artist",args[1:])
    if raw=="albums": return _media_group_command("album",args[1:])
    if raw=="queue": return _media_queue_command()
    if raw in {"doctor","diagnose","debug"}: return _media_doctor()
    if raw=="clear": return _media_clear_command()
    if raw in {"playlist","playlists"}: return _media_playlist_command(args[1:] if raw=="playlist" else ["list"])
    if raw=="save":
        if len(args)<2: print("usage: lk media save NAME"); return 2
        return _media_playlist_save(" ".join(args[1:]))
    if raw=="load":
        if len(args)<2: print("usage: lk media load NAME [--shuffle]"); return 2
        rest=args[1:]; shuffle="--shuffle" in rest
        return _media_playlist_load(" ".join(x for x in rest if x!="--shuffle"),shuffle=shuffle)
    if raw=="repeat": return _media_repeat_command(args[1:])
    if raw in {"state","json"}:
        print(json.dumps(_media_snapshot_payload(),ensure_ascii=False,separators=(",",":")))
        return 0
    if raw=="session-json":
        print(json.dumps(_media_full_session_payload(),ensure_ascii=False,separators=(",",":")))
        return 0
    if raw=="adopt":
        if len(args)!=2:
            print("usage: lk media adopt SESSION.json|- ")
            return 2
        return _media_adopt_session(args[1])
    if raw=="jump":
        if len(args)!=2:
            print("usage: lk media jump INDEX")
            return 2
        try: target=int(args[1])-1
        except ValueError:
            print("usage: lk media jump INDEX")
            return 2
        result=_media_jump_index(target)
        if result is None:
            print("LOOK media · no active queue")
            return 1
        if result==0: _media_control_session("status")
        return result
    if raw=="prepare" and len(args)>1: return _media_prepare_command(args[1:])
    if raw=="play" and len(args)>1: return _media_play_command(args[1:])

    aliases={"playpause":"toggle","previous":"prev","back":"prev"}
    action=aliases.get(raw,raw)
    if action not in {"status","play","pause","toggle","next","prev","stop"}:
        print("usage: lk media [browse|find QUERY|fabric|outputs|on NODE play TARGET|identify QUERY|--all|play [TARGET] [--shuffle] [--exact]|pause|toggle|next|prev|stop|queue|doctor|clear|state|jump INDEX]")
        print("                [scan ROOT|scan --relocate OLD_ROOT NEW_ROOT|library|find QUERY|artists|albums|playlist ...|repeat [off|all]]")
        print("                [add PATH|stream PATH|stream @NODE DIGEST|info [@NODE] DIGEST]")
        return 2

    # Transport follows a real player session, never mere queue metadata.
    # A newly playing external app wins immediately. LOOK owns transport only
    # while mpv has a loaded item (playing or paused). A previously claimed
    # paused system player may retain ownership. A stopped LOOK queue does not.
    playing_system=_media_system_owner(include_paused_owner=False)
    if playing_system:
        return _media_system_control(action,playing_system)

    if _media_mpv_loaded():
        result=_media_control_session(action)
        if result is not None:
            if action not in {"status","stop"}: _media_control_session("status")
            return result

    remembered_system=_media_system_owner(include_paused_owner=True)
    if remembered_system:
        return _media_system_control(action,remembered_system)

    # Explicit `lk media play` may intentionally resume a saved LOOK queue. The
    # global transport keys (toggle/next/prev/pause/stop) may not manufacture a
    # session from stale queue state.
    if action=="play":
        result=_media_control_session("play")
        if result is not None:
            if result==0: _media_control_session("status")
            return result
    if action=="status":
        session=_media_session()
        if session and session.get("queue"):
            session=_media_sync_session(session) or session
            entry=(session.get("queue") or [{}])[max(0,min(int(session.get("current_index") or 0),len(session.get("queue") or [{}])-1))]
            print(f"LOOK media · {session.get('state') or 'stopped'} · {_media_entry_label(entry)} · {int(session.get('current_index') or 0)+1}/{len(session.get('queue') or [])}")
            return 0
    print("LOOK media · no active media session")
    return 1


