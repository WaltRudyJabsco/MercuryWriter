def _tailscale_serve_status_text():
    tailscale=shutil.which("tailscale")
    if not tailscale: return ""
    try:
        proc=subprocess.run([tailscale,"serve","status"],capture_output=True,text=True,timeout=3)
        return (proc.stdout or "")+(proc.stderr or "")
    except Exception:
        return ""


def _service_alive(name,item):
    port=int(item.get("target_port",0) or 0)
    if not port: return False
    if name=="ollama":
        return _probe_ollama(LOCAL_OLLAMA_URL,.4)
    if name=="comfy":
        ok,_=_comfy_probe("http://127.0.0.1:8188",timeout=.5)
        return ok
    import socket
    try:
        with socket.create_connection(("127.0.0.1",port),timeout=.35):
            return True
    except OSError:
        return False


def _service_share_one(name,item):
    tailscale=shutil.which("tailscale")
    if not tailscale:
        return False,"Tailscale is not installed."
    if name=="ollama":
        rc=ollama_share([])
        return rc==0,("shared" if rc==0 else "Ollama share failed")
    target=int(item.get("target_port",0) or 0)
    https_port=int(item.get("https_port",0) or target)
    if not target:
        return False,f"{name} has no configured local port"
    if not _service_alive(name,item):
        return False,f"{name} is not listening on localhost:{target}"
    proc=subprocess.run(
        [tailscale,"serve","--bg",f"--https={https_port}",f"localhost:{target}"],
        capture_output=True,text=True
    )
    if proc.returncode==0:
        return True,f"https {https_port} → localhost:{target}"
    detail=(proc.stderr or proc.stdout or "").strip().splitlines()
    return False,(detail[-1] if detail else "Tailscale Serve failed")


def _service_unshare_one(name,item):
    tailscale=shutil.which("tailscale")
    if not tailscale:
        return False,"Tailscale is not installed."
    if name=="ollama":
        rc=ollama_share(["off"])
        return rc==0,("off" if rc==0 else "Ollama unshare failed")
    port=int(item.get("https_port",0) or item.get("target_port",0) or 0)
    if not port:
        return False,f"{name} has no configured share port"
    proc=subprocess.run([tailscale,"serve",f"--https={port}","off"],capture_output=True,text=True)
    if proc.returncode==0:
        return True,"off"
    detail=(proc.stderr or proc.stdout or "").strip().splitlines()
    return False,(detail[-1] if detail else "Tailscale Serve off failed")


def services_command(args):
    args=list(args or [])
    data=_service_refresh_discovery()
    action=(args[0].casefold() if args else "status")
    dns=_tailscale_dns_name()
    status_text=_tailscale_serve_status_text()

    if action in {"status","list"}:
        _title("LOOK SERVICES","local + tailnet")
        print(f"  host         {dns or 'Tailscale unavailable/unresolved'}")
        print()
        print("  SERVICE       LOCAL       STATE      SHARE")
        for name,item in data.items():
            target=int(item.get("target_port",0) or 0)
            https_port=int(item.get("https_port",0) or 0)
            alive=_service_alive(name,item) if target else False
            local=f":{target}" if target else "unconfigured"
            shared=bool(https_port and (f":{https_port}" in status_text or f"{https_port}" in status_text))
            share=(f"https://{dns}:{https_port}" if shared and dns else ("on" if shared else "off"))
            print(f"  {name:<13} {local:<11} {'running' if alive else ('stopped' if target else '—'):<10} {share}")
        print("\n  lk services share all")
        print("  lk services share SERVICE")
        print("  lk services unshare SERVICE|all")
        print("  lk services set mercury PORT")
        return 0

    if action=="set" and len(args)>=3:
        name=args[1].casefold()
        try: port=int(args[2])
        except ValueError:
            print("LOOK services · port must be an integer"); return 2
        if not (1<=port<=65535):
            print("LOOK services · port must be 1..65535"); return 2
        item=data.setdefault(name,{"kind":"http"})
        item.update({"local_port":port,"target_port":port,"https_port":port,"enabled":True})
        _save_services(data)
        print(f"LOOK services · {name} · localhost:{port} · share port {port}")
        return 0

    if action=="discover":
        before=int((data.get("mercury") or {}).get("target_port",0) or 0)
        data=_service_refresh_discovery(data)
        after=int((data.get("mercury") or {}).get("target_port",0) or 0)
        if after:
            print(f"LOOK services · Mercury Writer · localhost:{after}")
        elif not before:
            print("LOOK services · Mercury Writer not discovered; configure with `lk services set mercury PORT`")
        return services_command(["status"])

    if action in {"share","on"}:
        names=args[1:] or ["all"]
        if names==["all"]:
            names=[
                n for n,i in data.items()
                if i.get("enabled") and int(i.get("target_port",0) or 0) and _service_alive(n,i)
            ]
        rc=0
        _title("LOOK SHARE","tailnet only")
        for name in names:
            item=data.get(name)
            if not item:
                print(f"  ✗ {name:<12} unknown service"); rc=1; continue
            ok,msg=_service_share_one(name,item)
            port=int(item.get("https_port",0) or 0)
            url=f"https://{dns}:{port}" if ok and dns and port else ""
            print(f"  {'✓' if ok else '✗'} {name:<12} {msg}{' · '+url if url else ''}")
            if not ok: rc=1
        return rc

    if action in {"unshare","off","stop"}:
        names=args[1:] or ["all"]
        if names==["all"]:
            names=[n for n,i in data.items() if int(i.get("https_port",0) or 0)]
        rc=0
        for name in names:
            item=data.get(name)
            if not item: print(f"LOOK services · unknown: {name}"); rc=1; continue
            ok,msg=_service_unshare_one(name,item)
            print(f"  {'✓' if ok else '✗'} {name:<12} {msg}")
            if not ok: rc=1
        return rc

    print("usage: lk services [status|discover|set NAME PORT|share SERVICE|all|unshare SERVICE|all]")
    return 2


def share_command(args):
    """Friendly shortcut: bare `lk share` shares all configured/running LOOK services."""
    args=list(args or [])
    if not args:
        return services_command(["share","all"])
    if args[0].casefold() in {"status","list"}:
        return services_command(["status"])
    if args[0].casefold() in {"off","stop","unshare"}:
        return services_command(["unshare",*(args[1:] or ["all"])])
    return services_command(["share",*args])


def ollama_share(args):
    args=list(args or [])
    tailscale=shutil.which("tailscale")
    if not tailscale:
        print("LOOK OLLAMA · Tailscale is not installed")
        return 1
    if args and args[0]=="status":
        rc=subprocess.call([tailscale,"serve","status"])
        state="ready" if _probe_ollama(f"http://127.0.0.1:{OLLAMA_SHARE_PORT}",.3) else "off"
        manager,enabled,active=_ollama_proxy_service_state()
        persistence=(f"{manager} enabled" if enabled else (f"{manager} active" if active else f"{manager} not enabled"))
        print(f"LOOK OLLAMA · host-rewrite proxy {state} · {persistence} · 127.0.0.1:{OLLAMA_SHARE_PORT} · HTTPS :{OLLAMA_SHARE_PORT}")
        return rc
    if args and args[0] in {"off","stop"}:
        proc=subprocess.run([tailscale,"serve",f"--https={OLLAMA_SHARE_PORT}","off"])
        if proc.returncode==0:
            _disable_ollama_proxy_service()
            _stop_ollama_share_proxy()
            print("✓ Ollama tailnet share off")
        else:
            print("LOOK OLLAMA · Tailscale Serve needs elevated permission")
            print(f"  run: sudo tailscale serve {OLLAMA_SHARE_PORT} off")
        return proc.returncode

    if not _probe_ollama(LOCAL_OLLAMA_URL,.6):
        if _ensure_ollama_server(LOCAL_OLLAMA_URL,allow_start=True) is None:
            print("LOOK OLLAMA · local server unavailable")
            return 1
    manager,_=_ollama_proxy_service_paths()
    persistent=_install_ollama_proxy_service() if manager!="process" else False
    if persistent:
        deadline=time.monotonic()+3.0
        while time.monotonic()<deadline and not _probe_ollama(f"http://127.0.0.1:{OLLAMA_SHARE_PORT}",.2):
            time.sleep(.05)
    if not _probe_ollama(f"http://127.0.0.1:{OLLAMA_SHARE_PORT}",.3) and not _start_ollama_share_proxy():
        print("LOOK OLLAMA · could not start localhost share proxy")
        return 1
    print("LOOK OLLAMA · sharing localhost:11434 inside your tailnet")
    proc=subprocess.run([
        tailscale,"serve","--bg",f"--https={OLLAMA_SHARE_PORT}",f"localhost:{OLLAMA_SHARE_PORT}"
    ])
    if proc.returncode==0:
        dns=_tailscale_dns_name()
        print("✓ Ollama available to your Tailscale devices")
        if dns:
            print(f"  https://{dns}:{OLLAMA_SHARE_PORT}")
        print("  discover it elsewhere with: lk ollama host")
        return 0

    # Tailscale commonly reserves Serve configuration changes for root/operator.
    # Keep our localhost proxy alive so the one privileged Serve command can use it.
    print("LOOK OLLAMA · Tailscale Serve needs elevated permission")
    print(f"  run: sudo tailscale serve --bg --https={OLLAMA_SHARE_PORT} localhost:{OLLAMA_SHARE_PORT}")
    print("  then: lk ollama share status")
    return proc.returncode


