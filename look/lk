        f"request_time: {now.isoformat(timespec='seconds')}\n"
        f"current_date: {now.date().isoformat()}\n"
        f"local_time: {now.strftime('%H:%M:%S')}\n"
        f"timezone: {zone}\n"
        f"utc_offset: {now.strftime('%z')[:3]}:{now.strftime('%z')[3:]}\n"
        "source: host_system_clock\n"
        "This is authoritative for this turn. Never infer the current date, time, year, "
        "timezone, or relative dates from model knowledge or prior conversation."
    )

def _lo_direct_temporal_answer(prompt):
    """Answer simple host-clock questions without asking a model to reinterpret time."""
    low=" ".join(str(prompt or "").casefold().split()).strip(" ?!.")
    now=datetime.now().astimezone()
    if re.fullmatch(r"(?:what(?:'s| is) )?(?:the )?(?:local )?time(?: is it)?",low) or low in {"what time is it","time"}:
        return f"{now.strftime('%-I:%M %p')} {now.tzname() or 'local'}"
    if re.fullmatch(r"(?:what(?:'s| is) )?(?:the )?(?:date|date today|today's date)(?: today)?",low) or low in {"what is the date","what's the date"}:
        return now.strftime("%A, %B %-d, %Y")
    if low in {"what day is it","what day is today","what day is it today"}:
        return now.strftime("%A, %B %-d, %Y")
    return None

