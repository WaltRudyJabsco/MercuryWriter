        return 1
    print(f"  type    {' + '.join(dict.fromkeys(kinds))}")
    if actions:
        print("  actions")
        seen=set()
        for label,cmd in actions:
            if cmd in seen: continue
            seen.add(cmd); print(f"    {_c(f'{label:<10}', '36')} {cmd}")
