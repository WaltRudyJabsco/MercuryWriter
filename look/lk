def _system_snapshot():
    try:
        load=os.getloadavg()[0]
        load_text=f"{load:.2f}"
    except (AttributeError,OSError):
        load_text="?"
    usage=shutil.disk_usage(HOME)
    disk=f"{(usage.total-usage.free)/usage.total*100:.0f}%"
    uptime="?"
    try:
        if platform.system()=="Darwin":
            boot=_run_text(["sysctl","-n","kern.boottime"])
            m=re.search(r"sec = (\d+)",boot)
            if m:
                seconds=max(0,time.time()-int(m.group(1)))
                uptime=f"{int(seconds//86400)}d {int((seconds%86400)//3600)}h"
        elif Path("/proc/uptime").exists():
            seconds=float(Path("/proc/uptime").read_text().split()[0])
            uptime=f"{int(seconds//86400)}d {int((seconds%86400)//3600)}h"
    except Exception:
        pass
    return load_text,disk,uptime

