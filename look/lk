class _ResourceRef:
    __slots__=("path","kind","name","provenance","last_referenced_turn")
    def __init__(self,path,provenance="explicit",last_referenced_turn=0):
        p=Path(path).expanduser().resolve()
        self.path=p
        self.kind="directory" if p.is_dir() else "file"
        self.name=p.name or str(p)
        self.provenance=provenance
        self.last_referenced_turn=int(last_referenced_turn or 0)

    def line(self,index=None):
        lead=f"[{index}] " if index is not None else ""
        suffix="/" if self.kind=="directory" else ""
        try: size=f" · {self.path.stat().st_size} B" if self.kind=="file" else ""
        except OSError: size=""
        return f"{lead}{self.name}{suffix} · {self.kind}{size} · {self.path} · {self.provenance}"

def _resource_refs(paths,provenance="explicit"):
    out=[]; seen=set()
    for raw in paths or []:
        try: p=Path(raw).expanduser().resolve()
        except (OSError,RuntimeError): continue
        if p.exists() and str(p) not in seen:
            seen.add(str(p)); out.append(_ResourceRef(p,provenance))
    return out

def _extract_prompt_resources(text,cwd=None):
    """Recognize shell/Finder-style path text without treating ordinary prose as paths."""
    import shlex
    base=Path(cwd or _safe_cwd()).resolve()
    try: tokens=shlex.split(str(text or ""),posix=True)
    except ValueError: tokens=str(text or "").split()
    resources=[]; keep=[]
    for token in tokens:
        # Only path-shaped tokens qualify. Bare words remain language even if a same-named file exists.
        shaped=(token.startswith(("/","~/","./","../")) or "/" in token)
        if not shaped:
            keep.append(token); continue
        p=Path(token).expanduser()
        if not p.is_absolute(): p=base/p
        try: p=p.resolve()
        except (OSError,RuntimeError):
            keep.append(token); continue
        if p.exists(): resources.append(p)
        else: keep.append(token)
    return " ".join(keep).strip(),_resource_refs(resources,"dropped/path")

def _split_cli_resources(args,cwd=None):
    """Preserve argv boundaries: Finder drops with escaped spaces arrive as one argv item."""
    base=Path(cwd or _safe_cwd()).resolve(); text=[]; paths=[]
    for token in args:
        p=Path(token).expanduser()
        candidate=p if p.is_absolute() else base/p
        try: candidate=candidate.resolve()
        except (OSError,RuntimeError): candidate=None
        if candidate is not None and candidate.exists(): paths.append(candidate)
        else: text.append(token)
    return " ".join(text).strip(),_resource_refs(paths,"cli/drop")

def _resource_context_message(refs):
    if not refs: return ""
    return ("EXPLICIT RESOURCE CONTEXT\n"
            "These resources were explicitly supplied or selected by the operator. They are stronger referents than search candidates. "
            "Use them directly when the request says this/these/the file/the folder; do not rediscover them by filename. "
            "Do not assume file contents and do not mutate without an explicit request.\n"+
            "\n".join(r.line(i+1) for i,r in enumerate(refs[:200])))

def _resource_preview(refs, max_total=6000, max_file=6000):
    """Cheap eager preview only for a single small text resource.

    Resource context is a handle set, not a prompt dump. Multi-file comparisons and
    large documents stay lazy and are inspected through bounded read_file slices.
    """
    refs=list(refs or [])
    if len(refs)!=1 or refs[0].kind!="file": return ""
    ref=refs[0]
    try:
        size=ref.path.stat().st_size
        if size>96*1024: return ""
        raw=ref.path.read_bytes()[:max_file+1]
        if b"\x00" in raw[:4096]: return ""
        text=raw[:max_total].decode("utf-8",errors="replace")
    except (OSError,UnicodeError):
        return ""
    return f"RESOURCE [1] CONTENT PREVIEW · {ref.name}\n{text}" if text else ""

def _active_resource_message(refs):
    """Single authoritative model-facing slot for the user's current explicit resources."""
    if not refs: return "ACTIVE RESOURCE CONTEXT: none explicitly selected."
    manifest=_resource_context_message(refs)
    preview=_resource_preview(refs)
    rule=(
        "\nBINDING CONTRACT: These are the ACTIVE explicit resources for the current request. "
        "Pronouns such as this, this file, these, these files, them, and the selected files bind here BEFORE "
        "workspace listings, conversation history, memory, or search. If the requested operation needs file "
        "contents and a preview is present, use it. Otherwise call read_file/inspect_directory on the exact path. "
        "Never substitute a different same-named or previously discussed file."
    )
    return manifest+rule+("\n\n"+preview if preview else "")

def _resource_image_paths(refs, limit=8):
    image_ext={".png",".jpg",".jpeg",".webp",".gif",".bmp"}
    out=[]
    for ref in refs or []:
        if ref.kind=="file" and ref.path.suffix.casefold() in image_ext:
            out.append(ref.path)
        if len(out)>=limit: break
    return out

def _resource_visual_intent(prompt):
    """Cheap attention gate: decide whether an observed image needs pixels again."""
    text=" ".join(str(prompt or "").casefold().split())
    visual_terms=(
        "image", "picture", "photo", "screenshot", "comic", "panel", "diagram",
        "look at", "look closer", "see", "shown", "visible", "written", "text",
        "sign", "tattoo", "color", "colour", "wearing", "background", "foreground",
        "face", "hair", "chest", "shirt", "jacket", "object",
    )
    comparison_terms=(
        "compare", "difference", "different", "first one", "second one",
        "previous one", "other one", "both", "these two", "those two",
    )
    return (any(term in text for term in visual_terms),
            any(term in text for term in comparison_terms))

def _merge_resource_refs(existing, incoming, limit=200):
    """Retain cheap handles across a session while keeping newest resources last."""
    by_path={str(r.path):r for r in (existing or [])}
    order=[str(r.path) for r in (existing or [])]
    for ref in incoming or []:
        key=str(ref.path)
        if key in by_path:
            order.remove(key)
        by_path[key]=ref; order.append(key)
    return [by_path[k] for k in order[-limit:]]

def _resource_governor_message(refs,budget):
    if not refs: return ""
    return (
        "RESOURCE CONTEXT GOVERNOR: ResourceRef entries are cheap handles, not permission to load whole files into context. "
        f"This turn has a {int(budget['context']):,}-token context ceiling and {int(budget['output']):,}-token output ceiling. "
        "For several or large documents, inspect metadata/structure first, then read bounded slices only as needed. "
        "Keep compact working conclusions between reads; do not paste or retain entire documents in the conversation. "
        "For comparisons, gather evidence per resource and synthesize from those notes. If one inference cycle is insufficient, "
        "continue through tool rounds yourself rather than asking the operator to type next."
    )

