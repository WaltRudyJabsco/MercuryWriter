def _lo_task_tier(prompt, selected_paths=None):
    """Cheap deterministic budget selection: fast, standard, or deep."""
    text=" ".join(str(prompt or "").split()).casefold()
    selected_count=len(selected_paths or [])
    if selected_count >= 8:
        return "deep"
    deep_markers=(
        "debug", "diagnose", "refactor", "architect", "design", "analyze these",
        "compare these", "review these", "traceback", "root cause", "why does this fail",
        "implement", "rewrite", "across these files", "all these files",
    )
    if len(text)>=700 or sum(1 for m in deep_markers if m in text)>=2:
        return "deep"
    standard_markers=(
        "compare", "analy", "count", "inspect", "search", "find all", "summar",
        "explain", "why", "plan", "review", "check these", "look through",
    )
    if len(text)>=220 or selected_count>=3 or any(m in text for m in standard_markers):
        return "standard"
    return "fast"


def _lo_budget_for(prompt, thinking, selected_paths=None):
    tier=_lo_task_tier(prompt,selected_paths)
    # Explicit deep thinking is authoritative.
    if thinking=="deep":
        tier="deep"
    elif thinking=="adaptive" and tier=="fast" and _lo_prompt_needs_thinking(prompt):
        tier="standard"
    table={
        "fast":{"context":LO_FAST_CONTEXT_TOKENS,"output":LO_FAST_OUTPUT_TOKENS,"tool_rounds":LO_FAST_TOOL_ROUNDS},
        "standard":{"context":LO_STANDARD_CONTEXT_TOKENS,"output":LO_STANDARD_OUTPUT_TOKENS,"tool_rounds":LO_STANDARD_TOOL_ROUNDS},
        "deep":{"context":LO_DEEP_CONTEXT_TOKENS,"output":LO_DEEP_OUTPUT_TOKENS,"tool_rounds":LO_DEEP_TOOL_ROUNDS},
    }
    return tier,table[tier]


