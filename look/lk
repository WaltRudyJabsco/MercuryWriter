def ollama_test_resident_set(base_override=None):
    """Measure useful overlap among already-resident workers without changing the set.

    The first implementation compared a cold-ish sequential pass with a later warm
    concurrent pass and could report impossible >N× speedups. This version stabilizes
    every resident worker, alternates sequential order, repeats both phases, and uses
    medians with a physical sanity bound.
    """
    from concurrent.futures import ThreadPoolExecutor, as_completed
    import statistics
    base=_normalize_ollama_url(base_override) if base_override else _ollama_base()
    try:
        running=_ollama_ps(base)
    except Exception as exc:
        print(f"LOOK OLLAMA · {exc}")
        return 1
    names=[]; vram={}
    for item in running:
        name=(item.get("name") or item.get("model") or "").strip()
        if not name or name in names: continue
        names.append(name)
        raw=item.get("size_vram")
        if isinstance(raw,(int,float)): vram[name]=float(raw)
    print("LOOK RESIDENT SET TEST")
    print("  warm models only · 4096 context · 3× median · no cold loads or evictions")
    if not names:
        print("  resident   none"); return 1
    print("  resident   " + ", ".join(names))
    if len(names)<2:
        print("  need at least two resident models to measure overlap"); return 1

    def probe(name):
        started=time.monotonic()
        try:
            ttft,rate,elapsed,exact=_benchmark_speed(base,name)
            return {"model":name,"ok":True,"ttft":ttft,"rate":rate,"elapsed":elapsed,"exact":exact}
        except Exception as exc:
            return {"model":name,"ok":False,"error":str(exc),"elapsed":time.monotonic()-started}

    print("  stabilize  " + ", ".join(names), flush=True)
    for name in names:
        probe(name)  # deliberately untimed warm/cache equalizer

    seq_samples={name:[] for name in names}; seq_ttft={name:[] for name in names}; seq_rate={name:[] for name in names}
    seq_exact={name:[] for name in names}; seq_walls=[]
    for round_no in range(3):
        order=names if round_no%2==0 else list(reversed(names))
        started=time.monotonic()
        for name in order:
            row=probe(name)
            if row.get("ok"):
                seq_samples[name].append(float(row["elapsed"])); seq_ttft[name].append(float(row["ttft"])); seq_rate[name].append(float(row["rate"])); seq_exact[name].append(bool(row["exact"]))
        seq_walls.append(time.monotonic()-started)

    conc_samples={name:[] for name in names}; conc_ttft={name:[] for name in names}; conc_rate={name:[] for name in names}
    conc_exact={name:[] for name in names}; conc_walls=[]
    for _ in range(3):
        started=time.monotonic(); rows=[]
        with ThreadPoolExecutor(max_workers=len(names),thread_name_prefix="ollama-set") as pool:
            futures=[pool.submit(probe,name) for name in names]
            for fut in as_completed(futures): rows.append(fut.result())
        conc_walls.append(time.monotonic()-started)
        for row in rows:
            name=row["model"]
            if row.get("ok"):
                conc_samples[name].append(float(row["elapsed"])); conc_ttft[name].append(float(row["ttft"])); conc_rate[name].append(float(row["rate"])); conc_exact[name].append(bool(row["exact"]))

    med=lambda xs: statistics.median(xs) if xs else 0.0
    print()
    print(f"{'MODEL':<28} {'VRAM':>8} {'ALONE':>8} {'TOGETHER':>10} {'TTFT':>8} {'TOK/S':>8} {'EXACT':>7}")
    print("-"*89)
    for name in names:
        mem=(f"{vram[name]/1024**3:.1f}G" if name in vram else "—")
        print(f"{name:<28.28} {mem:>8} {med(seq_samples[name]):>7.2f}s {med(conc_samples[name]):>9.2f}s "
              f"{med(conc_ttft[name]):>7.2f}s {med(conc_rate[name]):>8.1f} {('yes' if conc_exact[name] and all(conc_exact[name]) else 'no'):>7}")

    sequential_wall=med(seq_walls); concurrent_wall=med(conc_walls)
    alone=[med(seq_samples[n]) for n in names if seq_samples[n]]
    serial_work=sum(alone); ideal=max(alone) if alone else 0.0
    speedup=(serial_work/concurrent_wall) if concurrent_wall>0 else 0.0
    efficiency=(ideal/concurrent_wall) if concurrent_wall>0 and ideal>0 else 0.0
    plausible=speedup <= len(names)*1.15
    print()
    print(f"  sequential wall   {sequential_wall:.2f}s median")
    print(f"  concurrent wall   {concurrent_wall:.2f}s median")
    if plausible:
        print(f"  useful speedup    {speedup:.2f}x  (physical ceiling ≈ {len(names):.0f}x for {len(names)} workers)")
        print(f"  parallel efficiency {efficiency*100:.0f}%  (100% = perfect overlap at solo speed)")
    else:
        print(f"  useful speedup    NOT SCORED · observed {speedup:.2f}x exceeds sanity bound")
        print("  warning           cache/order/runtime conditions changed between phases")
    print("  note              micro-probe only; real contexts, CPU spill and KV pressure can change the result")
    return 0

def _curator_request(payload=None):
    url="http://127.0.0.1:7332/v1/models/curation"
    data=None if payload is None else json.dumps(payload).encode("utf-8")
    req=urllib.request.Request(url,data=data,headers={"Content-Type":"application/json"},method=("POST" if data is not None else "GET"))
    with urllib.request.urlopen(req,timeout=190 if data and payload.get("apply") else 8) as response:
        return json.loads(response.read().decode("utf-8","replace"))


def _format_gib(value):
    if not isinstance(value,(int,float)): return "—"
    return f"{float(value)/(1024**3):.1f}G"


def ollama_curate(args):
    """Inspect or control the node's evidence-driven resident-set curator."""
    args=list(args or [])
    if args[:1]==["auto"]:
        if len(args)<2 or args[1] not in {"on","off"}:
            print("usage: lk ollama curate auto on|off")
            return 2
        mode="auto" if args[1]=="on" else "observe"
        try: data=_curator_request({"mode":mode})
        except Exception as exc:
            print(f"LOOK CURATOR · {exc}"); return 1
        print(f"LOOK MODEL CURATOR · {mode.upper()}")
        if mode=="auto": print("  interactive deep work may reserve the large worker; idle time returns to the balanced resident set")
        return 0
    profile="balanced"
    for item in args:
        if item in {"reflex","balanced","deep"}: profile=item
    apply="--apply" in args
    try:
        data=_curator_request({"profile":profile,"apply":True,"reason":"lk ollama curate"}) if apply else _curator_request({"profile":profile})
    except urllib.error.HTTPError as exc:
        detail=exc.read().decode("utf-8","replace")
        print(f"LOOK CURATOR · HTTP {exc.code} · {detail[:300]}"); return 1
    except Exception as exc:
        print(f"LOOK CURATOR · {exc}"); return 1
    state=data.get("state") or {}; plan=data.get("plan") or data
    if data.get("target") is not None and not plan.get("target"): plan=data
    print("LOOK MODEL CURATOR")
    print(f"  mode      {state.get('mode','observe')}")
    print(f"  profile   {plan.get('profile',profile)}")
    budget=plan.get("budget") or data.get("budget") or {}
    if budget:
        print(f"  budget    {_format_gib(budget.get('model_budget'))} models · {_format_gib(budget.get('external'))} non-Ollama · {_format_gib(budget.get('reserve'))} reserve")
    current=plan.get("current") or []
    target=plan.get("target") or data.get("target") or []
    disabled=plan.get("disabled") or []
    eligible=plan.get("eligible") or []
    print("  current   "+(", ".join(current) if current else "none"))
    print("  target    "+(", ".join(target) if target else "none"))
    print("  eligible  "+(", ".join(eligible) if eligible else "none"))
    print("  disabled  "+(", ".join(disabled) if disabled else "none"))
    try:
        set_state=_load_model_sets()
        if set_state.get("champion"): print(f"  champion  {set_state.get('champion')}")
        if set_state.get("challenger"): print(f"  challenger {set_state.get('challenger')}")
    except Exception:
        pass
    reason=plan.get("reason") or data.get("reason")
    if reason: print(f"  why       {reason}")
    if apply:
        print("  unloaded  "+(", ".join(data.get("unloaded") or []) or "none"))
        print("  loaded    "+(", ".join(data.get("loaded") or []) or "none"))
        for err in data.get("errors") or []: print(f"  error     {err}")
    models=plan.get("models") or []
    if models:
        print("\n  PURPOSE EVIDENCE")
        print(f"  {'MODEL':<27} {'SIZE':>6} {'FIT':>10} {'RSN':>5} {'TOOLS':>6} {'AGENT':>6} {'TTFT':>7} {'TOK/S':>7}")
        for row in models:
            r=row.get("roles") or {}
            print(f"  {str(row.get('name') or ''):<27.27} {_format_gib(row.get('size')):>6} {str(r.get('fit') or '—'):>10} {str(r.get('reasoning') if r.get('reasoning') is not None else '—'):>5} {str(r.get('tools') if r.get('tools') is not None else '—'):>6} {('yes' if r.get('agent') else 'no'):>6} {(f'{r.get('ttft'):.2f}s' if isinstance(r.get('ttft'),(int,float)) else '—'):>7} {(f'{r.get('rate'):.1f}' if isinstance(r.get('rate'),(int,float)) else '—'):>7}")
    return 0 if data.get("ok",True) else 1



