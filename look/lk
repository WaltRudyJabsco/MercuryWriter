def _lo_prompt_needs_thinking(prompt):
    """Small, inspectable adaptive heuristic; avoid turning casual chat into a reasoning job."""
    text=" ".join(str(prompt or "").split()).casefold()
    if len(text) >= 260 or "```" in text or "traceback" in text:
        return True
    structural=(
        "debug", "diagnose", "analy", "compare", "tradeoff", "trade-off",
        "architect", "design", "refactor", "implement", "why does", "why is",
        "step by step", "plan", "reason", "prove", "review this code",
    )
    return sum(1 for marker in structural if marker in text) >= 1

