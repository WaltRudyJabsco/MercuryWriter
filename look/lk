def _lo_readline_prompt(text):
    """Return a prompt whose display width matches what the line editor sees.

    GNU readline understands SOH/STX around ANSI escapes.  Python's libedit
    compatibility layer is less consistent across macOS builds, so use a plain
    prompt there rather than letting invisible color bytes corrupt redraw math.
    """
    raw=str(text)
    if readline is None:
        return raw
    if "libedit" in (getattr(readline, "__doc__", "") or "").lower():
        return re.sub(r"\x1b\[[0-9;]*m", "", raw)
    return re.sub(r"(\x1b\[[0-9;]*m)", r"\001\1\002", raw)


