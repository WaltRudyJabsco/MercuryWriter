def _normalize_ollama_url(value):
    from urllib.parse import urlparse
    value=str(value or "").strip().rstrip("/")
    if not value:
        return LOCAL_OLLAMA_URL
    if "://" not in value:
        value=f"http://{value}"
    parsed=urlparse(value)
    if not parsed.hostname:
        raise ValueError("invalid Ollama host")
    if parsed.port is None and parsed.scheme=="http":
        value=value + ":11434"
    return value.rstrip("/")


def _load_ollama_hosts():
    data={"default":"local","hosts":{}}
    try:
        loaded=json.loads(OLLAMA_HOSTS_FILE.read_text(encoding="utf-8"))
        if isinstance(loaded,dict):
            data["default"]=str(loaded.get("default") or "local")
            hosts=loaded.get("hosts") or {}
            if isinstance(hosts,dict):
                for name,item in hosts.items():
                    if isinstance(item,dict) and item.get("url"):
                        try:
                            data["hosts"][str(name)]={"url":_normalize_ollama_url(item["url"])}
                        except ValueError:
                            pass
    except (OSError,ValueError,TypeError):
        pass
    data["hosts"]["local"]={"url":LOCAL_OLLAMA_URL}
    if data["default"] not in data["hosts"]:
        data["default"]="local"
    return data


def _save_ollama_hosts(data):
    STATE_DIR.mkdir(parents=True,exist_ok=True)
    payload={
        "default":data.get("default","local"),
        "hosts":{k:v for k,v in (data.get("hosts") or {}).items() if k!="local"},
    }
    tmp=OLLAMA_HOSTS_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(payload,indent=2,sort_keys=True)+"\n",encoding="utf-8")
    os.chmod(tmp,0o600)
    tmp.replace(OLLAMA_HOSTS_FILE)
    os.chmod(OLLAMA_HOSTS_FILE,0o600)


def _ollama_base(override=None):
    if override:
        return _normalize_ollama_url(override)
    env=os.environ.get("OLLAMA_HOST","").strip()
    if env:
        return _normalize_ollama_url(env)
    data=_load_ollama_hosts()
    return data["hosts"].get(data["default"],{"url":LOCAL_OLLAMA_URL})["url"]


def _ollama_host_name(base=None):
    base=_ollama_base(base)
    data=_load_ollama_hosts()
    for name,item in data["hosts"].items():
        if item.get("url")==base:
            return name
    try:
        from urllib.parse import urlparse
        return urlparse(base).hostname or base
    except Exception:
        return base


def _is_local_ollama(base):
    from urllib.parse import urlparse
    try:
        return (urlparse(base).hostname or "").lower() in {"127.0.0.1","localhost","::1"}
    except Exception:
        return False


def _probe_ollama(base,timeout=.35):
    import urllib.request
    try:
        with urllib.request.urlopen(base.rstrip("/")+"/api/tags",timeout=timeout) as response:
            return response.status < 400
    except Exception:
        return False


def _tailscale_candidates():
    exe=shutil.which("tailscale")
    if not exe:
        return []
    try:
        proc=subprocess.run([exe,"status","--json"],capture_output=True,text=True,timeout=2)
        if proc.returncode!=0:
            return []
        status=json.loads(proc.stdout)
    except (OSError,subprocess.SubprocessError,ValueError,TypeError):
        return []

    peers=status.get("Peer") or {}
    nodes=list(peers.values()) if isinstance(peers,dict) else list(peers) if isinstance(peers,list) else []
    out=[]; seen=set()
    for node in nodes:
        if not isinstance(node,dict) or node.get("Online") is False:
            continue
        hostname=str(node.get("HostName") or "").strip()
        dns=str(node.get("DNSName") or "").strip().rstrip(".")
        ips=node.get("TailscaleIPs") or []
        name=hostname or (dns.split(".")[0] if dns else "")
        if not name:
            continue
        candidates=[]
        if dns:
            candidates.append(("serve",f"https://{dns}:{OLLAMA_SHARE_PORT}"))
        for ip in ips[:2]:
            candidates.append(("direct",f"http://{ip}:11434"))
        for transport,url in candidates:
            key=(name,url)
            if key not in seen:
                seen.add(key)
                out.append({"name":name,"url":url,"transport":transport})
    return out


def _discover_ollama_hosts():
    import concurrent.futures
    candidates=_tailscale_candidates()
    if not candidates:
        return []
    found=[]
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(12,len(candidates))) as pool:
        futures={pool.submit(_probe_ollama,item["url"],.45):item for item in candidates}
        for future,item in futures.items():
            try:
                if future.result():
                    found.append(item)
            except Exception:
                pass
    best={}
    for item in found:
        old=best.get(item["name"])
        if old is None or (item["transport"]=="serve" and old["transport"]!="serve"):
            best[item["name"]]=item
    return sorted(best.values(),key=lambda x:x["name"].casefold())


def _resolve_ollama_host(token):
    token=str(token or "").strip()
    if not token:
        return None,None
    if token=="local":
        return "local",LOCAL_OLLAMA_URL
    data=_load_ollama_hosts()
    if token in data["hosts"]:
        return token,data["hosts"][token]["url"]
    if "://" in token:
        try:
            url=_normalize_ollama_url(token)
            from urllib.parse import urlparse
            return (urlparse(url).hostname or "remote"),url
        except ValueError:
            return None,None
    for item in _discover_ollama_hosts():
        if item["name"].casefold()==token.casefold():
            return item["name"],item["url"]
    return None,None


def ollama_hosts(args):
    args=list(args or [])
    data=_load_ollama_hosts()

    if args and args[0]=="reset":
        removed=[name for name in data["hosts"] if name!="local"]
        data={"default":"local","hosts":{"local":{"url":LOCAL_OLLAMA_URL}}}
        _save_ollama_hosts(data)
        print("✓ reset legacy Ollama hosts · "+(", ".join(removed) if removed else "already clean"))
        return 0

    if args and args[0]=="prune":
        removed=[]
        # Prune means cruft, not merely offline: duplicate aliases for the same
        # normalized endpoint are stale state even when that endpoint is healthy.
        by_url={}
        for name,item in data["hosts"].items():
            if name=="local": continue
            by_url.setdefault(item.get("url",""),[]).append(name)
        for url,names in by_url.items():
            if len(names)>1:
                keep=data.get("default") if data.get("default") in names else sorted(names,key=str.casefold)[0]
                for name in names:
                    if name!=keep:
                        removed.append(name); data["hosts"].pop(name,None)
        for name,item in list(data["hosts"].items()):
            if name=="local": continue
            if not _probe_ollama(item.get("url",""),.35):
                removed.append(name); data["hosts"].pop(name,None)
        if data.get("default") in removed: data["default"]="local"
        _save_ollama_hosts(data)
        print("✓ pruned legacy Ollama hosts · "+(", ".join(removed) if removed else "none"))
        return 0

    if args and args[0]=="forget":
        if len(args)<2:
            print("LOOK OLLAMA · host name required")
            return 1
        name=args[1]
        if name=="local":
            print("LOOK OLLAMA · local cannot be removed")
            return 1
        if name not in data["hosts"]:
            print(f"LOOK OLLAMA · unknown host: {name}")
            return 1
        data["hosts"].pop(name,None)
        if data["default"]==name:
            data["default"]="local"
        _save_ollama_hosts(data)
        print(f"✓ forgot Ollama host · {name}")
        return 0

    if len(args)>=2 and args[0] not in {"list","status"}:
        name=args[0]
        try:
            url=_normalize_ollama_url(args[1])
        except ValueError:
            print("LOOK OLLAMA · invalid host URL")
            return 1
        data["hosts"][name]={"url":url}
        data["default"]=name
        _save_ollama_hosts(data)
        print(f"✓ Ollama host · {name} · {'ready' if _probe_ollama(url,.6) else 'saved · offline'}")
        return 0

    if len(args)==1 and args[0] not in {"list","status"}:
        token=args[0]
        name,url=_resolve_ollama_host(token)
        if not url:
            print(f"LOOK OLLAMA · host not found: {token}")
            print("  run: lk ollama host")
            return 1
        data["hosts"][name]={"url":url}
        data["default"]=name
        _save_ollama_hosts(data)
        print(f"✓ Ollama host · {name}")
        return 0

    discovered=_discover_ollama_hosts()
    merged={name:{"url":item["url"],"source":"saved"} for name,item in data["hosts"].items()}
    for item in discovered:
        merged.setdefault(item["name"],{"url":item["url"],"source":"tailscale"})
    current=_ollama_base()
    current_name=_ollama_host_name(current)

    _title("ollama hosts")
    print(f"  current  {current_name} · {current}")
    print()
    for name in sorted(merged,key=str.casefold):
        item=merged[name]
        url=item["url"]
        state=_c("ready","32") if _probe_ollama(url,.25) else _c("offline","2")
        marker="✓" if url==current else " "
        print(f"  {marker} {name:<18} {state:<18} {item['source']} · {url}")
    if shutil.which("tailscale"):
        print(f"\n  {_c('Tip','2')} · lo @NAME uses a host for one session")
    else:
        print(f"\n  {_c('Tailscale not installed','2')} · local and saved URL hosts still work")
    return 0



def _ollama_share_proxy():
    """Local-only proxy: keep Ollama protected while making Tailscale Serve compatible."""
    class Handler(BaseHTTPRequestHandler):
        protocol_version="HTTP/1.1"
        def log_message(self, fmt, *args):
            return
        def _forward(self):
            try:
                length=int(self.headers.get("Content-Length","0") or 0)
            except ValueError:
                length=0
            body=self.rfile.read(length) if length else None
            headers={k:v for k,v in self.headers.items()
                     if k.lower() not in {"host","connection","proxy-connection","transfer-encoding"}}
            # Ollama rejects reverse-proxy requests carrying the public tailnet Host.
            headers["Host"]="localhost:11434"
            try:
                conn=http.client.HTTPConnection("127.0.0.1",11434,timeout=300)
                conn.request(self.command,self.path,body=body,headers=headers)
                response=conn.getresponse()
                payload=response.read()
                self.send_response(response.status,response.reason)
                for key,value in response.getheaders():
                    if key.lower() not in {"connection","transfer-encoding","content-length"}:
                        self.send_header(key,value)
                self.send_header("Content-Length",str(len(payload)))
                self.end_headers()
                if self.command!="HEAD" and payload:
                    self.wfile.write(payload)
                conn.close()
            except Exception:
                self.send_response(502,"Bad Gateway")
                self.send_header("Content-Length","0")
                self.end_headers()
        do_GET=_forward
        do_POST=_forward
        do_PUT=_forward
        do_PATCH=_forward
        do_DELETE=_forward
        do_OPTIONS=_forward
        do_HEAD=_forward

    STATE_DIR.mkdir(parents=True,exist_ok=True)
    # The proxy records its own PID so health checks work identically whether
    # it was launched directly, by systemd, or by launchd.
    OLLAMA_SHARE_PID.write_text(str(os.getpid())+"\n")
    os.chmod(OLLAMA_SHARE_PID,0o600)
    server=ThreadingHTTPServer(("127.0.0.1",OLLAMA_SHARE_PORT),Handler)
    try:
        server.serve_forever(poll_interval=.25)
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
        try:
            if OLLAMA_SHARE_PID.read_text().strip()==str(os.getpid()):
                OLLAMA_SHARE_PID.unlink()
        except OSError:
            pass
    return 0


def _ollama_share_proxy_alive():
    try:
        pid=int(OLLAMA_SHARE_PID.read_text().strip())
        os.kill(pid,0)
        return pid
    except (OSError,ValueError,FileNotFoundError):
        try: OLLAMA_SHARE_PID.unlink()
        except OSError: pass
        return None


def _ollama_proxy_service_paths():
    """Return the native per-user service definition path for this host."""
    system=platform.system()
    if system=="Linux" and shutil.which("systemctl"):
        return "systemd", HOME/".config"/"systemd"/"user"/f"{OLLAMA_SHARE_SERVICE}.service"
    if system=="Darwin" and shutil.which("launchctl"):
        return "launchd", HOME/"Library"/"LaunchAgents"/f"com.look.{OLLAMA_SHARE_SERVICE}.plist"
    return "process", None


def _install_ollama_proxy_service():
    """Install/enable the existing proxy using the host OS service manager.

    LOOK owns the proxy logic; systemd/launchd only own restart-at-login/boot.
    Unknown Unix hosts fall back to the existing detached-process behavior.
    """
    manager,path=_ollama_proxy_service_paths()
    if manager=="process":
        return False
    path.parent.mkdir(parents=True,exist_ok=True)
    python=str(Path(sys.executable).resolve())
    lk=str(Path(__file__).resolve())
    if manager=="systemd":
        body=f"""[Unit]\nDescription=LOOK Ollama host-rewrite proxy\nAfter=network-online.target\n\n[Service]\nType=simple\nExecStart={python} {lk} _ollama-share-proxy\nRestart=on-failure\nRestartSec=2\n\n[Install]\nWantedBy=default.target\n"""
        if not path.exists() or path.read_text()!=body:
            path.write_text(body)
        subprocess.run(["systemctl","--user","daemon-reload"],check=False,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        rc=subprocess.run(["systemctl","--user","enable","--now",path.name],check=False).returncode
        return rc==0
    label=f"com.look.{OLLAMA_SHARE_SERVICE}"
    import plistlib
    payload={"Label":label,"ProgramArguments":[python,lk,"_ollama-share-proxy"],
             "RunAtLoad":True,"KeepAlive":{"SuccessfulExit":False},
             "ProcessType":"Background"}
    data=plistlib.dumps(payload,fmt=plistlib.FMT_XML)
    if not path.exists() or path.read_bytes()!=data:
        path.write_bytes(data)
    domain=f"gui/{os.getuid()}"
    subprocess.run(["launchctl","bootout",domain,str(path)],check=False,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    rc=subprocess.run(["launchctl","bootstrap",domain,str(path)],check=False).returncode
    if rc==0:
        subprocess.run(["launchctl","enable",f"{domain}/{label}"],check=False,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        subprocess.run(["launchctl","kickstart","-k",f"{domain}/{label}"],check=False,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    return rc==0


def _disable_ollama_proxy_service():
    manager,path=_ollama_proxy_service_paths()
    if manager=="systemd" and path and path.exists():
        subprocess.run(["systemctl","--user","disable","--now",path.name],check=False,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        return True
    if manager=="launchd" and path and path.exists():
        domain=f"gui/{os.getuid()}"
        label=f"com.look.{OLLAMA_SHARE_SERVICE}"
        subprocess.run(["launchctl","bootout",domain,str(path)],check=False,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        subprocess.run(["launchctl","disable",f"{domain}/{label}"],check=False,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        return True
    return False


def _ollama_proxy_service_state():
    manager,path=_ollama_proxy_service_paths()
    if manager=="systemd" and path:
        enabled=subprocess.run(["systemctl","--user","is-enabled",path.name],capture_output=True,text=True).returncode==0
        active=subprocess.run(["systemctl","--user","is-active",path.name],capture_output=True,text=True).returncode==0
        return manager,enabled,active
    if manager=="launchd" and path:
        label=f"com.look.{OLLAMA_SHARE_SERVICE}"
        domain=f"gui/{os.getuid()}"
        active=subprocess.run(["launchctl","print",f"{domain}/{label}"],capture_output=True).returncode==0
        disabled=subprocess.run(["launchctl","print-disabled",domain],capture_output=True,text=True)
        enabled=not (disabled.returncode==0 and f'"{label}" => true' in disabled.stdout)
        return manager,enabled,active
    return manager,False,bool(_ollama_share_proxy_alive())


def _start_ollama_share_proxy():
    if _ollama_share_proxy_alive():
        return True
    STATE_DIR.mkdir(parents=True,exist_ok=True)
    with open(os.devnull,"wb") as quiet:
        proc=subprocess.Popen(
            [sys.executable,str(Path(__file__).resolve()),"_ollama-share-proxy"],
            stdin=subprocess.DEVNULL,stdout=quiet,stderr=quiet,start_new_session=True
        )
    OLLAMA_SHARE_PID.write_text(str(proc.pid)+"\n")
    os.chmod(OLLAMA_SHARE_PID,0o600)
    deadline=time.monotonic()+2.0
    url=f"http://127.0.0.1:{OLLAMA_SHARE_PORT}"
    while time.monotonic()<deadline:
        if proc.poll() is not None:
            break
        if _probe_ollama(url,.2):
            return True
        time.sleep(.05)
    _stop_ollama_share_proxy()
    return False


def _stop_ollama_share_proxy():
    pid=_ollama_share_proxy_alive()
    if pid:
        try: os.kill(pid,signal.SIGTERM)
        except OSError: pass
    try: OLLAMA_SHARE_PID.unlink()
    except OSError: pass


