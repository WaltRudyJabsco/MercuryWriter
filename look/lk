def _memory_similarity_key(text):
    words=re.findall(r"[a-z0-9]+", str(text or "").casefold())
    stop={"the","a","an","to","be","is","are","for","and","of","in","on","user","context","memory","long","term"}
    return {w for w in words if w not in stop}


def _deterministic_memory_match(text,memory):
    """Return an active-candidate index only for strong distinctive-token overlap."""
    key=_memory_similarity_key(text)
    if not key:
        return None
    items=list(memory.get("memories",[]))[:MEMORY_CANDIDATE_LIMIT]
    best=None
    for idx,item in enumerate(items):
        old_key=_memory_similarity_key(item.get("text",""))
        if not old_key:
            continue
        inter=key & old_key
        overlap=len(inter)/max(1,min(len(key),len(old_key)))
        if len(inter)>=3 and overlap>=0.65:
            score=(overlap,len(inter))
            if best is None or score>best[0]:
                best=(score,idx)
    return best[1] if best else None


def _reinforcement_from_existing(user_text,memory):
    """Treat a strongly overlapping user statement as evidence even if extraction said NONE."""
    idx=_deterministic_memory_match(user_text,memory)
    if idx is None:
        return None
    item=memory.get("memories",[])[idx]
    # Use the established candidate's importance as the baseline; reinforcement
    # itself supplies the +8 bump in _reinforce_memory_item.
    importance=max(40,int(item.get("importance",50)))
    text=" ".join(str(user_text or "").split()).strip()[:420]
    return importance,text,idx


def _semantic_memory_match(base,model,text,memory):
    """Resolve a candidate against active candidates and durable memory."""
    items=list(memory.get("memories",[]))[:MEMORY_CANDIDATE_LIMIT]
    durable=list(memory.get("durable",[]))[-MEMORY_DURABLE_LIMIT:]
    if not items and not durable:
        return "new",None
    rows="\n".join(f"{i+1}|{m.get('text','')}" for i,m in enumerate(items)) or "(none)"
    durable_rows="\n".join(f"- {m.get('text','')}" for m in durable[-40:]) or "(none)"
    summaries="\n".join(f"{k.upper()}: {v}" for k,v in (memory.get("domain_summaries",{}) or {}).items()) or "(none)"
    prompt=f"""A new candidate memory may repeat existing user memory.
Return exactly one line:
NEW
DURABLE
MATCH|N

Use DURABLE only when durable atoms/summaries already clearly contain the same meaning.
Use MATCH only for semantic equivalence or direct reinforcement of an active candidate.
Prefer NEW when uncertain. Topic similarity alone is not a match.

DURABLE DOMAIN SUMMARIES:
{summaries}

DURABLE ATOMS:
{durable_rows}

ACTIVE CANDIDATES:
{rows}

NEW CANDIDATE:
{text}
"""
    try:
        raw=_local_chat_once(base,model,[
            {"role":"system","content":"Conservatively deduplicate semantic user memory. Output one action line only."},
            {"role":"user","content":prompt},
        ],num_ctx=4096,num_predict=32,think=False,temperature=0.05)
        final=_strip_reasoning_payload(raw).strip().upper()
        if final=="DURABLE": return "summary",None
        if final=="NEW": return "new",None
        m=re.fullmatch(r"MATCH\|(\d+)",final)
        if m:
            idx=int(m.group(1))-1
            if 0<=idx<len(items): return "match",idx
    except Exception:
        pass
    return "new",None


def _reinforce_memory_item(item,new_text,new_importance):
    item["importance"]=min(100,max(int(item.get("importance",50)),int(new_importance))+8)
    item["uses"]=int(item.get("uses",0))+1
    item["last_reinforced"]=time.time()
    # Keep established wording; it is usually less volatile than a new paraphrase.
    return item


def _promotion_candidates(memory,durable_text=""):
    promoted=[]
    for item in memory.get("memories",[]):
        importance=int(item.get("importance",0))
        uses=int(item.get("uses",1))
        text=str(item.get("text",""))
        if (durable_text and text.casefold()==durable_text.casefold()) or importance>=88 or (uses>=2 and importance>=60) or (uses>=3 and importance>=48):
            promoted.append(item)
    return promoted


def _living_memory_maintain(base,model,memory,durable_text=""):
    """Promote earned candidates to durable atoms, then compile compact summaries."""
    promoted=_promotion_candidates(memory,durable_text)
    if not promoted:
        memory["last_maintenance_at"]=time.time()
        # Periodic compiler can still shrink/rewrite existing durable memory.
        memory,compiled=_compile_memory(base,model,memory,force=False)
        return memory,compiled

    promoted_ids={id(x) for x in promoted}
    added=False
    for item in promoted:
        memory,did_add=_add_durable(memory,item)
        added=added or did_add
    memory["memories"]=[x for x in memory.get("memories",[]) if id(x) not in promoted_ids]
    memory["last_consolidated_at"]=time.time()

    # Promotion deserves an immediate domain/core recompile.
    memory,compiled=_compile_memory(base,model,memory,force=True)
    memory["last_maintenance_at"]=time.time()
    return memory,bool(added or compiled)


def _consolidate_memory_candidates(memory):
    """Merge only obvious duplicates; stronger wording survives."""
    items=sorted(memory.get("memories",[]), key=lambda m:int(m.get("importance",0)), reverse=True)
    kept=[]
    for item in items:
        text=str(item.get("text","")).strip()
        key=_memory_similarity_key(text)
        merged=False
        for old in kept:
            old_key=_memory_similarity_key(old.get("text",""))
            if not key or not old_key:
                continue
            intersection=key & old_key
            overlap=len(intersection)/max(1,min(len(key),len(old_key)))
            # Two distinctive shared tokens is enough for short candidate memories
            # such as "Portland OR context" vs "Portland OR location".
            obvious=(overlap >= 0.60 and len(intersection) >= 2)
            if obvious:
                old_importance=max(int(old.get("importance",0)),int(item.get("importance",0)))
                old["importance"]=min(100,old_importance+8)
                old["uses"]=int(old.get("uses",1))+int(item.get("uses",1))
                old["created_at"]=min(float(old.get("created_at",time.time())),float(item.get("created_at",time.time())))
                old["last_reinforced"]=max(float(old.get("last_reinforced",0)),float(item.get("last_reinforced",0)),time.time())
                memory["candidate_merges_total"]=int(memory.get("candidate_merges_total",0))+1
                merged=True
                break
        if not merged:
            kept.append(item)
    memory["memories"]=kept[:MEMORY_CANDIDATE_LIMIT]
    return memory


def _rewrite_summary_maintenance(base, model, old_summary, memories, durable_text=""):
    strong=[m for m in memories if int(m.get("importance",0))>=60]
    material="\n".join(f"- [{int(m.get('importance',0))}] {m.get('text','')}" for m in strong[:14])
    prompt=f"""Rewrite the long-term user summary from scratch.

The summary is a compact current hypothesis about the user, not a permanent archive.
Keep only durable knowledge that would materially improve future conversations.

Preserve enduring preferences, current durable context, recurring projects/workflows,
and explicit long-term memory requests unless newer information contradicts them.

Remove or generalize stale implementation details, redundant facts, superseded facts,
and trivia whose removal would not materially hurt future conversations.

Hard maximum: 180 words.
Return ONLY the summary. No headings, analysis, exclusions, or word counts.

CURRENT SUMMARY:
{old_summary or "(empty)"}

STRONG CANDIDATES:
{material or "(none)"}

EXPLICIT DURABLE MEMORY:
{durable_text or "(none)"}"""
    try:
        raw=_local_chat_once(base,model,[
            {"role":"system","content":"Maintain a compact, current, forgetful long-term user summary. Output only the summary."},
            {"role":"user","content":prompt},
        ], num_ctx=4096, num_predict=300, think=False, temperature=0.15)
        clean=_sanitize_summary(raw)
        return clean if clean else old_summary
    except Exception:
        return old_summary


def _atom_key(atom):
    return (str(atom.get("k","")).casefold(),str(atom.get("s","")).casefold(),
            str(atom.get("r","")).casefold(),str(atom.get("v","")).casefold())


def _merge_machine_atoms(memory, incoming):
    """Cheap machine-native memory. Human prose is only an inspection projection."""
    now=time.time(); rows=list(memory.get("atoms",[])); by_key={_atom_key(x):x for x in rows if isinstance(x,dict)}
    for raw in incoming or []:
        if not isinstance(raw,dict): continue
        atom={"k":str(raw.get("k") or "fact")[:32],
              "s":" ".join(str(raw.get("s") or "").split())[:180],
              "r":" ".join(str(raw.get("r") or "").split())[:80],
              "v":" ".join(str(raw.get("v") or "").split())[:360],
              "c":max(1,min(100,int(raw.get("c",70) or 70))),
              "u":max(1,int(raw.get("u",1) or 1)),"t":float(raw.get("t",now) or now)}
        if not (atom["s"] or atom["v"]): continue
        key=_atom_key(atom); old=by_key.get(key)
        if old:
            old["u"]=int(old.get("u",1))+atom["u"]
            old["c"]=min(100,max(int(old.get("c",70)),atom["c"])+2)
            old["t"]=max(float(old.get("t",0)),atom["t"])
        else:
            rows.append(atom); by_key[key]=atom
    # Storage is cheap, but stale low-value atoms should not grow without bound.
    rows.sort(key=lambda x:(float(x.get("t",0)),int(x.get("c",0)),int(x.get("u",1))))
    memory["atoms"]=rows[-MEMORY_ATOM_LIMIT:]
    return memory


def _machine_atom_relevance(atom,query):
    material=" ".join(str(atom.get(k,"")) for k in ("k","s","r","v"))
    return _memory_relevance(material,query)


def _relevant_machine_atoms(memory,query,limit=MEMORY_RETRIEVED_MACHINE_ATOMS):
    ranked=[]; now=time.time()
    for atom in memory.get("atoms",[]):
        score=_machine_atom_relevance(atom,query)
        if score<=0: continue
        age=max(0.0,(now-float(atom.get("t",now)))/86400.0)
        rank=score*100+int(atom.get("c",0))+min(20,int(atom.get("u",1))*2)-min(20,age)
        ranked.append((rank,atom))
    ranked.sort(key=lambda x:x[0],reverse=True)
    return [x[1] for x in ranked[:max(1,int(limit))]]


def _mirror_machine_atoms_to_fabric(atoms):
    """Best-effort local write. Peer convergence is handled by bounded Fabric sync."""
    try:
        store,_node=_fabric_memory_store()
        for a in atoms or []:
            if not isinstance(a,dict): continue
            store.add_atom("shared",str(a.get("k") or "fact"),str(a.get("s") or ""),
                           str(a.get("r") or ""),str(a.get("v") or ""),int(a.get("c",70) or 70),_node)
        return True
    except Exception:
        return False


def _remember_exchange(base, model, memory, user_text, assistant_text, profile="workspace", cognition=None):
    """Living Memory: evidence-driven extraction, semantic reinforcement, consolidation."""
    now=time.time()
    memory=_prune_contaminated_memory(memory)
    memory=_decay_memories(memory,now)
    memory["last_evidence_at"]=now
    memory["compiler_base"]=str(base)[:500]
    memory["compiler_model"]=str(model)[:200]
    if isinstance(cognition,dict):
        incoming_atoms=cognition.get("atoms") or []
        memory=_merge_machine_atoms(memory,incoming_atoms)
        if incoming_atoms:
            _mirror_machine_atoms_to_fabric(incoming_atoms)
            # Converge shared cognition in the background without making each
            # interactive turn pay for peer discovery/network latency.
            if now-float(memory.get("last_fabric_sync_at",0) or 0) >= 120:
                result=_fabric_memory_sync()
                if result.get("ok"):
                    memory["last_fabric_sync_at"]=now

    local_only=_conversation_local_memory_intent(user_text)
    candidate=None if local_only else _extract_memory_candidate(base,model,user_text,assistant_text)
    source="local-only" if local_only else "model"
    forced_idx=None
    if not candidate and not local_only:
        candidate=_high_recall_memory_candidate(user_text)
        source="high-recall"
    if not candidate and not local_only:
        candidate=_obvious_memory_candidate(user_text)
        source="obvious"
    if not candidate and not local_only:
        candidate=_explicit_memory_hint(user_text)
        source="explicit"
    if not candidate and not local_only:
        reinforcement=_reinforcement_from_existing(user_text,memory)
        if reinforcement:
            importance,text,forced_idx=reinforcement
            candidate=(importance,text)
            source="reinforce"
    if candidate and _looks_environmental_memory(candidate[1]):
        candidate=None
        forced_idx=None
        source="environment"

    memory["last_extraction_at"]=now
    memory["extractions_total"]=int(memory.get("extractions_total",0))+1
    if local_only:
        memory["candidate_local_suppressed"]=int(memory.get("candidate_local_suppressed",0))+1
        memory["last_extraction"]="local-only"
        memory["last_extraction_reason"]="explicit transient/sidebar scope; RECENT only"
    if candidate:
        memory["extractions_candidate"]=int(memory.get("extractions_candidate",0))+1
        memory["last_extraction"]=f"candidate:{source}"
        memory["last_extraction_reason"]="reusable user-authored preference/project/workflow signal"
    else:
        memory["extractions_none"]=int(memory.get("extractions_none",0))+1
        if not local_only:
            memory["last_extraction"]="none"
            memory["last_extraction_reason"]="no reusable user-authored signal survived extraction"

    durable=_durable_memory_intent(user_text)
    durable_text=""
    evidence_changed=False

    if candidate:
        importance,text=candidate
        if durable:
            importance=max(importance,95)
            durable_text=text

        durable_idx=_durable_memory_match(memory,text)
        if durable_idx is not None:
            durable_item=memory["durable"][durable_idx]
            durable_item["importance"]=min(100,max(int(durable_item.get("importance",60)),int(importance))+4)
            durable_item["uses"]=int(durable_item.get("uses",1))+1
            durable_item["last_reinforced"]=now
            memory["last_change"]="durable-reinforced"
            memory["last_compiled_at"]=0
            evidence_changed=True
            action,idx="summary",None
        elif forced_idx is not None:
            action,idx="match",forced_idx
        else:
            deterministic_idx=_deterministic_memory_match(text,memory)
            if deterministic_idx is not None:
                action,idx="match",deterministic_idx
            else:
                action,idx=_semantic_memory_match(base,model,text,memory)

        if action=="match" and idx is not None:
            memory["memories"][idx]=_reinforce_memory_item(memory["memories"][idx],text,importance)
            durable_text=str(memory["memories"][idx].get("text","")) if durable else durable_text
            evidence_changed=True
        elif action=="summary":
            # Already represented durably: don't refill the candidate pool.
            memory["summary_last_reinforced_at"]=now
        else:
            memory=_add_memory(memory,text,importance)
            evidence_changed=True

    memory=_consolidate_memory_candidates(memory)
    memory["maintenance_cycles"]=int(memory.get("maintenance_cycles",0))+1

    if evidence_changed or durable_text:
        memory,consolidated=_living_memory_maintain(base,model,memory,durable_text)
        if consolidated:
            memory["last_change"]="consolidated"
            memory["consolidations_total"]=int(memory.get("consolidations_total",0))+1
        elif candidate:
            memory["last_change"]="candidate"
    else:
        memory["last_maintenance_at"]=now

    _save_memory(memory)
    _learn_from_exchange(base,model,user_text,assistant_text,profile)
    return memory


