def _update_skill_meta(skill, signal="new"):
    skill=_sanitize_skill(skill)
    if not skill:
        return False
    state=_load_skill_state()
    skills=state.setdefault("skills",{})
    key=_skill_key(skill)
    now=time.time()
    item=skills.get(key,{
        "text":skill,
        "confidence":1,
        "positive_hits":0,
        "negative_hits":0,
        "created_at":now,
        "last_reinforced":now,
    })
    item["text"]=skill
    if signal=="positive":
        item["positive_hits"]=int(item.get("positive_hits",0))+1
        item["confidence"]=min(10,int(item.get("confidence",1))+1)
        item["last_reinforced"]=now
    elif signal=="negative":
        item["negative_hits"]=int(item.get("negative_hits",0))+1
        item["confidence"]=max(0,int(item.get("confidence",1))-2)
        item["last_reinforced"]=now
    elif signal=="corrective":
        item["confidence"]=max(2,int(item.get("confidence",1)))
        item["last_reinforced"]=now
    else:
        item["confidence"]=max(1,int(item.get("confidence",1)))
    skills[key]=item
    _save_skill_state(state)
    return True


def _remove_skill_meta(skill):
    state=_load_skill_state()
    state.setdefault("skills",{}).pop(_skill_key(skill),None)
    _save_skill_state(state)


