def _gtnw_canvas(width=74,height=22):
    """Scale the old WOPR map to the available terminal while preserving its shape."""
    base_w=74; base_h=22
    grid=[list(" "*width) for _ in range(height)]
    sx=max(1.0,width/base_w); sy=max(1.0,height/base_h)
    for y,line in enumerate(_GTNW_MAP):
        yy=min(height-1,int(round((y+3)*sy)))
        for x,ch in enumerate(line[:base_w]):
            if ch!=" ":
                xx=min(width-1,int(round(x*sx))); grid[yy][xx]=ch
    return grid


def _gtnw_arc(start,end,steps=22,bend=None):
    import random, math
    x0,y0=start; x1,y1=end
    if bend is None: bend=random.uniform(-5.5,-2.5)
    pts=[]
    for n in range(steps):
        t=n/(steps-1)
        x=x0+(x1-x0)*t
        y=y0+(y1-y0)*t + bend*4*t*(1-t)
        pts.append((int(round(x)),int(round(y))))
    return pts


def _gtnw_render(arcs, frame, sim_no, speed, outcome=None):
    blue="\033[38;5;45m"; red="\033[38;5;196m"; dim="\033[38;5;31m"; white="\033[1;38;5;255m"; reset="\033[0m"
    terminal=shutil.get_terminal_size((80,32))
    canvas_w=max(74,min(118,terminal.columns-2)); canvas_h=max(22,min(32,terminal.lines-9))
    grid=_gtnw_canvas(canvas_w,canvas_h)
    sx=canvas_w/74; sy=canvas_h/22
    us_launch=ru_launch=us_impact=ru_impact=0
    for side,pts,delay in arcs:
        age=frame-delay
        if age<0: continue
        upto=min(len(pts),max(1,age+1))
        if side=="US": us_launch+=1
        else: ru_launch+=1
        if upto>=len(pts):
            if side=="US": ru_impact+=1
            else: us_impact+=1
        for j,(x,y) in enumerate(pts[:upto]):
            x=int(round(x*sx)); y=int(round(y*sy))
            if 0<=y<len(grid) and 0<=x<len(grid[y]):
                marker="•" if j==upto-1 and upto<len(pts) else "."
                grid[y][x]=(blue+marker+reset) if side=="US" else (red+marker+reset)
    lines=["".join(row) for row in grid]
    header=[
        "\033[2J\033[H"+white+"                 GLOBAL THERMONUCLEAR WAR"+reset,
        dim+f"                 SIMULATION {sim_no:02d}    SPEED {speed}x"+reset,
        "",
    ]
    footer=[
        "",
        blue+f" UNITED STATES  launches {us_launch:02d}  impacts {us_impact:02d}"+reset+
        "        "+red+f"SOVIET UNION  launches {ru_launch:02d}  impacts {ru_impact:02d}"+reset,
        dim+"             space accelerate   r restart   esc exit"+reset,
    ]
    if outcome:
        footer += ["",white+"                         WINNER"+reset,"",red+"                          NONE"+reset]
    sys.stdout.write("\n".join(header+lines+footer)); sys.stdout.flush()


def _gtnw_make_sim():
    import random
    # Abstract coast-to-coast arcs only. No real targets, weapon data, or operational geography.
    us=[(12,9),(17,7),(21,11),(25,8)]
    ru=[(54,8),(58,7),(61,10),(65,8)]
    arcs=[]
    total=random.randint(12,20)
    for n in range(total):
        side="US" if n%2==0 else "USSR"
        start=random.choice(us if side=="US" else ru)
        end=random.choice(ru if side=="US" else us)
        arcs.append((side,_gtnw_arc(start,end,random.randint(18,28)),n*random.randint(2,4)))
    return arcs


def game_gtnw():
    try:
        with _game_terminal() as fd:
            sim_no=1; speed=1; frame=0; arcs=_gtnw_make_sim(); finished_at=None; verdict_spoken=False
            while True:
                max_frame=max(delay+len(pts) for _,pts,delay in arcs)
                done=frame>=max_frame
                _gtnw_render(arcs,frame,sim_no,speed,outcome=done)
                if done and finished_at is None: finished_at=time.monotonic()
                if done and time.monotonic()-finished_at>2.4:
                    if sim_no>=3:
                        sys.stdout.write("\n\033[1;38;5;45m                 SIMULATIONS COMPLETE\n\n"
                                         "                 US VICTORIES       0\n"
                                         "                 USSR VICTORIES     0\n"
                                         f"                 MUTUAL LOSSES      {sim_no}\n\n"
                                         "                      INTERESTING.\033[0m")
                        sys.stdout.flush()
                        if not verdict_spoken:
                            look_games.wopr_say("INTERESTING. SOMETIMES THE BEST MOVE IS NOT TO PLAY.")
                            verdict_spoken=True
                        time.sleep(2.0)
                    sim_no+=1; frame=0; arcs=_gtnw_make_sim(); finished_at=None; continue
                key=_game_key(fd,0.10/max(1,speed))
                if key=="esc": return 0
                if key=="r": sim_no=1; speed=1; frame=0; arcs=_gtnw_make_sim(); finished_at=None; verdict_spoken=False; continue
                if key==" ": speed=2 if speed==1 else (4 if speed==2 else 1)
                if not done: frame+=speed
    except RuntimeError as exc:
        print(f"LOOK game · {exc}"); return 1


def _media_macos_run(app, statement):
    """Run one AppleScript statement only if the target app is already open."""
    script=(
        f'if application "{app}" is running then\n'
        f'  tell application "{app}" to {statement}\n'
        'else\n'
        '  return "__LOOK_NOT_RUNNING__"\n'
        'end if'
    )
    try:
        return subprocess.run(["osascript","-e",script],capture_output=True,text=True,timeout=3)
    except (OSError,subprocess.SubprocessError):
        return None


def _media_macos_get(app, expression):
    p=_media_macos_run(app,f'get {expression}')
    if p is None or p.returncode!=0:
        return None
    out=(p.stdout or "").strip()
    if not out or out=="__LOOK_NOT_RUNNING__":
        return None
    return out


def _media_macos_status_for(app):
    state=_media_macos_get(app,"player state")
    if state is None:
        return None

    artist=_media_macos_get(app,"artist of current track") or ""
    title=_media_macos_get(app,"name of current track") or ""

    return {"player":app,"state":state,"artist":artist,"title":title}


def _media_macos_players():
    return [x for x in (_media_macos_status_for(app) for app in ("Music","Spotify")) if x]


def _media_macos_owner(*, include_paused_owner=True):
    players=_media_macos_players()
    playing=next((p for p in players if p["state"].lower()=="playing"),None)
    if playing:
        return playing
    if include_paused_owner:
        owner=str((_media_session() or {}).get("owner") or "")
        if owner.startswith("system:"):
            wanted=owner.split(":",1)[1]
            prior=next((p for p in players if p["player"]==wanted),None)
            if prior:
                return prior
    return None


def _media_macos_show_status(preferred=None):
    players=_media_macos_players()
    if not players:
        print("LOOK media · no supported player is open (Music or Spotify)")
        return 1
    current=next((p for p in players if p["player"]==preferred),None) if preferred else None
    current=current or next((p for p in players if p["state"].lower()=="playing"),players[0])
    track=" — ".join(x for x in (current["artist"],current["title"]) if x)
    print(f"{current['player']} · {current['state'] or 'unknown'}" + (f" · {track}" if track else ""))
    return 0


def _media_macos(action, preferred=None):
    if action=="status":
        return _media_macos_show_status(preferred)
    commands={
        "Music":{"play":"play","pause":"pause","toggle":"playpause","next":"next track","prev":"previous track","stop":"stop"},
        "Spotify":{"play":"play","pause":"pause","toggle":"playpause","next":"next track","prev":"previous track","stop":"pause"},
    }
    owner=_media_macos_owner()
    order=[]
    if preferred: order.append(preferred)
    if owner and owner["player"] not in order: order.append(owner["player"])
    order += [app for app in ("Music","Spotify") if app not in order]
    for app in order:
        p=_media_macos_run(app,commands[app][action])
        if p is None: continue
        out=(p.stdout or "").strip()
        if p.returncode==0 and out!="__LOOK_NOT_RUNNING__":
            _media_claim_owner("system:"+app)
            return _media_macos_show_status(preferred=app)
    print("LOOK media · no supported player is open (Music or Spotify)")
    return 1


def _media_linux_players():
    playerctl=shutil.which("playerctl")
    if not playerctl: return playerctl,[]
    try:
        p=subprocess.run([playerctl,"-l"],capture_output=True,text=True,timeout=3)
        return playerctl,[x.strip() for x in (p.stdout or "").splitlines() if x.strip()]
    except (OSError,subprocess.SubprocessError):
        return playerctl,[]


def _media_linux_owner(*, include_paused_owner=True):
    playerctl,players=_media_linux_players()
    if not playerctl: return None
    for candidate in players:
        try:
            st=subprocess.run([playerctl,"-p",candidate,"status"],capture_output=True,text=True,timeout=2)
            if (st.stdout or "").strip().lower()=="playing": return candidate
        except (OSError,subprocess.SubprocessError): pass
    if include_paused_owner:
        owner=str((_media_session() or {}).get("owner") or "")
        if owner.startswith("system:") and owner.split(":",1)[1] in players:
            return owner.split(":",1)[1]
    return None


def _media_linux(action, preferred=None):
    playerctl,players=_media_linux_players()
    if not playerctl:
        print("LOOK media · Linux media control needs playerctl (MPRIS)")
        print("  install with your package manager, e.g. sudo apt install playerctl")
        return 1
    if not players:
        print("LOOK media · no MPRIS player found"); return 1
    chosen=preferred if preferred in players else (_media_linux_owner() or players[0])
    try:
        if action=="status":
            state=subprocess.run([playerctl,"-p",chosen,"status"],capture_output=True,text=True,timeout=2).stdout.strip()
            artist=subprocess.run([playerctl,"-p",chosen,"metadata","artist"],capture_output=True,text=True,timeout=2).stdout.strip()
            title=subprocess.run([playerctl,"-p",chosen,"metadata","title"],capture_output=True,text=True,timeout=2).stdout.strip()
            track=" — ".join(x for x in (artist,title) if x)
            print(f"{chosen} · {state or 'unknown'}" + (f" · {track}" if track else ""))
            return 0
        command={"play":"play","pause":"pause","toggle":"play-pause","next":"next","prev":"previous","stop":"stop"}[action]
        rc=subprocess.run([playerctl,"-p",chosen,command],timeout=3).returncode
        if rc==0: _media_claim_owner("system:"+chosen)
        return rc
    except (OSError,subprocess.SubprocessError) as e:
        print(f"LOOK media · {e}"); return 1


def _media_system_owner(*, include_paused_owner=True):
    """Return the real transport owner, never mere queue state."""
    if platform.system()=="Darwin":
        row=_media_macos_owner(include_paused_owner=include_paused_owner)
        return ("Darwin",row["player"]) if row else None
    if platform.system()=="Linux":
        player=_media_linux_owner(include_paused_owner=include_paused_owner)
        return ("Linux",player) if player else None
    return None


def _media_system_control(action, owner=None):
    system=platform.system()
    preferred=(owner[1] if owner else None)
    if system=="Darwin": return _media_macos(action,preferred)
    if system=="Linux": return _media_linux(action,preferred)
    print(f"LOOK media · unsupported platform: {system}"); return 1


def _media_pause_playing_system():
    """Quietly hand transport ownership to LOOK after LOOK really starts.

    This prevents two players from remaining active. Failure is intentionally
    nonfatal: external-player control is an optional edge capability.
    """
    owner=_media_system_owner()
    if not owner:
        return
    system,preferred=owner
    try:
        if system=="Darwin":
            command={"Music":"pause","Spotify":"pause"}.get(preferred)
            if command: _media_macos_run(preferred,command)
        elif system=="Linux":
            playerctl,_=_media_linux_players()
            if playerctl: subprocess.run([playerctl,"-p",preferred,"pause"],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=2)
    except (OSError,subprocess.SubprocessError):
        pass


def _media_fcl_node():
    exe=shutil.which("fcl-node") or str(HOME/".local/bin/fcl-node")
    return exe if Path(exe).exists() else ""


def _media_fabric_cli(args):
    exe=_media_fcl_node()
    if not exe:
        raise RuntimeError("Unified Node is not installed")
    p=subprocess.run([exe,*args,"--json"],capture_output=True,text=True,timeout=600)
    if p.returncode!=0:
        raise RuntimeError((p.stderr or p.stdout or "Fabric command failed").strip())
    raw=(p.stdout or "").strip()
    try:
        return json.loads(raw)
    except ValueError:
        # CLI helpers should emit pure JSON, but shell/service startup chatter must
        # never make media unusable. Accept one complete JSON value at the tail.
        decoder=json.JSONDecoder()
        for offset,ch in reversed(list(enumerate(raw))):
            if ch not in "{[":
                continue
            try:
                value,end=decoder.raw_decode(raw[offset:])
            except ValueError:
                continue
            if not raw[offset+end:].strip():
                return value
        detail=raw[-240:].replace("\n"," · ") if raw else "empty stdout"
        raise RuntimeError(f"Fabric command returned invalid JSON · {detail}")


def _media_update_identity_for_path(path,digest):
    """Attach expensive SHA identity to an existing cheap scan row."""
    if not digest:
        return
    target=str(Path(path).expanduser().resolve())
    library=_media_library()
    changed=False
    for row in library.get("entries") or []:
        if str(row.get("path") or "") == target:
            row["digest"]=str(digest)
            row["identified_at"]=time.time()
            changed=True
            break
    if changed:
        library["updated"]=time.time()
        _media_save_library(library)


def _media_register(path):
    target=Path(path).expanduser().resolve()
    if not target.is_file():
        raise FileNotFoundError(target)
    payload=_media_fabric_cli(["artifact-add",str(target)])
    meta=payload.get("artifact") or {}
    _media_update_identity_for_path(target,meta.get("digest"))
    return payload


def _media_fabric_catalog():
    """One online Fabric catalog, with a local-library fallback when the node is down."""
    try:
        payload=_media_fabric_cli(["media-catalog"])
        if isinstance(payload,dict):
            return payload
    except RuntimeError:
        pass
    local=_media_library()
    node=platform.node() or "local"
    rows=[]
    for raw in local.get("entries") or []:
        row=dict(raw)
        row["node"]=node
        row["identified"]=bool(row.get("digest"))
        rows.append(row)
    return {
        "schema":"fabric-media-catalog-v1",
        "entries":rows,
        "nodes":[{"node":node,"count":len(rows),"identified":sum(1 for row in rows if row.get("digest")),"online":True}],
        "locations":len(rows),
        "identified_locations":sum(1 for row in rows if row.get("digest")),
        "fallback":True,
    }


def _media_catalog_entries():
    payload=_media_fabric_catalog()
    nodes=payload.get("nodes") or []
    local_node=str((nodes[0] or {}).get("node") or platform.node() or "local") if nodes else (platform.node() or "local")
    return media_core.merge_catalog_entries(payload.get("entries") or [],local_node=local_node),payload


def _media_query_matches(query,match_mode="fuzzy"):
    """Resolve catalog text with one shared literal/fuzzy confidence contract."""
    query=" ".join(str(query or "").split()).strip()
    if not query:
        return "none",[]
    rows,_=_media_catalog_entries()
    mode=str(match_mode or "fuzzy").casefold()
    if mode=="literal":
        exact=media_core.exact_entries({"entries":rows},query)
        if len(exact)==1: return "item",exact
        if exact: return "ambiguous",exact
        return "none",[]

    qnorm=media_core.normalize_match_text(query)
    exact_album=[r for r in rows if media_core.normalize_match_text(str(r.get("album") or ""))==qnorm]
    if exact_album:
        return "album",sorted(exact_album,key=media_core.entry_sort_key)
    artist_q=media_core._artist_key(media_core.normalize_match_text(query))
    exact_artist=[r for r in rows if media_core._artist_key(media_core.normalize_match_text(str(r.get("artist") or "")))==artist_q]
    if exact_artist:
        return "artist",sorted(exact_artist,key=media_core.entry_sort_key)
    exact_title=[r for r in rows if media_core.normalize_match_text(str(r.get("title") or ""))==qnorm]
    if exact_title:
        return "title",sorted(exact_title,key=media_core.entry_sort_key)

    ranked=media_core.rank_entries({"entries":rows},query,limit=12)
    if not ranked:
        return "none",[]
    fuzzy=[row for row,_score in ranked]
    artists={str(r.get("artist") or "").strip() for r in fuzzy if str(r.get("artist") or "").strip()}
    if len(artists)==1:
        artist=next(iter(artists))
        norm_artist=media_core._artist_key(media_core.normalize_match_text(artist))
        if artist_q and (artist_q in norm_artist or norm_artist in artist_q):
            return "artist",sorted(fuzzy,key=media_core.entry_sort_key)

    top=ranked[0][1]
    second=ranked[1][1] if len(ranked)>1 else 0.0
    # Strong normalized/partial matches may execute without interaction. Close
    # races remain ambiguous so the caller can cheaply offer candidates.
    if top>=0.97 or (top>=0.90 and top-second>=0.08) or (top>=0.84 and len(ranked)==1):
        return "item",[ranked[0][0]]
    return "ambiguous",fuzzy


def _media_tool_search(query,limit=12):
    query=" ".join(str(query or "").split()).strip()
    try:
        limit=max(1,min(40,int(limit or 12)))
    except (TypeError,ValueError):
        limit=12
    kind,rows=_media_query_matches(query)
    payload={
        "edge":"MEDIA",
        "operation":"search",
        "query":query,
        "match_kind":kind,
        "matches":len(rows),
        "results":[{
            "id":row.get("digest") or row.get("id"),
            "artist":row.get("artist") or "",
            "album":row.get("album") or "",
            "title":row.get("title") or "",
            "node":row.get("node") or "",
            "identified":bool(row.get("digest")),
        } for row in rows[:limit]],
    }
    return json.dumps(payload,ensure_ascii=False)


def _media_tool_play(query,shuffle=False,kind="",artist="",selection="",limit=0,match_mode="fuzzy"):
    query=" ".join(str(query or "").split()).strip()
    kind_filter=str(kind or "").casefold()
    artist=" ".join(str(artist or "").split()).strip()
    selection=str(selection or "").casefold()
    if query:
        match_kind,rows=_media_query_matches(query,match_mode=match_mode)
    elif kind_filter or artist or selection:
        catalog,_=_media_catalog_entries()
        try: wanted_limit=max(0,min(100,int(limit or 0)))
        except (TypeError,ValueError): wanted_limit=0
        rows=media_core.select_entries({"entries":catalog},kind=kind_filter,artist=artist,selection=selection or "all",limit=wanted_limit)
        match_kind="selector"
    else:
        return _ToolResult(False,"needs_input","MEDIA NEEDS INPUT · what should I play?")
    label=query or (artist if artist else ("any "+kind_filter if kind_filter else "media"))
    if not rows:
        return _ToolResult(False,"not_found",f"MEDIA NOT FOUND · {label}")
    if match_kind=="ambiguous":
        preview="; ".join(_media_row_label(row) for row in rows[:8])
        return _ToolResult(False,"ambiguous",f"MEDIA AMBIGUOUS · {label} · {len(rows)} matches · {preview}")
    session=media_core.new_session(rows,shuffle=bool(shuffle))
    # Capture the edge diagnostic so browser/LO callers see the useful reason rather
    # than a generic MEDIA PLAY FAILED receipt. Successful playback remains quiet.
    import io, contextlib
    edge_log=io.StringIO()
    with contextlib.redirect_stdout(edge_log):
        rc=_media_launch_session(session)
    if rc!=0:
        detail=" · ".join(line.strip() for line in edge_log.getvalue().splitlines() if line.strip())
        suffix=f" · {detail[:500]}" if detail else ""
        return _ToolResult(False,"failed",f"MEDIA PLAY FAILED · {query}{suffix}")
    if match_kind=="title" and len(rows)==1:
        label=_media_row_label(rows[0])
    return _ToolResult(True,"ok",f"MEDIA PLAY OK · {match_kind} · {label} · {len(rows)} item{'s' if len(rows)!=1 else ''}" + (" · shuffle" if shuffle else ""))


def _media_tool_queue(query):
    query=" ".join(str(query or "").split()).strip()
    if not query:
        return _ToolResult(False,"needs_input","MEDIA NEEDS INPUT · what should I queue?")
    kind,rows=_media_query_matches(query)
    if not rows:
        return _ToolResult(False,"not_found",f"MEDIA NOT FOUND · {query}")
    if kind=="ambiguous":
        preview="; ".join(_media_row_label(row) for row in rows[:8])
        return _ToolResult(False,"ambiguous",f"MEDIA AMBIGUOUS · {query} · {len(rows)} matches · {preview}")
    count=_media_queue_append(rows)
    return _ToolResult(True,"ok",f"MEDIA QUEUE OK · {kind} · {query} · {count} item{'s' if count!=1 else ''}")


def _media_snapshot_payload():
    """Small renderer-neutral view of the canonical LOOK MediaSession."""
    snap=_media_status_snapshot()
    if not snap:
        return {"active":False,"state":"stopped","index":0,"count":0,"entry":{},"queue":[]}
    session=snap.get("session") or {}
    queue=session.get("queue") or []
    def clean(row):
        return {
            "artist":str(row.get("artist") or ""),
            "album":str(row.get("album") or ""),
            "title":str(row.get("title") or Path(str(row.get("path") or "Media")).name),
            "id":str(row.get("digest") or row.get("id") or ""),
            "node":str(row.get("node") or ""),
        }
    return {
        "active":bool(queue) and snap.get("state") in {"playing","paused"},
        "state":str(snap.get("state") or "stopped"),
        "index":int(snap.get("index") or 0),
        "count":int(snap.get("count") or 0),
        "position":snap.get("position"),
        "duration":snap.get("duration"),
        "volume":snap.get("volume"),
        "entry":clean(snap.get("entry") or {}),
        "queue":[clean(row) for row in queue],
        "shuffle":bool(session.get("shuffle")),
        "repeat":str(session.get("repeat") or "off"),
        "player":str(session.get("player") or ""),
        "owner":str(session.get("owner") or ""),
        "source_node":str((snap.get("entry") or {}).get("node") or ""),
        "playback_node":socket.gethostname(),
        "presentation":str(session.get("presentation") or ""),
        "launch_argv":list(session.get("launch_argv") or []),
        "updated":session.get("updated"),
    }



def _media_full_session_payload():
    session=_media_sync_session() or _media_session()
    if not session:
        return {"schema":media_core.SCHEMA_SESSION,"queue":[],"current_index":0,"state":"stopped"}
    return media_core.normalize_session(session)


def _media_adopt_session(source):
    try:
        raw=sys.stdin.read() if source=="-" else Path(source).expanduser().read_text(encoding="utf-8")
        data=json.loads(raw or "{}")
        session=media_core.normalize_session(data)
    except (OSError,ValueError,TypeError) as exc:
        print(f"LOOK media · invalid session: {exc}")
        return 1
    if not session.get("queue"):
        print("LOOK media · adopted session is empty")
        return 1
    return _media_launch_session(session)

def _media_tool_control(action):
    aliases={"resume":"play","previous":"prev"}
    action=aliases.get(str(action or "status").casefold(),str(action or "status").casefold())
    if action not in {"status","play","pause","toggle","next","prev","stop","first","last","first_album","next_album"}:
        return _ToolResult(False,"invalid",f"MEDIA CONTROL INVALID · {action}")
    if action=="status":
        snap=_media_status_snapshot()
        if not snap:
            return _ToolResult(True,"ok","MEDIA STATUS · nothing playing")
        entry=snap["entry"]
        return _ToolResult(True,"ok",f"MEDIA STATUS · {snap['state']} · {_media_entry_label(entry)} · {snap['index']+1}/{snap['count']}")
    if action in {"first","last","first_album","next_album"}:
        result=_media_jump_ordinal(action)
    else:
        result=_media_control_session(action)
    if result is None:
        return _ToolResult(False,"unavailable",f"MEDIA CONTROL UNAVAILABLE · {action} · no LOOK media session")
    if result!=0:
        return _ToolResult(False,"failed",f"MEDIA CONTROL FAILED · {action}")
    snap=_media_status_snapshot()
    suffix=f" · {_media_entry_label(snap['entry'])}" if snap else ""
    return _ToolResult(True,"ok",f"MEDIA CONTROL OK · {action}{suffix}")


def _media_jump_ordinal(action):
    """Move within the canonical queue without asking a model to interpret ordinals."""
    session=_media_sync_session() or _media_session()
    if not session or not session.get("queue"):
        return None
    queue=session["queue"]
    current=max(0,min(int(session.get("current_index") or 0),len(queue)-1))
    if action=="first":
        target=0
    elif action=="last":
        target=len(queue)-1
    else:
        album=str(queue[current].get("album") or "").strip().casefold()
        if not album: return 1
        matches=[i for i,row in enumerate(queue) if str(row.get("album") or "").strip().casefold()==album]
        if not matches: return 1
        if action=="first_album":
            target=matches[0]
        else:
            target=next((i for i,row in enumerate(queue[current+1:],start=current+1)
                         if str(row.get("album") or "").strip().casefold()!=album),None)
            if target is None: return 1
    runtime_map=session.get("runtime_queue_indices") or list(range(len(queue)))
    try:
        runtime_pos=runtime_map.index(target)
    except ValueError:
        return 1
    result=_media_mpv_request(["set_property","playlist-pos",runtime_pos])
    if not result or result.get("error")!="success":
        return 1
    session["current_index"]=target
    session["state"]="playing"
    _media_save_session(session)
    return 0


def _media_identify_catalog_entry(row):
    """Promote one discovered row to SHA identity on the node that owns its bytes."""
    if row.get("digest"):
        return dict(row)
    node=str(row.get("node") or "").strip()
    entry_id=str(row.get("id") or "").strip()
    path=str(row.get("path") or "").strip()
    if path and Path(path).expanduser().is_file():
        payload=_media_register(path)
        out=dict(row)
        out["digest"]=(payload.get("artifact") or {}).get("digest")
        return out
    if node and entry_id:
        payload=_media_fabric_cli(["media-identify","--node",node,entry_id])
        entry=payload.get("entry") or {}
        out=dict(row)
        out.update(entry)
        out["digest"]=(payload.get("artifact") or {}).get("digest") or entry.get("digest")
        return out
    raise RuntimeError("media item has no reachable source to identify")


def _media_artifact(digest,node=None):
    args=["artifact"]
    if node:
        args += ["--node",node]
    args.append(digest)
    return _media_fabric_cli(args)


def _media_read_json(path, default):
    try:
        data=json.loads(Path(path).read_text(encoding="utf-8"))
        return data
    except (OSError,ValueError,TypeError):
        return default


def _media_library():
    return media_core.normalize_library(_media_read_json(MEDIA_LIBRARY_FILE,{}))


def _media_save_library(library):
    _atomic_json(MEDIA_LIBRARY_FILE,media_core.normalize_library(library))


def _media_session():
    if not MEDIA_SESSION_FILE.exists():
        return None
    data=_media_read_json(MEDIA_SESSION_FILE,{})
    if not isinstance(data,dict):
        return None
    return media_core.normalize_session(data)


def _media_save_session(session):
    session=media_core.normalize_session(session)
    session["updated"]=time.time()
    _atomic_json(MEDIA_SESSION_FILE,session)
    return session


def _media_claim_owner(owner):
    """Remember who owns transport so pause does not lose the next keypress.

    A player that is merely paused is still the active media session. External
    playback is re-detected on every command, so a newly playing app can claim
    ownership without a resident watcher.
    """
    session=_media_session() or media_core.new_session([])
    session["owner"]=str(owner or "")
    session["owner_updated"]=time.time()
    return _media_save_session(session)


def _media_mpv_request(command):
    """Send one command to the LOOK-owned mpv session, if one is alive."""
    if not hasattr(socket,"AF_UNIX") or not MEDIA_IPC_FILE.exists():
        return None
    request={"command":list(command),"request_id":int(time.time_ns() & 0x7fffffff)}
    try:
        with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as sock:
            sock.settimeout(.6)
            sock.connect(str(MEDIA_IPC_FILE))
            sock.sendall((json.dumps(request,separators=(",",":"))+"\n").encode())
            data=b""
            while b"\n" not in data and len(data)<65536:
                chunk=sock.recv(4096)
                if not chunk: break
                data+=chunk
        if not data:
            return None
        return json.loads(data.splitlines()[0])
    except (OSError,ValueError):
        return None


def _media_mpv_property(name):
    result=_media_mpv_request(["get_property",name])
    if result and result.get("error")=="success":
        return result.get("data")
    return None


def _media_owned_mpv_pids():
    """Return only mpv processes launched with LOOK's exact IPC marker.

    A vanished IPC pathname can orphan an otherwise healthy mpv process. Process
    ownership therefore cannot depend on the socket still existing. Never match
    generic mpv processes: users may have unrelated players open.
    """
    marker=f"--input-ipc-server={MEDIA_IPC_FILE}"
    owned=[]
    proc_root=Path("/proc")
    if proc_root.is_dir():
        for item in proc_root.iterdir():
            if not item.name.isdigit(): continue
            try:
                raw=(item/"cmdline").read_bytes()
                argv=[x.decode("utf-8","replace") for x in raw.split(b"\0") if x]
            except (OSError,PermissionError):
                continue
            if not argv or Path(argv[0]).name!="mpv" or marker not in argv: continue
            owned.append(int(item.name))
        return sorted(set(owned))
    # Portable fallback for macOS/other Unix hosts. Match the exact IPC argument
    # and executable token rather than using killall/pgrep mpv.
    try:
        out=subprocess.check_output(["ps","-axo","pid=,command="],text=True,stderr=subprocess.DEVNULL)
    except (OSError,subprocess.SubprocessError):
        return []
    for line in out.splitlines():
        line=line.strip()
        if not line or marker not in line: continue
        first,*rest=line.split(None,1)
        try: pid=int(first)
        except ValueError: continue
        command=rest[0] if rest else ""
        token=command.split(None,1)[0] if command else ""
        if Path(token).name=="mpv": owned.append(pid)
    return sorted(set(owned))


def _media_stop_owned_mpvs(*, except_pid=None):
    """Stop stale LOOK-owned playback workers without touching unrelated mpv."""
    victims=[pid for pid in _media_owned_mpv_pids() if pid!=except_pid and pid!=os.getpid()]
    for pid in victims:
        try: os.kill(pid,signal.SIGTERM)
        except (ProcessLookupError,PermissionError): pass
    if victims:
        deadline=time.time()+0.35
        while time.time()<deadline:
            alive=[]
            for pid in victims:
                try: os.kill(pid,0); alive.append(pid)
                except (ProcessLookupError,PermissionError): pass
            if not alive: break
            time.sleep(.03)
        for pid in victims:
            try: os.kill(pid,0)
            except (ProcessLookupError,PermissionError): continue
            try: os.kill(pid,signal.SIGKILL)
            except (ProcessLookupError,PermissionError): pass
    return victims


def _media_mpv_alive():
    """True when LOOK's mpv IPC endpoint answers, regardless of idle state."""
    result=_media_mpv_request(["get_property","idle-active"])
    return bool(result and result.get("error")=="success")


def _media_mpv_loaded():
    """True only when LOOK's mpv owns an actually loaded media item.

    An --idle=yes worker with a dead URL is infrastructure, not a media session.
    It must never steal MM/MN/MP from Music, Spotify, or an MPRIS player.
    """
    if not _media_mpv_alive():
        return False
    idle=_media_mpv_property("idle-active")
    return idle is False


def _media_wait_for_mpv_loaded(timeout=3.0):
    deadline=time.monotonic()+max(.2,float(timeout))
    while time.monotonic()<deadline:
        if _media_mpv_loaded():
            return True
        time.sleep(.035)
    return _media_mpv_loaded()


def _media_wait_for_mpv_start(proc, timeout=3.0):
    """Confirm our freshly spawned mpv actually became controllable.

    Popen only proves exec was attempted. A real playback receipt requires the
    owned worker to survive startup and expose its IPC socket; otherwise surface
    the player log instead of recording a fictional playing session.
    """
    deadline=time.monotonic()+max(.2,float(timeout))
    while time.monotonic()<deadline:
        if proc.poll() is not None:
            detail=" · ".join(line.strip() for line in _media_tail_player_log(6) if line.strip())
            print(f"LOOK media · mpv exited during startup · exit {proc.returncode}" + (f" · {detail[:500]}" if detail else ""))
            return False
        if _media_mpv_loaded():
            return True
        time.sleep(.035)
    if proc.poll() is None and _media_mpv_loaded():
        return True
    detail=" · ".join(line.strip() for line in _media_tail_player_log(6) if line.strip())
    print("LOOK media · mpv did not become ready" + (f" · {detail[:500]}" if detail else ""))
    try: proc.terminate()
    except OSError: pass
    return False


def _media_time(value):
    if not isinstance(value,(int,float)) or value < 0:
        return "--:--"
    seconds=int(value)
    if seconds >= 3600:
        return f"{seconds//3600}:{(seconds%3600)//60:02d}:{seconds%60:02d}"
    return f"{seconds//60}:{seconds%60:02d}"


def _media_entry_label(entry):
    artist=str(entry.get("artist") or "").strip()
    title=str(entry.get("title") or "").strip()
    if not title:
        title=Path(str(entry.get("path") or entry.get("digest") or "Media")).name
    return f"{artist} — {title}" if artist else title


def _media_sync_session(session=None):
    """Reconcile runtime position into LOOK's canonical queue state."""
    session=session or _media_session()
    if not session:
        return None
    if _media_mpv_alive():
        pos=_media_mpv_property("playlist-pos")
        if isinstance(pos,int) and session.get("queue"):
            runtime_map=session.get("runtime_queue_indices") or []
            if isinstance(runtime_map,list) and 0 <= pos < len(runtime_map):
                session["current_index"]=max(0,min(int(runtime_map[pos]),len(session["queue"])-1))
            else:
                session["current_index"]=max(0,min(pos,len(session["queue"])-1))
        idle=bool(_media_mpv_property("idle-active"))
        paused=bool(_media_mpv_property("pause"))
        session["state"]="stopped" if idle else ("paused" if paused else "playing")
        session["position"]=_media_mpv_property("time-pos")
        session["duration"]=_media_mpv_property("duration")
        session["volume"]=_media_mpv_property("volume")
        return _media_save_session(session)
    if session.get("state") in {"playing","paused"}:
        session["state"]="stopped"
        session.pop("pid",None)
        return _media_save_session(session)
    return session


def _media_status_snapshot():
    session=_media_sync_session()
    if not session:
        return None
    queue=session.get("queue") or []
    idx=int(session.get("current_index") or 0)
    entry=queue[idx] if queue and 0 <= idx < len(queue) else {}
    return {
        "session":session,
        "entry":entry,
        "index":idx,
        "count":len(queue),
        "state":session.get("state") or "stopped",
        "position":session.get("position"),
        "duration":session.get("duration"),
        "volume":session.get("volume"),
    }


def _media_local_node_names():
    """Names that unambiguously refer to this machine for media routing."""
    names={"local","localhost","127.0.0.1",platform.node(),socket.gethostname()}
    return {str(name).strip().casefold() for name in names if str(name).strip()}


def _media_entry_source(entry):
    """Resolve a queue entry without disguising stale local paths as streams.

    Local catalog rows must resolve to real local files. Only rows owned by another
    Fabric node are routed through the loopback media proxy. This keeps a moved or
    unmounted disk visible as catalog state instead of making mpv fail on a fake URL.
    """
    candidates=[]
    primary_path=str(entry.get("path") or "").strip()
    if primary_path:
        candidates.append((str(entry.get("node") or ""),primary_path,str(entry.get("id") or ""),str(entry.get("digest") or "")))
    for loc in entry.get("locations") or []:
        if not isinstance(loc,dict): continue
        item=(str(loc.get("node") or ""),str(loc.get("path") or "").strip(),str(loc.get("id") or ""),str(loc.get("digest") or ""))
        if item not in candidates: candidates.append(item)

    for _node,path,_entry_id,_digest in candidates:
        if not path: continue
        if path.startswith(("http://","https://")): return path
        target=Path(path).expanduser()
        if target.is_file(): return str(target.resolve())

    local_names=_media_local_node_names()
    stale_local=[]
    for node,path,entry_id,_digest in candidates:
        if node and str(node).casefold() in local_names:
            if path:
                stale_local.append(path)
            continue
        if node and entry_id:
            return "http://127.0.0.1:7332/v1/media/item?"+urllib.parse.urlencode({"node":node,"id":entry_id,"path":path})

    if stale_local:
        raise FileNotFoundError(
            "stale local catalog path: "+stale_local[0]+" · rescan or relocate the media root"
        )

    digest=str(entry.get("digest") or "").strip()
    source_node=str(entry.get("node") or "").strip()
    if digest:
        params={"digest":digest}
        if source_node: params["node"]=source_node
        return "http://127.0.0.1:7332/v1/media/artifact?"+urllib.parse.urlencode(params)
    raise FileNotFoundError(primary_path or "media queue entry has no path, catalog id, or digest")


def _media_wait_for_local_queue(queue, attempts=4):
    """Give automounted local media one bounded chance to become readable.

    Desktop/removable volumes can briefly disappear at the exact instant playback is
    requested even though the mount is healthy a fraction of a second later. Probe
    once per queue, not once per track, so a missing 60-song album costs about one
    second rather than a minute. Remote-only queues return immediately.
    """
    local_names=_media_local_node_names()
    paths=[]
    for entry in queue:
        candidates=[entry]
        candidates.extend(loc for loc in (entry.get("locations") or []) if isinstance(loc,dict))
        for loc in candidates:
            node=str(loc.get("node") or entry.get("node") or "").strip().casefold()
            path=str(loc.get("path") or "").strip()
            if not path or path.startswith(("http://","https://")):
                continue
            if not node or node in local_names:
                paths.append(Path(path).expanduser())
    if not paths:
        return False

    delays=(0.0,0.12,0.28,0.55)
    tries=max(1,min(int(attempts),len(delays)))
    for attempt in range(tries):
        if attempt:
            time.sleep(delays[attempt])
        if any(path.is_file() for path in paths):
            return True
    return False


def _media_write_m3u(queue):
    MEDIA_QUEUE_FILE.parent.mkdir(parents=True,exist_ok=True)
    _media_wait_for_local_queue(queue)
    lines=["#EXTM3U"]
    playable=[]
    missing=[]
    index_map=[]
    for queue_index,entry in enumerate(queue):
        try:
            source=_media_entry_source(entry)
        except (RuntimeError,FileNotFoundError,ValueError) as exc:
            missing.append((_media_entry_label(entry),str(exc)))
            continue
        lines.append(f"#EXTINF:-1,{_media_entry_label(entry)}")
        lines.append(source)
        playable.append(entry)
        index_map.append(queue_index)
    MEDIA_QUEUE_FILE.write_text("\n".join(lines)+"\n",encoding="utf-8")
    try: os.chmod(MEDIA_QUEUE_FILE,0o600)
    except OSError: pass
    return playable,missing,index_map


def _media_mpv_binary():
    """Find mpv even when LOOK is invoked from a sparse service environment.

    Browser/system services commonly miss Homebrew/Linuxbrew paths that interactive
    shells add during startup. Playback capability should not depend on shell rc files.
    """
    configured=str(os.environ.get("LOOK_MEDIA_PLAYER","")).strip()
    if configured:
        found=shutil.which(configured)
        if found: return found
        if Path(configured).is_file(): return str(Path(configured).resolve())
    found=shutil.which("mpv")
    if found: return found
    candidates=(
        Path.home()/".linuxbrew/bin/mpv",
        Path("/home/linuxbrew/.linuxbrew/bin/mpv"),
        Path("/opt/homebrew/bin/mpv"),
        Path("/usr/local/bin/mpv"),
        Path("/usr/bin/mpv"),
    )
    for candidate in candidates:
        if candidate.is_file() and os.access(candidate,os.X_OK):
            return str(candidate)
    return ""


def _media_tail_player_log(limit=12):
    try:
        lines=MEDIA_MPV_LOG.read_text(encoding="utf-8",errors="replace").splitlines()
    except OSError:
        return []
    return lines[-max(1,int(limit)):]


def _media_doctor():
    """Small deterministic probe for the player edge and current queue source."""
    mpv=_media_mpv_binary()
    print("LOOK MEDIA DOCTOR")
    print(f"  mpv       {mpv or 'missing'}")
    if mpv:
        try:
            cp=subprocess.run([mpv,"--version"],capture_output=True,text=True,timeout=3)
            first=(cp.stdout or cp.stderr or "").splitlines()[:1]
            if first: print(f"  version   {first[0]}")
        except Exception as exc:
            print(f"  version   error · {exc}")
    session=_media_session() or {}
    queue=session.get("queue") or []
    print(f"  queue     {len(queue)} item{'s' if len(queue)!=1 else ''}")
    if queue:
        idx=max(0,min(int(session.get("current_index") or 0),len(queue)-1))
        row=queue[idx]
        print(f"  item      {idx+1}/{len(queue)} · {_media_entry_label(row)}")
        try:
            source=_media_entry_source(row)
            print(f"  source    {source}")
            local=Path(source).expanduser() if not str(source).startswith(("http://","https://")) else None
            if local is not None:
                try:
                    st=local.stat(); print(f"  bytes     {st.st_size:,}")
                except OSError as exc:
                    print(f"  bytes     unavailable · {exc}")
            if str(source).startswith(("http://","https://")):
                try:
                    req=urllib.request.Request(source,headers={"Range":"bytes=0-1023"})
                    with urllib.request.urlopen(req,timeout=4) as response:
                        status=getattr(response,"status",200)
                        cr=response.headers.get("Content-Range") or ""
                        cl=response.headers.get("Content-Length") or ""
                        sample=response.read(32)
                        detail=" · ".join(x for x in (cr,(f"{cl} bytes" if cl else "")) if x)
                        print(f"  http      {status}" + (f" · {detail}" if detail else "") + f" · sample {len(sample)} bytes")
                except urllib.error.HTTPError as exc:
                    try: body=exc.read(300).decode("utf-8","replace").strip()
                    except Exception: body=""
                    print(f"  http      {exc.code} {exc.reason}" + (f" · {body[:220]}" if body else ""))
                except Exception as exc:
                    print(f"  http      error · {exc}")
            if mpv:
                probe=[mpv,"--no-config","--no-terminal","--ao=null","--vo=null","--length=0.25",source]
                try:
                    cp=subprocess.run(probe,capture_output=True,text=True,timeout=6)
                    print(f"  decode    {'ok' if cp.returncode==0 else 'failed'} · exit {cp.returncode}")
                    detail=(cp.stderr or cp.stdout or "").strip().splitlines()[-4:]
                    for line in detail:
                        print(f"            {line[:180]}")
                except subprocess.TimeoutExpired:
                    print("  decode    timeout after 6s")
                except Exception as exc:
                    print(f"  decode    error · {exc}")
        except Exception as exc:
            print(f"  source    error · {exc}")
    log=_media_tail_player_log(8)
    if log:
        print("  last mpv log:")
        for line in log:
            print(f"    {line[:180]}")
    return 0


def _media_queue_has_video(queue):
    """Return true when a queue needs a visible video presentation."""
    for row in queue or []:
        media_type=str(row.get("media_type") or "").casefold()
        path=str(row.get("path") or row.get("title") or "").casefold()
        if media_type.startswith("video/") or Path(path).suffix in {".mp4",".m4v",".mov",".mkv",".webm",".avi",".wmv",".flv",".vob",".mts",".m2ts",".ts"}:
            return True
    return False


def _media_reuse_needs_visible_restart(wants_video):
    """Restart our player when a headless/audio session must become visible video.

    mpv can reuse one IPC-owned worker for ordinary queue changes, but a process
    born as an audio-only session may remain headless on macOS even after a video
    source is loaded. Treat presentation class as process state, not just media
    metadata, and relaunch only when crossing audio/headless -> video.
    """
    if not wants_video:
        return False
    current=_media_session() or {}
    return str(current.get("presentation") or "audio").casefold() != "video"


def _media_launch_session(session):
    """Mirror LOOK's canonical queue into mpv and start at the requested item."""
    session=media_core.normalize_session(session)
    queue=session.get("queue") or []
    if not queue:
        print("LOOK media · queue is empty")
        return 1
    mpv=_media_mpv_binary()
    if not mpv:
        # A single item can still use the 5.2.15 fallback path. Multi-item queues
        # require mpv because LOOK deliberately does not implement a codec/player loop.
        if len(queue)==1:
            try:
                return _media_launch_stream(_media_entry_source(queue[0]),_media_entry_label(queue[0]),session=session)
            except (RuntimeError,FileNotFoundError) as exc:
                print(f"LOOK media · {exc}")
                return 1
        print("LOOK media · queue playback needs mpv")
        print("  install mpv with your package manager; the library/index itself has no dependency")
        return 1

    playable,missing,index_map=_media_write_m3u(queue)
    if not playable:
        print("LOOK media · no playable queue entries")
        for label,error in missing[:5]:
            print(f"  × {label} · {error}")
        if len(missing)>5:
            print(f"  … {len(missing)-5} more")
        return 1
    if missing:
        # Missing entries are skipped at the edge, but canonical queue remains untouched
        # so a moved disk can be repaired/reindexed rather than silently forgotten.
        print(f"LOOK media · {len(missing)} unavailable queue item(s) skipped")

    wanted=max(0,min(int(session.get("current_index") or 0),len(queue)-1))
    if wanted in index_map:
        idx=index_map.index(wanted)
    else:
        idx=next((i for i,qidx in enumerate(index_map) if qidx>wanted),0)
    session["runtime_queue_indices"]=index_map

    # One LOOK playback worker per output. Reuse it unless the request changes
    # presentation class from audio/headless to visible video. That transition is
    # relaunched so macOS cannot keep a formerly audio-only mpv hidden.
    queue_video=_media_queue_has_video(queue)
    if _media_mpv_alive():
        if not _media_reuse_needs_visible_restart(queue_video):
            loaded=_media_mpv_request(["loadlist",str(MEDIA_QUEUE_FILE),"replace"])
            if loaded and loaded.get("error")=="success":
                _media_mpv_request(["set_property","playlist-pos",idx])
                _media_mpv_request(["set_property","pause",False])
                if not _media_wait_for_mpv_loaded():
                    detail=" · ".join(line.strip() for line in _media_tail_player_log(6) if line.strip())
                    print("LOOK media · media source did not load" + (f" · {detail[:500]}" if detail else ""))
                    return 1
                session["player"]="mpv"
                session["owner"]="look"
                session["owner_updated"]=time.time()
                session["state"]="playing"
                session["current_index"]=index_map[idx]
                _media_save_session(session)
                _media_pause_playing_system()
                print(f"LOOK media · queue → existing mpv · {len(queue)} item{'s' if len(queue)!=1 else ''}")
                return 0

    # No reachable IPC owner remains. Reap only processes bearing LOOK's exact
    # IPC marker, then replace the stale socket pathname and launch one worker.
    _media_stop_owned_mpvs()
    try: MEDIA_IPC_FILE.unlink(missing_ok=True)
    except OSError: pass

    try:
        MEDIA_MPV_LOG.parent.mkdir(parents=True,exist_ok=True)
        MEDIA_MPV_LOG.write_text("",encoding="utf-8")
    except OSError:
        pass
    cmd=[
        mpv,
        # Playback is infrastructure: user mpv config must not silently disable
        # video output or otherwise change Fabric semantics between nodes.
        "--no-config",
        f"--input-ipc-server={MEDIA_IPC_FILE}",
        "--no-terminal",
        "--idle=yes",
        f"--log-file={MEDIA_MPV_LOG}",
        f"--playlist={MEDIA_QUEUE_FILE}",
        f"--playlist-start={idx}",
    ]
    if queue_video:
        cmd.append("--force-window=immediate")
    if session.get("repeat")=="all":
        cmd.append("--loop-playlist=inf")
    try:
        proc=subprocess.Popen(cmd,stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    except OSError as exc:
        print(f"LOOK media · player launch failed: {exc}")
        return 1
    if not _media_wait_for_mpv_start(proc):
        return 1
    session["pid"]=proc.pid
    session["player"]="mpv"
    session["owner"]="look"
    session["owner_updated"]=time.time()
    session["presentation"]="video" if _media_queue_has_video(queue) else "audio"
    session["launch_argv"]=[str(x) for x in cmd]
    session["state"]="playing"
    session["current_index"]=index_map[idx]
    _media_save_session(session)
    _media_pause_playing_system()
    print(f"LOOK media · queue → mpv · {len(queue)} item{'s' if len(queue)!=1 else ''}")
    return 0


def _media_launch_stream(url,source="",session=None):
    """Launch one Fabric byte stream using a mature media engine."""
    stream_video=_media_queue_has_video((session or {}).get("queue") or [])
    mpv=_media_mpv_binary()
    if mpv:
        if _media_mpv_alive():
            if not _media_reuse_needs_visible_restart(stream_video):
                loaded=_media_mpv_request(["loadfile",url,"replace"])
                if loaded and loaded.get("error")=="success":
                    _media_mpv_request(["set_property","pause",False])
                    if not _media_wait_for_mpv_loaded():
                        detail=" · ".join(line.strip() for line in _media_tail_player_log(6) if line.strip())
                        print("LOOK media · media source did not load" + (f" · {detail[:500]}" if detail else ""))
                        return 1
                    if session is None:
                        session=media_core.new_session([{"title":source or "Fabric media","digest":"stream"}])
                    session["url"]=url; session["source"]=source; session["started"]=time.time()
                    session["player"]="mpv"; session["owner"]="look"; session["owner_updated"]=time.time(); session["state"]="playing"
                    _media_save_session(session)
                    _media_pause_playing_system()
                    print(f"LOOK media · Fabric stream → existing mpv" + (f" · {source}" if source else ""))
                    return 0
        _media_stop_owned_mpvs()
        try: MEDIA_IPC_FILE.unlink(missing_ok=True)
        except OSError: pass
        cmd=[mpv,"--no-config",f"--input-ipc-server={MEDIA_IPC_FILE}","--no-terminal","--idle=yes",f"--log-file={MEDIA_MPV_LOG}"]
        if stream_video: cmd.append("--force-window=immediate")
        cmd.append(url)
        try:
            proc=subprocess.Popen(cmd,stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        except OSError as exc:
            print(f"LOOK media · player launch failed: {exc}")
            return 1
        if not _media_wait_for_mpv_start(proc):
            return 1
        if session is None:
            session=media_core.new_session([{"title":source or "Fabric media","digest":"stream"}])
        session["pid"]=proc.pid
        session["url"]=url
        session["source"]=source
        session["started"]=time.time()
        session["player"]="mpv"
        session["owner"]="look"
        session["owner_updated"]=time.time()
        session["presentation"]="video" if stream_video else "audio"
        session["launch_argv"]=[str(x) for x in cmd]
        session["state"]="playing"
        _media_save_session(session)
        _media_pause_playing_system()
        print(f"LOOK media · Fabric stream → mpv" + (f" · {source}" if source else ""))
        return 0

    configured=str(os.environ.get("LOOK_MEDIA_PLAYER","")).strip()
    vlc=shutil.which(configured) if configured else shutil.which("vlc")
    try:
        if not vlc and sys.platform=="darwin" and Path("/Applications/VLC.app").exists():
            subprocess.Popen(["open","-a","VLC",url],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            print("LOOK media · Fabric stream → VLC")
            return 0
        if vlc:
            subprocess.Popen([vlc,url],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            print("LOOK media · Fabric stream → VLC")
            return 0
    except OSError as exc:
        print(f"LOOK media · player launch failed: {exc}")
        return 1

    result=_tool_open_url(url)
    if result.startswith("URL OPEN OK"):
        print("LOOK media · Fabric stream → system browser/player")
        return 0
    print("LOOK media · no mpv/VLC player available")
    print(f"  stream: {url}")
    return 1


def _media_stream_command(args):
    """Explicit Fabric-stream proof path. Queue playback may optimize same-node files locally."""
    if not args:
        print("usage: lk media stream PATH | lk media stream @NODE sha256:DIGEST")
        return 2
    try:
        if args[0].startswith("@"):
            if len(args)<2:
                raise ValueError("remote playback requires @NODE and sha256:DIGEST")
            node=args[0][1:]
            digest=args[1]
            if not digest.startswith("sha256:"):
                raise ValueError("remote playback requires a sha256:DIGEST artifact")
            payload=_media_artifact(digest,node)
            source=f"{node}:{(payload.get('artifact') or {}).get('name') or digest}"
            entry={"node":node,"digest":digest,"title":(payload.get("artifact") or {}).get("name") or digest}
        elif args[0].startswith("sha256:"):
            payload=_media_artifact(args[0])
            source=(payload.get("artifact") or {}).get("name") or args[0]
            entry={"digest":args[0],"title":source}
        else:
            path=" ".join(args)
            payload=_media_register(path)
            meta=payload.get("artifact") or {}
            source=meta.get("name") or str(Path(path).name)
            entry=media_core.entry_from_path(path)
            entry["digest"]=meta.get("digest")
        url=str(payload.get("stream_url") or "")
        if not url:
            raise RuntimeError("Fabric returned no stream URL")
        session=media_core.new_session([entry])
        return _media_launch_stream(url,source,session=session)
    except (RuntimeError,ValueError,FileNotFoundError) as exc:
        print(f"LOOK media · {exc}")
        return 1


