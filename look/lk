def _command_rows():
    rows=[]
    for item in _COMMANDS:
        command,args,category,description,*alias=item
        template=(command+(" "+args if args else "")).strip()
        extra=(" · "+alias[0]) if alias else ""
        rows.append((template,category,description+extra))
    return rows

def _write_command_request(command):
    """Return a safe editable command stem; placeholders stay documentation, not shell syntax."""
    STATE_DIR.mkdir(parents=True,exist_ok=True)
    path=STATE_DIR/"command_request"
    stem=re.sub(r"\s+(?:\[[^]]*\]|<[^>]*>)(?:\s+.*)?$","",command).rstrip()
    if stem != command.rstrip(): stem += " "
    path.write_text(stem+"\n")

def commands_screen():
    """Searchable command palette. Enter/Right sends the template back to the parent shell."""
    rows=_command_rows()
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        for template,category,description in rows:
            print(f"{template:<34} {category:<8} {description}")
        return 0
    fd=sys.stdin.fileno(); old=termios.tcgetattr(fd)
    query=""; idx=0
    try:
        tty.setcbreak(fd)
        while True:
            terms=query.casefold().split()
            visible=[r for r in rows if all(t in " ".join(r).casefold() for t in terms)]
            idx=min(idx,max(0,len(visible)-1))
            term=shutil.get_terminal_size((100,30)); usable=max(4,term.lines-5)
            top=max(0,min(max(0,len(visible)-usable),idx-usable+1))
            os.system("clear")
            print(f"LOOK COMMANDS · {len(visible)} of {len(rows)}")
            print("─"*min(term.columns,100))
            for n,(template,category,description) in enumerate(visible[top:top+usable],start=top):
                mark=_c("›","1;36") if n==idx else " "
                print(f"{mark} {template:<34} {_c(category,'2'):<18} {description}")
            print(f"\n{_c('FILTER','1;36')} {query}█  {_c('type search · ↑↓ choose · Enter/→ send to shell · Esc clear/back · q quit','2')}",end="",flush=True)
            key=_read_tty_key(fd)
            if key in {"q","Q","\x03"}: break
            if key=="esc":
                if query: query=""; idx=0; continue
                break
            if key in {"up","k"} and visible: idx=max(0,idx-1); continue
            if key in {"down","j"} and visible: idx=min(len(visible)-1,idx+1); continue
            if key=="pageup" and visible: idx=max(0,idx-usable); continue
            if key=="pagedown" and visible: idx=min(len(visible)-1,idx+usable); continue
            if key in {"\r","\n","right"} and visible:
                _write_command_request(visible[idx][0]); break
            if key in {"\x7f","\b"}:
                if query: query=query[:-1]; idx=0
                continue
            if len(key)==1 and key.isprintable(): query+=key; idx=0
    finally:
        termios.tcsetattr(fd,termios.TCSADRAIN,old); print()
    return 0

def _command_audit():
    rows=_command_rows()
    categories={}
    for _,category,_ in rows: categories[category]=categories.get(category,0)+1
    templates=[r[0] for r in rows]
    duplicates=sorted({x for x in templates if templates.count(x)>1})
    print(f"LOOK COMMAND AUDIT · {len(rows)} registered forms")
    print("  registry      canonical _COMMANDS")
    print("  categories    "+" · ".join(f"{k} {v}" for k,v in sorted(categories.items())))
    print(f"  duplicates    {len(duplicates)}"+(" · "+", ".join(duplicates) if duplicates else ""))
    print("  palette       lk commands · searchable · Enter/→ composes to shell")
    print("  aliases       ergonomic entry points; shared implementations remain canonical")
    return 1 if duplicates else 0

