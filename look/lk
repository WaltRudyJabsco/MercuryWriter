def _tone_file(kind):
    """Generate tiny synthesized feedback tones; no bundled audio assets required."""
    cache=STATE_DIR/"feedback"; cache.mkdir(parents=True,exist_ok=True)
    path=cache/f"{kind}.wav"
    if path.exists(): return path
    spec={"accept":(660,0.045,0.13),"complete":(880,0.075,0.15),"notify":(740,0.060,0.13),"error":(220,0.090,0.16)}
    freq,duration,amp=spec.get(kind,spec["accept"]); rate=22050; frames=max(1,int(rate*duration))
    try:
        with wave.open(str(path),"wb") as wav:
            wav.setnchannels(1); wav.setsampwidth(2); wav.setframerate(rate); buf=bytearray()
            for i in range(frames):
                fade=min(1.0,i/(rate*.008),max(0.0,(frames-i)/(rate*.012)))
                sample=int(32767*amp*fade*math.sin(2*math.pi*freq*i/rate)); buf.extend(struct.pack("<h",sample))
            wav.writeframes(bytes(buf))
        return path
    except OSError: return None


def _play_feedback_sound(kind):
    path=_tone_file(kind)
    if not path: return
    if platform.system()=="Darwin" and shutil.which("afplay"): args=[shutil.which("afplay"),str(path)]
    elif shutil.which("paplay"): args=[shutil.which("paplay"),str(path)]
    elif shutil.which("aplay"): args=[shutil.which("aplay"),"-q",str(path)]
    else: return
    try: subprocess.Popen(args,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
    except OSError: pass


def _feedback(kind="accept", label=""):
    """Receipt-driven finite feedback. Ordinary navigation never calls this."""
    cfg=_load_feedback()
    if not sys.stdout.isatty(): return
    sound=cfg.get("sound","off")
    if sound=="expressive" or (sound=="subtle" and kind in {"complete","error","notify"}): _play_feedback_sound(kind)
    motion=cfg.get("motion","subtle")
    if motion=="off": return
    glyphs={"accept":("·","◆","·"),"complete":("·","◈","✓"),"notify":("·","◐","●"),"error":("·","×","!")}.get(kind,("·","◆","·"))
    code={"accept":"36","complete":"32","notify":"36","error":"33"}.get(kind,"36")
    frames=glyphs if motion=="normal" else (glyphs[1],glyphs[-1]); delay=.045 if motion=="normal" else .035
    suffix=f" {_c(label,'2')}" if label else ""
    for frame in frames:
        sys.stdout.write(f"\r\033[2K{_c(frame,code)}{suffix}"); sys.stdout.flush(); time.sleep(delay)
    sys.stdout.write("\r\033[2K"); sys.stdout.flush()


def _feedback_command(args):
    cfg=_load_feedback()
    if not args or args[0] in {"status","show"}:
        _title("feedback","terminal expression")
        print(f"  sound   {cfg['sound']}"); print(f"  motion  {cfg['motion']}"); print(f"  config  {FEEDBACK_FILE}")
        print("\n  lk sound              toggle off/subtle")
