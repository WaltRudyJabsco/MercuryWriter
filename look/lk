    print("  Then retry here:      lk comfy discover")
    return 1


def _discover_comfy_paths():
    cfg=_load_comfy_config()
    managed=Path(str(cfg.get("install_path") or "")).expanduser() if str(cfg.get("install_path") or "").strip() else None
    roots=[
        HOME/"ComfyUI",HOME/"comfyui",HOME/"Applications"/"ComfyUI",
        HOME/"Documents"/"ComfyUI",HOME/"Downloads"/"ComfyUI",
        Path("/opt/ComfyUI"),Path("/srv/ComfyUI"),
    ]
    if managed:
        roots.insert(0,managed)
    found=[]
    for root in roots:
        if root.exists() and (root/"main.py").exists():
            found.append(root.resolve())
    # Locate likely legacy model folders without recursively walking all of HOME.
    model_roots=[]
    for root in found:
        for rel in ("models/checkpoints","models/unet","models/diffusion_models"):
            p=root/rel
            if p.exists(): model_roots.append(p.resolve())
    return found,model_roots


def _comfy_model_inventory(model_roots,limit=40):
    exts={".safetensors",".ckpt",".pt",".pth",".gguf"}
    rows=[]
    seen=set()
    for root in model_roots:
        try:
            base_depth=len(root.parts)
            for current,dirs,files in os.walk(root,followlinks=False):
                path=Path(current)
                depth=len(path.parts)-base_depth
                if depth>=3:
                    dirs[:]=[]
                for name in files:
                    fp=path/name
                    if fp.suffix.casefold() in exts:
                        rp=str(fp.resolve())
                        if rp in seen: continue
                        seen.add(rp)
                        try:
                            rows.append((fp.name,fp.stat().st_size,fp))
                        except OSError:
                            pass
        except OSError:
            pass
    rows.sort(key=lambda x:x[1],reverse=True)
    return rows[:limit]


def _comfy_workflow_candidates():
    """Canonical workflow fallbacks, ordered from installed state to package source."""
    return [
        STATE_DIR/"workflows"/"sdxl-api.json",
        ROOT/"workflows"/"sdxl-api.json",
    ]


def _comfy_resolve_workflow(cfg=None,repair=True):
    """Return (path, label, error). Self-heal missing/empty starter config when possible."""
    cfg=dict(cfg or _load_comfy_config())
    raw=str(cfg.get("workflow") or "").strip()
    candidates=[]
    if raw:
        candidates.append(Path(raw).expanduser())
    candidates.extend(_comfy_workflow_candidates())

    seen=set()
    for path in candidates:
        try:
            path=path.resolve()
        except OSError:
            continue
        if str(path) in seen:
            continue
        seen.add(str(path))
        if not path.exists() or not path.is_file():
            continue
        try:
            data=json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        if not isinstance(data,dict) or not data:
            continue

        label="SDXL starter" if path.name=="sdxl-api.json" else path.name
        if repair and str(path)!=raw:
            cfg["workflow"]=str(path)
            _save_comfy_config(cfg)
        return path,label,""

    if raw:
        return None,"",f"Configured workflow is missing or unreadable: {raw}"
    return None,"","No Comfy workflow configured and no packaged starter workflow was found."


def _comfy_workflow_display(cfg=None):
    path,label,error=_comfy_resolve_workflow(cfg,repair=True)
    if path:
        return f"{label} · ready",path
    return f"not ready · {error}",None


def _comfy_replace_placeholders(obj,prompt,negative,seed):
    if isinstance(obj,dict):
        return {k:_comfy_replace_placeholders(v,prompt,negative,seed) for k,v in obj.items()}
    if isinstance(obj,list):
        return [_comfy_replace_placeholders(v,prompt,negative,seed) for v in obj]
    if isinstance(obj,str):
        if obj=="__PROMPT__": return prompt
        if obj=="__NEGATIVE__": return negative
        if obj=="__SEED__": return int(seed)
        return obj.replace("__PROMPT__",prompt).replace("__NEGATIVE__",negative).replace("__SEED__",str(seed))
    return obj


def _comfy_unload(host=None):
    """Ask ComfyUI to release loaded models/torch cache while keeping its API alive."""
    import urllib.request
    host=str(host or _load_comfy_config()["host"]).rstrip("/")
    payload=json.dumps({"unload_models":True,"free_memory":True}).encode("utf-8")
    req=urllib.request.Request(host+"/free",data=payload,headers={"Content-Type":"application/json"},method="POST")
    try:
        with urllib.request.urlopen(req,timeout=8) as response:
            response.read()
        return True,"models unloaded · service remains ready"
    except Exception as exc:
        return False,f"VRAM release failed: {exc}"


def _comfy_generate(prompt,negative="",seed=None,open_result=True):
    import urllib.request, urllib.parse, random
    cfg=_load_comfy_config()
    host=str(cfg["host"]).rstrip("/")
    workflow_path,workflow_label,workflow_error=_comfy_resolve_workflow(cfg,repair=True)
    if not workflow_path:
        return False,workflow_error+" Run `lk comfy bootstrap` to restore the starter workflow."
    try:
        workflow=json.loads(workflow_path.read_text(encoding="utf-8"))
    except Exception as exc:
        return False,f"Workflow could not be read: {exc}"
    seed=int(seed if seed is not None else random.randrange(1,2**31-1))
    workflow=_comfy_replace_placeholders(workflow,str(prompt),str(negative),seed)
    payload=json.dumps({"prompt":workflow,"client_id":"look-shell"}).encode()
    request=urllib.request.Request(host+"/prompt",data=payload,headers={"Content-Type":"application/json"},method="POST")
    try:
        with urllib.request.urlopen(request,timeout=15) as response:
            queued=json.load(response)
        prompt_id=queued.get("prompt_id")
        if not prompt_id:
            return False,f"Comfy did not return a prompt id: {queued}"
        deadline=time.time()+600
        history={}
        while time.time()<deadline:
            time.sleep(1.0)
            try:
                with urllib.request.urlopen(host+"/history/"+str(prompt_id),timeout=5) as response:
                    history=json.load(response)
            except Exception:
                continue
            item=history.get(str(prompt_id)) or history.get(prompt_id) or {}
            outputs=item.get("outputs") or {}
            images=[]
            for node in outputs.values():
                if isinstance(node,dict):
                    images.extend(node.get("images") or [])
            if images:
                output_dir=Path(str(cfg.get("output_dir") or (HOME/"Pictures"/"LOOK"))).expanduser()
                output_dir.mkdir(parents=True,exist_ok=True)
                saved=[]
                for idx,image in enumerate(images[:8]):
                    filename=image.get("filename")
                    if not filename: continue
                    query=urllib.parse.urlencode({
                        "filename":filename,
                        "subfolder":image.get("subfolder",""),
                        "type":image.get("type","output"),
                    })
                    dest=output_dir/f"{time.strftime('%Y%m%d-%H%M%S')}-{idx+1}-{Path(filename).name}"
                    with urllib.request.urlopen(host+"/view?"+query,timeout=30) as response:
                        dest.write_bytes(response.read())
                    saved.append(dest)
                if saved:
                    if open_result and bool(cfg.get("auto_preview",True)):
                        preview_receipt=_preview_host_path(saved[0])
                        if str(preview_receipt).startswith("PREVIEW OK"):
                            _mark_generated_preview(saved[0])
                    result=f"{len(saved)} image(s) · "+", ".join(str(p) for p in saved)
                    if bool(cfg.get("auto_unload",True)):
                        released,msg=_comfy_unload(host)
                        result += f" · {'VRAM released' if released else msg}"
                    return True,result
            status=item.get("status") or {}
            if status.get("completed") is True and not outputs:
                return False,"Comfy completed without image output."
        return False,"Comfy generation timed out after 10 minutes."
    except Exception as exc:
        return False,f"Comfy generation failed: {exc}"


COMFY_PID_FILE=STATE_DIR/"comfy.pid"
COMFY_LOG_FILE=STATE_DIR/"comfy.log"


def _comfy_pid():
    try:
        pid=int(COMFY_PID_FILE.read_text(encoding="utf-8").strip())
        os.kill(pid,0)
        return pid
    except Exception:
        try: COMFY_PID_FILE.unlink()
        except OSError: pass
        return 0


def _comfy_launcher():
    launcher=HOME/".local"/"bin"/"look-comfy"
    return launcher if launcher.exists() else None


def _comfy_start():
    ok,_=_comfy_probe(timeout=0.6)
    if ok:
        return True,"ComfyUI is already reachable."
    launcher=_comfy_launcher()
    if not launcher:
        return False,"Managed Comfy launcher not found. Run the installer/bootstrap on the GPU host."
    STATE_DIR.mkdir(parents=True,exist_ok=True)
    log=open(COMFY_LOG_FILE,"ab",buffering=0)
    try:
        proc=subprocess.Popen(
            [str(launcher)],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            start_new_session=True,
        )
    except OSError as exc:
        log.close()
        return False,f"Comfy start failed: {exc}"
    COMFY_PID_FILE.write_text(str(proc.pid)+"\n",encoding="utf-8")
    for _ in range(40):
        time.sleep(0.25)
        ok,_=_comfy_probe(timeout=0.5)
        if ok:
            return True,f"ComfyUI started · pid {proc.pid}"
        if proc.poll() is not None:
            return False,f"ComfyUI exited during startup · see {COMFY_LOG_FILE}"
    return False,f"ComfyUI has not become ready yet · pid {proc.pid} · see {COMFY_LOG_FILE}"


def _comfy_stop():
    pid=_comfy_pid()
    if not pid:
        ok,_=_comfy_probe(timeout=0.5)
        if ok:
            return False,"ComfyUI is reachable but was not started by LOOK; refusing to kill an unknown process."
        return True,"ComfyUI is not running."
    try:
        os.kill(pid,15)
    except OSError as exc:
        return False,f"Comfy stop failed: {exc}"
    for _ in range(40):
        time.sleep(0.1)
        try: os.kill(pid,0)
        except OSError:
            try: COMFY_PID_FILE.unlink()
            except OSError: pass
            return True,"ComfyUI stopped."
    return False,f"ComfyUI did not exit cleanly · pid {pid}"


