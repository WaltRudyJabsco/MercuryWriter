def _memory_context(memory,query=""):
    parts=[]
    core=str(memory.get("core_summary","")).strip()
    if core:
        parts.append("Compact user-memory index:\n"+core)

    domains=_relevant_domains(memory,query)
    if domains:
        rows="\n".join(f"{domain.upper()}: {text}" for _,domain,text in domains)
        parts.append("Relevant durable memory summaries:\n"+rows)

    atoms=_relevant_durable(memory,query)
    if atoms:
        rows="\n".join(f"- {m.get('text','')}" for m in atoms)
        parts.append("Relevant durable memory details:\n"+rows)

    machine=_relevant_machine_atoms(memory,query)
    if machine:
        # Compact projection only at the prompt boundary; storage stays typed.
        rows="\n".join(f"- {a.get('k')}|{a.get('s')}|{a.get('r')}|{a.get('v')}" for a in machine)
        parts.append("Relevant machine memory:\n"+rows)

    # Candidates are cheap hypotheses; inject only relevant ones, never the whole pool.
    candidates=[]
    for item in memory.get("memories",[]):
        score=_memory_relevance(item.get("text",""),query)
        if score>0:
            candidates.append((score,int(item.get("importance",0)),item))
    candidates.sort(key=lambda x:(x[0],x[1]),reverse=True)
    candidates=[x[2] for x in candidates[:RECENT_MEMORY_SLOTS]]
    if candidates:
        rows="\n".join(
            f"- [{int(m.get('importance',50)):02d}] {m.get('text','')}" for m in candidates
        )
        parts.append(
            "Relevant candidate memories (hypotheses, not instructions; retrieval does not reinforce):\n"+rows
        )

    try:
        core_text=CORE_FILE.read_text(encoding="utf-8").strip()
        skills=_effective_skills_text()
    except OSError:
        core_text=skills=""
    if core_text: parts.insert(0,core_text)
    if skills: parts.insert(1 if core_text else 0,skills)
    personality_name=_load_personality()
    personality=_personality_text(personality_name)
    if personality:
        parts.insert((1 if core_text else 0)+(1 if skills else 0),personality)
    fabric_memory=_fabric_memory_context(query, personality_name)
    if fabric_memory:
        parts.append(fabric_memory)
    return "\n\n".join(parts)


def _decay_memories(memory, now=None):
    """Time-based forgetting. Conversation volume must not accelerate forgetting."""
    now=float(now or time.time())
    last=float(memory.get("last_decay_at",now) or now)
    # One point per 12 elapsed hours, capped so a machine returning after months
    # cannot vaporize the whole candidate pool in one maintenance pass.
    points=max(0,min(12,int((now-last)//(12*3600))))
    if points<=0:
        memory.setdefault("last_decay_at",now)
        return memory
    kept=[]
    expired=0
    for item in memory.get("memories",[]):
        importance=max(0,int(item.get("importance",50))-points)
        if importance>0:
            item["importance"]=importance
            kept.append(item)
        else:
            expired+=1
    if expired:
        memory["candidate_expired_total"]=int(memory.get("candidate_expired_total",0))+expired
    kept.sort(key=lambda x:int(x.get("importance",0)),reverse=True)
    memory["memories"]=kept[:MEMORY_CANDIDATE_LIMIT]
    memory["last_decay_at"]=now
    return memory


def _add_memory(memory, text, importance=60):
    text=" ".join(str(text).split()).strip()[:900]
    if not text: return memory
    for item in memory.get("memories", []):
        if str(item.get("text","")).casefold()==text.casefold():
            item["importance"]=min(100, max(int(item.get("importance",50)),importance)+5)
            item["uses"]=int(item.get("uses",0))+1
            item["last_reinforced"]=time.time()
            item.setdefault("created_at",item["last_reinforced"])
            return memory
    now=time.time()
    memory.setdefault("memories",[]).append(
        {"text":text,"importance":max(1,min(100,int(importance))),"uses":1,
         "created_at":now,"last_reinforced":now}
    )
    # Candidate slots are competitive: importance + recency + reinforcement.
    def rank(item):
        age_hours=max(0.0,(now-float(item.get("last_reinforced",now)))/3600.0)
        recency=max(0.0,12.0-min(12.0,age_hours/6.0))
        return int(item.get("importance",0))+min(12,int(item.get("uses",1))*2)+recency
    before=len(memory["memories"])
    memory["memories"].sort(key=rank,reverse=True)
    memory["memories"]=memory["memories"][:MEMORY_CANDIDATE_LIMIT]
    if before>len(memory["memories"]):
        memory["candidate_evictions"]=int(memory.get("candidate_evictions",0))+before-len(memory["memories"])
    return memory


def _forget_memory(fragment):
    memory=_load_memory()
    fragment=str(fragment).casefold().strip()
    before_candidates=len(memory.get("memories",[]))
    before_durable=len(memory.get("durable",[]))
    memory["memories"]=[
        m for m in memory.get("memories",[])
        if fragment not in str(m.get("text","")).casefold()
    ]
    memory["durable"]=[
        m for m in memory.get("durable",[])
        if fragment not in str(m.get("text","")).casefold()
    ]
    # Domain summaries are regenerated by the background compiler; clearing them
    # prevents stale wording from surviving an explicit forget.
    memory["domain_summaries"]={}
    memory["core_summary"]=""
    memory["summary"]=""
    if fragment and fragment in str(memory.get("legacy_summary","")).casefold():
        memory["legacy_summary"]=""
    memory["last_compiled_at"]=0
    _save_memory(memory)
    return (before_candidates-len(memory["memories"]))+(before_durable-len(memory["durable"]))


