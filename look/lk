_LO_RETRY_ACTION_MAX_AGE_SECONDS=4*60*60

def _lo_latest_command_action(max_age=_LO_RETRY_ACTION_MAX_AGE_SECONDS):
    """Recover a recent typed command attempt as an explicit-retry referent.

    This is host state, not conversational memory.  A later `again` still passes
    through the current access profile and command-risk gate before execution.
    """
    try:
        rows=_world_state().latest_receipts(24)
    except Exception:
        return None
    now=time.time()
    for row in reversed(rows):
        if str(row.get("action") or "")!="run_command":
            continue
        try:
            if max_age is not None and now-float(row.get("observed_at") or 0)>float(max_age):
                return None
        except (TypeError,ValueError):
            return None
        args=dict(row.get("args") or {})
        command=str(args.get("command") or "").strip()
        if command:
            return {"tool":"run_command","args":args,"path":command}
    return None

def _jev_command_intent(prompt,last_action=None):
    """Resolve an explicit command through the shared deterministic JEV tree."""
    previous={}
    if last_action and last_action.get("tool")=="run_command":
        previous=dict(last_action.get("args") or {})

    def head_resolves(head):
        if shutil.which(head):
            return True
        if "/" in head or head.startswith("."):
            try: return Path(head).expanduser().exists()
            except OSError: return False
        return False

    decision=_jev_module().command_imperative(
        prompt,head_resolves=head_resolves,prior=previous)
    if not decision:
        return None
    command=str(decision["command"])
    args={"command":command,"interactive":decision["terminal"]=="current"}
    if decision["terminal"]=="new":
        args["new_terminal"]=True
    return {"tool":"run_command","args":args,"path":command,"jev":decision}


def _lo_explicit_command_action(prompt,last_action=None):
