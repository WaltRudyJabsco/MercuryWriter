def _page_text(body: str) -> int:
    """Page long system text only when it exceeds the current terminal."""
    lines = body.rstrip("\n").splitlines()
    height = max(6, shutil.get_terminal_size((80, 24)).lines - 1)

    # Non-interactive output should stay pipe-friendly.
    if len(lines) <= height or not sys.stdin.isatty() or not sys.stdout.isatty():
        print(body, end="" if body.endswith("\n") else "\n")
        return 0

    top = 0
    old = termios.tcgetattr(sys.stdin.fileno())
    try:
        tty.setcbreak(sys.stdin.fileno())
        while True:
            os.system("clear")
            page = lines[top:top + height - 1]
            sys.stdout.write("\n".join(page))
            sys.stdout.write(
                f"\n\033[2m{min(top + height - 1, len(lines))}/{len(lines)}"
                " · j/k ↑/↓ line · Space/PgDn page · b/PgUp back · g/G ends · q quit\033[0m"
            )
            sys.stdout.flush()

            # Read from the file descriptor directly. TextIO buffering can split
            # an ANSI arrow sequence after ESC, which used to make ↑/↓ look like
            # a bare Escape and drop out of the help pager.
            fd = sys.stdin.fileno()
            ch = os.read(fd, 1)
            key = ch.decode("utf-8", "ignore")
            if ch == b"\x1b":
                seq = bytearray(ch)
                while len(seq) < 6:
                    ready, _, _ = select.select([fd], [], [], 0.10)
                    if not ready:
                        break
                    seq.extend(os.read(fd, 1))
                    if seq[-1:] in b"~ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz":
                        break
                key = {
                    b"\x1b[A": "up",
                    b"\x1b[B": "down",
                    b"\x1b[5~": "pageup",
                    b"\x1b[6~": "pagedown",
                }.get(bytes(seq), "esc")

            page_size = height - 1
            max_top = max(0, len(lines) - page_size)
            if key in {"q", "esc"}:
                break
            if key in {"j", "down"}:
                top = min(max_top, top + 1)
            elif key in {"k", "up"}:
                top = max(0, top - 1)
            elif key in {" ", "pagedown"}:
                top = min(max_top, top + page_size)
            elif key in {"b", "pageup"}:
                top = max(0, top - page_size)
            elif key == "g":
                top = 0
            elif key == "G":
                top = max_top
    finally:
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
        sys.stdout.write("\n")
        sys.stdout.flush()
    return 0


def _help_color(body):
    """Add restrained semantic ANSI color to LOOK's own help text."""
    if not sys.stdout.isatty():
        return body
    reset="\033[0m"; bold="\033[1m"; cyan="\033[36m"; magenta="\033[35m"
    section_names={"LOOK","INSPECT","SYSTEM","FILE CARD","FILE ACTIONS","SHORTCUTS","LIVE FILTER / SELECTION","HELP PAGER"}
    shortcut_tokens=("lk","lkl","lkd","lkf","lkt","lkr","lkz","zll WORD","cdl WORD",
                     "fznv","f","rs","rb","lh","lo","lo ASK")
    out=[]
    in_shortcuts=False
    for line in body.splitlines():
        stripped=line.strip()
        if "LOOK " in line and ("filesystem, navigation, shell" in line or "inspect the computer" in line):
            out.append(cyan+bold+line+reset); continue
        if stripped in section_names:
            in_shortcuts=(stripped=="SHORTCUTS")
            out.append(magenta+bold+line+reset); continue
        if in_shortcuts and stripped:
            colored=line
            for token in sorted(shortcut_tokens,key=len,reverse=True):
                colored=re.sub(
                    rf'(?<!\S){re.escape(token)}(?=\s|$)',
                    lambda m: cyan+bold+m.group(0)+reset,
                    colored
                )
            out.append(colored); continue
        m=re.match(r'^(\s{2})(\S+(?:\s*/\s*\S+)?)(.*)$', line)
        if m and stripped:
            out.append(m.group(1)+cyan+bold+m.group(2)+reset+m.group(3)); continue
        out.append(line)
    return "\n".join(out)+"\n"

