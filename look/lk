def _tailscale_comfy_candidates():
    """Return online tailnet peers at LOOK's dedicated Comfy HTTPS port."""
    exe=shutil.which("tailscale")
    if not exe:
        return []
    try:
        proc=subprocess.run([exe,"status","--json"],capture_output=True,text=True,timeout=3)
        if proc.returncode!=0:
            return []
        status=json.loads(proc.stdout or "{}")
    except (OSError,subprocess.SubprocessError,ValueError,TypeError):
        return []

    peers=status.get("Peer") or {}
    nodes=list(peers.values()) if isinstance(peers,dict) else list(peers) if isinstance(peers,list) else []
    out=[]; seen=set()
    for node in nodes:
        if not isinstance(node,dict) or node.get("Online") is False:
            continue
        hostname=str(node.get("HostName") or "").strip()
        dns=str(node.get("DNSName") or "").strip().rstrip(".")
        ips=node.get("TailscaleIPs") or []
        name=hostname or (dns.split(".")[0] if dns else "")
        candidates=[]
        if dns:
            candidates.append(("serve",f"https://{dns}:8188"))
        for ip in ips[:2]:
            candidates.append(("direct",f"http://{ip}:8188"))
        for transport,url in candidates:
            key=(name,url)
            if name and key not in seen:
                seen.add(key)
                out.append({"name":name,"url":url,"transport":transport})
    return out


def _discover_comfy_hosts():
    """Probe tailnet peers concurrently and return reachable Comfy services."""
    import concurrent.futures
    candidates=_tailscale_comfy_candidates()
    if not candidates:
        return []
    found=[]
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(12,len(candidates))) as pool:
        futures={pool.submit(_comfy_probe,item["url"],.7):item for item in candidates}
        for future,item in futures.items():
            try:
                ok,_=future.result()
                if ok:
                    found.append(item)
            except Exception:
                pass
    best={}
    for item in found:
        old=best.get(item["name"])
        if old is None or (item["transport"]=="serve" and old["transport"]!="serve"):
            best[item["name"]]=item
    return sorted(best.values(),key=lambda x:x["name"].casefold())


def _comfy_is_gpu_host():
    """Local managed install is sensible only on a Linux NVIDIA workstation."""
    return platform.system()=="Linux" and bool(shutil.which("nvidia-smi"))


def _comfy_adopt_remote(quiet=False):
    """Self-heal an offline client by finding a reachable tailnet Comfy service."""
    cfg=_load_comfy_config()
    ok,_=_comfy_probe(cfg.get("host"),timeout=.6)
    if ok:
        return cfg.get("host"),"configured"

    found=_discover_comfy_hosts()
    if not found:
        return None,"none"

    # One service is unambiguous. If there are several, prefer a peer named 3090,
    # otherwise choose the first stable sort and make that visible to the user.
    choice=next((x for x in found if "3090" in x["name"].casefold()),found[0])
    cfg["host"]=choice["url"].rstrip("/")
    # A client is not a managed Comfy host merely because it can use one.
    cfg["install_path"]=""
    cfg["python"]=""
    _save_comfy_config(cfg)
    if not quiet:
        print(f"✓ Comfy host · {choice['name']} · {cfg['host']}")
    return cfg["host"],choice["name"]


def comfy_discover_command():
    """Discover in the right order: configured remote → tailnet → local GPU assets."""
    cfg=_load_comfy_config()
    ok,_=_comfy_probe(cfg.get("host"),timeout=.7)
    if ok:
        print(f"LOOK Comfy · ready · {cfg['host']}")
