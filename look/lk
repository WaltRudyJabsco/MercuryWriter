def _load_brain_state():
    """Persistent working state. Goals survive a chat process; models do not have to."""
    try:
        data=json.loads(BRAIN_STATE_FILE.read_text(encoding="utf-8"))
        if not isinstance(data,dict): return _empty_brain_state()
    except (OSError,json.JSONDecodeError):
        return _empty_brain_state()
    out=_empty_brain_state(); out.update(data)
    if not isinstance(out.get("active_goals"),list): out["active_goals"]=[]
    if not isinstance(out.get("recent_goals"),list): out["recent_goals"]=[]
    return out

def _save_brain_state(state):
    try:
        STATE_DIR.mkdir(parents=True,exist_ok=True)
        state=dict(state or _empty_brain_state()); state["updated_at"]=time.time()
        state["active_goals"]=list(state.get("active_goals") or [])[-16:]
        state["recent_goals"]=list(state.get("recent_goals") or [])[-24:]
        tmp=BRAIN_STATE_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(state,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
        os.chmod(tmp,0o600); tmp.replace(BRAIN_STATE_FILE); os.chmod(BRAIN_STATE_FILE,0o600)
        return True
    except OSError:
        return False

def _brain_set_pending(kind, *, goal="", slot="", resume="", request=""):
    state=_load_brain_state()
    state["pending"]={"kind":kind,"goal":goal,"slot":slot,"resume":resume,"request":request[:500],"since":time.time(),"wake_on":"operator_input","close_when":"slot_resolved_or_cancelled"}
    if goal:
        rows=[g for g in state.get("active_goals",[]) if g.get("goal")!=goal]
        rows.append({"goal":goal,"status":"waiting","slot":slot,"request":request[:500],"wake_on":"operator_input","close_when":"completed_failed_or_cancelled","updated_at":time.time()})
        state["active_goals"]=rows
    _save_brain_state(state)
    return state["pending"]

def _brain_resume_goal(goal, *, request=""):
    """A required operator slot was filled; the goal is runnable, not pending.

    Pending means LO is waiting on the operator. Once the operator answers, clear
    that obligation before touching an external edge so a provider failure or
    process restart cannot reinterpret an unrelated future utterance as the slot.
    """
    state=_load_brain_state()
    pending=state.get("pending")
    if pending and (not goal or pending.get("goal")==goal):
        state["pending"]=None
    rows=[]; found=False
    for row in state.get("active_goals",[]):
        if row.get("goal")==goal:
            live=dict(row); live["status"]="running"; live["slot"]=""
            if request: live["request"]=request[:500]
            live["updated_at"]=time.time(); rows.append(live); found=True
        else:
            rows.append(row)
    if goal and not found:
        rows.append({"goal":goal,"status":"running","slot":"","request":request[:500],"wake_on":"receipt_or_operator_input","close_when":"completed_failed_or_cancelled","updated_at":time.time()})
    state["active_goals"]=rows
    _save_brain_state(state)

def _brain_clear_pending(goal="", *, outcome="", status="done"):
    state=_load_brain_state(); pending=state.get("pending")
    if pending and (not goal or pending.get("goal")==goal): state["pending"]=None
    if goal:
        active=[]
        for row in state.get("active_goals",[]):
            if row.get("goal")==goal:
                done=dict(row); done["status"]=status if outcome else "cleared"; done["outcome"]=outcome[:500]; done["updated_at"]=time.time()
                state.setdefault("recent_goals",[]).append(done)
            else: active.append(row)
        state["active_goals"]=active
    _save_brain_state(state)

def _brain_context():
    state=_load_brain_state(); pending=state.get("pending")
    active=state.get("active_goals",[])
    if not pending and not active: return ""
    lines=["PERSISTENT WORKING STATE (authoritative; continue it unless the operator clearly changes goals):"]
    if pending:
        lines.append(f"PENDING: goal={pending.get('goal','')} slot={pending.get('slot','')} resume={pending.get('resume','')} request={pending.get('request','')}")
    for row in active[-4:]:
        lines.append(f"ACTIVE: {row.get('goal','')} · {row.get('status','active')} · missing {row.get('slot','')}")
    return "\n".join(lines)

def _world_command(args):
    try:
        state=_world_state().load()
    except Exception as exc:
        print(f"LO world unavailable: {exc}"); return 1
    print("LO world · typed persistent state")
    gid=state.get("active_goal_id") or "none"
    print(f"  active goal  {gid}")
    goals=state.get("goals") or []
    if goals:
        for row in goals[-5:]:
            print(f"  goal         {row.get('id','?')} · {row.get('status','?')} · {row.get('primary','general')} · {str(row.get('request',''))[:72]}")
    receipts=state.get("receipts") or []
    print(f"  receipts     {len(receipts)} typed")
    for row in receipts[-5:]:
        mark="✓" if row.get("ok") else "×"
        extra=f" · {row.get('failure_class')}" if row.get('failure_class') else ""
        print(f"               {mark} {row.get('action','?')} · {row.get('status','?')}{extra} · {str(row.get('message','')).splitlines()[0][:80]}")
    events=state.get("events") or []
    print(f"  events       {len(events)} bounded")
    print("  rule         language proposes; receipts establish truth; goals survive models")
    return 0


def _brain_command(args):
    args=list(args or []); state=_load_brain_state()
    if args and args[0] in {"clear","reset"}:
        _save_brain_state(_empty_brain_state()); print("LO brain · working state cleared"); return 0
    print("LO brain · persistent working state")
    pending=state.get("pending")
    if pending:
        print(f"  pending      {pending.get('goal','?')} · needs {pending.get('slot','?')} · {_age_label(pending.get('since',0))}")
        if pending.get('request'): print(f"  request      {pending.get('request')}")
    else: print("  pending      none")
    active=state.get("active_goals",[])
    print(f"  active       {len(active)} goal{'s' if len(active)!=1 else ''}")
    for row in active[-6:]: print(f"               {row.get('goal','?')} · {row.get('status','active')} · {row.get('slot','')} · wake {row.get('wake_on','event')}")
    recent=state.get("recent_goals",[])
    print(f"  recent       {len(recent)} completed/cleared")
    print("  rule         models may sleep; goals stay alive")
    return 0

def _lo_home_location_declaration(prompt):
    """Read an explicit operator correction such as 'my home is Portland Oregon'.

    This is semantic state supplied by the operator, not geocoder inference.  A
    trailing weather request is stripped so the learned value stays a place.
    """
    text=" ".join(str(prompt or "").strip().split()).strip(" .!?")
    if not text:
        return None
    patterns=(
        r"(?:^|\b)(?:no[, ]+)?(?:my\s+)?home(?:\s+location)?\s+(?:is|=)\s+(.+)$",
        r"^(?:please\s+)?(?:remember(?:\s+that)?\s+)?i\s+(?:live|reside)\s+in\s+(.+)$",
    )
    match=None
    for pattern in patterns:
        match=re.search(pattern,text,re.I)
        if match: break
    if not match:
        return None
    place=match.group(1).strip(" ,.;:?!")
    # Keep ordinary place words, but cut a second clause that asks for weather.
    place=re.split(r"\s+(?=(?:what(?:'s| is)|how(?:'s| is)|give me|tell me)\s+(?:the\s+)?(?:weather|forecast|temperature)\b)",place,maxsplit=1,flags=re.I)[0]
    place=re.split(r"\s+(?=weather\b)",place,maxsplit=1,flags=re.I)[0]
    place=_normalize_weather_location(place.strip(" ,.;:?!"))
    return place if 1 <= len(place) <= 96 else None

def _lo_learned_home_location(memory):
    """Return the newest authoritative machine atom for the operator's home."""
    best=None
    for atom in (memory or {}).get("atoms",[]) or []:
        if not isinstance(atom,dict):
            continue
        if str(atom.get("s") or "").casefold() != "home":
            continue
        if str(atom.get("r") or "").casefold() != "weather_location":
            continue
        value=_normalize_weather_location(atom.get("v"))
        if not value:
            continue
        stamp=float(atom.get("t",0) or 0)
        if best is None or stamp >= best[0]:
            best=(stamp,value)
    return best[1] if best else None

def _lo_store_home_location(memory, location):
    """Set, rather than accumulate, the single current home weather location."""
    location=_normalize_weather_location(location)
    if not location:
        return memory
    rows=[]
    for atom in (memory or {}).get("atoms",[]) or []:
        if not isinstance(atom,dict):
            continue
        if str(atom.get("s") or "").casefold()=="home" and str(atom.get("r") or "").casefold()=="weather_location":
            continue
        rows.append(atom)
    memory["atoms"]=rows
    return _merge_machine_atoms(memory,[{"k":"preference","s":"home","r":"weather_location","v":location,"c":100,"u":1}])


def _lo_store_default_location(memory, location):
    """Persist the operator's default place for ambiguous location-dependent work."""
    location=_normalize_weather_location(location)
    if not location: return memory
    rows=[]
    for atom in (memory or {}).get("atoms",[]) or []:
        if not isinstance(atom,dict): continue
        if str(atom.get("s") or "").casefold()=="location" and str(atom.get("r") or "").casefold()=="default":
            continue
        rows.append(atom)
    memory["atoms"]=rows
    return _merge_machine_atoms(memory,[{"k":"preference","s":"location","r":"default","v":location,"c":100,"u":1}])

def _lo_location_memory_directive(prompt, memory):
    """Resolve explicit anaphoric location-memory directives against verified home.

    This deliberately handles the common follow-up 'remember that I live there'
    only when LOOK already has an authoritative home location; the model never
    gets to invent the referent.
    """
    text=" ".join(str(prompt or "").strip().split())
    low=text.casefold()
    if "remember" not in low and "make a point" not in low:
        return None
    if not re.search(r"\b(?:live|reside)\s+there\b|\bdefault\s+to\s+there\b",low):
        return None
    home=_lo_learned_home_location(memory)
    if not home: return None
    wants_default=bool(re.search(r"\bdefault\b.*\b(?:location|there|local)\b|\bambiguous location",low))
    return {"home":home,"default":wants_default}

def _lo_weather_pending_location(prompt, memory):
    """Resolve only a plausible answer to LO's pending weather-location slot.

    A pending slot gets first refusal, not ownership of the next utterance. New
    questions and commands supersede it. Explicit weather wording may still fill
    the slot, but only its extracted location is consumed.
    """
    raw=" ".join(str(prompt or "").strip().split())
    text=raw.strip(" ,.;:?!")
    if not text or len(text.split()) > 10:
        return None
    low=text.casefold()
    if low in {"home","my home","at home","here"}:
        return _lo_learned_home_location(memory)
    if _lo_requires_weather(raw):
        return _lo_weather_location(raw)
    # Questions/commands are new intent, not slot values. Keep this structural:
    # do not grow a blacklist of every capability LO may acquire.
    if raw.rstrip().endswith("?") or re.match(
        r"^(?:lo\s+)?(?:what|when|where|who|why|how|which|is|are|am|was|were|do|does|did|can|could|would|will|should|tell|show|give|play|open|find|search|stop|pause|write|delete|email|calendar)\b",
        low, re.I):
        return None
    return _normalize_weather_location(text)

def _lo_weather_location(prompt):
    """Extract and canonicalize an explicit place for deterministic WEATHER."""
    text=" ".join(str(prompt or "").strip().split())
    if not text or not _lo_requires_weather(text):
        return None
    patterns=(
        r"\b(?:weather|forecast|temperature|temp|rain(?:ing)?|snow(?:ing)?|wind(?:y)?|humidity|precipitation)\b.*?\b(?:in|for|at|near)\s+(.+)$",
        r"\b(?:in|for|at|near)\s+([^?!.]+?)(?:\s+(?:today|tonight|tomorrow|this morning|this afternoon|this evening))?[?!.]*$",
    )
    for pattern in patterns:
        match=re.search(pattern,text,re.I)
        if not match:
            continue
        place=match.group(1).strip(" \t,.;:?!")
        place=re.sub(r"\s+(?:today|tonight|tomorrow|this morning|this afternoon|this evening)$","",place,flags=re.I).strip()
        place=_normalize_weather_location(place)
        if 1 <= len(place) <= 96:
            return place
    return None

def _lo_weather_history_location(history):
    """Recover the active weather place from ephemeral user discourse.

    A location-changing continuation ("how about Beaverton OR") becomes the new
    weather referent even though it does not repeat the word "weather".
    """
    current=None
    weather_active=False
    for prior in list(history or [])[-16:]:
        if not isinstance(prior,dict) or str(prior.get("role") or "").lower()!="user":
            continue
        text=str(prior.get("content") or "")
        declared_home=_lo_home_location_declaration(text)
        place=_lo_weather_location(text) or declared_home
        if place:
            current=place
            weather_active=True
            continue
        if not weather_active:
            continue
        compact=" ".join(text.strip().split()).strip(" ?!.")
        match=re.match(r"^(?:how|what)\s+about\s+(.+)$",compact,re.I)
        if not match:
            continue
        candidate=match.group(1).strip(" ,.;:?!")
        if re.fullmatch(r"(?:today|tonight|tomorrow|this morning|this afternoon|this evening|the high|the low|high|low|that)",candidate,re.I):
            continue
        followup=_normalize_weather_location(candidate)
        if followup:
            current=followup
    return current

def _lo_weather_default_location():
    """Optional operator-owned default; never infer geographic location from the model."""
    configured=os.environ.get("LOOK_WEATHER_LOCATION") or os.environ.get("LO_WEATHER_LOCATION") or ""
    return _normalize_weather_location(configured) or None

def _lo_weather_context(history):
    """Whether recent ephemeral discourse established WEATHER as the active topic."""
    for prior in reversed(list(history or [])[-8:]):
        if not isinstance(prior,dict) or str(prior.get("role") or "").lower()!="user":
            continue
        if _lo_requires_weather(prior.get("content","")):
            return True
    return False

def _lo_weather_followup(prompt, history):
    """Recognize narrow weather continuations without making WEATHER a generic pronoun trap."""
    if not _lo_weather_context(history):
        return False
    low=" ".join(str(prompt or "").casefold().split()).strip(" ?!.")
    if not low:
        return False
    patterns=(
        r"^(?:how|what) about\b",
        r"\b(?:high|low|highs|lows)\b",
        r"^(?:today|tonight|tomorrow|this morning|this afternoon|this evening)\b",
        r"\b(?:accurate|correct|right|verify|verification|check that|double[- ]check)\b",
        r"^(?:and|also)\s+(?:today|tonight|tomorrow)\b",
    )
    return any(re.search(pattern,low,re.I) for pattern in patterns)

def _lo_weather_followup_location(prompt, history):
    """Resolve an explicit location inside a weather continuation such as 'how about Beaverton OR'."""
    if not _lo_weather_context(history):
        return None
    text=" ".join(str(prompt or "").strip().split()).strip(" ?!.")
    match=re.match(r"^(?:how|what)\s+about\s+(.+)$",text,re.I)
    if not match:
        return None
    candidate=match.group(1).strip(" ,.;:?!")
    # These are temporal/verification continuations, not place names.
    if re.fullmatch(r"(?:today|tonight|tomorrow|this morning|this afternoon|this evening|the high|the low|high|low|that)",candidate,re.I):
        return None
    return _normalize_weather_location(candidate) or None

def _lo_weather_verification_requested(prompt):
    low=" ".join(str(prompt or "").casefold().split())
    return bool(re.search(r"\b(?:accurate|correct|right|verify|verification|double[- ]check)\b|\bcheck that\b",low))

def _weather_payload(tool_content):
    """Parse a typed WEATHER receipt; prose is never used as weather state."""
    try:
        row=json.loads(str(tool_content))
    except Exception:
        return None
    if not isinstance(row,dict) or row.get("edge")!="WEATHER":
        return None
    return row

def _weather_direct_followup(prompt, tool_content):
    """Answer scalar weather follow-ups directly from typed receipt fields."""
    row=_weather_payload(tool_content)
    if not row:
        return None
    low=" ".join(str(prompt or "").casefold().split())
    if not (re.search(r"\bhighs?\b",low) and re.search(r"\blows?\b",low)):
        return None
    forecast=list(row.get("forecast") or [])
    if not forecast:
        return None
    index=1 if "tomorrow" in low and len(forecast)>1 else 0
    day=forecast[index] or {}
    high=day.get("high_f"); low_temp=day.get("low_f")
    if high is None or low_temp is None:
        return None
    place=row.get("location") or {}
    name=str(place.get("name") or "the selected location")
    region=str(place.get("region") or "").strip()
    label=f"{name}, {region}" if region and region.casefold() not in name.casefold() else name
    when="tomorrow" if index==1 else "today"
    return f"The high {when} in {label} is {high:.1f}°F, and the low is {low_temp:.1f}°F."

def _lo_weather_only_query(prompt):
    """True when WEATHER grounding is the only operational edge this turn needs."""
    text=" ".join(str(prompt or "").casefold().split())
    if not _lo_requires_weather(text):
        return False
    # Keep full tools for compound requests such as save/open/search/compare.
    other=r"\b(save|write|create|copy|move|delete|remove|open|play|launch|search|find|file|folder|directory|compare|code|debug|run|command|process|port|generate|image|schedule)\b"
    return not re.search(other,text)

def _lo_explicit_web_scope(prompt):
    low=" ".join(str(prompt or "").casefold().split())
    return bool(re.search(r"\b(online|on the web|web|youtube(?:\.com)?|vimeo(?:\.com)?|website|site|url|browser)\b",low))

def _lo_action_continuation(prompt,last_action):
    """Short confirmations/retries inherit the prior actionable referent."""
    if not last_action: return False
    low=" ".join(str(prompt or "").casefold().split())
    if not low: return False
    if last_action.get("tool")=="run_command" and low==str(last_action.get("path") or "").casefold():
        return True
    patterns=(
        r"^(yes|yes!|yep|yeah|sure|okay|ok)(\b|[!.])",
        r"^(try|do|play|open|run)\s+(it\s+|that\s+)?again\b",
        r"^(try\s+(it|that)\s+now|run\s+(it|that)\s+now)\b",
        r"^(try again|do it|run it|that one|the same one|go ahead|please do)\b",
    )
    return any(re.search(p,low) for p in patterns)

def _lo_requires_external_action(prompt):
    """Requests whose success changes visible host state and therefore require a receipt."""
    text=" ".join(str(prompt or "").split()).strip().casefold()
    if not text: return False
    if re.search(r"^(what|why|how|did|does|is|was|were|where)\b",text): return False
    return bool(re.search(r"\b(open|play|launch|preview|reveal|show)\b",text))

def _external_action_succeeded(name,result):
    text=str(result or "")
    return (
        (name=="open_path" and text.startswith(("OPEN OK","DISPATCH OK"))) or
        (name=="preview_path" and text.startswith("PREVIEW OK")) or
        (name=="reveal_path" and text.startswith("REVEAL OK")) or
        (name=="open_url" and text.startswith("URL OPEN OK"))
    )

def _answer_claims_external_success(answer):
    low=" ".join(str(answer or "").casefold().split())
    return bool(re.search(r"\b(now playing|is playing|opened|launched|playing in|opened in|enjoy the show)\b",low))

def _answer_claims_unobserved_runtime_state(answer):
    """Claims stronger than an OPEN OK receipt: these require process/player observation."""
    low=" ".join(str(answer or "").casefold().split())
    return bool(re.search(
        r"\b(still running|still playing|currently running|currently playing|"
        r"is running|remains running|continues? playing|playback (?:is )?(?:active|running))\b",low
    ))

def _truthful_dispatch_summary(answer):
    """Downgrade launch/playback prose to exactly what OPEN OK establishes."""
    text=str(answer or "").strip()
    # Keep useful target wording where possible, but never assert playback/process state.
    text=re.sub(r"\bis now playing in VLC\b","was handed to the VLC launcher",text,flags=re.I)
    text=re.sub(r"\bis playing in VLC\b","was handed to the VLC launcher",text,flags=re.I)
    text=re.sub(r"\bnow playing\b","was handed to the configured player launcher",text,flags=re.I)
    text=re.sub(r"\bopened in VLC\b","was handed to the VLC launcher",text,flags=re.I)
    text=re.sub(r"\bwas sent to VLC\b","was handed to the VLC launcher",text,flags=re.I)
    text=re.sub(r"\b(still running|still playing|currently running|currently playing|is running)\b",
                "was dispatched successfully",text,flags=re.I)
    return text

def _lo_requires_filesystem_action(prompt):
    """Detect an actual request to mutate local files, not discussion of prior work."""
    text=" ".join(str(prompt or "").split()).strip().casefold()
    if not text:
        return False
    if re.search(r"\b(find|search|locate|show|reveal|open|play|preview|inspect|read)\b",text) and not re.search(r"\b(create|make|write|save|copy|duplicate|move|rename|remove|delete|edit|replace)\b",text):
        return False

    # Questions, retrospective discussion, acknowledgements, and feedback should
    # never trigger the host's "a mutation must occur" guard.
    retrospective=(
        r"^(did|do|does|was|were|is|are|what|where|why|how|which|who|when)\b",
        r"\b(you|we|it)\s+(did|made|created|wrote|saved|copied|moved|renamed|removed|deleted|edited|replaced)\b",
        r"\b(good job|nice job|great job|thanks|thank you|interesting|correct|worked|successful)\b",
        r"\b(i don't see|i do not see|where is|where did|what happened|didn't|did not)\b",
    )
    if any(re.search(pattern,text) for pattern in retrospective):
        return False

    # Explicit imperative/request forms. This deliberately favors precision;
    # if the model chooses to mutate on a conversational request, tool receipts
    # still govern truth even when this extra host guard is not engaged.
    action=r"(create|make|write|save|copy|duplicate|move|rename|remove|delete|edit|replace)"
    object_hint=(
        r"(file|files|folder|folders|directory|directories|path|paths|txt|md|json|csv|yaml|yml|py|js|html)"
        r"|[./~][^\s]*"
    )
    request_forms=(
        rf"^(please\s+)?{action}\b",
        rf"^(can|could|would|will)\s+you\s+(please\s+)?{action}\b",
        rf"^(i\s+want|i'd\s+like|i\s+need)\s+(you\s+to\s+)?{action}\b",
        rf"\b(please|lets|let's)\s+{action}\b",
    )
    explicit_request=any(re.search(pattern,text) for pattern in request_forms)
    # Also accept a base-form action followed by a concrete filesystem object,
    # useful for casual prefixes/typos such as "quick test -- lets make a file".
    casual_request=bool(re.search(rf"\b{action}\b.*{object_hint}",text))
    return bool((explicit_request or casual_request) and re.search(object_hint,text))


def _lo_runtime_policy(mode, prompt):
    """Thinking behavior is separate from token/tool budget selection."""
    mode=(mode or "adaptive").lower()
    if mode=="light":
        return {"think":False,"temperature":0.35}
    if mode=="deep":
        return {"think":True,"temperature":0.30}
    return {
        "think":_lo_prompt_needs_thinking(prompt),
        "temperature":0.35,
    }

def _lo_message_size(message):
    try:
        return len(json.dumps(message, ensure_ascii=False, default=str))
    except Exception:
        return len(str(message))

def _trim_lo_history(messages, base_count):
    """Keep core system context plus a bounded recent working conversation."""
    base=list(messages[:base_count])
    tail=list(messages[base_count:])[-LO_HISTORY_MAX_MESSAGES:]
    kept=[]
    used=0
    for item in reversed(tail):
        size=_lo_message_size(item)
        if kept and used+size > LO_HISTORY_MAX_CHARS:
            break
        kept.append(item); used+=size
    kept.reverse()
    # Never begin retained history in the middle of a tool-call transaction.
    while kept and kept[0].get("role") != "user":
        kept.pop(0)
    return base+kept

def _read_choice(path, allowed, default, env_name=None):
