def _tool_inspect_directory(workspace, raw_path=".", recursive=False, max_entries=200000):
    """Count filesystem objects deterministically without feeding listings to the model."""
    target=_safe_workspace_path(workspace,raw_path)
    if not target.exists():
        raise ValueError(f"Path does not exist: {raw_path}")
    if not target.is_dir():
        raise ValueError(f"Not a directory: {raw_path}")

    recursive=bool(recursive)
    max_entries=max(100,min(int(max_entries or 200000),500000))
    started=time.perf_counter()
    files=directories=symlinks=other=0
    total_bytes=0
    scanned=0
    truncated=False

    def count_entry(path):
        nonlocal files,directories,symlinks,other,total_bytes,scanned,truncated
        if scanned>=max_entries:
            truncated=True
            return False
        scanned+=1
        try:
            if path.is_symlink():
                symlinks+=1
            elif path.is_file():
                files+=1
                try: total_bytes+=path.stat().st_size
                except OSError: pass
            elif path.is_dir():
                directories+=1
            else:
                other+=1
        except OSError:
            other+=1
        return True

    if recursive:
        # os.scandir is substantially cheaper than materializing directory listings.
        stack=[target]
        while stack and not truncated:
            current=stack.pop()
            try:
                with os.scandir(current) as it:
                    for entry in it:
                        p=Path(entry.path)
                        if not count_entry(p):
                            break
                        try:
                            if entry.is_dir(follow_symlinks=False) and not entry.is_symlink():
                                stack.append(p)
                        except OSError:
                            pass
            except (OSError,PermissionError):
                other+=1
    else:
        try:
            with os.scandir(target) as it:
                for entry in it:
                    if not count_entry(Path(entry.path)):
                        break
        except (OSError,PermissionError) as exc:
            raise ValueError(f"Could not inspect directory: {exc}")

    elapsed_ms=(time.perf_counter()-started)*1000
    payload={
        "path":str(target),
        "recursive":recursive,
        "files":files,
        "directories":directories,
        "symlinks":symlinks,
        "other":other,
        "total_entries":files+directories+symlinks+other,
        "file_bytes":total_bytes,
        "scanned_entries":scanned,
        "truncated":truncated,
        "limit":max_entries,
        "elapsed_ms":round(elapsed_ms,2),
    }
    return json.dumps(payload,ensure_ascii=False)


def _natural_version_key(name):
    """Natural/version-aware filename ordering without pretending every digit is SemVer."""
    parts=re.split(r"(\d+)",str(name).casefold())
    return tuple((1,int(p)) if p.isdigit() else (0,p) for p in parts)


def _match_command(args):
    """Resolve a glob deliberately, then rank it by version, time, or name."""
    if not args:
        print("usage: lk match PATTERN [v|t|n] [--all]")
        return 2
    pattern=args[0]
    rank="v"
    show_all=False
    for arg in args[1:]:
        if arg in {"v","version"}: rank="v"
        elif arg in {"t","time","newest"}: rank="t"
        elif arg in {"n","name"}: rank="n"
        elif arg=="--all": show_all=True
        elif arg.startswith("-"):
            print(f"LOOK match · unknown option: {arg}"); return 2
        else:
            print(f"LOOK match · unexpected argument: {arg}"); return 2
    pattern=str(Path(pattern).expanduser())
    import glob
    rows=[Path(x) for x in glob.glob(pattern,recursive=True)]
    if not rows:
        print(f"LOOK match · no matches: {args[0]}")
        return 1
    if rank=="t":
        rows.sort(key=lambda x:(x.stat().st_mtime_ns,_natural_version_key(x.name)),reverse=True)
    elif rank=="n":
        rows.sort(key=lambda x:x.name.casefold())
    else:
        rows.sort(key=lambda x:_natural_version_key(x.name),reverse=True)
    if show_all:
        for x in rows: print(x)
    else:
        print(rows[0])
    return 0


