def _read_tty_key(fd, timeout=None):
    if timeout is not None:
        ready,_,_=select.select([fd],[],[],timeout)
        if not ready:
            return ""
    ch=os.read(fd,1)
    if ch != b"\x1b":
        return ch.decode("utf-8","ignore")
    seq=bytearray(ch)
    while len(seq)<8:
        ready,_,_=select.select([fd],[],[],0.035)
        if not ready:
            break
        seq.extend(os.read(fd,1))
        if seq[-1:] in b"~ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz":
            break
    return {
        b"\x1b[A":"up",
        b"\x1b[B":"down",
        b"\x1b[C":"right",
        b"\x1b[D":"left",
        b"\x1b[5~":"pageup",
        b"\x1b[6~":"pagedown",
        b"\x1b[1;2A":"shiftup",
        b"\x1b[1;2B":"shiftdown",
        b"\x1b[1;2C":"shiftright",
        b"\x1b[1;2D":"shiftleft",
        b"\x1b[H":"home", b"\x1b[1~":"home",
        b"\x1b[F":"end", b"\x1b[4~":"end",
    }.get(bytes(seq),"esc")


def _select_values(title, rows):
    """Shared LOOK selector: browse, Enter to filter, arrows/J/K move, Y copies value."""
    if not rows:
        return 1
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        _title(title)
        for label,value in rows:
            print(f"  {label}  {value}")
        return 0

    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    query=""
    filtering=False
    idx=0
    notice=""
    try:
        tty.setcbreak(fd)
        sys.stdout.write("\033[2J\033[H")
        sys.stdout.flush()
        while True:
            terms=query.casefold().split()
            visible=[
                row for row in rows
                if all(term in f"{row[0]} {row[1]}".casefold() for term in terms)
            ]
            if visible:
                idx=min(idx,len(visible)-1)
            else:
                idx=0

            terminal=shutil.get_terminal_size((100,30))
            height=max(8,terminal.lines)
            width=max(40,terminal.columns)
            usable=max(3,height-5)
            top=max(0,min(max(0,len(visible)-usable),idx-usable+1))
            page=visible[top:top+usable]

            sys.stdout.write("\033[2J\033[H")
            _title(title, f"{len(visible)} of {len(rows)}")
            for n,(label,value) in enumerate(page,start=top):
                mark=_c("›","1;36") if n==idx else " "
                raw_value=str(value)
                max_label=max(8,width-len(raw_value)-5)
                shown_label=str(label)
                if len(shown_label)>max_label:
                    shown_label=shown_label[:max(1,max_label-1)]+"…"
                value_text=_c(raw_value,"2")
                print(f"{mark} {shown_label}  {value_text}")

            if filtering:
                footer=(f"{_c('FILTER','1;36')} {query}█  "
                        f"{_c('↑↓ choose  Y copy  Enter done  Esc clear/back  q quit','2')}")
            else:
                footer=_c("↑↓ choose  Enter filter  Y copy  PgUp/PgDn page  Esc/q exit","2")
            if notice:
                footer += "  " + _c(notice,"33")
                notice=""
            print("\n"+footer,end="",flush=True)

            # Media Info is text-first: Chafa is already on screen. On terminals
            # with a native graphics plane, progressively replace only the art box.
            if info_mode and visible and art_w:
                cover=_media_cover_path(visible[idx])
                if cover:
                    warning_rows=1 if catalog_meta and (catalog_meta.get("errors") or catalog_meta.get("fallback")) else 0
                    art_row=2+warning_rows+len(page)+3
                    art_col=detail_w+3
                    native_art.request(cover,art_row,art_col,info_height,art_w)
            # Keep waiting for a real key while allowing a completed thumbnail to
            # paint asynchronously. Artwork can never delay selector input.
            while True:
                watched=[fd]+([native_art.wakeup_fd] if native_art.wakeup_fd is not None else [])
                ready,_,_=select.select(watched,[],[])
                if native_art.wakeup_fd is not None and native_art.wakeup_fd in ready:
                    try: os.read(native_art.wakeup_fd,4096)
                    except (OSError,BlockingIOError): pass
                    native_art.paint_ready()
                    if fd not in ready: continue
                key=_read_tty_key(fd)
                break
            if key in {"q","Q","\x03"}:
                break
            if key=="esc":
                if filtering and query:
                    query=""
                    idx=0
                    continue
                if filtering:
                    filtering=False
                    continue
                break
            if (key in {"up","K"} or (key=="k" and not filtering)) and visible:
                idx=max(0,idx-1)
                continue
            if (key in {"down","J"} or (key=="j" and not filtering)) and visible:
                idx=min(len(visible)-1,idx+1)
                continue
            if key=="pageup" and visible:
                idx=max(0,idx-usable)
                continue
            if key=="pagedown" and visible:
                idx=min(len(visible)-1,idx+usable)
                continue
            if key in {"y","Y"} and visible:
                notice="copied" if _copy_value(visible[idx][1]) else "clipboard unavailable"
                continue
            if key in {"\r","\n"}:
                filtering=not filtering
                continue
            if filtering and key in {"\x7f","\b"}:
                if query:
                    query=query[:-1]
                    idx=0
                continue
            if filtering and len(key)==1 and key.isprintable():
                query+=key
                idx=0
                continue
    finally:
        termios.tcsetattr(fd,termios.TCSADRAIN,old)
        print()
    return 0



