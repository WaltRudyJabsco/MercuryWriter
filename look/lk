class _InferenceEvents:
    """Truthful JSONL observability for inference clients.

    Events describe only state LOOK can directly observe.  The human terminal
    renderer remains independent; machine clients get a stable stdout stream.
    """
    def __init__(self, stream=None, request_id=None):
        self.stream=stream or sys.stdout
        self.request_id=request_id or uuid.uuid4().hex[:12]
        self.started=time.monotonic()
        self.seq=0

    def emit(self,event,**fields):
        self.seq+=1
        row={
            "event":str(event),
            "request_id":self.request_id,
            "seq":self.seq,
            "elapsed_ms":int((time.monotonic()-self.started)*1000),
        }
        for key,value in fields.items():
            if value is not None:
                row[key]=value
        self.stream.write(json.dumps(row,ensure_ascii=False,separators=(",",":"))+"\n")
        self.stream.flush()


