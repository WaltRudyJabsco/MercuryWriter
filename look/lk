def _lo_cognition_route(prompt,use_openjev=True):
    """Return the shared bounded route while preserving exact host reflexes."""
    # Exact deterministic edges remain authoritative. Cognition adds fuzziness and
    # tool neighborhoods; it never weakens the hard weather/game/media contracts.
    if _lo_game_intent(prompt):
        family="games"
    elif _lo_requires_weather(prompt):
        family="weather"
    elif _lo_requires_live_web(prompt):
        family="web"
    elif _lo_media_intent_profile(prompt,"workspace"):
        family="media"
    else:
        family=None
    try:
        route=_cognition_module().analyze(prompt,use_openjev=use_openjev)
        if family and route.primary!=family:
            route.primary=family
            if family not in route.families: route.families.insert(0,family)
            neighbors=_cognition_module().FAMILY_NEIGHBORS.get(family,{family})
            route.allowed_tools=sorted(set(route.allowed_tools) | {name for f in neighbors for name in _cognition_module().FAMILY_TOOLS.get(f,set())})
            route.confidence=max(route.confidence,.995)
            route.source="rules"
            route.reason="authoritative host reflex"
        return route
    except Exception:
        class _Route:
            primary=family or "general"; families=[family or "general"]; confidence=.5; margin=.5
            source="fallback"; reason="cognition module unavailable"; allowed_tools=[]; needs_clarification=False
            def public(self): return {"primary":self.primary,"families":self.families,"confidence":self.confidence,"margin":self.margin,"source":self.source,"reason":self.reason,"allowed_tools":self.allowed_tools,"needs_clarification":self.needs_clarification}
        return _Route()


