def _profile_entries():
    """Yield (source, archive-relative-path) for curated portable identity."""
    _ensure_intelligence_files()
    for name in PROFILE_STATE_FILES:
        src=STATE_DIR/name
        if src.is_file():
            yield src,Path("profile")/"state"/name
    for dirname in PROFILE_STATE_DIRS:
        base=STATE_DIR/dirname
        if base.is_dir():
            for src in sorted(base.rglob("*")):
                if src.is_file():
                    yield src,Path("profile")/"state"/dirname/src.relative_to(base)
    for name in PROFILE_CONFIG_FILES:
        src=CONFIG_DIR/name
        if src.is_file():
            yield src,Path("profile")/"config"/name


def _profile_inventory():
    entries=list(_profile_entries())
    return entries,sum(src.stat().st_size for src,_ in entries if src.exists())


def _profile_write_directory(destination):
    destination=Path(destination).expanduser().resolve()
    destination.mkdir(parents=True,exist_ok=False)
    _atomic_json(destination/"manifest.json",_profile_manifest())
    copied=0
    for src,rel in _profile_entries():
        dst=destination/rel
        dst.parent.mkdir(parents=True,exist_ok=True)
        shutil.copy2(src,dst)
        copied+=1
    return copied


def _profile_export(output=None):
    stamp=time.strftime("%Y%m%d-%H%M%S")
    out=Path(output).expanduser() if output else _safe_cwd()/f"look-profile-{stamp}.zip"
    if out.suffix.lower()!=".zip":
        out=out.with_suffix(".zip")
    out=out.resolve()
    if out.exists():
        print(f"LOOK profile · export refused · already exists: {out}")
        return 1
    out.parent.mkdir(parents=True,exist_ok=True)
    manifest=_profile_manifest()
    entries=list(_profile_entries())
    try:
        with zipfile.ZipFile(out,"w",zipfile.ZIP_DEFLATED) as archive:
            archive.writestr("manifest.json",json.dumps(manifest,indent=2)+"\n")
            for src,rel in entries:
                archive.write(src,rel.as_posix())
        _feedback("complete","profile exported")
        print(f"PROFILE EXPORT OK · {out}")
        print(f"  {len(entries)} files · {out.stat().st_size/1024:.1f} KB")
        print("  secrets/runtime state excluded")
        return 0
    except OSError as exc:
        try: out.unlink()
        except OSError: pass
        print(f"LOOK profile · export failed · {exc}")
        return 1


def _profile_backup(args):
    cfg=_load_profile_config()
    root_arg=""
    keep=cfg["keep"]
    words=list(args)
    if "--keep" in words:
        i=words.index("--keep")
        try:
            keep=max(1,min(50,int(words[i+1])))
        except (ValueError,IndexError):
            print("usage: lk profile backup [DEST] [--keep N]"); return 2
        words=words[:i]+words[i+2:]
    if words:
        root_arg=" ".join(words).strip()
        cfg["backup_root"]=str(Path(root_arg).expanduser().resolve())
        cfg["keep"]=keep
        _save_profile_config(cfg)
    root_text=cfg.get("backup_root","")
    if not root_text:
        print("LOOK profile · no backup destination configured")
        print("  run: lk profile backup ~/Documents/LOOK")
        return 1

    root=Path(root_text).expanduser().resolve()
    backups=root/"LOOK-profile-backups"
    backups.mkdir(parents=True,exist_ok=True)
    stamp=time.strftime("%Y-%m-%d-%H%M%S")
    target=backups/stamp
    try:
        count=_profile_write_directory(target)
        snapshots=sorted(p for p in backups.iterdir() if p.is_dir())
        for old in snapshots[:-keep]:
            shutil.rmtree(old,ignore_errors=True)
        _feedback("complete","profile backed up")
        print(f"PROFILE BACKUP OK · {target}")
        print(f"  {count} files · keeping {keep} snapshots")
        return 0
    except (OSError,FileExistsError) as exc:
        shutil.rmtree(target,ignore_errors=True)
        print(f"LOOK profile · backup failed · {exc}")
        return 1


def _safe_profile_member(name):
    path=Path(name)
    return (
        not path.is_absolute()
        and ".." not in path.parts
        and (name=="manifest.json" or (path.parts and path.parts[0]=="profile"))
    )


def _profile_restore(source,args):
    source=Path(source).expanduser().resolve()
    yes="--yes" in args
    temp_root=None
    try:
        if source.is_file() and source.suffix.lower()==".zip":
            temp_root=Path(tempfile.mkdtemp(prefix="look-profile-restore."))
            with zipfile.ZipFile(source) as archive:
                bad=[n for n in archive.namelist() if not _safe_profile_member(n)]
                if bad:
                    print("LOOK profile · restore refused · unsafe archive paths")
                    return 1
                archive.extractall(temp_root)
            base=temp_root
        elif source.is_dir():
            base=source
        else:
            print(f"LOOK profile · restore source not found: {source}")
            return 1

        manifest_path=base/"manifest.json"
        try:
            manifest=json.loads(manifest_path.read_text(encoding="utf-8"))
        except (OSError,ValueError):
            print("LOOK profile · restore refused · manifest missing or invalid")
            return 1
        schema=int(manifest.get("profile_schema",0) or 0)
        if schema!=PROFILE_SCHEMA_VERSION:
            print(f"LOOK profile · unsupported profile schema {schema}")
            return 1

        files=[p for p in (base/"profile").rglob("*") if p.is_file()] if (base/"profile").exists() else []
        if not files:
            print("LOOK profile · restore refused · profile is empty")
            return 1

        if not yes and sys.stdin.isatty():
            answer=input(f"Restore {len(files)} profile files into this LOOK installation? [y/N] ").strip().lower()
            if answer not in {"y","yes"}:
                print("· cancelled"); return 1

        # Local safety snapshot independent of configured external backup.
        safety=STATE_DIR/"restore_snapshots"/time.strftime("%Y%m%d-%H%M%S")
        safety.mkdir(parents=True,exist_ok=True)
        for live,_ in _profile_entries():
            try:
                if live.exists():
                    rel=(Path("config")/live.name) if live.parent==CONFIG_DIR else (Path("state")/live.relative_to(STATE_DIR))
                    dst=safety/rel
                    dst.parent.mkdir(parents=True,exist_ok=True)
                    shutil.copy2(live,dst)
            except (OSError,ValueError):
                pass

        restored=0
        state_src=base/"profile"/"state"
        config_src=base/"profile"/"config"
        if state_src.exists():
            for src in sorted(state_src.rglob("*")):
                if not src.is_file(): continue
                rel=src.relative_to(state_src)
                # 4.5.0 and earlier exported this machine-specific choice.
                # Ignore it on restore so a 3090 preference cannot poison an M4.
                if rel == Path("ollama_model"):
                    continue
                dst=STATE_DIR/rel
                dst.parent.mkdir(parents=True,exist_ok=True)
                shutil.copy2(src,dst); restored+=1
        if config_src.exists():
            for src in sorted(config_src.rglob("*")):
                if not src.is_file(): continue
                rel=src.relative_to(config_src)
                dst=CONFIG_DIR/rel
                dst.parent.mkdir(parents=True,exist_ok=True)
                shutil.copy2(src,dst); restored+=1

        _feedback("complete","profile restored")
        print(f"PROFILE RESTORE OK · {restored} files")
        print(f"  from    {source}")
        print(f"  safety  {safety}")
        return 0
    finally:
        if temp_root is not None:
            shutil.rmtree(temp_root,ignore_errors=True)


