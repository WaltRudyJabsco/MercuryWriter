def _shortcut_collision_kind(name):
    """Best-effort current shell/system collision classification."""
    # Python cannot see parent-shell aliases/functions; the managed zsh layer
    # performs the authoritative runtime check. Here we report builtins/files.
    if name in {"fc","cd","pwd","echo","read","type"}:
        return "builtin"
    resolved=shutil.which(name)
    return f"executable · {resolved}" if resolved else "free/alias/function unknown until rb"


