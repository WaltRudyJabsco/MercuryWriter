def _command_words(command):
    try:
        import shlex
        return shlex.split(str(command or ""),posix=True)
    except ValueError:
        return []


def _inspection_command(command):
    """Known non-mutating shell inspections that POWER may run without prompting."""
    words=_command_words(command)
    if not words:
        return False
    # Shell composition/redirection changes semantics; require confirmation.
    if re.search(r"[;&|><`$()]",str(command)):
        return False
    exe=Path(words[0]).name

    universal={"--version","-V","--help","-h"}
    if len(words)==2 and words[1] in universal and exe not in {"rm","mv","cp","dd","kill","pkill"}:
        return True

    if exe in {"pwd","whoami","uname","hostname","which","whereis","type","id","uptime"}:
        return True
    if exe=="ollama" and len(words)>=2 and words[1] in {"list","ps","show","--version","-v","version"}:
        return True
    if exe=="git" and len(words)>=2 and words[1] in {"status","branch","log","diff","show","rev-parse","remote"}:
        # Explicitly reject flags commonly used to mutate despite the subcommand.
        return not any(w in {"--delete","-D","-d","--force","-f","--set-upstream-to"} for w in words[2:])
    if exe=="nvidia-smi":
        return True
    if exe in {"ls","stat","file","du","df","ps","lsof","env","printenv"}:
        return True
    return False


def _command_grant_key(command):
