def _evidence_record(source, claim, *, ok=True, confidence=100, receipt="", **fields):
    """Write compact epistemic evidence into the existing receipt journal.

    Evidence is provenance, not prose.  The journal stays bounded by _audit_receipt
    and downstream cognition can distinguish operator/host/tool/model authority.
    """
    source=str(source or "model").casefold()
    badge=_EVIDENCE_BADGES.get(source,source.upper()[:8])
    _audit_receipt("evidence","evidence",str(claim)[:500],ok=ok,source=source,badge=badge,
                   confidence=max(0,min(100,int(confidence))),receipt=receipt,**fields)
