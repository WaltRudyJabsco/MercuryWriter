def _media_relocate_root(old_root,new_root):
    """Explicitly replace one indexed root, then scan its new filesystem location."""
    library=_media_library()
    old=str(Path(old_root).expanduser())
    old_resolved=str(Path(old).resolve()) if Path(old).exists() else old
    known=list(library.get("roots") or [])
    match=next((r for r in known if r==old or r==old_resolved),None)
    if not match:
        raise ValueError(f"media root is not indexed: {old_root}")
    target=Path(new_root).expanduser().resolve()
    if not target.is_dir():
        raise NotADirectoryError(target)
    # Remove the dead root first so a relocation cannot leave duplicate logical rows.
    library["entries"]=[row for row in library.get("entries") or [] if str(row.get("root") or "")!=match]
    library["roots"]=[r for r in known if r!=match]
    return media_core.scan_root(target,library),match,str(target)


def _media_scan_command(args):
    if args and args[0] in {"--relocate","--move-root"}:
        if len(args)<3:
            print("usage: lk media scan --relocate OLD_ROOT NEW_ROOT")
            return 2
        old_root=args[1]
        new_root=" ".join(args[2:])
        started=time.monotonic()
        try:
            library,old_base,new_base=_media_relocate_root(old_root,new_root)
        except (OSError,ValueError,NotADirectoryError) as exc:
            print(f"LOOK media · {exc}")
            return 1
        _media_save_library(library)
        count=sum(1 for row in library["entries"] if row.get("root")==new_base)
        print(f"LOOK MEDIA ROOT RELOCATED · {count:,} items · {time.monotonic()-started:.2f}s")
        print(f"  from  {old_base}")
        print(f"  to    {new_base}")
        print(f"  index {MEDIA_LIBRARY_FILE}")
        return 0
    if not args:
        # No-argument scan means "find my normal media", not "walk all of HOME".
        # The latter drags caches/Application Support into the catalog and made the
        # useful local library hard to see.  Keep roots explicit and predictable.
        home=Path.home()
        candidates=[home/"Music", home/"Movies"]
        if sys.platform=="darwin":
            # Apple Music commonly stores local downloads below this hierarchy.
            candidates += [home/"Music"/"Music"/"Media.localized", home/"Music"/"Music"/"Media"]
        roots=[]
        for candidate in candidates:
            try:
                resolved=candidate.expanduser().resolve()
            except OSError:
                continue
            if resolved.is_dir() and not any(resolved==r or r in resolved.parents for r in roots):
                roots.append(resolved)
        if not roots:
            print("LOOK media · no standard local media folders found")
            print("  use: lk media scan /path/to/media")
            return 1
        started=time.monotonic(); library=_media_library()
        for scan_root in roots:
            try:
                library=media_core.scan_root(scan_root,library)
            except (OSError,NotADirectoryError):
                continue
        _media_save_library(library)
        print(f"LOOK MEDIA DISCOVERY · {len(library.get('entries') or []):,} local items · {time.monotonic()-started:.2f}s")
        for scan_root in roots:
            count=sum(1 for row in library.get("entries") or [] if row.get("root")==str(scan_root))
            print(f"  {count:>7,}  {scan_root}")
        return 0
    root=Path(" ".join(args)).expanduser()
    started=time.monotonic()
    try:
        library=media_core.scan_root(root,_media_library())
    except (OSError,NotADirectoryError) as exc:
        print(f"LOOK media · {exc}")
        return 1
    _media_save_library(library)
    base=str(root.resolve())
    count=sum(1 for row in library["entries"] if row.get("root")==base)
    print(f"LOOK MEDIA LIBRARY · {count:,} items · {time.monotonic()-started:.2f}s")
    print(f"  root  {base}")
    print(f"  index {MEDIA_LIBRARY_FILE}")
    print("  fast scan · no media bytes hashed or decoded")
    return 0


