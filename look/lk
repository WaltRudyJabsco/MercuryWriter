def _resource_referent_intent(prompt):
    """Resolve cheap discourse references before asking the model to rediscover them."""
    low=" ".join(str(prompt or "").casefold().split())
    pronoun=bool(re.search(r"\b(it|this|that|this file|that file|these|them|those)\b",low))
    browser=bool(re.search(r"\b(open|launch|show)\b.*\b(browser|web browser)\b",low))
    return pronoun,browser

def _promote_resource(refs, archive, turn_id):
    """Newest explicitly supplied/discussed resources win pronoun resolution."""
    for ref in refs or []:
        ref.last_referenced_turn=turn_id
    return _merge_resource_refs(archive,refs)

def _latest_resource(refs, archive):
    candidates=list(refs or []) or list(archive or [])
    if not candidates: return None
    return max(candidates,key=lambda r:(int(getattr(r,"last_referenced_turn",0)), candidates.index(r)))

def _resource_constraints(prompt):
    low=" ".join(str(prompt or "").casefold().split())
    aliases={
        "html":(".html",".htm",".xhtml"), "pdf":(".pdf",),
        "docx":(".docx",), "word":(".docx",".doc"),
        "markdown":(".md",".markdown"), "md":(".md",".markdown"),
        "text":(".txt",), "rtf":(".rtf",),
        "image":(".png",".jpg",".jpeg",".webp",".gif"),
        "picture":(".png",".jpg",".jpeg",".webp",".gif"),
        "photo":(".png",".jpg",".jpeg",".webp",".gif"),
        "video":(".mp4",".mov",".mkv",".webm",".avi"),
        "movie":(".mp4",".mov",".mkv",".webm",".avi"),
    }
    out=[]
    for word,exts in aliases.items():
        if re.search(rf"\b{re.escape(word)}\b",low): out.extend(exts)
    return tuple(dict.fromkeys(out))

def _resolve_known_resource(prompt, refs, archive):
    pool=_merge_resource_refs(list(refs or []),list(archive or []))
    if not pool: return None
    suffixes=_resource_constraints(prompt)
    if suffixes:
        compatible=[r for r in pool if r.kind=="file" and r.path.suffix.casefold() in suffixes]
        if compatible:
            return max(compatible,key=lambda r:int(getattr(r,"last_referenced_turn",0)))
        return None
    pronoun,_=_resource_referent_intent(prompt)
    if pronoun:
        return max(pool,key=lambda r:int(getattr(r,"last_referenced_turn",0)))
    return None

