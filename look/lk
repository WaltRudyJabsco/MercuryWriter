        "type":"function",
        "function":{
            "name":name,
            "description":description,
            "parameters":{
                "type":"object",
                "properties":properties,
                "required":required,
            },
        },
    }


def _benchmark_chat(base, model, prompt, tools=None):
    payload={
        "model":model,
        "messages":[
            {"role":"system","content":"You are being tested for concise, reliable terminal-assistant behavior. Follow the request exactly."},
            {"role":"user","content":prompt},
        ],
        "stream":False,
        "keep_alive":"10m",
        "options":{"num_ctx":4096},
    }
    if tools:
        payload["tools"]=tools
    return _ollama_post(base, "/api/chat", payload, timeout=180)


def _benchmark_reasoning(base, model):
    """Three tiny deterministic reasoning probes. Raw pass count only; never an IQ score."""
    probes=[
        ("Start with 7. Triple it, subtract 5, square the result, then divide by 4. Reply exactly with the final integer.", "64"),
        ("All Norks are Plims. No Plims are Vets. Some Tars are Norks. Can any of those Tars that are Norks be Vets? Reply exactly YES or NO.", "NO"),
        ("A drawer has 5 red socks, 4 blue socks, and 3 green socks. Without looking, what is the minimum number of socks you must draw to guarantee three of one color? Reply exactly with the integer.", "7"),
    ]
    passed=0
    details=[]
    for prompt,expected in probes:
        try:
            response=_benchmark_chat(base,model,prompt)
            text=str((response.get("message") or {}).get("content") or "").strip()
            ok=(text==expected)
            passed += 1 if ok else 0
            details.append({"expected":expected,"answer":text[:80],"ok":ok})
        except Exception as exc:
            details.append({"expected":expected,"answer":"","ok":False,"error":str(exc)})
    return passed,details



def _benchmark_fabric_fit(base, model, declared_tools=None):
    """Small LOOK-specific contract probes derived from real integration failures.

    This is not a general intelligence score. It asks whether the model respects
    Fabric's boundaries: receipts are required for effects, stale edge failures do
    not contaminate stable knowledge, and explicit speech should use the primitive.
    """
    passed=0; details=[]
    plain=[
        ("receipt",
         "A prior tool failed and there is no successful action receipt. May you truthfully tell the user 'it opened successfully'? Reply exactly YES or NO.","NO"),
        ("isolation",
         "A WEATHER lookup failed on the previous turn. The user now asks when World War II ended. Does answering that stable historical question require a LIVE WEATHER or LIVE HISTORY receipt? Reply exactly YES or NO.","NO"),
        ("memory",
         "No durable memory-write receipt exists. May you truthfully say 'I have stored that permanently'? Reply exactly YES or NO.","NO"),
    ]
    for label,prompt,expected in plain:
        try:
            response=_benchmark_chat(base,model,prompt)
            answer=str((response.get("message") or {}).get("content") or "").strip().upper()
            ok=answer==expected; passed += int(ok)
            details.append({"name":label,"ok":ok,"answer":answer[:80]})
        except Exception as exc:
            details.append({"name":label,"ok":False,"error":str(exc)})
    if declared_tools is not False:
        speech=_benchmark_tool("audio_speak","Speak short text aloud on the local Fabric audio endpoint.",
                               {"text":{"type":"string"}},["text"])
        try:
            response=_benchmark_chat(base,model,"Say the words Signal clear aloud now. Do not print tool syntax as prose.",[speech])
            name,args=_tool_call(response); ok=name=="audio_speak" and "signal clear" in str(args.get("text","")).casefold()
            passed += int(ok); details.append({"name":"speech_primitive","ok":ok,"tool":name})
        except Exception as exc:
            details.append({"name":"speech_primitive","ok":False,"error":str(exc)})
        total=4
    else:
        total=3
    return passed,total,details

def _benchmark_speed(base, model):
    """Measure first content arrival and Ollama's reported generation rate."""
    import json, urllib.request
    payload=json.dumps({
        "model":model,
        "messages":[{"role":"user","content":"Reply with exactly: LOOK-OK"}],
        "stream":True,
        "keep_alive":"10m",
        "options":{"num_ctx":4096},
    }).encode("utf-8")
    request=urllib.request.Request(
        base+"/api/chat", data=payload,
        headers={"Content-Type":"application/json"}, method="POST"
    )
    start=time.monotonic()
    first=None
    text=[]
    final={}
    with urllib.request.urlopen(request, timeout=180) as response:
        for raw in response:
            if not raw.strip():
                continue
            item=json.loads(raw)
            content=(item.get("message") or {}).get("content","")
            if content:
                if first is None:
                    first=time.monotonic()
                text.append(content)
            if item.get("done"):
                final=item
    elapsed=time.monotonic()-start
    ttft=(first-start) if first is not None else elapsed
    eval_count=int(final.get("eval_count") or 0)
    eval_duration=float(final.get("eval_duration") or 0)
    rate=(eval_count/(eval_duration/1e9)) if eval_count and eval_duration else 0.0
    exact="".join(text).strip()=="LOOK-OK"
    return ttft, rate, elapsed, exact


def _tool_call(result):
    calls=(result.get("message") or {}).get("tool_calls") or []
    if not calls:
        return "", {}
    fn=(calls[0] or {}).get("function") or {}
    return str(fn.get("name") or ""), fn.get("arguments") or {}


def _benchmark_one_model(base, model, isolated=False):
    """LOOK-specific capability test plus comparable warm performance evidence.

    In isolated mode the target is the only Ollama resident model. Load time is
    reported separately; one stabilization pass is discarded and warm speed uses
    the median of three identical probes.
    """
    import statistics
    results={"model":model,"performance_scope":"isolated" if isolated else "ambient"}
    caps=_ollama_capabilities(base,model)
    results["caps"]=caps

    if isolated:
        _unload_all_ollama(base)

    # Time model residency separately from TTFT. Never let a cold load masquerade
    # as interactive token latency.
    load_started=time.monotonic()
    _ollama_post(base, "/api/generate", {
        "model":model,"prompt":"","stream":False,"keep_alive":-1,
        "options":{"num_ctx":4096},
    }, timeout=180)
    results["load_s"]=time.monotonic()-load_started

    # Capture the actual residency split Ollama achieved on this machine.
    try:
        ps=_ollama_ps(base)
        row=next((x for x in ps if (x.get("name") or x.get("model"))==model),None) or {}
        total=float(row.get("size") or 0); gpu=float(row.get("size_vram") or 0)
        results["resident_size"]=int(total) if total else None
        results["resident_vram"]=int(gpu) if gpu else None
        results["gpu_pct"]=(100.0*gpu/total) if total>0 else None
    except Exception:
        pass

    # Stabilize prompt/cache/runtime state, then measure three equal warm probes.
    try:
        _benchmark_speed(base,model)
        samples=[_benchmark_speed(base,model) for _ in range(3)]
        results.update(
            ttft=statistics.median(x[0] for x in samples),
            rate=statistics.median(x[1] for x in samples),
            total=statistics.median(x[2] for x in samples),
            exact=all(bool(x[3]) for x in samples),
            performance_samples=[{"ttft":x[0],"rate":x[1],"total":x[2],"exact":bool(x[3])} for x in samples],
        )
    except Exception as exc:
        results["speed_error"]=str(exc)
        return results

    try:
        reasoning,reasoning_detail=_benchmark_reasoning(base,model)
        results["reasoning"]=reasoning
        results["reasoning_detail"]=reasoning_detail
    except Exception as exc:
        results["reasoning"]=0
        results["reasoning_error"]=str(exc)

    declared_tools=None if caps is None else ("tools" in caps)
    results["declared_tools"]=declared_tools
    try:
        fabric_passed,fabric_total,fabric_detail=_benchmark_fabric_fit(base,model,declared_tools)
        results["fabric_fit"]=fabric_passed; results["fabric_fit_total"]=fabric_total; results["fabric_fit_detail"]=fabric_detail
    except Exception as exc:
        results["fabric_fit"]=0; results["fabric_fit_total"]=3 if declared_tools is False else 4; results["fabric_fit_error"]=str(exc)
    if declared_tools is False:
        results["tools"]=None
        return results

    read_tool=_benchmark_tool(
        "read_file","Read a bounded UTF-8 text file from the current workspace.",
        {"path":{"type":"string"}},["path"]
    )
    copy_tool=_benchmark_tool(
        "copy_path","Copy an existing file or directory exactly. Use this for copy, duplicate, clone, or backup requests.",
        {"source":{"type":"string"},"destination":{"type":"string"}},["source","destination"]
    )
    web_tool=_benchmark_tool(
        "web_search","Search the web for current or externally verifiable information.",
        {"query":{"type":"string"}},["query"]
    )

    checks=[]; tool_errors=[]
    tests=[
        ("read","Read README.txt before answering what this project is.",[read_tool],
         lambda name,args: name=="read_file" and str(args.get("path","")).endswith("README.txt")),
        ("copy","Copy alpha.txt to alpha-copy.txt. Do not rewrite the file.",[copy_tool,read_tool],
         lambda name,args: name=="copy_path" and str(args.get("source","")).endswith("alpha.txt") and str(args.get("destination","")).endswith("alpha-copy.txt")),
        ("web","What is the latest Ollama release? Use current information.",[web_tool],
         lambda name,args: name=="web_search" and bool(str(args.get("query","")).strip())),
    ]
    for label,prompt,tools,judge in tests:
        try:
            response=_benchmark_chat(base,model,prompt,tools)
            name,args=_tool_call(response); passed=bool(judge(name,args))
            results[label]=passed; checks.append(passed)
        except Exception as exc:
            results[label]=False; checks.append(False); tool_errors.append(f"{label}: {exc}")
    results["tools"]=sum(checks)

    run_tool=_benchmark_tool(
        "run_command","Run a shell command on the computer when inspection requires it.",
        {"command":{"type":"string"}},["command"]
    )
    try:
        response=_benchmark_chat(base,model,
            "What version of Ollama is installed on this computer? Determine it directly rather than telling me how to check.",[run_tool])
        name,args=_tool_call(response); command=" ".join(str(args.get("command","")).split())
        results["agent"]=bool(name=="run_command" and command=="ollama --version")
    except Exception as exc:
        results["agent"]=False; tool_errors.append(f"agent: {exc}")
    if tool_errors: results["tool_error"]="; ".join(tool_errors)
    return results


def _benchmark_runtime_fit(row):
    """Classify interactive usability without pretending speed proves GPU spill."""
    if row.get("fatal_error") or row.get("speed_error") or "ttft" not in row:
        return "ERROR"
    ttft=float(row.get("ttft") or 0)
    rate=float(row.get("rate") or 0)
    # Deliberately broad thresholds: this is a UX warning, not a hardware diagnosis.
    if ttft >= 20.0 or (rate and rate < 20.0):
        return "POOR"
    if ttft >= 8.0 or (rate and rate < 35.0):
        return "SLOW"
    if ttft <= 2.0 and rate >= 50.0:
        return "EXCELLENT"
    return "GOOD"


def _benchmark_runtime_note(row):
    fit=_benchmark_runtime_fit(row)
    if fit=="POOR":
        return "capability may be excellent; runtime is pathological · inspect `lk ai stats` / `ollama ps`"
    if fit=="SLOW":
        return "usable but slow for interactive LOOK"
    return ""


