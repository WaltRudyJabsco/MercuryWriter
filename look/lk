def _place_lookup(query,count=5):
    import json
    from urllib.parse import urlencode
    query=str(query or "").strip()
    if not query: return "Place lookup requires a location."
    data=_http_json("https://geocoding-api.open-meteo.com/v1/search?"+urlencode({"name":query,"count":max(1,min(int(count),5)),"language":"en","format":"json"}))
    rows=[]
    for item in (data.get("results") or [])[:5]:
        rows.append({"name":item.get("name"),"region":", ".join(x for x in [item.get("admin1"),item.get("country")] if x),"latitude":item.get("latitude"),"longitude":item.get("longitude"),"timezone":item.get("timezone")})
    return json.dumps(_info_envelope("Open-Meteo geocoding","PLACE",{"query":query,"results":rows},source_url="https://geocoding-api.open-meteo.com/"),ensure_ascii=False)

def _weather_lookup(location):
    import json
    from urllib.parse import urlencode
    # Normalize at the edge too. Model-issued tool calls and deterministic
    # preflight must resolve identical user places identically.
    location=_normalize_weather_location(location)
    geo=json.loads(_place_lookup(location,1)); matches=geo.get("results") or []
    if not matches: return f"No weather location match for {location!r}."
    place=matches[0]
    params={"latitude":place["latitude"],"longitude":place["longitude"],"timezone":"auto","temperature_unit":"fahrenheit","wind_speed_unit":"mph","precipitation_unit":"inch","current":"temperature_2m,apparent_temperature,relative_humidity_2m,precipitation,weather_code,cloud_cover,wind_speed_10m,wind_direction_10m","daily":"weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,precipitation_sum,sunrise,sunset","forecast_days":3}
    data=_http_json("https://api.open-meteo.com/v1/forecast?"+urlencode(params)); daily=data.get("daily") or {}; days=[]
    for i,day in enumerate((daily.get("time") or [])[:3]):
        def at(k):
            v=daily.get(k) or []; return v[i] if i<len(v) else None
        days.append({"date":day,"weather_code":at("weather_code"),"high_f":at("temperature_2m_max"),"low_f":at("temperature_2m_min"),"precip_probability_pct":at("precipitation_probability_max"),"precipitation_in":at("precipitation_sum"),"sunrise":at("sunrise"),"sunset":at("sunset")})
    return json.dumps(_info_envelope("Open-Meteo","WEATHER",{"location":place,"observed_at":(data.get("current") or {}).get("time"),"current":data.get("current") or {},"current_units":data.get("current_units") or {},"forecast":days},as_of=(data.get("current") or {}).get("time"),source_url="https://open-meteo.com/"),ensure_ascii=False)

def _weather_code_text(code):
    try: code=int(code)
    except Exception: return ""
    if code==0: return "clear"
    if code in (1,2): return "partly cloudy"
    if code==3: return "overcast"
    if code in (45,48): return "foggy"
    if code in (51,53,55,56,57): return "drizzle"
    if code in (61,63,65,66,67): return "rain"
    if code in (71,73,75,77): return "snow"
    if code in (80,81,82): return "rain showers"
    if code in (85,86): return "snow showers"
    if code in (95,96,99): return "thunderstorms"
    return ""

def _weather_direct_summary(tool_content):
    """Render ordinary current-weather requests directly from the typed receipt."""
    row=_weather_payload(tool_content)
    if not row:
        return None
    place=row.get("location") or {}
    name=str(place.get("name") or "the selected location")
    region=str(place.get("admin1") or place.get("region") or "").strip()
    country=str(place.get("country") or "").strip()
    label=", ".join(x for x in (name,region) if x)
    if country and country.casefold() not in {"united states","united states of america"}:
        label=", ".join(x for x in (label,country) if x)
    cur=row.get("current") or {}
    forecast=list(row.get("forecast") or [])
    today=forecast[0] if forecast else {}
    temp=cur.get("temperature_2m"); feels=cur.get("apparent_temperature")
    humidity=cur.get("relative_humidity_2m"); wind=cur.get("wind_speed_10m")
    condition=_weather_code_text(cur.get("weather_code"))
    bits=[]
    if temp is not None: bits.append(f"{float(temp):.1f}°F")
    if condition: bits.append(condition)
    if feels is not None and temp is not None and abs(float(feels)-float(temp)) >= 1.0:
        bits.append(f"feels like {float(feels):.1f}°F")
    current=" · ".join(bits) if bits else "Current conditions available"
    details=[]
    if today.get("high_f") is not None and today.get("low_f") is not None:
        details.append(f"today {float(today['high_f']):.1f}°/{float(today['low_f']):.1f}°")
    if today.get("precip_probability_pct") is not None:
        details.append(f"rain {float(today['precip_probability_pct']):.0f}%")
    if humidity is not None: details.append(f"humidity {float(humidity):.0f}%")
    if wind is not None: details.append(f"wind {float(wind):.1f} mph")
    suffix=("; " + ", ".join(details)) if details else ""
    return f"{label}: {current}{suffix}."

def _weather_verify_nws(tool_content):
    """Cross-check current conditions against the nearest NWS observation station.

    Verification is deliberately independent of the Open-Meteo forecast path.
    Failure here never invalidates the original receipt; it only means the
    independent check was unavailable.
    """
    import json
    row=_weather_payload(tool_content)
    if not row:
        return None
    place=row.get("location") or {}
    lat=place.get("latitude"); lon=place.get("longitude")
    if lat is None or lon is None:
        return None
    try:
        point=_http_json(f"https://api.weather.gov/points/{float(lat):.4f},{float(lon):.4f}")
        stations_url=((point.get("properties") or {}).get("observationStations") or "").strip()
        if not stations_url:
            return None
        stations=_http_json(stations_url)
        features=list(stations.get("features") or [])
        if not features:
            return None
        station_props=features[0].get("properties") or {}
        station_id=str(station_props.get("stationIdentifier") or "").strip()
        station_url=str(features[0].get("id") or "").rstrip("/")
        if not station_url:
            return None
        obs=_http_json(station_url+"/observations/latest")
        props=obs.get("properties") or {}
        def q(name):
            item=props.get(name) or {}
            return item.get("value")
        temp_c=q("temperature")
        humidity=q("relativeHumidity")
        wind_ms=q("windSpeed")
        temp_f=(float(temp_c)*9.0/5.0+32.0) if temp_c is not None else None
        wind_mph=(float(wind_ms)*2.2369362921) if wind_ms is not None else None
        payload={
            "edge":"WEATHER_VERIFY",
            "source":"National Weather Service",
            "confidence":"DIRECT",
            "as_of":props.get("timestamp"),
            "retrieved_at":time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "source_url":station_url+"/observations/latest",
            "station":station_id or station_props.get("name"),
            "temperature_f":round(temp_f,1) if temp_f is not None else None,
            "relative_humidity_pct":round(float(humidity),1) if humidity is not None else None,
            "wind_mph":round(wind_mph,1) if wind_mph is not None else None,
            "text_description":props.get("textDescription"),
        }
        return json.dumps(payload,ensure_ascii=False)
    except Exception:
        return None

def _weather_verification_answer(weather_content, verification_content):
    """Return a concise numeric comparison without asking a model to reconcile receipts."""
    import json
    primary=_weather_payload(weather_content)
    if not primary:
        return None
    try:
        verify=json.loads(str(verification_content)) if verification_content else None
    except Exception:
        verify=None
    current=primary.get("current") or {}
    ptemp=current.get("temperature_2m")
    phum=current.get("relative_humidity_2m")
    place=primary.get("location") or {}
    name=str(place.get("name") or "the selected location")
    if not isinstance(verify,dict):
        return f"Open-Meteo still reports {ptemp:.1f}°F for {name}. I couldn't obtain an independent NWS observation for this check." if ptemp is not None else "I couldn't obtain an independent NWS observation for this check."
    vtemp=verify.get("temperature_f")
    vhum=verify.get("relative_humidity_pct")
    bits=[]
    if ptemp is not None and vtemp is not None:
        bits.append(f"temperature: Open-Meteo {float(ptemp):.1f}°F; NWS {float(vtemp):.1f}°F (difference {abs(float(ptemp)-float(vtemp)):.1f}°F)")
    if phum is not None and vhum is not None:
        bits.append(f"humidity: Open-Meteo {float(phum):.0f}%; NWS {float(vhum):.0f}%")
    station=verify.get("station")
    suffix=f" at NWS station {station}" if station else " from the nearest NWS observation"
    if bits:
        return f"Independent check for {name}{suffix}: " + "; ".join(bits) + "."
    return f"I reached the NWS observation feed for {name}, but it did not provide comparable current values."

