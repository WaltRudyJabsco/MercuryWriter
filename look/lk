def _lo_media_direct_answer(tool_content,ok):
    text=str(tool_content or "")
    if ok and text.startswith("MEDIA PLAY OK"):
        parts=[x.strip() for x in text.split("·")]
        label=parts[2] if len(parts)>2 else "media"
        count=parts[3] if len(parts)>3 else ""
        return f"Playing {label}" + (f" · {count}" if count else "") + "."
    if ok and text.startswith("MEDIA QUEUE OK"):
        parts=[x.strip() for x in text.split("·")]
        label=parts[2] if len(parts)>2 else "media"
        count=parts[3] if len(parts)>3 else ""
        return f"Queued {label}" + (f" · {count}" if count else "") + "."
    if ok and text.startswith("MEDIA STATUS"):
        return text.replace("MEDIA STATUS · ","",1)+"."
    if ok and text.startswith("MEDIA CONTROL OK"):
        action=text.split("·",2)[1].strip() if "·" in text else "done"
        return action.capitalize()+"."
    if "MEDIA NOT FOUND" in text:
        query=text.split("·",1)[1].strip() if "·" in text else "that"
        return f"I couldn't find {query} in the current Fabric media catalog."
    if "MEDIA AMBIGUOUS" in text:
        return "I found multiple local media matches. Use `lk media find` to pick one, or give me a more specific artist, album, or title."
    return text or "Media action failed."


