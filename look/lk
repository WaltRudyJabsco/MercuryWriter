def _access_command(args):
    """Inspect and manage persistent LO filesystem grants."""
    if not args or args[0] in {"list","status"}:
        rules=_load_path_access()
        _title("LO FILE ACCESS","persistent grants")
        print(f"  default      current LO workspace")
        if not rules:
            print("  always       none")
        else:
            print("  ALWAYS")
            for rule in rules:
                caps="/".join(rule.get("capabilities",[])) or "none"
                print(f"    {rule['path']}  · {caps}")
        if _SESSION_PATH_GRANTS:
            print("  SESSION")
            for rule in _SESSION_PATH_GRANTS:
                print(f"    {rule['path']}  · {'/'.join(rule.get('capabilities',[]))}")
        print("\n  lk access add PATH [read|write]")
        print("  lk access remove PATH")
        print("  lk access personal")
        print("  lk access clear")
        return 0

    action=args[0]
    if action=="personal":
        rules=_load_path_access()
        for p in (HOME/"Desktop",HOME/"Documents",HOME/"Downloads"):
            if not p.exists(): continue
            canonical=str(p.resolve())
            existing=next((r for r in rules if str(Path(r["path"]).expanduser().resolve())==canonical),None)
            if existing:
                existing["capabilities"]=sorted(set(existing.get("capabilities",[]))|{"read","write"})
            else:
                rules.append({"path":canonical,"capabilities":["read","write"],"created_at":time.time()})
        _save_path_access(rules)
        print("LO access · Personal folders allowed · read/write")
        return 0

    if action=="add" and len(args)>=2:
        path=Path(args[1]).expanduser().resolve()
        capability=(args[2].casefold() if len(args)>=3 else "write")
        if capability not in {"read","write"}:
            print("usage: lk access add PATH [read|write]"); return 2
        caps=["read","write"] if capability=="write" else ["read"]
        rules=_load_path_access()
        existing=next((r for r in rules if str(Path(r["path"]).expanduser().resolve())==str(path)),None)
        if existing: existing["capabilities"]=sorted(set(existing.get("capabilities",[]))|set(caps))
        else: rules.append({"path":str(path),"capabilities":caps,"created_at":time.time()})
        _save_path_access(rules)
        print(f"LO access · always · {path} · {'/'.join(caps)}")
        return 0

    if action=="remove" and len(args)>=2:
        path=str(Path(args[1]).expanduser().resolve())
        rules=_load_path_access()
        kept=[r for r in rules if str(Path(r["path"]).expanduser().resolve())!=path]
        _save_path_access(kept)
        print(f"LO access · removed {len(rules)-len(kept)} grant(s) · {path}")
        return 0

    if action=="clear":
        _save_path_access([])
        _SESSION_PATH_GRANTS.clear(); _ONCE_PATH_GRANTS.clear()
        print("LO access · persistent and session grants cleared")
        return 0

    print("usage: lk access [list|personal|add PATH [read|write]|remove PATH|clear]")
    return 2


def _tool_open_url(url,intent="open"):
    """Open an explicit http(s) resource with the configured/default browser."""
    raw=str(url or "").strip()
    try:
        parsed=urllib.parse.urlparse(raw)
    except Exception:
        return "URL OPEN FAILED · invalid URL"
    if parsed.scheme not in {"http","https"} or not parsed.netloc:
        return "URL OPEN FAILED · only http/https URLs are allowed"
    if str(intent or "open").casefold() in {"play","watch"} and "youtu" in parsed.netloc.casefold():
        kind=_web_resource_type(raw)
        if kind!="video":
            return f"URL OPEN REFUSED · play/watch requires a YouTube video candidate, got {kind}"
    try:
        if sys.platform=="darwin":
            proc=subprocess.run(["open",raw],stdout=subprocess.DEVNULL,stderr=subprocess.PIPE,text=True,timeout=8)
        elif os.name=="nt":
            os.startfile(raw)  # type: ignore[attr-defined]
            return f"URL OPEN OK · {raw}"
        else:
            proc=subprocess.run(["xdg-open",raw],stdout=subprocess.DEVNULL,stderr=subprocess.PIPE,text=True,timeout=8)
        if proc.returncode==0:
            return f"URL OPEN OK · {raw}"
        return f"URL OPEN FAILED · {proc.stderr.strip() or 'launcher returned nonzero'}"
    except (OSError,subprocess.SubprocessError) as exc:
        return f"URL OPEN FAILED · {exc}"

