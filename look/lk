                          "c":max(1,min(100,int(item.get("c",item.get("confidence",70)) or 70))),
                          "u":max(1,int(item.get("u",item.get("uses",1)) or 1)),
                          "t":float(item.get("t",item.get("updated_at",time.time())) or time.time())})
        atoms=atoms[-MEMORY_ATOM_LIMIT:]
        previous_summary=_sanitize_summary(data.get("summary",""))
        legacy_summary=_sanitize_summary(data.get("legacy_summary",""))
        if source_schema<MEMORY_SCHEMA_VERSION and previous_summary:
            legacy_summary=previous_summary
            previous_summary=""
            domain_summaries={}
        result={"schema_version":MEMORY_SCHEMA_VERSION,
                "summary":previous_summary,
                "legacy_summary":legacy_summary,
                "core_summary":_sanitize_summary(data.get("core_summary",""))[:1200] if source_schema>=MEMORY_SCHEMA_VERSION else "",
                "domain_summaries":domain_summaries,
                "durable":durable,
                "memories":cleaned[:MEMORY_CANDIDATE_LIMIT],
                "atoms":atoms,
                "maintenance_cycles":max(0,int(data.get("maintenance_cycles",0) or 0)),
                "last_decay_at":float(data.get("last_decay_at",time.time()) or time.time()),
                "last_evidence_at":float(data.get("last_evidence_at",0) or 0),
                "last_maintenance_at":float(data.get("last_maintenance_at",0) or 0),
                "last_consolidated_at":float(data.get("last_consolidated_at",0) or 0),
                "last_change":str(data.get("last_change", ""))[:80],
