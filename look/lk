def _safe_cwd(repair=True):
    """Return a live working directory even if the shell's current directory was deleted."""
    try:
        return Path.cwd()
    except FileNotFoundError:
        pass

    raw=os.environ.get("PWD","").strip()
    candidate=Path(raw).expanduser() if raw else HOME
    # A deleted child can usually recover to its nearest surviving ancestor.
    while not candidate.exists() and candidate != candidate.parent:
        candidate=candidate.parent
    if not candidate.is_dir():
        candidate=HOME
    if repair:
        try:
            os.chdir(candidate)
        except OSError:
            candidate=HOME
            try: os.chdir(candidate)
            except OSError: pass
    return candidate.resolve() if candidate.exists() else HOME


