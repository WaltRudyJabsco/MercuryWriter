def _ollama_tags(base, timeout=2):
    import json, urllib.request
    with urllib.request.urlopen(base+"/api/tags", timeout=timeout) as response:
        return json.load(response).get("models", [])


def _ollama_post(base, endpoint, payload, timeout=120):
    import json, urllib.request
    data=json.dumps(payload).encode("utf-8")
    request=urllib.request.Request(
        base+endpoint, data=data,
        headers={"Content-Type":"application/json"}, method="POST"
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.load(response)


def _ollama_capabilities(base, model):
    """Return Ollama-declared capabilities, or None when this server cannot report them."""
    try:
        shown=_ollama_post(base, "/api/show", {"model":model}, timeout=8)
    except Exception:
        return None
    caps=shown.get("capabilities")
    if not isinstance(caps, list):
        return None
    return [str(cap).strip().lower() for cap in caps if str(cap).strip()]



VISION_EXTENSIONS={".png",".jpg",".jpeg",".webp",".gif",".bmp"}


def _resolve_image_path(token,workspace):
    raw=str(token or "").strip().strip("'\\\"")
    if not raw:
        return None
    path=Path(os.path.expandvars(raw)).expanduser()
    if not path.is_absolute():
        path=Path(workspace)/path
    try:
        path=path.resolve()
    except OSError:
        return None
    if path.exists() and path.is_file() and path.suffix.casefold() in VISION_EXTENSIONS:
        return path
    return None


def _extract_prompt_images(prompt,workspace):
    '''Find explicit local image paths in natural-language prompts without guessing filenames.'''
    text=str(prompt or "")
    candidates=[]
    quoted_re = re.compile(r"[\"']([^\"']+\.(?:png|jpe?g|webp|gif|bmp))[\"']", re.I)
    plain_re = re.compile(r"(?:^|\s)(~?\.?/?[^\s\"'`]+\.(?:png|jpe?g|webp|gif|bmp))(?=\s|$|[,.!?])", re.I)
    candidates.extend(m.group(1) for m in quoted_re.finditer(text))
    candidates.extend(m.group(1) for m in plain_re.finditer(text))
    out=[]
    seen=set()
    for candidate in candidates:
        path=_resolve_image_path(candidate,workspace)
        if path and str(path) not in seen:
            seen.add(str(path))
            out.append(path)
    return out[:8]


def _encode_ollama_images(paths):
    import base64
    encoded=[]
    for path in paths:
        try:
            encoded.append(base64.b64encode(Path(path).read_bytes()).decode("ascii"))
        except OSError:
            continue
    return encoded


def _vision_model_answer(image_bytes, question, label="screen"):
