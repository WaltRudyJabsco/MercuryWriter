def _open_file(path, choose=False):
    try:
        if platform.system()=="Darwin":
            if choose:
                # `open -a` needs an app name; keep LOOK's card simple and use
                # the default app here. The filesystem browser still provides
                # the richer O/open-with chooser.
                return subprocess.call(["open",str(path)])
            return subprocess.call(["open",str(path)])
