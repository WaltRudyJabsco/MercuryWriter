def _linux_window_id(ref):
    token=str((ref or {}).get("window_token") or "").strip()
    wmctrl=shutil.which("wmctrl")
    if not token or not wmctrl: return ""
    try:
        proc=subprocess.run([wmctrl,"-lx"],capture_output=True,text=True,timeout=3)
    except (OSError,subprocess.SubprocessError): return ""
    for line in (proc.stdout or "").splitlines():
        if token in line:
            return line.split(None,1)[0]
    return ""


def _window_action_typed_referent(ref,action):
    """Perform a curated action on one typed terminal-window referent."""
    ref=dict(ref or {}); action=str(action or "").casefold()
    if ref.get("kind")!="terminal_window": return f"Window {action} failed: unsupported referent type"
    curator=_capability_curator_module(); adapters=curator.adapters_for("terminal_window",action)
    platform_name=str(ref.get("platform") or "")

    if platform_name=="darwin":
        wid=str(ref.get("os_window_id") or "").strip()
        if not wid.isdigit(): return f"Window {action} failed: terminal window handle is unavailable"
        osa=shutil.which("osascript") or ("osascript" if action=="close" else "")
        if not osa: return f"Window {action} failed: osascript is unavailable"
        if action=="close": script='tell application "Terminal" to close (first window whose id is '+wid+')'
        elif action=="focus": script='tell application \"Terminal\" to activate\ntell application \"Terminal\" to set index of (first window whose id is '+wid+') to 1'
        elif action=="maximize": script='tell application \"Finder\" to set screenBounds to bounds of window of desktop\ntell application \"Terminal\" to set bounds of (first window whose id is '+wid+') to screenBounds\ntell application \"Terminal\" to activate'
        elif action=="fullscreen": script='tell application \"Terminal\" to activate\ntell application \"Terminal\" to set index of (first window whose id is '+wid+') to 1\ntell application \"System Events\" to keystroke \"f\" using {control down, command down}'
        else: return f"Window {action} failed: no macOS adapter"
        proc=subprocess.run([osa,"-e",script],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=8)
        ok=proc.returncode==0
        if adapters: curator.record_result(adapters[0]["id"],action,ok)
        if not ok: return f"Window {action} failed: {(proc.stdout or '').strip() or 'Terminal rejected the action'}"
        return ("close ok · terminal window closed" if action=="close" else f"window {action} ok · terminal window {action}d")

    if platform_name=="linux":
        # Prefer semantic window-manager control when available; close retains a
        # process-handle fallback so Wayland machines do not lose 7.0.5 behavior.
        wid=_linux_window_id(ref)
        wmctrl=shutil.which("wmctrl")
        if wid and wmctrl and action in {"close","focus","maximize","fullscreen"}:
            if action=="close": argv=[wmctrl,"-ic",wid]
            elif action=="focus": argv=[wmctrl,"-ia",wid]
            elif action=="maximize": argv=[wmctrl,"-ir",wid,"-b","add,maximized_vert,maximized_horz"]
            else: argv=[wmctrl,"-ir",wid,"-b","add,fullscreen"]
            proc=subprocess.run(argv,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=5)
            ok=proc.returncode==0
            for adapter in adapters:
                if adapter.get("id")=="linux-wmctrl": curator.record_result("linux-wmctrl",action,ok); break
            if ok: return ("close ok · terminal window closed" if action=="close" else f"window {action} ok · terminal window {action}d")
        if action=="minimize" and wid and shutil.which("xdotool"):
            proc=subprocess.run([shutil.which("xdotool"),"windowminimize",wid],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=5)
            ok=proc.returncode==0; curator.record_result("linux-xdotool",action,ok)
            if ok: return "window minimize ok · terminal window minimized"
        control_fifo=Path(str(ref.get("control_fifo") or "")) if ref.get("control_fifo") else None
        if action in {"focus","maximize","minimize","fullscreen"} and control_fifo is not None and control_fifo.exists():
            try:
                # O_NONBLOCK avoids hanging forever if the terminal-side controller died.
                fd=os.open(control_fifo,os.O_WRONLY|os.O_NONBLOCK)
                try: os.write(fd,(action+"\n").encode())
                finally: os.close(fd)
                return f"window {action} dispatch ok · terminal control channel"
            except OSError as exc:
                pass
        if action!="close":
            why="no compatible discovered window adapter"
            return f"Window {action} failed: {why}"
        pid=0
        try:
            pid_file=Path(str(ref.get("pid_file") or ""))
            if pid_file.exists(): pid=int(pid_file.read_text().strip())
        except (OSError,ValueError): pid=0
        if pid<=1:
            try: pid=int(ref.get("launcher_pid") or 0)
            except (TypeError,ValueError): pid=0
        if pid<=1: return "Window close failed: terminal process handle is unavailable"
        try: os.kill(pid,signal.SIGTERM)
        except ProcessLookupError: return "Window close failed: terminal window is no longer running"
        except OSError as exc: return f"Window close failed: {exc}"
        curator.record_result("linux-process-handle","close",True)
        return "close ok · terminal window closed"
    return f"Window {action} failed: unsupported platform {platform_name or 'unknown'}"


def _close_typed_referent(ref):
    return _window_action_typed_referent(ref,"close")

def _run_command_tool(workspace,args,profile):
    command=str(args.get("command","")).strip()
    if _looks_like_shell_file_discovery(command):
        return "Command blocked: use search_files for filesystem discovery."
    if not command:
        return "Command tool failed: empty command"

    # Purpose-built locator owns filesystem discovery. Refuse expensive shell
    # fallbacks so the model cannot regress to find/mdfind/fd after a miss.
    first=re.split(r"\s+",command,maxsplit=1)[0]
    base=Path(first).name.casefold()
    if base in {"find","mdfind","fd","fdfind","locate","plocate"}:
        return "Command denied · filesystem discovery must use search_files; do not fall back to shell search"

    cwd_raw=str(args.get("cwd","") or "").strip()
    cwd=Path(cwd_raw).expanduser() if cwd_raw else workspace
    if not cwd.is_absolute():
        cwd=(workspace/cwd).resolve()
    try:
        cwd=cwd.resolve()
    except OSError:
        return f"Command tool failed: invalid cwd: {cwd}"
    if not cwd.exists() or not cwd.is_dir():
        return f"Command tool failed: cwd is not a directory: {cwd}"

    try:
        timeout=max(1,min(60,int(args.get("timeout",20) or 20)))
    except (TypeError,ValueError):
        timeout=20

    if profile=="power":
        grant_key=_command_grant_key(command)
        trusted=_power_command_risk(command)=="ordinary" or grant_key in _SESSION_COMMAND_GRANTS
        if not trusted and not _confirm_command(command):
            return "Command denied by user."
    shell=shutil.which("zsh")
    if not shell:
        return "Command tool failed: zsh is not available on PATH"

    new_terminal=bool(args.get("new_terminal",False))
    if new_terminal:
        return _launch_command_new_terminal(command,cwd,shell,args)

    interactive=bool(args.get("interactive",False))
    if interactive:
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            return "Command tool failed: interactive terminal requested without a TTY"
        try:
            proc=subprocess.run([shell,"-lc",command],cwd=str(cwd))
            if proc.returncode in {130,-signal.SIGINT}:
                return "interactive exit 130 · launched; terminal session interrupted by user"
            return f"interactive exit {proc.returncode} · terminal session {'completed' if proc.returncode==0 else 'ended'}"
        except KeyboardInterrupt:
            return "interactive exit 130 · launched; terminal session interrupted by user"
        except OSError as exc:
            return f"Command tool failed: {exc}"

    try:
        proc=subprocess.run(
            [shell,"-lc",command],
            cwd=str(cwd),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=timeout,
        )
        output=(proc.stdout or "").strip()
        if len(output)>16000:
            output="[output truncated to final 16000 characters]\n"+output[-16000:]
        if proc.returncode==0 and not output:
            return "exit 0 · NO TASK PROGRESS · command produced no output; continue with another strategy"
        return f"exit {proc.returncode}" + (f"\n{output}" if output else "")
    except subprocess.TimeoutExpired as exc:
        partial=exc.stdout or ""
        if isinstance(partial,bytes):
            partial=partial.decode(errors="replace")
        partial=partial.strip()
        return f"Command timed out after {timeout}s" + (f"\n{partial[-8000:]}" if partial else "")
    except OSError as exc:
        return f"Command tool failed: {exc}"

