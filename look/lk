                events.emit("request_done",status=("ok" if ok else "failed"),rounds=0,tool_calls=1,prompt_tokens=0,output_tokens=0,load_ms=0)
            if one_shot: return 0
            continue

        turn_id -= 1

        # Shared host routing runs before any surface or model gets to improvise.
        # This is the same gate for terminal LOOK, Signal, and Albert.
        turn_route=_lo_cognition_route(prompt,use_openjev=True)
        if weather_forced_location:
            turn_route=_lo_cognition_route("weather",use_openjev=True)
        turn_intent="web_current" if turn_route.primary=="web" else turn_route.primary
        turn_force_search=bool(force_search or turn_intent=="web_current")
        turn_goal=_lo_goal(prompt,turn_route)
        if turn_goal:
            try: _world_state().begin_goal(turn_goal)
            except Exception: pass
        if events:
            events.emit("intent_routed",family=turn_intent,families=list(turn_route.families),confidence=turn_route.confidence,margin=turn_route.margin,source=turn_route.source,forced_search=turn_force_search)
            if turn_goal:
                events.emit("goal_started",**turn_goal.public())
                events.emit("plan_created",goal_id=turn_goal.id,steps=list(turn_goal.steps))

        # An explicit `lk ...` line is an operator command, not language for the model.
        # Execute it argv-safe with the current TTY so interactive LOOK surfaces work
        # inside LO without consuming inference or Fabric model authorization.
        if prompt == "lk" or prompt.startswith("lk "):
            try:
                argv=shlex.split(prompt)[1:]
                if argv and argv[0] != "lo":
                    exe=shutil.which("lk") or str(Path(__file__).resolve())
                    subprocess.run([exe,*argv])
                elif argv:
                    print("LO · nested `lk lo` is disabled")
                else:
                    print("LO · give lk a command")
            except (ValueError,OSError) as exc:
                print(f"LO · lk command failed: {exc}")
            continue

        # Hard turn boundary: handles/conversation persist; retry/evidence authority does not.
        turn_id += 1
        turn_document_reanchors = 0
        turn_tool_retry = False
        turn_evidence = []
        turn_proposed_action = None
        turn_successful_tools=set()

        # Terminal drag/drop becomes first-class resource context. Finder and most Linux
        # terminals paste escaped/quoted paths into the input line; normalize them here.
        clean_prompt,dropped_refs=_extract_prompt_resources(prompt,workspace)
        if dropped_refs:
            # A fresh explicit drop/path is stronger than stale conversational resources.
            # Multiple paths supplied in this turn remain one active resource set.
            resource_refs=_resource_refs([r.path for r in dropped_refs],"explicit")
            resource_archive=_promote_resource(resource_refs,resource_archive,turn_id)
            # Explicit resources define the current task. Cross-session prose is historical
            # and must not contaminate resource evidence (e.g. an old vision description).
            messages[recent_context_index]["content"]=""
            fresh_image_paths.update(str(p) for p in _resource_image_paths(resource_refs))
            selected_paths=[r.path for r in resource_refs]
            names=" · ".join(r.name+("/" if r.kind=="directory" else "") for r in resource_refs[:6])
            extra=f" · +{len(resource_refs)-6}" if len(resource_refs)>6 else ""
            print(_c(f"  context +{len(resource_refs)} · {names}{extra}","2"))
            messages[resource_message_index]["content"]=_active_resource_message(resource_refs)
            prompt=clean_prompt or "Work with these explicitly supplied resources."

        # Pronoun + explicit browser action is deterministic discourse state, not an LLM search task.
        _has_pronoun,_browser_intent=_resource_referent_intent(prompt)
        if _has_pronoun and _browser_intent:
            # "that HTML file" beats pure recency; known compatible resources beat search.
            referent=_resolve_known_resource(prompt,resource_refs,resource_archive)
            if referent:
                result=_browser_open_resource(referent,workspace,profile)
                if result is not None:
                    tool_content,ok,_elapsed=result
                    if ok:
                        referent.last_referenced_turn=turn_id
                        resource_refs=[referent]
                        resource_archive=_promote_resource(resource_refs,resource_archive,turn_id)
                        last_action={"tool":"open_path","args":{"path":str(referent.path),"intent":"browser"},"path":str(referent.path)}
                        print("\n"+_lo_label("lo","35")+"\n"+_ollama_markup(f"Sent {referent.name} to the browser.")+"\n")
                    else:
                        print("\\n"+_lo_label("lo","35")+"\\n"+_ollama_markup(str(tool_content))+"\\n")
                    continue

        _ai_foreground(True,"lo")
        # Memory can change asynchronously between turns. Reload cheaply from
        # disk, then retrieve only what is relevant to this exact prompt.
        memory=_load_memory()
        messages[memory_message_index]["content"]=_memory_context(memory,prompt)
        messages[brain_context_index]["content"]=_brain_context()
        messages=[m for i,m in enumerate(messages) if i < base_message_count or not (m.get("role")=="system" and str(m.get("content","")).startswith(("RESOURCE CONTEXT GOVERNOR:","TYPED WORLD STATE (","LIVE STATE (")))]
        world_context=_world_context()
        if world_context:
            messages.append({"role":"system","content":world_context})
        live_context=_live_state_context(prompt)
        if live_context:
            messages.append({"role":"system","content":live_context})
        messages=_trim_lo_history(messages, base_message_count)
        # Resource context is governed before inference: handles stay cheap; evidence is sliced.
        _resource_tier,_resource_budget=_lo_budget_for(prompt,thinking_mode,selected_paths)
        messages[resource_message_index]["content"]=_active_resource_message(resource_refs)
        governor=_resource_governor_message(resource_refs,_resource_budget)
        if governor:
            messages.append({"role":"system","content":governor})
        # Bind active explicit resources in the latest user turn as well as the system slot.
        # Small local models respond much more reliably when referents are adjacent to intent.
        user_message={"role":"user","content":_resource_bound_prompt(prompt,resource_refs)}
        # Images may have been stripped from prompt text into ResourceRef before this point.
        # Vision therefore consumes the authoritative resource set first, plus any residual path text.
        # ResourceRef persistence is cheap; vision payload persistence is not. Attach
        # new images once, then rehydrate pixels only when the language asks for
        # visual evidence again. Comparisons may revive recent archived images.
        active_images=_resource_image_paths(resource_refs)
        visual_needed,visual_compare=_resource_visual_intent(prompt)
        image_paths=[]
        for p in active_images:
            if str(p) in fresh_image_paths or str(p) not in observed_image_paths:
                image_paths.append(p)
        if not image_paths and visual_needed:
            candidates=_resource_image_paths(resource_archive) if visual_compare else active_images
            if not candidates and resource_archive:
                candidates=_resource_image_paths(resource_archive)[-1:]
            image_paths=list(candidates[-8:] if visual_compare else candidates[:1])
        for p in _extract_prompt_images(prompt,workspace):
            if p not in image_paths and len(image_paths)<8: image_paths.append(p)
        turn_image_paths=list(image_paths)
        if image_paths and supports_vision:
            encoded=_encode_ollama_images(image_paths)
            if encoded:
                user_message["images"]=encoded
                label="rechecking" if all(str(p) in observed_image_paths for p in image_paths) else "attached"
                names=" · ".join(Path(p).name for p in image_paths[:2])
                detail=f" · {names}" if label=="rechecking" else ""
                print(f"{_ansi_label('vision ›','35')} {len(encoded)} image{'s' if len(encoded)!=1 else ''} {label}{detail}")
        elif image_paths and not supports_vision:
            print(f"{_ansi_label('vision ›','33')} {len(image_paths)} image resource{'s' if len(image_paths)!=1 else ''} · selected model does not advertise vision")
        if _lo_explicit_web_scope(prompt):
            messages.append({"role":"system","content":(
                "RESOURCE SCOPE: the operator explicitly requested an online/web resource. "
                "Use web_search (or a canonical information tool) rather than local file discovery. "
                "If they ask to open/play/watch a discovered result, follow discovery with open_url using an exact returned URL. "
                "For play/watch intent, select resource_type=video; do not satisfy play/watch by opening a channel, profile, playlist, or search page. "
                "If no credible video candidate exists, present the result or ask rather than opening the wrong resource. "
                "Do not claim browser launch without URL OPEN OK."
            )})
        else:
            messages.append({"role":"system","content":(
                "RESOURCE SCOPE: unqualified open/play/find requests default to the operator's local world. "
                "For music or media, use media_search/media_play/media_queue/media_control against the Fabric catalog before any web search or filesystem guessing. "
                "Do not silently escalate a local miss to the public web; ask or wait for explicit online intent."
            )})
        latest_ref=_latest_resource(resource_refs,resource_archive)
        if latest_ref:
            messages.append({"role":"system","content":(
                "EPHEMERAL CURRENT REFERENT (session only): the most recently supplied/discussed resource is "
                f"{latest_ref.path}. Resolve ordinary it/this/that against KNOWN SESSION RESOURCES first. "
                "Honor explicit type constraints such as 'that HTML file' before pure recency. A compatible known resource "
                "outranks filesystem search. Search only when no known resource satisfies the request. "
                "BOUNDED INITIATIVE: prefer cheap deterministic attempts. Filesystem discovery MUST use search_files; never use run_command with ls/find/fd/locate/mdfind/tree to discover files. If uncertainty is not decreasing, candidates are broad, "
                "or another speculative step is unlikely to help, ask the user for one small useful clue instead of grinding. "
                "Fail quickly and truthfully rather than making the user wait for uncertain work. "
                "This is discourse state, not durable memory."
            )})
        elif last_action:
            messages.append({"role":"system","content":(
                "EPHEMERAL CURRENT REFERENT (session only): last successful actionable item: "
                f"{last_action['path']} via {last_action['tool']}. Resolve it/that/the same one against this "
                "referent when context fits. Do not search merely to rediscover this exact item."
            )})
        # Time is an observed host fact, not language-model knowledge. Refresh it on
        # every turn and keep exactly one current temporal receipt in context.
        messages=[m for m in messages if not (m.get("role")=="system" and str(m.get("content","")).startswith("TRUSTED TEMPORAL CONTEXT\n"))]
        messages.append({"role":"system","content":_temporal_context()})
        if last_authoritative_receipt:
            messages.append({"role":"system","content":(
                "LATEST AUTHORITATIVE HOST RECEIPT (session evidence; quote it rather than speculate when the operator asks what happened):\n"
                f"tool={last_authoritative_receipt.get('tool')}\n{last_authoritative_receipt.get('result','')}"
            )})
        messages.append(user_message)

        # LOOK Games are a tiny deterministic capability family. Resolve them
        # before inference so "gtnw" can never become a filesystem or web search.
        game_intent=None if turn_force_search else _lo_game_intent(prompt)
        if game_intent:
            game_name=game_intent["tool"]; game_args=game_intent["args"]
            if events: events.emit("tool_start",tool=game_name,mode="preflight")
            game_content,game_ok,_game_elapsed=_tool_transaction(
                game_name,game_args,lambda: _run_capability_tool(game_name,game_args,workspace,profile))
            answer=_lo_game_direct_answer(game_content,game_ok)
            print("\n"+_lo_label("lo","35")+"\n"+_ollama_markup(answer)+"\n")
            messages.append({"role":"assistant","content":answer})
            if game_ok: turn_successful_tools.add(game_name)
            if events:
                events.emit("tool_done",tool=game_name,mode="preflight",elapsed_tool_ms=_game_elapsed,status=("ok" if game_ok else "failed"))
                events.emit("response",text=answer)
                if turn_goal:
                    assessment=_cognition_module().assess(turn_goal,successful_tools=list(turn_successful_tools),final_text=answer)
                    events.emit("goal_verified",goal_id=turn_goal.id,**assessment)
                events.emit("request_done",status=("ok" if game_ok else "error"),rounds=0,tool_calls=1,prompt_tokens=0,output_tokens=0,load_ms=0)
            _ai_foreground(False,"lo")
            if one_shot: return 0 if game_ok else 1
            continue

        # Narrow local-media commands are deterministic capability requests, not
        # general web/search questions. Resolve them before inference so a model
        # cannot turn "play Talking Heads" into an internet search.
        media_intent=None if turn_force_search else _lo_media_intent_profile(prompt,profile)
        if media_intent and media_intent.get("pending_decision"):
            d=media_intent.get("pending_decision") or {}
            answer=f"I need a quick media choice. Decision {d.get('id','?')} is pending in Fabric; answer it here, Signal, or another trusted surface."
            print("\n"+_lo_label("lo","35")+"\n"+_ollama_markup(answer)+"\n")
            messages.append({"role":"assistant","content":answer})
            if events:
                events.emit("request_done",status="needs_input",rounds=0,tool_calls=0,prompt_tokens=0,output_tokens=0,load_ms=0)
            _ai_foreground(False,"lo")
            if one_shot: return 0
            continue
        if media_intent:
            media_name=media_intent["tool"]
            media_args=media_intent["args"]
            detail=str(media_args.get("query") or media_args.get("action") or "media")
            print(f"{_lo_label('media','35')}  {detail}")
            with _activity("media"):
                media_content,media_ok,_media_elapsed=_tool_transaction(
                    media_name,media_args,
                    lambda: _run_capability_tool(media_name,media_args,workspace,profile),
                )
            _lo_receipt("result",str(media_content).splitlines()[0],ok=media_ok,color="33")
            answer=_lo_media_direct_answer(media_content,media_ok)
            print("\n"+_lo_label("lo","35")+"\n"+_ollama_markup(answer)+"\n")
            messages.append({"role":"assistant","content":answer})
            if media_ok:
                turn_successful_tools.add(media_name)
                last_authoritative_receipt={"tool":media_name,"result":str(media_content)[:1200],"time":time.time()}
                if continuation_of:
                    # Successful clarification teaches a compact resolver relationship.
                    old=str(continuation_of.get("query") or "").strip()
                    new=str(media_args.get("query") or "").strip()
                    if old and new:
                        memory=_merge_machine_atoms(memory,[{"k":"resolver","s":old,"r":"resolves_to","v":new,"c":92,"u":1}])
                        _save_memory(memory)
                pending_media_clarification=None
            elif "MEDIA AMBIGUOUS" in str(media_content):
                pending_media_clarification={"query":str(media_args.get("query") or detail),"time":time.time()}
            else:
                pending_media_clarification=None
            if events:
                events.emit("tool_done",tool=media_name,mode="preflight",elapsed_tool_ms=_media_elapsed,status=("ok" if media_ok else "failed"))
                events.emit("response",text=answer)
                if turn_goal:
                    assessment=_cognition_module().assess(turn_goal,successful_tools=list(turn_successful_tools),final_text=answer)
                    events.emit("goal_verified",goal_id=turn_goal.id,**assessment)
                events.emit("request_done",status=("ok" if media_ok else "needs_input"),rounds=0,tool_calls=1,prompt_tokens=0,output_tokens=0,load_ms=0)
            _ai_foreground(False,"lo")
            if one_shot:
                return 0 if media_ok else 1
            continue

        # Search mode is deliberately deterministic: search first, then answer.
        if turn_force_search:
            if not has_web:
                _ai_foreground(False,"lo")
                print("search › OLLAMA_API_KEY is not set\n")
                messages.pop()
                continue
            try:
                print(f"{_ansi_label('search ›', '33')} {prompt}")
                with _activity("searching"):
                    result = _search_web(prompt)
                messages.append({
                    "role": "system",
                    "content": "Current web search results for the user's latest question:\n" + _typed_search_text(result) +
                               "\nUse these results when answering. When citing or recommending any result, preserve the exact URL from the result and emit a complete Markdown link in the form [descriptive label](https://actual-url). Never emit [source], [1], or a site name as a pseudo-link without an actual URL, and never invent a URL.",
                })
            except KeyboardInterrupt:
                _ai_foreground(False,"lo")
                print("\n· cancelled\n")
                messages.pop()
                continue
            except Exception as exc:
                _ai_foreground(False,"lo")
                if events:
                    events.emit("error", stage="search", error=str(exc), error_type=type(exc).__name__)
                    events.emit("request_done", status="error", rounds=0, tool_calls=1,
                                prompt_tokens=0, output_tokens=0, load_ms=0)
                print(f"search › {exc}\n")
                messages.pop()
                # Machine callers must get a real failed turn here. Falling back to
                # input() made Albert report the entire cognition plane as offline.
                if one_shot:
                    return 1
                continue

        # Normal mode exposes tools to the model, but explicit mutations are also
        # enforced by the host so prose can never masquerade as execution.
        mutation_required=(profile!="conservative" and _lo_requires_filesystem_action(prompt))
        external_action_required=(profile!="conservative" and _lo_requires_external_action(prompt))
        speech_required=(profile!="conservative" and _lo_requires_speech(prompt))
        # Weather discourse state is derived only from user/assistant turns, never
        # from the many transient system messages LOOK adds around each request.
        weather_discourse=[m for m in messages if str(m.get("role") or "").lower() in {"user","assistant"}][-16:]
        weather_explicit=_lo_requires_weather(prompt)
        weather_followup=_lo_weather_followup(prompt, weather_discourse)
        weather_required=bool(weather_forced_location or weather_explicit or weather_followup)
        weather_verify=_lo_weather_verification_requested(prompt) if weather_required else False
        weather_succeeded=False
        weather_repair_sent=False
        weather_prefetched=False
        external_action_attempted=False
        external_action_succeeded=False
        last_external_result=""
        action_repair_sent=False
        mutation_attempted=False
        mutation_succeeded=False
        last_mutation_result=""
        mutation_repair_sent=False
        speech_repair_sent=False
        memory_write_receipt=False
        tool_refusal_repair_sent=False
        host_repair_final=False

        # Resolve WEATHER location before inference. Explicit wording wins, then
        # ephemeral conversation history, then an operator-owned default. The
        # host never asks the language model to invent the user's location.
        weather_location=None
        weather_location_source=None
        if weather_required:
            weather_location=weather_forced_location or _lo_weather_location(prompt)
            weather_location_source="working" if weather_forced_location else ("explicit" if weather_location else None)
            if not weather_location and weather_followup:
                weather_location=_lo_weather_followup_location(prompt, weather_discourse)
                weather_location_source="followup" if weather_location else None
            if not weather_location:
                weather_location=_lo_weather_history_location(weather_discourse)
                weather_location_source="session" if weather_location else None
            # A learned home is the operator-owned default for an otherwise
            # locationless weather request. Do not ask again once they taught us.
            if not weather_location:
                weather_location=_lo_learned_home_location(_load_memory())
                weather_location_source="learned_home" if weather_location else None
            if not weather_location:
                weather_location=_lo_weather_default_location()
                weather_location_source="configured" if weather_location else None
            if weather_location and events:
                events.emit("weather_location", location=weather_location, source=weather_location_source)

        # An unresolved location is not a provider failure. Ask one small useful
        # question instead of running a doomed model/tool round and later claiming
        # that WEATHER itself failed.
        if weather_required and not weather_location:
            pending_weather_clarification=True
            pending_home_definition=False
            _brain_set_pending("slot",goal="weather",slot="weather.location",resume="weather.current",request=prompt)
            answer="Which location should I use for the weather?"
            print("\n"+_lo_label("lo","35")+"\n"+_ollama_markup(answer)+"\n")
            if events:
                events.emit("weather_location_required")
                events.emit("response", text=answer)
                events.emit("request_done", status="needs_input", rounds=0, tool_calls=0,
                            prompt_tokens=0, output_tokens=0, load_ms=0)
            _ai_foreground(False,"lo")
            if one_shot:
                return 0
            continue

        if weather_location:
            tool_started=time.monotonic()
            if events: events.emit("tool_start", tool="weather", mode="preflight")
            print(f"{_ansi_label('weather ›', '36')} {weather_location}")
            weather_content=""
            # WEATHER is a read-only/idempotent edge. One bounded retry makes a
            # transient network/provider hiccup invisible without risking a
            # duplicate mutation. Mutating capabilities must never inherit this.
            for weather_attempt in range(2):
                try:
                    with _activity("weather" if weather_attempt == 0 else "weather retry"):
                        weather_content=_weather_lookup(weather_location)
                    weather_succeeded=not str(weather_content).startswith(("Weather lookup failed:","No weather location match"))
                except Exception as exc:
                    weather_content=f"Weather lookup failed: {exc}"
                    weather_succeeded=False
                if weather_succeeded or str(weather_content).startswith("No weather location match"):
                    break
                if weather_attempt == 0:
                    if events: events.emit("tool_retry", tool="weather", mode="preflight", reason="transient_read_failure", attempt=2)
                    time.sleep(.18)
            if weather_succeeded:
                pending_weather_clarification=False
                pending_home_definition=False
                if pending_home_candidate:
                    memory=_load_memory()
                    memory=_lo_store_home_location(memory,pending_home_candidate); _save_memory(memory)
                    _mirror_machine_atoms_to_fabric([{"k":"preference","s":"home","r":"weather_location","v":pending_home_candidate,"c":100,"u":1}])
                _brain_clear_pending("weather",outcome=f"weather receipt for {weather_location}")
                weather_prefetched=True
                receipt=_info_receipt("weather",weather_content)
                if receipt:
                    _show_info_receipt(receipt)
                    if events: events.emit("source_receipt", **receipt)
                messages.append({"role":"system","content":(
                    "LIVE WEATHER RECEIPT FOR THIS TURN\n" + weather_content +
                    "\nUse this canonical WEATHER result to answer the user's latest question. "
                    "Do not call weather again unless the receipt is unusable."
                )})
            if not weather_succeeded:
                pending_weather_clarification=False
                pending_home_definition=False
                _brain_clear_pending("weather",outcome=f"weather failed for {weather_location}",status="failed")
                # A failed live edge is an operational fact, not merely missing
                # evidence. Surface the reason so networking/provider failures
                # can be diagnosed from the same terminal that observed them.
                weather_failure_detail=str(weather_content or "unknown WEATHER failure").strip()
                print(f"{_ansi_label('weather !', '31')} {weather_failure_detail}")
                if events: events.emit("tool_error", tool="weather", mode="preflight", error=weather_failure_detail)
            if events:
                events.emit("tool_done", tool="weather", mode="preflight",
                            elapsed_tool_ms=int((time.monotonic()-tool_started)*1000),
                            status=("ok" if weather_succeeded else "failed"))

        # Scalar follow-ups are receipt reads, not language-model arithmetic. This
        # prevents numbers from adjacent weather turns being silently recombined.
        direct_weather_answer=None
        if weather_succeeded:
            if weather_verify:
                verification_content=_weather_verify_nws(weather_content)
                if events:
                    events.emit("weather_verify", source="National Weather Service",
                                status=("ok" if verification_content else "unavailable"))
                direct_weather_answer=_weather_verification_answer(weather_content,verification_content)
                if verification_content:
                    try:
                        verification_receipt=json.loads(verification_content)
                    except Exception:
                        verification_receipt=None
                    if isinstance(verification_receipt,dict):
                        _show_info_receipt(verification_receipt)
                        if events:
                            events.emit("source_receipt", **{k:verification_receipt.get(k) for k in ("edge","source","confidence","as_of","retrieved_at","source_url") if verification_receipt.get(k) is not None})
            if direct_weather_answer is None:
                direct_weather_answer=_weather_direct_followup(prompt,weather_content)
            if direct_weather_answer is None and (weather_forced_location or re.search(r"\b(?:weather|temperature|my weather)\b",str(prompt),re.I)):
                direct_weather_answer=_weather_direct_summary(weather_content)

        if direct_weather_answer:
            print("\n"+_lo_label("lo","35")+"\n"+_ollama_markup(direct_weather_answer)+"\n")
            messages.append({"role":"assistant","content":direct_weather_answer})
            if events:
                events.emit("response", text=direct_weather_answer)
                events.emit("request_done", status="ok", rounds=0, tool_calls=1,
                            prompt_tokens=0, output_tokens=0, load_ms=0)
            _ai_foreground(False,"lo")
            if one_shot:
                return 0
            continue

        runtime=_lo_runtime_policy(thinking_mode, prompt)
        task_tier,budget=_lo_budget_for(prompt,thinking_mode,selected_paths)
        task_started=time.monotonic()
        task_rounds=0
        task_tool_calls=0
        task_prompt_tokens=0
        task_prompt_s=0.0
        task_eval_tokens=0
        task_eval_s=0.0
        task_load_s=0.0
        task_trace=[]
        repeated_tool_calls={}
        # Route once per operator turn, then keep every tool continuation on the
        # same worker/model. This preserves locality and avoids cross-node thrash.
        turn_fabric_route={} if fabric_mode else None

        for _ in range(budget["tool_rounds"]):
            weather_text_fast_path=(weather_prefetched and _lo_weather_only_query(prompt))
            payload_messages=messages
            payload_context=budget["context"]
            payload_output=budget["output"]
            if weather_text_fast_path:
                # A deterministic edge already did the retrieval. Do not make a reflex
                # model reread LO's full tool/personality/context manual merely to phrase
                # a trusted receipt. Keep the session state intact; compact only this call.
                payload_messages=[
                    {"role":"system","content":_temporal_context()},
                    {"role":"system","content":(
                        "FAST EDGE: Answer the user's weather question naturally and concisely from the trusted WEATHER receipt below. "
                        "Do not recompute dates or weekdays, invent conditions, call tools, or mention internal routing.\n\n"
                        + weather_content)},
                    user_message,
                ]
                payload_context=min(int(payload_context),4096)
                payload_output=min(int(payload_output),384)
            payload_obj = {
                "model": model,
                "messages": payload_messages,
                "stream": False,
                # LOOK is an interactive shell assistant. On a dedicated Ollama
                # host, unloading the primary model between turns only creates
                # cold-start latency with no user benefit.
                "keep_alive": -1,
                "options": {
                    "num_ctx": payload_context,
                    "num_predict": payload_output,
                    "temperature": runtime["temperature"],
                },
            }
            if supports_thinking:
                payload_obj["think"]=runtime["think"]
            tools=[]
            if supports_tools and not host_repair_final and not weather_text_fast_path:
                tools = _lo_tools_for_route(profile,turn_route)
                route_allowed=set(getattr(turn_route,"allowed_tools",[]) or [])
                if has_web and not turn_force_search and (not route_allowed or "web_search" in route_allowed):
                    tools.append(web_tool)
                payload_obj["tools"] = tools
                if events: events.emit("tools_scoped",family=turn_intent,tools=[t.get("function",{}).get("name","") for t in tools])

            try:
                aggregate={"role":"assistant","content":"","thinking":"","tool_calls":[]}
                roller=_RollingThinking(_load_think_display())
                waiting=_ActivityHandle("waiting for model").start()
                first_event=True
                final_event={}
                task_rounds+=1
                if events: events.emit("inference_start", round=task_rounds)
                progress_tokens=0
                try:
                    if fabric_mode:
                        stream_iter=_fabric_stream_chat(payload_obj,events=events,route=turn_fabric_route)
                    else:
                        stream_iter=_ollama_stream_chat(base,payload_obj,events=events)
                    for event in stream_iter:
                        fragment=event.get("message",{}) or {}
                        thought=str(fragment.get("thinking") or "")
                        content=str(fragment.get("content") or "")
                        calls=fragment.get("tool_calls") or []
                        if first_event and (thought or content or calls):
                            waiting.finish(); first_event=False
                            if events: events.emit("first_token", round=task_rounds)
                        if events and (thought or content):
                            progress_tokens += 1
                            if progress_tokens % 16 == 0:
                                events.emit("token_progress", chunks=progress_tokens, round=task_rounds)
                        if thought:
                            aggregate["thinking"]+=thought
                            roller.feed(thought)
                        if content:
                            aggregate["content"]+=content
                        if calls:
                            aggregate["tool_calls"].extend(calls)
                        if event.get("done"):
                            final_event=event
                finally:
                    waiting.finish()
                roller.finish()
                task_prompt_tokens+=int(final_event.get("prompt_eval_count") or 0)
                task_prompt_s+=float(final_event.get("prompt_eval_duration") or 0)/1e9
                task_eval_tokens+=int(final_event.get("eval_count") or 0)
                task_eval_s+=float(final_event.get("eval_duration") or 0)/1e9
                task_load_s+=float(final_event.get("load_duration") or 0)/1e9
                if events:
                    events.emit("inference_done", round=task_rounds,
                                prompt_tokens=int(final_event.get("prompt_eval_count") or 0),
                                output_tokens=int(final_event.get("eval_count") or 0),
                                load_ms=int(float(final_event.get("load_duration") or 0)/1e6),
                                prompt_eval_ms=int(float(final_event.get("prompt_eval_duration") or 0)/1e6),
                                eval_ms=int(float(final_event.get("eval_duration") or 0)/1e6))
                result={"message":aggregate}
                if turn_image_paths:
                    observed_image_paths.update(str(p) for p in turn_image_paths)
                    fresh_image_paths.difference_update(str(p) for p in turn_image_paths)
                    # Do not resend megabytes of image data on later tool rounds or turns.
                    user_message.pop("images",None)
            except KeyboardInterrupt:
                _ai_foreground(False,"lo")
                if events:
                    events.emit("inference_cancelled", round=task_rounds)
                    events.emit("request_done", status="cancelled", rounds=task_rounds,
                                tool_calls=task_tool_calls, prompt_tokens=task_prompt_tokens,
                                output_tokens=task_eval_tokens, load_ms=int(task_load_s*1000))
                print("\n· cancelled\n")
                messages.pop()
                if one_shot:
                    return 130
                break
            except Exception as exc:
                _ai_foreground(False,"lo")
                if events:
                    events.emit("error", stage="inference", error=str(exc), error_type=type(exc).__name__)
                    events.emit("request_done", status="error")
                print(f"LOOK OLLAMA · {exc}")
                messages.pop()
                if one_shot: return 1
                break

            message = result.get("message", {})
            tool_calls = message.get("tool_calls") or []
            if tool_calls:
                task_tool_calls+=len(tool_calls)
                messages.append(message)
                for call in tool_calls:
                    function = call.get("function", {})
                    name = function.get("name", "")
                    args = function.get("arguments", {}) or {}
                    if isinstance(args, str):
                        try:
                            args=json.loads(args)
                        except Exception:
                            args={}
                    signature=name+":"+json.dumps(args,sort_keys=True,default=str)
                    repeated_tool_calls[signature]=repeated_tool_calls.get(signature,0)+1
                    if repeated_tool_calls[signature]>=3:
                        tool_content="STOP · repeated identical tool call detected; choose a different step or finish the task."
                        _audit_receipt("lo","loop_guard",name,ok=False)
                        messages.append({"role":"tool","content":tool_content})
                        continue
                    task_trace.append({"tool":name,"args":args})
                    task_trace=task_trace[-12:]
                    tool_event_started=time.monotonic()
                    if events: events.emit("tool_start", tool=name)

                    if name == "weather":
                        location=args.get("location","")
                        try:
                            print(f"{_ansi_label('weather ›', '36')} {location}")
                            with _activity("weather"):
                                tool_content=_weather_lookup(location)
                            weather_succeeded=not str(tool_content).startswith(("Weather lookup failed:","No weather location match"))
                        except Exception as exc: tool_content=f"Weather lookup failed: {exc}"
                    elif name == "place_lookup":
                        query=args.get("query","")
                        try:
                            print(f"{_ansi_label('place ›', '36')} {query}")
                            with _activity("geocoding"):
                                tool_content=_place_lookup(query)
                        except Exception as exc: tool_content=f"Place lookup failed: {exc}"
                    elif name == "wikipedia":
                        query=args.get("query","")
                        try:
                            print(f"{_ansi_label('wiki ›', '35')} {query}")
                            with _activity("wikipedia"):
                                tool_content=_wikipedia_lookup(query)
                        except Exception as exc: tool_content=f"Wikipedia lookup failed: {exc}"
                    elif name == "wikidata":
                        query=args.get("query","")
                        try:
                            print(f"{_ansi_label('data ›', '35')} {query}")
                            with _activity("wikidata"):
                                tool_content=_wikidata_lookup(query)
                        except Exception as exc: tool_content=f"Wikidata lookup failed: {exc}"
                    elif name == "papers":
                        query=args.get("query","")
                        try:
                            print(f"{_ansi_label('papers ›', '36')} {query}")
                            with _activity("crossref"):
                                tool_content=_papers_lookup(query,args.get("rows",5))
                        except Exception as exc: tool_content=f"Papers lookup failed: {exc}"
                    elif name == "archive":
                        query=args.get("query","")
                        try:
                            print(f"{_ansi_label('archive ›', '33')} {query}")
                            with _activity("archive"):
                                tool_content=_archive_lookup(query,args.get("rows",5))
                        except Exception as exc: tool_content=f"Archive lookup failed: {exc}"
                    elif name == "open_url":
                        with _activity("open url"):
                            tool_content,ok,_elapsed=_tool_transaction(
                                name,args,lambda: _tool_open_url(args.get("url",""),args.get("intent","open")))
                        external_action_attempted=True
                        last_external_result=str(tool_content)
                        if ok:
                            external_action_succeeded=True
                            turn_successful_tools.add(name)
                            last_action=_lo_action_from_tool(name,args,tool_content)
                    elif name == "web_search":
                        if not has_web or turn_force_search:
                            tool_content = "Web search is unavailable in this session."
                        else:
                            query = args.get("query", prompt)
                            try:
                                print(f"{_ansi_label('search ›', '33')} {query}")
                                with _activity("searching"):
                                    search_result = _search_web(query)
                                tool_content = _typed_search_text(search_result)
                            except Exception as exc:
                                tool_content = f"Web search failed: {exc}"
                    elif name in {"list_files", "inspect_directory", "read_file", "search_files", "search_content", "write_file", "create_text_files", "copy_path", "move_path", "remove_path", "make_directory", "reveal_path", "open_path", "preview_path"}:
                        if name in {"write_file","create_text_files"}:
                            args=_normalize_creation_destination(prompt,name,args)
                        with _activity(name.replace("_"," ")):
                            tool_content,ok,_elapsed=_tool_transaction(
                                name,args,lambda: _run_filesystem_tool(workspace,name,args,profile))
                        if name=="search_files" and ok:
                            last_candidates=str(tool_content)[:12000]
                        if name in {"open_path","preview_path","reveal_path"}:
                            external_action_attempted=True
                            last_external_result=str(tool_content)
                            if _external_action_succeeded(name,tool_content):
                                external_action_succeeded=True
                        if ok: turn_successful_tools.add(name)
                        action_state=_lo_action_from_tool(name,args,tool_content)
                        if action_state:
                            last_action=action_state
                        if name in _LO_MUTATION_TOOLS:
                            mutation_attempted=True
                            last_mutation_result=str(tool_content)
                            if _mutation_tool_succeeded(name,tool_content):
                                mutation_succeeded=True
                            _lo_receipt("file",str(tool_content).splitlines()[0],ok=_mutation_tool_succeeded(name,tool_content),color="32")
                    elif name in {"list_processes","listening_ports","system_snapshot"}:
                        print(f"{_lo_label('system','36')}  {name.replace('_',' ')}")
                        with _activity("inspecting"):
                            tool_content,_ok,_elapsed=_tool_transaction(
                                name,args,lambda: _run_system_inspection_tool(name,args))
                        if _ok: turn_successful_tools.add(name)
                    elif name in {"generate_image","schedule_prompt","schedule_list","game_action","audio_speak","media_search","media_play","media_queue","media_control"}:
                        if name=="generate_image":
                            label,activity="image","generating"
                        elif name=="game_action":
                            label,activity="game","game"
                        elif name=="audio_speak":
                            label,activity="speech","speaking"
                        elif name.startswith("media_"):
                            label,activity="media","media"
                        else:
                            label,activity="schedule","scheduling"
                        detail=str(args.get("query") or args.get("action") or name.replace("_"," "))
                        print(f"{_lo_label(label,'35')}  {detail}")
                        with _activity(activity):
                            tool_content,_ok,_elapsed=_tool_transaction(
                                name,args,lambda: _run_capability_tool(name,args,workspace,profile))
                        if _ok:
                            turn_successful_tools.add(name)
                            _evidence_record("action",f"{name} succeeded",confidence=100,receipt=name)
                        _lo_receipt("result",str(tool_content).splitlines()[0],ok=_ok,color="33")
                    elif name=="run_command":
                        if _lo_terminal_interactive_intent(prompt):
                            args=dict(args); args["interactive"]=True
                        if profile not in {"power","unsafe"}:
                            tool_content="Command execution is unavailable in this access profile."
                        else:
                            command_text=str(args.get("command","")).strip()
                            raw_search=bool(re.search(r"(^|[;&|]\s*)(mdfind|find|fd|fdfind|locate|plocate|rg)\b",command_text,re.I))
                            if raw_search:
                                tool_content="USE SPECIALIZED TOOL · local discovery belongs to search_files (name/path) or search_content (text). Raw shell search was not run."
                                _audit_receipt("lo","specialized_tool_guard",command_text[:180],ok=False)
                                if events: events.emit("tool_done", tool=name, elapsed_tool_ms=int((time.monotonic()-tool_event_started)*1000), status="blocked")
                                messages.append({"role":"tool","tool_name":name,"content":tool_content})
                                continue
                            is_inspection=_inspection_command(command_text)
                            print(f"{_lo_label('inspect' if is_inspection else 'command','36' if is_inspection else '33')}  {command_text}")
                            with _activity("inspecting" if is_inspection else "running command"):
                                tool_content,_ok,_elapsed=_tool_transaction(
                                    name,args,lambda: _run_command_tool(workspace,args,profile))
                            last_action=_lo_action_from_tool(name,args,tool_content)
                            last_authoritative_receipt={"tool":"run_command","result":str(tool_content)[:1200],"time":time.time()}
                            if _ok: turn_successful_tools.add(name)
                            _lo_receipt("result",tool_content.splitlines()[0],ok=_ok,color="33")
                    else:
                        tool_content = f"Unknown tool: {name}"

                    info_receipt=_info_receipt(name,tool_content)
                    if info_receipt:
                        _show_info_receipt(info_receipt)
                        if events:
                            events.emit("source_receipt", **info_receipt)
                    if events:
                        events.emit("tool_done", tool=name, elapsed_tool_ms=int((time.monotonic()-tool_event_started)*1000))
                    messages.append({
                        "role": "tool",
                        "tool_name": name,
                        "content": tool_content,
                    })
                continue

            answer = message.get("content", "").strip()

            # Fresh weather is a host-enforced trust boundary. A prose-only model
            # answer is never allowed to masquerade as a live observation.
            if weather_required and not weather_succeeded:
                if not weather_repair_sent:
                    weather_repair_sent=True
                    messages.append({"role":"system","content":(
                        "LIVE WEATHER GROUNDING REQUIRED. The user's latest question depends on current or forecast weather, "
                        "but no successful WEATHER receipt exists for this turn. Call the weather tool now for the relevant location. "
                        "Do not answer from model memory, prior conversation, or an assumed date/time."
                    )})
                    continue
                answer=("I can't give a trustworthy current-weather answer because this turn did not obtain "
                        "a successful live WEATHER receipt.")
                message={"role":"assistant","content":answer,"thinking":"","tool_calls":[]}

            # Some otherwise capable models reason correctly about a shell
            # inspection but emit prose instead of crossing into a tool call.
            # In POWER/UNSAFE, recover only known read-only inspections. LOOK
            # executes the safe command deterministically, feeds the receipt
            # back, and gives the model one final chance to answer.
            if profile in {"power","unsafe"} and not tool_refusal_repair_sent:
                repair_command=_answer_inspection_command(answer)
                if repair_command and re.search(r"(^|[;&|]\s*)(mdfind|find|fd|fdfind|locate|plocate|rg)\b",repair_command,re.I):
                    repair_command=None
                if repair_command and _looks_like_tool_refusal(answer):
                    tool_refusal_repair_sent=True
                    print(f"{_ansi_label('repair ›','33')} {repair_command}")
                    with _activity("inspecting"):
                        repair_result=_run_command_tool(workspace,{"command":repair_command,"timeout":30},profile)
                    print(f"{_ansi_label('result ›','33')} {repair_result.splitlines()[0]}")
                    host_repair_final=True
                    messages.append({
                        "role":"system",
                        "content":(
                            "HOST INSPECTION COMPLETE. LOOK has already completed the inspection. "
                            f"Command: `{repair_command}`\nResult:\n{repair_result}\n"
                            "FINAL-ANSWER-ONLY TURN: answer the user's original question directly from this result. "
                            "Do not inspect again, do not propose another command, and do not ask the user to run anything."
                        )
                    })
                    continue

            # A model may describe an intended action, but only a positive host
            # receipt permits a success claim. Give it one repair turn to cross
            # the tool boundary; otherwise report the truth.
            if mutation_required and mutation_succeeded:
                answer=_mutation_truth_summary(last_mutation_result)
                message={"role":"assistant","content":answer,"thinking":"","tool_calls":[]}

            elif external_action_required and not external_action_succeeded:
                if not action_repair_sent:
                    action_repair_sent=True
                    messages.append({"role":"system","content":(
                        "VERIFIED-ACTION REQUIRED. The user asked for a host-visible action. "
                        "You do not yet have a successful OPEN/PREVIEW/REVEAL receipt. "
                        "If the exact target is known from conversation or search evidence, call the appropriate tool now. "
                        "Do not say it opened/played/launched until the tool returns success."
                    )})
                    continue
                detail=(last_external_result or "no host action receipt was produced").strip()
                answer=f"I did not verify that the requested action completed. {detail}"
                message={"role":"assistant","content":answer,"thinking":"","tool_calls":[]}

            elif (not external_action_required) and _answer_claims_external_success(answer) and not external_action_succeeded:
                # Final renderer invariant: success prose cannot cross this point
                # without a receipt. If a verified session referent exists, LOOK
                # performs that exact action itself; otherwise suppress the claim.
                if last_action:
                    with _activity(last_action["tool"].replace("_"," ")):
                        host_result,_tx_ok,_elapsed=_tool_transaction(
                            "verified_action_replay",last_action["args"],
                            lambda: (_tool_open_url(last_action["args"].get("url",""),last_action["args"].get("intent","open"))
                                     if last_action["tool"]=="open_url"
                                     else _run_filesystem_tool(workspace,last_action["tool"],last_action["args"],profile)),
                            truth_name=last_action["tool"])
                    host_ok=_tx_ok and _external_action_succeeded(last_action["tool"],host_result)
                    if host_ok:
                        external_action_succeeded=True
                    else:
                        answer=f"I did not verify that the requested action completed. {host_result}"
                        message={"role":"assistant","content":answer,"thinking":"","tool_calls":[]}
                else:
                    answer="I don't have a successful host-action receipt for that, so I can't claim it opened or played."
                    message={"role":"assistant","content":answer,"thinking":"","tool_calls":[]}

            elif mutation_required and mutation_attempted and not mutation_succeeded:
                detail=(last_mutation_result or "filesystem mutation did not return a success receipt").strip()
                answer=f"I did not complete the requested filesystem change. {detail}"
                message={"role":"assistant","content":answer,"thinking":"","tool_calls":[]}

            elif mutation_required and not mutation_attempted:
                if not mutation_repair_sent:
                    mutation_repair_sent=True
                    messages.append({
                        "role":"system",
                        "content":(
                            "EXECUTION REQUIRED. The user's latest request explicitly asks for a local filesystem change, "
                            "but you have not called any mutation tool yet. Do not explain or claim success. "
                            "Call the appropriate filesystem tool now. For several new text files, prefer create_text_files. "
                            "If a needed parent directory is missing, call make_directory first."
                        )
                    })
                    continue
                # Second prose-only completion is not allowed to become a false receipt.
                answer="I did not execute a filesystem mutation tool, so I have not changed any files."
                message={"role":"assistant","content":answer,"thinking":"","tool_calls":[]}

            # Speech is an effect, not prose. Recover one narrow pseudo-call or
            # force one real tool round before allowing the turn to complete.
            candidate_before_gate=_split_ollama_thinking(message)[1]
            if speech_required and "audio_speak" not in turn_successful_tools:
                pseudo=_extract_audio_pseudocall(candidate_before_gate)
                if pseudo:
                    with _activity("speech"):
                        speech_content,speech_ok,_speech_elapsed=_tool_transaction(
                            "audio_speak",pseudo,lambda: _run_capability_tool("audio_speak",pseudo,workspace,profile))
                    _lo_receipt("speech",str(speech_content).splitlines()[0],ok=speech_ok,color="35")
                    if speech_ok:
                        turn_successful_tools.add("audio_speak")
                        _evidence_record("action","speech dispatched",confidence=100,receipt="audio_speak")
                        message={"role":"assistant","content":"Spoken.","thinking":"","tool_calls":[]}
                    else:
                        message={"role":"assistant","content":f"I couldn't complete the speech action. {speech_content}","thinking":"","tool_calls":[]}
                elif not speech_repair_sent:
                    speech_repair_sent=True
                    messages.append({"role":"system","content":(
                        "EXECUTION REQUIRED. The operator explicitly asked for speech, but no audio_speak receipt exists. "
                        "Do not print audiospeak(...) or describe speaking. Call audio_speak now with the short text to be spoken."
                    )})
                    continue
                else:
                    message={"role":"assistant","content":"I did not execute the speech tool, so I can't claim anything was spoken.","thinking":"","tool_calls":[]}

            # LAST GATE: no host-success prose may reach rendering without a
            # successful receipt in this turn. This intentionally duplicates the
            # earlier policy guard so future control-flow edits cannot bypass it.
            candidate_final=_split_ollama_thinking(message)[1]
            # Models cannot certify durable memory by saying they remembered. Explicit
            # memory writes need a host receipt; background extraction is not synchronous truth.
            if _answer_claims_memory_write(candidate_final) and not memory_write_receipt:
                candidate_final="I haven't verified a durable memory write for that yet, so I won't claim it was stored."
                message={"role":"assistant","content":candidate_final,"thinking":"","tool_calls":[]}
            # Any successful action tool in this turn is authoritative evidence. The
            # renderer may not overrule a real receipt merely because it came through
            # media/speech/game rather than OPEN/PREVIEW/REVEAL bookkeeping.
            authoritative_action_tools={"media_play","media_queue","media_control","audio_speak","game_action","open_path","preview_path","reveal_path","open_url"}
            authoritative_action_success=bool(authoritative_action_tools & set(turn_successful_tools)) or external_action_succeeded
            if mutation_required and mutation_succeeded:
                candidate_final=_mutation_truth_summary(last_mutation_result)
                message={"role":"assistant","content":candidate_final,"thinking":"","tool_calls":[]}
            elif _answer_claims_external_success(candidate_final) and not authoritative_action_success:
                candidate_final="I don't have a successful host-action receipt, so I can't claim that it opened or played."
                message={"role":"assistant","content":candidate_final,"thinking":"","tool_calls":[]}
            elif external_action_succeeded and (
                _answer_claims_external_success(candidate_final) or
                _answer_claims_unobserved_runtime_state(candidate_final)
            ):
                # OPEN OK proves dispatch, not foreground focus, process lifetime,
                # player state, or active playback.
                candidate_final=_truthful_dispatch_summary(candidate_final)
                message={"role":"assistant","content":candidate_final,"thinking":"","tool_calls":[]}

            messages.append(message)
            # Thinking was already presented live according to the selected display mode.
            final=_split_ollama_thinking(message)[1]
            if final:
                print("\n"+_lo_label("lo","35")+"\n"+_ollama_markup(final)+"\n")
            else:
                print("\n"+_lo_label("lo","35")+"\n"+_c("(no final response)","2")+"\n")
            if turn_goal and not events:
                try:
                    assessment=_cognition_module().assess(turn_goal,successful_tools=list(turn_successful_tools),final_text=final)
                    _world_state().close_goal(turn_goal.id,satisfied=bool(assessment.get("satisfied")),reason=str(assessment.get("reason") or ""))
                except Exception:
                    pass
            if events:
                events.emit("response", text=final)
                if turn_goal:
                    try:
                        assessment=_cognition_module().assess(turn_goal,successful_tools=list(turn_successful_tools),final_text=final)
                        try: _world_state().close_goal(turn_goal.id,satisfied=bool(assessment.get("satisfied")),reason=str(assessment.get("reason") or ""))
                        except Exception: pass
                        events.emit("goal_verified",goal_id=turn_goal.id,**assessment)
                    except Exception:
                        pass
                events.emit("request_done", status="ok", rounds=task_rounds, tool_calls=task_tool_calls,
                            prompt_tokens=task_prompt_tokens, output_tokens=task_eval_tokens,
                            load_ms=int(task_load_s*1000))
            _record_ai_stats({
                "time":time.time(),"model":model,"host":_ollama_host_name(base),
