def _named_home_destination(prompt):
    """Resolve explicit common home-folder language to a canonical path."""
    text=" ".join(str(prompt or "").split()).casefold()
    checks=(
        ("downloads", HOME/"Downloads"),
        ("desktop", HOME/"Desktop"),
        ("documents", HOME/"Documents"),
    )
    for word,path in checks:
        patterns=(
            f"~/{word}",
            f"my {word} folder",
            f"the {word} folder",
            f"actual {word} folder",
            f"top-level {word}",
            f"top level {word}",
        )
        if any(p in text for p in patterns):
            return path.resolve()
    return None


def _normalize_creation_destination(prompt,name,args):
    """Make named common folders concrete before the filesystem boundary checks."""
    dest=_named_home_destination(prompt)
    if dest is None or name not in {"write_file","create_text_files"}:
        return args
    fixed=dict(args)
    if name=="write_file":
        raw=Path(str(fixed.get("path") or ""))
        # Preserve only the requested filename; the spoken destination owns the directory.
        if raw.name:
            fixed["path"]=str(dest/raw.name)
    else:
        files=[]
        for item in fixed.get("files",[]) or []:
            row=dict(item)
            raw=Path(str(row.get("path") or ""))
            if raw.name:
                row["path"]=str(dest/raw.name)
            files.append(row)
        fixed["files"]=files
    return fixed


def _mutation_tool_succeeded(name,result):
    text=str(result or "")
    if name=="write_file":
        return text.startswith("WRITE OK")
    prefixes={
        "create_text_files":"CREATE FILES OK",
        "copy_path":"COPY OK",
        "move_path":"MOVE OK",
        "remove_path":"REMOVE OK",
        "make_directory":("MKDIR OK","Directory already exists:"),
    }
    expected=prefixes.get(name)
    if isinstance(expected,tuple): return text.startswith(expected)
    return bool(expected and text.startswith(expected))

def _mutation_truth_summary(result):
    """Render exactly the successful filesystem state established by its receipt."""
    first=str(result or "").strip().splitlines()[0] if str(result or "").strip() else ""
    clean=re.sub(r"\s*·\s*undo available\s*·\s*lk undo\s*$","",first,flags=re.I)
    labels={
        "MOVE OK":"Moved","COPY OK":"Copied","REMOVE OK":"Removed",
        "WRITE OK":"Wrote","CREATE FILES OK":"Created","MKDIR OK":"Created directory",
    }
    for prefix,verb in labels.items():
        if clean.startswith(prefix):
            return verb+" "+clean[len(prefix):].lstrip(" ·")
    return clean or "Filesystem change completed."

def _temporal_context():
    """Return authoritative wall-clock context from the host, never model memory."""
    now=datetime.now().astimezone()
