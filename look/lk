                "last_worker_error":str(data.get("last_worker_error", ""))[:500],
                "last_extraction_at":float(data.get("last_extraction_at",0) or 0),
                "last_extraction":str(data.get("last_extraction","never"))[:120],
                "last_extraction_reason":str(data.get("last_extraction_reason",""))[:180],
                "extractions_total":max(0,int(data.get("extractions_total",0) or 0)),
                "extractions_candidate":max(0,int(data.get("extractions_candidate",0) or 0)),
                "extractions_none":max(0,int(data.get("extractions_none",0) or 0)),
                "consolidations_total":max(0,int(data.get("consolidations_total",0) or 0)),
                "promotions_total":max(0,int(data.get("promotions_total",0) or 0)),
                "candidate_merges_total":max(0,int(data.get("candidate_merges_total",0) or 0)),
                "candidate_local_suppressed":max(0,int(data.get("candidate_local_suppressed",0) or 0)),
                "candidate_expired_total":max(0,int(data.get("candidate_expired_total",0) or 0)),
                "candidate_evictions":max(0,int(data.get("candidate_evictions",0) or 0)),
                "last_compiled_at":float(data.get("last_compiled_at",0) or 0),
