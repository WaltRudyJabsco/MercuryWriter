def _lo_media_decision_intent(prompt,profile="workspace"):
    """Use the learned decision worker only for bounded media ambiguity.

    Exact media commands never pay the ~0.5s learned-worker tax. This path is for
    relational language where current playback state materially disambiguates intent.
    """
    low=" ".join(str(prompt or "").casefold().split()).strip(" .!?")
    triggers=("next one","skip this","skip it","next album","this album","the album",
              "this band","first song","first track","start this album","restart this album",
              "something else by")
    if not any(x in low for x in triggers):
        return None
    snap=_media_status_snapshot()
    if not snap:
        return None
    entry=snap.get("entry") or {}
    artist=str(entry.get("artist") or "")
    album=str(entry.get("album") or "")
    title=str(entry.get("title") or entry.get("name") or "")
    state=(
        "A local LOOK media session is active.\n"
        f"Current track: {title or 'unknown'}\n"
        f"Current artist: {artist or 'unknown'}\n"
        f"Current album: {album or 'unknown'}\n"
        f"User said: {prompt}\n"
        "Operations: next_track advances one track; next_album jumps to the first track of the next album; "
        "first_album restarts the current album; search_artist searches the local Fabric media catalog for the current artist; "
        "conversation means no media operation."
    )
    candidates=["next_track","next_album","first_album","search_artist","conversation"]
    try:
        judged=_lo_decision_post("/v1/decisions/shadow",{
            "state":state,"question":"Which media operation did the user request?","candidates":candidates,
            "profile":profile,"consequence":"low","reversible":True},timeout=2.5)
    except Exception:
        return None                         # learned worker is optional by design
    if not judged.get("ok") or judged.get("choice") not in candidates:
        return None
    choice=str(judged["choice"])
    if choice=="conversation": return None
    policy=judged.get("policy") or {}
    if policy.get("action")=="act":
        return _lo_media_decision_to_intent(choice,entry,judged)

    # Concentrate uncertainty into the shared Decision Plane. Terminal, Signal or
    # another trusted surface may answer the same object. Enter leaves it pending.
    try:
        created=_lo_decision_post("/v1/decisions",{
            "question":"Media intent: "+str(prompt),
            "choices":[{"value":x,"label":x.replace("_"," ")} for x in candidates if x!="conversation"],
            "profile":profile,"confidence":float(judged.get("confidence") or 0.0),
            "margin":float(judged.get("margin") or 0.0),"consequence":"low","reversible":True,
            "preferred":choice,"provider":"openjev","context":{"state":state,"judgment":judged}},timeout=3.0)
    except Exception:
        return None
    decision=created.get("decision") or {}
    did=str(decision.get("id") or "")
    choices=[str(x.get("value")) for x in decision.get("choices") or [] if isinstance(x,dict)]
    if not did:
        return None
    print(f"{_lo_label('ask','33')}  {choice} · conf {float(judged.get('confidence') or 0):.2f} · margin {float(judged.get('margin') or 0):.2f}")
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return {"pending_decision":decision,"judgment":judged}
    print("  "+" / ".join(f"{i+1}:{x}" for i,x in enumerate(choices))+"  · Enter leaves pending")
    sys.stdout.write("  > "); sys.stdout.flush()
    expires=float(decision.get("expires") or time.time()+30)
    while time.time()<expires:
        try:
            current=(_lo_decision_get(f"/v1/decisions/{did}").get("decision") or {})
        except Exception:
            current={}
        if current and current.get("status")!="pending":
            selected=str(current.get("selected") or "")
            sys.stdout.write("\r\033[2K")
            print(f"decision › {selected or current.get('status')} · {current.get('response_source') or 'fabric'}")
            return _lo_media_decision_to_intent(selected,entry,judged) if selected else {"pending_decision":current,"judgment":judged}
        ready,_,_=select.select([sys.stdin],[],[],0.25)
        if not ready: continue
        entered=sys.stdin.readline().strip()
        if not entered:
            return {"pending_decision":decision,"judgment":judged}
        selected=None
        if entered.isdigit() and 1<=int(entered)<=len(choices): selected=choices[int(entered)-1]
        else: selected=next((x for x in choices if x.casefold()==entered.casefold()),None)
        if not selected:
            print("  choose "+" / ".join(choices)+" (or number); Enter leaves pending")
            sys.stdout.write("  > "); sys.stdout.flush(); continue
        try:
            _lo_decision_post("/v1/decisions/answer",{"id":did,"selected":selected,"source":"terminal"},timeout=3.0)
        except Exception:
            return {"pending_decision":decision,"judgment":judged}
        return _lo_media_decision_to_intent(selected,entry,judged)
    return {"pending_decision":decision,"judgment":judged}


def _lo_media_decision_to_intent(choice,entry,judged=None):
    if choice=="next_track": return {"tool":"media_control","args":{"action":"next"},"judgment":judged}
    if choice=="next_album": return {"tool":"media_control","args":{"action":"next_album"},"judgment":judged}
    if choice=="first_album": return {"tool":"media_control","args":{"action":"first_album"},"judgment":judged}
    if choice=="search_artist":
        artist=str((entry or {}).get("artist") or "").strip()
        return {"tool":"media_search","args":{"query":artist},"judgment":judged} if artist else None
    return None


