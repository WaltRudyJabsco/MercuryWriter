LOOK_INFO_USER_AGENT="LOOK-Shell/4.49.0 (local text client)"

def _run_filesystem_tool(workspace, name, args, profile="workspace"):
    global _FILESYSTEM_ACCESS_PROFILE
    previous_profile=_FILESYSTEM_ACCESS_PROFILE
    _FILESYSTEM_ACCESS_PROFILE=str(profile or "workspace").casefold()
    try:
        return _run_filesystem_tool_impl(workspace,name,args,str(profile or 'workspace').casefold())
    finally:
        _FILESYSTEM_ACCESS_PROFILE=previous_profile
        # "Allow once" covers the complete tool transaction, including its
        # internal source/destination/final-path checks, then disappears.
        _ONCE_PATH_GRANTS.clear()


def _http_json(url, timeout=12):
    """Fetch JSON through Python first, then the host HTTP stack.

    macOS Python installs can have a different CA/DNS/proxy environment from
    the operator's shell. Canonical read-only information edges should not die
    merely because urllib and the host disagree, so curl is an independent
    bounded fallback. If both transports fail, preserve both errors for the
    diagnostic surface instead of collapsing them into "no receipt".
    """
    import json, shutil, subprocess, urllib.request
    urllib_error=None
    request=urllib.request.Request(url,headers={"User-Agent":LOOK_INFO_USER_AGENT,"Accept":"application/json"})
    try:
        with urllib.request.urlopen(request,timeout=timeout) as response:
            return json.load(response)
    except Exception as exc:
        urllib_error=f"{type(exc).__name__}: {exc}"

    curl=shutil.which("curl")
    if not curl:
        raise RuntimeError(f"urllib failed ({urllib_error}); curl is unavailable")
    try:
        proc=subprocess.run(
            [curl,"-fsSL","--max-time",str(max(1,int(timeout))),
             "-A",LOOK_INFO_USER_AGENT,"-H","Accept: application/json",url],
            stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=max(2,int(timeout)+2),
        )
        if proc.returncode != 0:
            detail=(proc.stderr or "").strip() or f"exit {proc.returncode}"
            raise RuntimeError(detail)
        return json.loads(proc.stdout)
    except Exception as exc:
        curl_error=f"{type(exc).__name__}: {exc}"
        raise RuntimeError(f"HTTP JSON failed: urllib [{urllib_error}]; curl [{curl_error}]") from exc

def _info_envelope(source, edge, payload, *, as_of=None, source_url=None, direct=True):
    """Shared epistemic receipt for canonical information edges."""
    return {
        "edge":edge,
        "source":source,
        "confidence":"DIRECT" if direct else "DERIVED",
        "as_of":as_of,
        "retrieved_at":time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "source_url":source_url,
        **payload,
    }


def _info_receipt(tool_name, tool_content):
    """Return deterministic provenance for user-visible information tools.

    The model may paraphrase a fact, but it does not own the evidence label.
    LOOK emits this receipt directly from the edge that actually ran.
    """
    canonical={"weather":"WEATHER","place_lookup":"PLACE","wikipedia":"WIKI",
               "wikidata":"DATA","papers":"PAPERS","archive":"ARCHIVE"}
    if tool_name in canonical:
        try:
            row=json.loads(str(tool_content))
        except Exception:
            return None
        if not isinstance(row,dict) or str(row.get("edge") or "") != canonical[tool_name]:
            return None
        return {k:row.get(k) for k in ("edge","source","confidence","as_of","retrieved_at","source_url") if row.get(k) is not None}
    if tool_name=="web_search" and not str(tool_content).startswith(("Web search is unavailable","Web search failed")):
        return {"edge":"SEARCH","source":"Ollama Web Search","confidence":"SEARCHED",
                "retrieved_at":time.strftime("%Y-%m-%dT%H:%M:%S%z")}
    return None


