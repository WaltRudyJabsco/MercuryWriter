    prompt="[y] once"
    if allow_session:
        prompt+=" · [s] allow command this session"
    prompt+=" · Enter/Esc cancel › "
    try:
        answer=input(prompt).strip().casefold()
    except (EOFError,KeyboardInterrupt):
        print()
        return "cancel"
    if answer in {"y","yes","once"}:
        return "once"
    if allow_session and answer in {"s","session"}:
        return "session"
    return "cancel"


def _confirm_command(command):
