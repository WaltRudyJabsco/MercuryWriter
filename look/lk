def _normalize_weather_location(location):
    """Canonicalize human shorthand before sending it to geocoding.

    Open-Meteo geocoding is much happier with ``Portland, Oregon`` than the
    speech-shaped ``portland or``.  Only unambiguous US state suffixes are
    expanded; everything else is preserved rather than guessed.
    """
    place=" ".join(str(location or "").strip().split()).strip(" \t,.;:?!")
    if not place:
        return ""
    match=re.match(r"^(.+?)(?:,|\s)\s*([A-Za-z]{2})$",place)
    if match:
        state=_US_STATE_ABBREVIATIONS.get(match.group(2).upper())
        if state:
            city=match.group(1).strip(" \t,")
            return f"{city}, {state}"

    # Speech and casual typing commonly omit the comma in a full state name
    # ("portland oregon").  Canonicalization is a host responsibility: model
    # choice must never determine whether the same place resolves on two nodes.
    for state in sorted(set(_US_STATE_ABBREVIATIONS.values()), key=len, reverse=True):
        suffix=" "+state.casefold()
        folded=place.casefold()
        if folded.endswith(suffix):
            city=place[:len(place)-len(state)].strip(" \t,")
            if city:
                return f"{city}, {state}"
    return place



