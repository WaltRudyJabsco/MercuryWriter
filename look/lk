def _alert_command(args):
    """Route one explicit attention event through Fabric.

    Named targets use @target so ordinary message text is never stolen as routing.
    `active` and `follow-me` are accepted by Fabric but intentionally unresolved
    until trustworthy presence evidence exists.
    """
    rest=list(args or [])
    target="origin"; importance="normal"; voice="default"
    if rest and rest[0].startswith("@") and len(rest[0])>1:
        target=rest.pop(0)[1:]
    while rest and rest[0].startswith("--"):
        flag=rest.pop(0)
        if flag in {"--important","--urgent","--low"}:
            importance=flag[2:]
        elif flag=="--voice" and rest:
            voice=rest.pop(0).casefold()
        else:
            print("usage: lk alert [@TARGET] [--important|--urgent|--low] [--voice PROFILE] MESSAGE"); return 2
    if not rest:
        print("usage: lk alert [@TARGET] [--important|--urgent|--low] [--voice PROFILE] MESSAGE"); return 2
    if voice!="default" and voice not in _speech_profiles():
        print("voice profiles · "+", ".join(_speech_profiles())); return 2
    argv=["alert","--target",target,"--importance",importance,"--channel","voice","--voice-profile",voice," ".join(rest)]
    try:
        result=_media_fabric_cli(argv)
    except Exception as exc:
        print(f"LOOK alert failed · {exc}"); return 1
    plan=result.get("plan") or {}
    if plan.get("status")=="presence-unresolved":
        print(f"LOOK alert · {target} · presence unresolved · no delivery guessed"); return 1
    delivered=sum(1 for row in result.get("delivery") or [] if row.get("ok"))
    attempted=len(result.get("delivery") or [])
    print(f"LOOK alert · {target} · {delivered}/{attempted} delivered")
    return 0 if result.get("ok") else 1


