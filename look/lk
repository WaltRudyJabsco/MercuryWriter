def _discover_mercury_port():
    """Best-effort discovery; never invent a Mercury port."""
    try:
        proc=subprocess.run(["ps","-ax","-o","command="],capture_output=True,text=True,timeout=2)
        for line in proc.stdout.splitlines():
            low=line.casefold()
            if "mercury" not in low:
                continue
            for pattern in (
                r"--port(?:=|\s+)(\d{2,5})",
                r"\bport(?:=|\s+)(\d{2,5})",
            ):
                m=re.search(pattern,line,re.I)
                if m:
                    port=int(m.group(1))
                    if 1<=port<=65535:
                        return port
    except Exception:
        pass
    # lsof can recover listening port from a Mercury-named process command.
    lsof=shutil.which("lsof")
    if lsof:
        try:
            proc=subprocess.run([lsof,"-nP","-iTCP","-sTCP:LISTEN"],capture_output=True,text=True,timeout=2)
            mercury_pids=set()
            ps=subprocess.run(["ps","-ax","-o","pid=,command="],capture_output=True,text=True,timeout=2)
            for line in ps.stdout.splitlines():
                if "mercury" in line.casefold():
                    parts=line.strip().split(None,1)
                    if parts: mercury_pids.add(parts[0])
            for line in proc.stdout.splitlines()[1:]:
                parts=line.split()
                if len(parts)<9 or parts[1] not in mercury_pids:
                    continue
                m=re.search(r":(\d+)(?:\s+\(LISTEN\))?$",line)
                if m:
                    port=int(m.group(1))
                    if 1<=port<=65535:
                        return port
        except Exception:
            pass
    return 0


def _service_refresh_discovery(data=None):
    data=data or _load_services()
    mercury=data.setdefault("mercury",{})
    if not int(mercury.get("target_port",0) or 0):
        port=_discover_mercury_port()
        if port:
            mercury.update({"local_port":port,"target_port":port,"https_port":port,"kind":"http","enabled":True})
            _save_services(data)
    return data


def _tailscale_dns_name():
    tailscale=shutil.which("tailscale")
    if not tailscale: return ""
    try:
        proc=subprocess.run([tailscale,"status","--json"],capture_output=True,text=True,timeout=3)
        data=json.loads(proc.stdout or "{}")
