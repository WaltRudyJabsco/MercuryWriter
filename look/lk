def _papers_lookup(query,rows=5):
    import json
    from urllib.parse import urlencode
    query=str(query or "").strip()
    if not query: return "Papers lookup requires a query."
    rows=max(1,min(int(rows or 5),5))
    data=_http_json("https://api.crossref.org/works?"+urlencode({"query.bibliographic":query,"rows":rows}))
    out=[]
    for item in ((data.get("message") or {}).get("items") or [])[:rows]:
        title=(item.get("title") or [""])[0]
        authors=[" ".join(x for x in [a.get("given"),a.get("family")] if x) for a in (item.get("author") or [])[:6]]
        date_parts=(((item.get("published-print") or item.get("published-online") or item.get("issued") or {}).get("date-parts") or [[]])[0])
        published="-".join(str(x) for x in date_parts) if date_parts else None
        doi=item.get("DOI")
        out.append({"title":title,"authors":authors,"published":published,
                    "container":(item.get("container-title") or [None])[0],"doi":doi,
                    "url":f"https://doi.org/{doi}" if doi else item.get("URL")})
    return json.dumps(_info_envelope("Crossref","PAPERS",{"query":query,"results":out},
                      source_url="https://api.crossref.org/"),ensure_ascii=False)


def _archive_lookup(query,rows=5):
