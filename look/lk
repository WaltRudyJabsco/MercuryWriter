def _append_learned_skill(skill, signal="new"):
    """Append/reinforce one generalized skill while keeping skills.md human-readable."""
    skill=_sanitize_skill(skill)
    if not skill:
        return False
    _ensure_intelligence_files()
    current=_learned_skills()
    folded=skill.casefold()

    for old in current:
        oldf=old.casefold()
        if folded==oldf or folded in oldf or oldf in folded:
            _update_skill_meta(old, "positive" if signal=="positive" else signal)
            return False

    if len(current)>=24:
        return False
    try:
        text=SKILLS_FILE.read_text(encoding="utf-8")
        marker="## Learned"
        if marker not in text:
            text=text.rstrip()+"\n\n## Learned\n\n"
        if not text.endswith("\n"):
            text+="\n"
        text+=f"- {skill}.\n"
        SKILLS_FILE.write_text(text,encoding="utf-8")
        _update_skill_meta(skill,signal)
        return True
    except OSError:
        return False


def _find_learned_skill(fragment):
    frag=" ".join(str(fragment or "").split()).strip().casefold()
    if not frag:
        return None
    for skill in _learned_skills():
        sf=skill.casefold()
        if frag==sf or frag in sf or sf in frag:
            return skill
    return None


def _learn_from_exchange(base, model, user_text, assistant_text, profile):
    """Self-learning respects LO's capability boundary."""
    if profile=="conservative":
        return False
    skill=_extract_skill_candidate(base,model,user_text,assistant_text)
    return bool(skill and _append_learned_skill(skill))



