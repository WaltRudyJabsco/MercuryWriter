def _receipt_log_path():
    path=HOME/".local"/"share"/"look"/"receipts"
    path.mkdir(parents=True,exist_ok=True)
    return path/"current.jsonl"

def _repair_receipt_log(path):
    """Repair 4.20-4.22 journals that used literal backslash-n separators."""
    if not path.exists(): return
    try:
        raw=path.read_text(encoding="utf-8",errors="replace")
        if "\\\\n" not in raw or "\n" in raw: return
        valid=[]
        for part in raw.split("\\\\n"):
            if not part.strip(): continue
            try:
                row=json.loads(part)
                if isinstance(row,dict): valid.append(row)
            except ValueError: pass
        if valid:
            tmp=path.with_suffix(".repair")
            with tmp.open("w",encoding="utf-8") as f:
                for row in valid:
                    f.write(json.dumps(row,ensure_ascii=False,separators=(",",":"))+"\n")
            tmp.replace(path)
    except OSError: pass

def _audit_receipt(actor,action,detail="",ok=True,**fields):
    """Bounded append-only action journal; never stores conversation/file contents."""
    path=_receipt_log_path()
    try:
        _repair_receipt_log(path)
        if path.exists() and path.stat().st_size>2_000_000:
            archive=path.with_name(f"receipts-{time.strftime('%Y%m%d-%H%M%S')}.jsonl")
            path.replace(archive)
            old=sorted(path.parent.glob("receipts-*.jsonl"),key=lambda p:p.stat().st_mtime,reverse=True)
            for stale in old[5:]:
                try: stale.unlink()
                except OSError: pass
        row={"ts":time.strftime("%Y-%m-%dT%H:%M:%S%z"),"actor":actor,"action":action,
             "detail":str(detail)[:500],"result":"ok" if ok else "failed"}
        for k,v in fields.items():
            if v not in (None,""): row[k]=str(v)[:500]
        with path.open("a",encoding="utf-8") as f:
            f.write(json.dumps(row,ensure_ascii=False,separators=(",",":"))+"\n")
    except OSError: pass


