def _ai_broker_path():
    return Path(__file__).resolve().with_name("look_ai.py")


def _ai_broker_request(command, **payload):
    """Best-effort local broker RPC. The filesystem queues remain durable truth."""
    message={"command":command,**payload}
    try:
        sock=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
        sock.settimeout(.35)
        sock.connect(str(AI_SOCKET))
        sock.sendall((json.dumps(message,ensure_ascii=False)+"\n").encode())
        data=b""
        while not data.endswith(b"\n") and len(data)<65536:
            chunk=sock.recv(4096)
            if not chunk: break
            data+=chunk
        sock.close()
        return json.loads(data.decode() or "{}") if data else {"ok":True}
    except (OSError,ValueError,json.JSONDecodeError):
        return None


def _ai_pid_alive(pid):
    try:
        os.kill(int(pid),0)
        return True
    except Exception:
        return False


def _ai_wait_broker_cleanup(timeout=2.5):
    """Wait until the old broker has finished unlinking its runtime identity."""
    deadline=time.time()+timeout
    while time.time()<deadline:
        if not AI_SOCKET.exists() and not AI_PID_FILE.exists():
            return True
        time.sleep(.05)
    return not AI_SOCKET.exists() and not AI_PID_FILE.exists()


def _ai_broker_start():
    """Ensure the resident broker exists and is running THIS installed LOOK core."""
    reply=_ai_broker_request("status")
    if reply and reply.get("ok"):
        running=str(reply.get("core_version") or "")
        if running==VERSION:
            return True

        # The broker imports LOOK once at process start. After an upgrade, a live
        # old broker would otherwise keep executing stale memory/tool policy.
        old_pid=int(reply.get("pid",0) or 0)
        _ai_broker_request("stop")
        cleaned=_ai_wait_broker_cleanup(2.5)

        if not cleaned and old_pid>0:
            try: os.kill(old_pid,signal.SIGTERM)
            except OSError: pass
            cleaned=_ai_wait_broker_cleanup(1.5)

        # If the old process is gone but left stale identity files behind, clear
        # only those stale files. Never unlink a socket owned by a live process.
        if not cleaned and old_pid>0 and not _ai_pid_alive(old_pid):
            try: AI_SOCKET.unlink()
            except OSError: pass
            try: AI_PID_FILE.unlink()
            except OSError: pass
            cleaned=True

        if not cleaned:
            return False

    broker=_ai_broker_path()
    if not broker.exists():
        return False
    try:
        STATE_DIR.mkdir(parents=True,exist_ok=True)
        log=open(AI_LOG_FILE,"ab",buffering=0)
        subprocess.Popen(
            [sys.executable,str(broker),"--daemon"],
            stdin=subprocess.DEVNULL,stdout=log,stderr=log,
            start_new_session=True,close_fds=True,
        )
        log.close()
    except OSError:
        return False

    for _ in range(50):
        time.sleep(.05)
        reply=_ai_broker_request("status")
        if reply and reply.get("ok") and str(reply.get("core_version") or "")==VERSION:
            return True
    return False


def _ai_broker_wake(kind="work"):
    # Work already running inside the broker needs no recursive socket wake;
    # returning True also prevents legacy fallback workers from being spawned.
    if os.environ.get("LOOK_AI_BROKER_PROCESS")=="1":
        return True
    if _ai_broker_start():
        return bool(_ai_broker_request("wake",kind=kind))
    return False


def _ai_foreground(active, label="interactive"):
    """Foreground lease: broker will not START maintenance while this is fresh."""
    if active:
        try:
            _atomic_json(AI_FOREGROUND_FILE,{"pid":os.getpid(),"label":label,"time":time.time()})
        except Exception:
            pass
        _ai_broker_request("foreground",active=True,label=label,pid=os.getpid())
    else:
        try: AI_FOREGROUND_FILE.unlink()
        except OSError: pass
        _ai_broker_request("foreground",active=False,pid=os.getpid())


