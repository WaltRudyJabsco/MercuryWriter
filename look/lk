    media_ext={".mp4",".mkv",".mov",".avi",".m4v",".webm",".mp3",".m4a",".flac",".wav",".ogg"}
    if intent=="play" or target.suffix.casefold() in media_ext:
        player=_preferred_media_player()
        if player:
            if sys.platform=="darwin":
                proc=subprocess.Popen(["open","-a",player,str(target)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            else:
                proc=subprocess.Popen([player,str(target)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            # A successful launcher handoff is observable; playback is not.
            time.sleep(0.04)
            if proc.poll() not in (None,0):
                return f"DISPATCH FAILED · {target} · {player} · launcher exit {proc.returncode}"
            return f"DISPATCH OK · {target} · {player}"
    return _open_host_path(target)


