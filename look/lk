def _mutate_file(path, action):
    """Explicit file mutation from the file card; all local LOOK mutations share one undo journal."""
    p=Path(path)
    if action in {"move","copy","send"}:
        label={"move":"to","copy":"to","send":"to (host:path)"}[action]
        try:
            dest,cancelled=_prompt_line(f"{label} › ")
        except KeyboardInterrupt:
            return
        dest=dest.strip()
        if cancelled or not dest:
            return
        if action=="move":
            print(_journal_move(p,dest))
        elif action=="copy":
            print(_journal_copy(p,dest))
        else:
            cmd=["scp",str(p),dest]
            if p.is_dir(): cmd=["scp","-r",str(p),dest]
            subprocess.call(cmd)
        return
    if action=="remove":
        try:
            answer,cancelled=_prompt_line(f"remove {p.name}? [r confirms · Esc/Enter cancels] › ")
        except KeyboardInterrupt:
            return
        if cancelled or answer.strip().lower()!="r":
            return
        print(_journal_remove(p))


def _file_card_lines(p):
    p=Path(p).expanduser().resolve()
    st=p.stat()
    kind=_run_text(['file','-b',str(p)]) if shutil.which('file') else ''
    lines=[
        f"{p.name} · file",
        "",
        f"  path     {p}",
        f"  size     {_human_size(st.st_size)}",
        f"  mode     {oct(st.st_mode & 0o777)}",
        f"  modified {time.strftime('%Y-%m-%d %H:%M', time.localtime(st.st_mtime))}",
    ]
    if kind:
        lines.append(f"  type     {kind}")
    lines += _file_preview_lines(p,kind)
    return lines


def inspect_file(path):
    """Interactive file card: inspect first, act only on explicit keypress."""
    p=Path(path).expanduser().resolve()
    try:
        lines=_file_card_lines(p)
    except OSError as exc:
        print(f"LOOK · {p.name}\n  {_c('✗','31')} {exc}")
        return 1

    # Non-interactive output stays composable.
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("\n".join(lines))
        return 0

    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    top=0
    try:
        tty.setcbreak(fd)
        while True:
            height=max(8,shutil.get_terminal_size((90,28)).lines)
            page_size=max(3,height-3)
            max_top=max(0,len(lines)-page_size)
            os.system("clear")
            visible=lines[top:top+page_size]
            print("\n".join(visible))
            if len(lines)>page_size:
                print(_c(f"{min(top+page_size,len(lines))}/{len(lines)} · j/k ↑/↓ · Space/b page", "2"))
            print(
                f"{_c('Enter','36')} open  {_c('E','36')} edit  {_c('Y','36')} copy path  "
                f"{_c('P','36')} print path  {_c('M','36')} move  {_c('C','36')} copy  "
                f"{_c('S','36')} send  {_c('R','31')} remove  {_c('q','2')} quit"
            )
            sys.stdout.flush()

            ch=os.read(fd,1)
            key=ch.decode("utf-8","ignore")
            if ch==b"\x1b":
                seq=bytearray(ch)
                while len(seq)<6:
                    ready,_,_=select.select([fd],[],[],0.08)
                    if not ready: break
                    seq.extend(os.read(fd,1))
                    if seq[-1:] in b"~ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz": break
                key={b"\x1b[A":"up",b"\x1b[B":"down",b"\x1b[5~":"pageup",b"\x1b[6~":"pagedown"}.get(bytes(seq),"esc")

            if key in {"q","esc"}: break
            if key in {"j","down"}: top=min(max_top,top+1); continue
            if key in {"k","up"}: top=max(0,top-1); continue
            if key in {" ","pagedown"}: top=min(max_top,top+page_size); continue
            if key in {"b","pageup"}: top=max(0,top-page_size); continue

            # Restore cooked mode while an external app/prompt owns the terminal.
            termios.tcsetattr(fd,termios.TCSADRAIN,old)
            if key in {"\r","\n"}: _open_file(p)
            elif key=="E": _edit_file(p)
            elif key=="B":
                print("copied file to clipboard" if _copy_file_clipboard(p) else "file clipboard unavailable")
                input("press Enter › ")
            elif key=="Y":
                print("copied" if _copy_path(p) else str(p))
                input("press Enter › ")
            elif key=="P":
                print(str(p))
                return 0
            elif key=="M":
                _mutate_file(p,"move")
                if not p.exists(): return 0
            elif key=="C": _mutate_file(p,"copy")
            elif key=="S": _mutate_file(p,"send")
            elif key=="R":
                _mutate_file(p,"remove")
                if not p.exists(): return 0
            old=termios.tcgetattr(fd)
            tty.setcbreak(fd)
    finally:
        try: termios.tcsetattr(fd,termios.TCSADRAIN,old)
        except Exception: pass
    return 0

def inspect_anything(term):
    """Human-first classification for `lk <anything>`. Paths always win."""
    if term.lower()=="xyzzy":
        print(_c("A hollow voice says: magic hands.", "35"))
        return 0
    expanded=Path(term).expanduser()
    if expanded.exists():
        if expanded.is_dir(): return render([str(expanded)])
        return inspect_file(expanded)
    if term.isdigit():
        n=int(term)
        if 1 <= n <= 65535: return inspect_port(n)
    if shutil.which(term): return inspect_command(term)
    proc=inspect_process(term)
    if proc is not None: return proc
    print(f"LOOK · don't know how to inspect {_c(term, '1;36')}")
    print(f"  {_c('hint','33')} path · command · port · process, or try lk help")
    return 1



