def inspect_disk():
    _title('disk')
    seen=set()
    for label,path in [('cwd',_safe_cwd()),('home',HOME)]:
        try:
            usage=shutil.disk_usage(path)
        except OSError:
            continue
        key=(usage.total,usage.free)
        if key in seen: continue
        seen.add(key)
        used=usage.total-usage.free
        pct=(used/usage.total*100) if usage.total else 0
        print(f"  {label:<5} {path}")
        print(f"        {used/(1024**3):.0f} GB used · {usage.free/(1024**3):.0f} GB free · {usage.total/(1024**3):.0f} GB total · {pct:.0f}%")
    return 0


def _process_rows(term=None):
    text=_run_text(['ps','-axo','pid=,command='],2)
    rows=[]
    for line in text.splitlines():
        stripped=line.strip()
        if not stripped: continue
        parts=stripped.split(None,1)
        if not parts or not parts[0].isdigit(): continue
        pid=parts[0]; command=parts[1] if len(parts)>1 else ''
        if int(pid)==os.getpid(): continue
        if term and term.lower() not in stripped.lower(): continue
        rows.append((command[:72] or "process",pid))
    return rows

def inspect_process(term):
    """Best-effort process-name lookup with selectable PID values."""
    rows=_process_rows(term)
    if not rows: return None
    return _select_values(f"{term} · process",rows)

