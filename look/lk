def _preferred_model_for_base(base=None, installed=None, running=None):
    """Resolve the model preference in the same scope as the Ollama endpoint.

    Local preference belongs to this machine. Legacy remote/direct hosts keep a
    separate machine-local preference so choosing a 3090 model can never change
    the M4's local fallback model.
    """
    env=os.environ.get("LOOK_OLLAMA_MODEL","").strip()
    if env:
        return env
    base=_normalize_ollama_url(base or LOCAL_OLLAMA_URL)
    if _is_local_ollama(base):
        return _active_ollama_model()
    prefs=_load_ollama_host_models()
    preferred=str(prefs.get(base) or "").strip()
    if preferred:
        return preferred
    # Old releases had one global model preference. Reuse it only when the
    # remote host actually has that model; otherwise prefer a resident model.
    active=_active_ollama_model()
    installed_names=[(m.get("name") or m.get("model") or "").strip() for m in (installed or [])]
    installed_names=[x for x in installed_names if x]
    if active and active in installed_names:
        return active
    running_names=[(m.get("name") or m.get("model") or "").strip() for m in (running or [])]
    running_names=[x for x in running_names if x]
    if running_names:
        return running_names[0]
    if installed_names:
        return installed_names[0]
    return active


def _save_model_preference_for_base(base,model):
    base=_normalize_ollama_url(base or LOCAL_OLLAMA_URL)
    if _is_local_ollama(base):
        _save_active_ollama_model(model)
        return
    prefs=_load_ollama_host_models()
    prefs[base]=str(model).strip()
    _save_ollama_host_models(prefs)


