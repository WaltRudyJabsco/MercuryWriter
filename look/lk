def _run_system_inspection_tool(name,args):
    if name=="list_processes":
        query=str(args.get("query","") or "").casefold().strip()
        rows=_process_rows(query or None)
        if not rows:
            return "No matching processes."
        shown=rows[:60]
        body="\\n".join(f"{pid}\\t{command}" for command,pid in shown)
        if len(rows)>len(shown):
            body+=f"\\n… {len(rows)-len(shown)} more"
        return body
    if name=="listening_ports":
        port=args.get("port")
        try:
            port=int(port) if port not in (None,"") else None
        except (TypeError,ValueError):
            return "Port must be an integer."
        text=""
        if shutil.which("lsof"):
            cmd=["lsof","-nP","-iTCP","-sTCP:LISTEN"]
            text=_run_text(cmd,2)
        elif shutil.which("ss"):
            text=_run_text(["ss","-ltnp"],2)
        if not text:
            return "No listener information available."
        rows=text.splitlines()
        if port is not None:
            token=f":{port}"
            header=rows[:1]
            rows=header+[line for line in rows[1:] if token in line] if rows else []
        if not rows or (port is not None and len(rows)<=1):
            return f"No listening process found on TCP port {port}."
        return "\\n".join(rows[:80])
    if name=="system_snapshot":
        usage=shutil.disk_usage(HOME)
        mem="unknown"
        if platform.system()=="Darwin":
            raw=_run_text(["sysctl","-n","hw.memsize"])
            if raw.isdigit(): mem=f"{int(raw)/(1024**3):.1f} GB"
        elif Path("/proc/meminfo").exists():
            m=re.search(r"MemTotal:\\s+(\\d+)",Path("/proc/meminfo").read_text())
            if m: mem=f"{int(m.group(1))*1024/(1024**3):.1f} GB"
        try: load=f"{os.getloadavg()[0]:.2f}"
        except (AttributeError,OSError): load="unknown"
        return (
            f"host={platform.node()}\\n"
            f"os={platform.system()} {platform.release()}\\n"
            f"arch={platform.machine()}\\n"
            f"load1={load}\\n"
            f"memory={mem}\\n"
            f"disk_free={usage.free/(1024**3):.1f} GB\\n"
            f"ollama={'available' if shutil.which('ollama') else 'not found'}\\n"
            f"tailscale={'available' if shutil.which('tailscale') else 'not found'}"
        )
    return f"Unknown system inspection tool: {name}"


