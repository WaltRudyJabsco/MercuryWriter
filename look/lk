def _vision_parse_seconds(value, default):
    if value is None:
        return float(default)
    text=str(value).strip().casefold()
    match=re.fullmatch(r"(\d+(?:\.\d+)?)\s*([sm]?)",text)
    if not match:
        raise ValueError(f"invalid duration: {value}")
    amount=float(match.group(1)); unit=match.group(2) or "s"
    return amount*(60.0 if unit=="m" else 1.0)


def _vision_screen_fetch(node="", previous_hash="", max_width=1600, quality=72):
    params={"max_width":str(int(max_width)),"quality":str(int(quality))}
    if node:
        params["node"]=str(node)
    if previous_hash:
        params["previous_hash"]=str(previous_hash)
    url="http://127.0.0.1:7332/v1/vision/screen?"+urllib.parse.urlencode(params)
    try:
        with urllib.request.urlopen(url,timeout=22) as response:
            payload=json.loads(response.read(10*1024*1024).decode("utf-8","replace"))
    except urllib.error.HTTPError as exc:
        try:
            payload=json.loads(exc.read(8192).decode("utf-8","replace") or "{}")
        except Exception:
            payload={"error":str(exc)}
        raise RuntimeError(str(payload.get("error") or exc))
    if not isinstance(payload,dict) or not payload.get("ok"):
        raise RuntimeError(str((payload or {}).get("error") or "screen capture failed"))
    return payload


def _vision_frame_bytes(payload):
    encoded=str((payload or {}).get("image_base64") or "")
    if not encoded:
        return None
    try:
        return base64.b64decode(encoded,validate=True)
    except Exception as exc:
        raise RuntimeError(f"invalid screen frame: {exc}")


def _vision_frame_suffix(mime):
    return ".webp" if str(mime)=="image/webp" else ".png"


def _vision_save_frame(data, mime, destination):
    path=Path(destination).expanduser()
    if not path.suffix:
        path=path.with_suffix(_vision_frame_suffix(mime))
    path.parent.mkdir(parents=True,exist_ok=True)
    path.write_bytes(data)
    return path.resolve()


