def _settings_file_access_menu():
    rules=_load_path_access()
    if not shutil.which("fzf") or not (sys.stdin.isatty() and sys.stdout.isatty()):
        return _access_command([])
    options=[
        ("personal","Allow Desktop/Documents/Downloads read + write"),
        ("add","Add another folder grant"),
        ("remove","Remove a persistent folder grant"),
        ("list","Inspect current grants"),
        ("clear","Clear persistent + session grants"),
    ]
    payload="\n".join(f"{key}\t{label}" for key,label in options)+"\n"
    result=subprocess.run(
        ["fzf","--prompt","file access › ","--header",f"{len(rules)} persistent grant(s) · Enter choose · Esc back",
         "--height","~45%","--reverse","--no-multi","--delimiter","\t","--with-nth","2..",
         "--border=rounded"],
        input=payload,text=True,capture_output=True
    )
    if result.returncode!=0 or not result.stdout.strip():
        return 0
    action=result.stdout.split("\t",1)[0].strip()
    if action in {"personal","list","clear"}:
        if action=="clear" and not _confirm("Clear all LO file grants? [y/N] "):
            return 0
        return _access_command([action] if action!="list" else [])
    if action=="remove":
        rules=_load_path_access()
        if not rules:
            print("LO access · no persistent grants")
            return 0
        choices="\n".join(f"{r['path']}\t{r['path']} · {'/'.join(r.get('capabilities',[]))}" for r in rules)+"\n"
        picked=subprocess.run(
            ["fzf","--prompt","remove grant › ","--header","Enter remove · Esc back",
             "--height","~45%","--reverse","--no-multi","--delimiter","\t","--with-nth","2..",
             "--border=rounded"],
            input=choices,text=True,capture_output=True
        )
        if picked.returncode!=0 or not picked.stdout.strip(): return 0
        return _access_command(["remove",picked.stdout.split("\t",1)[0].strip()])
    if action=="add":
        try:
            path=input("folder path › ").strip()
        except (EOFError,KeyboardInterrupt):
            print(); return 0
        if not path: return 0
        cap=_settings_pick_choice("capability","write",[
            ("read","read only"),("write","read + write"),
        ],lambda args: args[0] if args else "write")
        # _settings_pick_choice normally returns a callback's result; this lambda
        # intentionally returns the selected string.
        if cap not in {"read","write"}: cap="write"
        return _access_command(["add",path,cap])
    return 0


