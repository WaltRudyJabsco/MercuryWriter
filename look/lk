    if args[0]=="sound":
        value=(args[1].casefold() if len(args)>1 else ("subtle" if cfg["sound"]=="off" else "off"))
        if value in {"on","true"}: value="subtle"
        if value not in {"off","subtle","expressive"}: print("usage: lk feedback sound off|subtle|expressive"); return 2
        cfg["sound"]=value; _save_feedback(cfg); print(f"LOOK sound · {value}")
        if value!="off": _feedback("accept","sound on")
