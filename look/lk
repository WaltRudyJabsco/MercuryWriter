    if clear and sys.stdout.isatty():
        sys.stdout.write("\033[2J\033[H"); sys.stdout.flush()
    label=node or "local"
    size=int((meta or {}).get("bytes") or len(data))
    provider=((meta or {}).get("provider") or {}).get("name") or "screen"
    print(f"FABRIC VISION · {label} · {provider} · {size/1024:.0f} KiB · ephemeral")
    if not chafa:
        print("  frame captured · install chafa for terminal preview, or use --save / --ask")
        return
    width=max(40,min(120,shutil.get_terminal_size((100,30)).columns-2))
    height=max(12,min(38,shutil.get_terminal_size((100,30)).lines-4))
    with tempfile.TemporaryDirectory(prefix="look-vision-") as temp:
        path=Path(temp)/("frame"+_vision_frame_suffix(mime))
        path.write_bytes(data)
        subprocess.run([chafa,"--format=symbols","--colors","full","--color-space","rgb","--size",f"{width}x{height}",str(path)],check=False)


def _vision_screen_command(args):
    node=""; ask=""; save=""; watch=None; every=5.0; max_width=1600; quality=72
    i=0
    while i<len(args):
        token=args[i]
        if token.startswith("@") and len(token)>1 and not node:
            node=token[1:]; i+=1; continue
        if token=="--node" and i+1<len(args):
            node=args[i+1].lstrip("@"); i+=2; continue
        if token=="--ask":
            i+=1; parts=[]
            while i<len(args) and not args[i].startswith("--"):
                parts.append(args[i]); i+=1
            ask=" ".join(parts).strip() or "Describe what is happening on this screen and flag anything that looks wrong."
            continue
        if token=="--save" and i+1<len(args):
            save=args[i+1]; i+=2; continue
        if token=="--watch":
            if i+1<len(args) and not args[i+1].startswith("-"):
                watch=_vision_parse_seconds(args[i+1],30); i+=2
            else:
                watch=30.0; i+=1
            continue
        if token=="--every" and i+1<len(args):
            every=_vision_parse_seconds(args[i+1],5); i+=2; continue
        if token=="--max-width" and i+1<len(args):
            max_width=int(args[i+1]); i+=2; continue
        if token=="--quality" and i+1<len(args):
            quality=int(args[i+1]); i+=2; continue
        if token in {"-h","--help"}:
            print("usage: lk vision screen [@NODE] [--ask QUESTION] [--save FILE] [--watch [30s]] [--every 5s] [--max-width 1600] [--quality 72]")
            return 0
        if not node and token not in {"local","self"}:
            node=token; i+=1; continue
        print(f"LOOK VISION · unknown option: {token}"); return 2

    if watch is not None:
        watch=max(2.0,min(600.0,float(watch))); every=max(2.0,min(60.0,float(every)))
        if ask:
            print("LOOK VISION · --ask is one-shot; omit --watch when asking the model")
            return 2
        deadline=time.monotonic()+watch; previous=""; mime="image/webp"; changes=0; polls=0
        print(f"FABRIC VISION · watching {node or 'local'} for {watch:g}s · every {every:g}s · Ctrl-C stops")
        try:
            while True:
                polls+=1
                payload=_vision_screen_fetch(node,previous,max_width,quality)
                previous=str(payload.get("hash") or previous)
                incoming=_vision_frame_bytes(payload)
                if incoming is not None:
                    mime=str(payload.get("mime") or mime); changes+=1
                    _vision_terminal_preview(incoming,mime,node or str(payload.get("node") or "local"),payload,clear=True)
                    print(f"WATCH · changed frame {changes} · poll {polls} · Ctrl-C stops")
                    if save:
                        saved=_vision_save_frame(incoming,mime,save)
                        print(f"LATEST · {saved}")
                else:
                    print(f"\rWATCH · unchanged · poll {polls} · Ctrl-C stops",end="",flush=True)
                remaining=deadline-time.monotonic()
                if remaining<=0:
                    break
                time.sleep(min(every,remaining))
        except KeyboardInterrupt:
            print()
        print(f"FABRIC VISION · stopped · {polls} polls · {changes} changed frame{'s' if changes!=1 else ''} · nothing retained remotely")
        return 0

    try:
        payload=_vision_screen_fetch(node,"",max_width,quality)
        data=_vision_frame_bytes(payload)
        if data is None:
            raise RuntimeError("capture returned no frame")
    except Exception as exc:
        print(f"LOOK VISION · {node or 'local'} · {exc}")
        return 1

    label=node or str(payload.get("node") or "local")
    mime=str(payload.get("mime") or "image/png")
    if save:
        saved=_vision_save_frame(data,mime,save)
        print(f"FABRIC VISION · saved {label} → {saved}")
    if ask:
        try:
            text,model=_vision_model_answer(data,ask,label)
        except Exception as exc:
            print(f"LOOK VISION · {exc}")
            return 1
        print(f"{_ansi_label('vision ›','35')} {label} · {model}")
        print(text or "(no response)")
        return 0
    _vision_terminal_preview(data,mime,label,payload)
    return 0


def vision_command(args):
    """One-shot image understanding plus user-initiated Fabric screen vision."""
    if not args:
        print("usage: lk vision IMAGE [QUESTION...] | lk vision screen [@NODE] [OPTIONS]")
        return 2
    if str(args[0]).casefold() in {"screen","desktop","fabric"}:
        return _vision_screen_command(list(args[1:]))
    image=Path(args[0]).expanduser()
    if not image.exists():
        print(f"LOOK VISION · not found: {image}")
        return 1
    question=" ".join(args[1:]).strip() or "Describe this image carefully."
    try:
        text,model=_vision_model_answer(image.read_bytes(),question,str(image.resolve()))
    except Exception as exc:
        print(f"LOOK VISION · {exc}")
        if "does not advertise vision" in str(exc):
            print("  choose a vision-capable model with `lk ollama models`")
        return 1
    print(f"{_ansi_label('vision ›','35')} {image.resolve()} · {model}")
    print(text or "(no response)")
    return 0

def _load_ollama_model_prefs():
    try:
        data=json.loads(OLLAMA_MODELS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        data={}
    disabled=data.get("disabled",[])
    return {str(name) for name in disabled if str(name).strip()}


def _save_ollama_model_prefs(disabled):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp=OLLAMA_MODELS_FILE.with_suffix(".tmp")
    tmp.write_text(
        json.dumps({"disabled":sorted(disabled)}, indent=2)+"\n",
        encoding="utf-8",
    )
    os.chmod(tmp,0o600)
    tmp.replace(OLLAMA_MODELS_FILE)
    os.chmod(OLLAMA_MODELS_FILE,0o600)


def _ollama_set_model(base, model):
    """Unload resident models, preload the selected one, and remember the choice."""
    running=_ollama_ps(base)
    for item in running:
        name=(item.get("name") or item.get("model") or "").strip()
        if name and name != model:
            try:
                _ollama_post(base, "/api/generate", {"model":name, "keep_alive":0}, timeout=30)
            except Exception:
                pass

    # An empty generation request loads the model without asking it to answer.
    _ollama_post(base, "/api/generate", {"model":model, "prompt":"", "keep_alive":"10m"}, timeout=180)
    _save_model_preference_for_base(base,model)
    return model


def _model_capability_label(caps):
    if caps is None:
        return "capabilities ?"
    useful=[c for c in ("tools","thinking","vision","embedding","completion") if c in caps]
    return " · ".join(useful) if useful else "text"


def _ollama_model_rows(base, names, loaded, disabled):
    rows=[]
    selected_name=_preferred_model_for_base(base, installed=[{"name":n} for n in names], running=[{"name":n} for n in loaded])
    width=max(64,shutil.get_terminal_size((100,24)).columns)
    # Leave enough room for TEST/LOAD/SEL glyphs and a useful capability tail.
    name_width=max(18,min(30,width-42))
    for name in names:
        caps=_ollama_capabilities(base,name)
        test_on=name not in disabled
        test_mark=_c("✓","32") if test_on else _c("×","2")
        load_mark=_c("●","32") if name in loaded else " "
        select_mark=_c("★","33") if name == selected_name else " "
        raw_name=name if len(name)<=name_width else name[:max(1,name_width-1)]+"…"
        padded=f"{raw_name:<{name_width}}"
        shown_name=_c(padded,"1") if name == selected_name else padded
        raw_label=_model_capability_label(caps)
        if raw_label=="capabilities ?":
            label=_c("?","2")
        else:
            short={"completion":"text","embedding":"embed"}
            parts=[]
            for cap in raw_label.split(" · "):
                shown=short.get(cap,cap)
                code={"tools":"36","thinking":"35","vision":"33"}.get(cap,"2")
                parts.append(_c(shown,code))
            label=" · ".join(parts)
        # Columns: TEST LOAD SEL MODEL CAPABILITIES.
        display=f"{test_mark:^4} {load_mark:^4} {select_mark:^3} {shown_name} {label}"
        rows.append((name,display,caps))
    return rows


def ollama_models(select_model=None, base_override=None):
    """Select a model on one Ollama endpoint without leaking preference across hosts."""
    base=_normalize_ollama_url(base_override) if base_override else _ollama_base()
    if _ensure_ollama_server(base, allow_start=_is_local_ollama(base)) is None:
        print("LOOK OLLAMA · server unavailable")
        return 1

    try:
        installed=_ollama_tags(base)
        running=_ollama_ps(base)
    except Exception as exc:
        print(f"LOOK OLLAMA · {exc}")
        return 1

    names=[(m.get("name") or m.get("model") or "").strip() for m in installed]
    names=[n for n in names if n]
    loaded={(m.get("name") or m.get("model") or "").strip() for m in running}
    loaded.discard("")
    disabled=_load_ollama_model_prefs()
    valid=set(names)
    pruned=disabled-valid
    if pruned:
        disabled &= valid
        _save_ollama_model_prefs(disabled)

    if not names:
        print("LOOK OLLAMA · no installed models")
        return 1

    if select_model:
        if select_model not in names:
            print(f"LOOK OLLAMA · model not installed: {select_model}")
            return 1
        chosen=select_model
    elif sys.stdin.isatty() and sys.stdout.isatty() and shutil.which("fzf"):
        chosen=None
        while chosen is None:
            rows=_ollama_model_rows(base,names,loaded,disabled)
            payload="\n".join(f"{name}\t{display}" for name,display,_ in rows)+"\n"
            result=subprocess.run(
                [
                    "fzf",
                    "--prompt","model › ",
                    "--header","TEST LOAD SEL  MODEL  CAPABILITIES\nEnter select · X test on/off · ● loaded · ★ selected",
                    "--height","~70%",
                    "--reverse",
                    "--info","inline",
                    "--no-multi",
                    "--delimiter","\t",
                    "--with-nth","2..",
                    "--ansi",
                    "--expect","x,X,enter",
                ],
                input=payload, text=True, capture_output=True
            )
            if result.returncode != 0 or not result.stdout.strip():
                return 0
            lines=result.stdout.rstrip("\r\n").splitlines()
            key=lines[0].lower() if lines else ""
            selected=lines[1] if len(lines)>1 else ""
            model=selected.split("\t",1)[0].strip()
            if not model:
                return 0
            if key=="x":
                if model in disabled:
                    disabled.remove(model)
                else:
                    disabled.add(model)
                _save_ollama_model_prefs(disabled)
                # Re-read persisted state so redraw reflects disk truth, not only RAM.
                disabled=_load_ollama_model_prefs()
                continue
            chosen=model
    else:
        rows=_ollama_model_rows(base,names,loaded,disabled)
        _title("ollama models")
        print(f"  TEST {_c('✓','32')}/{_c('×','2')} · LOAD {_c('●','32')} · SELECT {_c('★','33')}")
        for _,display,_ in rows:
            print(f"  {display}")
        return 0

    try:
        with _activity(f"loading {chosen}"):
            _ollama_set_model(base, chosen)
    except Exception as exc:
        print(f"LOOK OLLAMA · could not load {chosen}: {exc}")
        return 1

    caps=_ollama_capabilities(base,chosen)
    suffix=f" · {_model_capability_label(caps)}"
    if chosen in disabled:
        suffix+=" · test off"
    print(f"LOOK OLLAMA · {_c(chosen,'1;32')} selected{suffix}")
    return 0


def _benchmark_guard(active, ttl=3600):
    """Best-effort local node guard so background model management cannot contaminate a sweep."""
    if not _is_local_ollama(_ollama_base()):
        return False
    payload={"active":bool(active),"ttl":int(ttl),"reason":"lk ollama test"}
    try:
        req=urllib.request.Request(
            "http://127.0.0.1:7332/v1/models/benchmark-guard",
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type":"application/json"}, method="POST")
        with urllib.request.urlopen(req,timeout=3) as response:
            json.loads(response.read().decode("utf-8","replace"))
        return True
    except Exception:
        return False


def _unload_all_ollama(base):
    """Unload every resident Ollama model on one endpoint; used only by isolated benchmarks."""
    try:
        running=_ollama_ps(base)
    except Exception:
        running=[]
    for item in running:
        name=(item.get("name") or item.get("model") or "").strip()
        if not name:
            continue
        try:
            _ollama_post(base,"/api/generate",{"model":name,"keep_alive":0},timeout=30)
        except Exception:
            pass


def _restore_resident_set(base, names):
    """Restore the pre-benchmark warm set at the canonical 4096 context."""
    _unload_all_ollama(base)
    restored=[]
    for name in names:
        try:
            _ollama_post(base,"/api/generate",{
                "model":name,"prompt":"","stream":False,"keep_alive":-1,
                "options":{"num_ctx":4096},
            },timeout=180)
            restored.append(name)
        except Exception:
            pass
    return restored


def _benchmark_tool(name, description, properties, required):
