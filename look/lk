        if has('main.py'): actions.append(('start','python main.py'))
        elif has('app.py'): actions.append(('start','python app.py'))
    if has('Cargo.toml'):
        kinds.append('Rust'); actions += [('run','cargo run'),('test','cargo test'),('build','cargo build')]
    if has('Makefile'):
        kinds.append('Make'); actions.append(('targets','make -n <target>'))
    if has('docker-compose.yml') or has('compose.yml') or has('compose.yaml'):
        kinds.append('Docker Compose'); actions.append(('start','docker compose up'),('stop','docker compose down'))
    if has('Dockerfile'):
