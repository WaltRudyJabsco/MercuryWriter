def _reflect_on_feedback(base,model,job):
    polarity=str(job.get("polarity",""))
    learned=_learned_skills()
    existing="\n".join(f"- {x}" for x in learned) or "(none)"
    prompt=f"""The user gave {polarity.upper()} feedback about the immediately preceding completed interaction.

PREVIOUS REQUEST:
{job.get('request','')}

PREVIOUS ANSWER:
{job.get('answer','')}

USER FEEDBACK:
{job.get('feedback','')}

EXISTING LEARNED SKILLS:
{existing}

Decide whether there is one genuinely reusable operational lesson.

Return exactly ONE line:
NONE
NEW|general reusable lesson
REINFORCE|exact existing skill
WEAKEN|exact existing skill
CORRECT|general corrective lesson

Rules:
- Praise/criticism itself is not a skill.
- Never store user facts, filenames, project-specific facts, or wording/style mimicry.
- REINFORCE/WEAKEN only when one existing skill clearly applies to the success/failure.
- NEW/CORRECT only for craft useful on many future tasks.
- Prefer NONE over speculation.
- Maximum lesson length 40 words.
"""
    raw=_local_chat_once(base,model,[
        {"role":"system","content":"You are a conservative background reviewer improving reusable assistant craft. Output exactly one action line."},
        {"role":"user","content":prompt},
    ],num_ctx=6144,num_predict=120,think=False,temperature=0.1)
    final=_strip_reasoning_payload(raw).strip()
    m=re.fullmatch(r"\s*(NONE|NEW|REINFORCE|WEAKEN|CORRECT)(?:\|(.*))?\s*",final,re.I)
    if not m:
        return "none",None
    action=m.group(1).lower()
    payload=(m.group(2) or "").strip()
    if action=="none":
        return action,None
    if action in {"reinforce","weaken"}:
        skill=_find_learned_skill(payload)
        return action,skill
    skill=_sanitize_skill(payload)
    return action,skill or None


