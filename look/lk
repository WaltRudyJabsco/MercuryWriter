def _media_row_label(row):
    artist=str(row.get("artist") or "").strip()
    album=str(row.get("album") or "").strip()
    title=str(row.get("title") or Path(str(row.get("path") or "media")).name).strip()
    track=row.get("track")
    prefix=f"{track:02d} " if isinstance(track,int) else ""
