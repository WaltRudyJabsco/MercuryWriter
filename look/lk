    return main


def _strip_ansi(text):
    return re.sub(r"\x1b\[[0-9;?]*[ -/]*[@-~]", "", str(text))


def _terminal_frame_payload(frame):
    """Replace a terminal frame without exposing blank/stale cells between frames.

    Each logical row erases its own old remainder. Clearing only after the final
    cursor position leaves suffixes like `LOGICALical` when a new row is shorter.
    """
    rows=str(frame or "").split("\n")
    return "\033[H"+"\n".join(row+"\033[K" for row in rows)+"\033[J"

def _ansi_clip(text,width):
    """Clip terminal-symbol art by visible cells without cutting ANSI CSI sequences."""
    width=max(0,int(width))
    if width<=0: return ""
    raw=str(text or "")
    token_re=re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|.",re.S)
    out=[]; visible=0; clipped=False
    for match in token_re.finditer(raw):
        token=match.group(0)
        if token.startswith("\x1b["):
            out.append(token)
            continue
        if visible>=width:
            clipped=True
            break
        out.append(token); visible+=1
    if clipped or "\x1b[" in raw:
        out.append("\x1b[0m")
    return "".join(out)


def _media_art_source(row):
    """Return the first real local media file represented by a catalog row.

    Artwork must never depend on Fabric reachability when the bytes already exist
    locally. The primary path gets the old 8.3.18 fast path; physical sources and
    locations are fallbacks for collapsed logical rows and player queue entries.
    """
    if not isinstance(row,dict): return ""
    ordered=[]
    primary=str(row.get("path") or "").strip()
    if primary: ordered.append(primary)
    for key in ("sources","locations"):
        for item in row.get(key) or []:
            if isinstance(item,dict):
                raw=str(item.get("path") or "").strip()
                if raw: ordered.append(raw)
    seen=set()
    for raw in ordered:
        if raw in seen or raw.startswith(("http://","https://")): continue
        seen.add(raw)
        try:
            path=Path(raw).expanduser()
            if path.is_file(): return str(path.resolve())
        except (OSError,RuntimeError):
            continue
    return ""



def _media_remote_preview_identity(row):
    """Return the remote owner identity needed for a source-local terminal preview.

    Artwork must follow the same routing decision as playback.  Prefer explicit
    catalog metadata, then derive identity from the exact loopback media URL that
    `_media_entry_source()` would hand to mpv.  If remote audio can play, this keeps
    preview routing from independently choosing (or losing) a different owner.
    """
    if not isinstance(row,dict): return None
    candidates=[]
    art=row.get("art")
    if isinstance(art,dict): candidates.append(dict(art))
    candidates.append({k:row.get(k) for k in ("node","id","path","mtime")})
    for key in ("sources","locations"):
        for item in row.get(key) or []:
            if isinstance(item,dict):
                merged=dict(item)
                if not merged.get("node"): merged["node"]=row.get("node")
                if not merged.get("id"): merged["id"]=row.get("id")
                candidates.append(merged)
    local=_media_local_node_names()
    for item in candidates:
        node=str(item.get("node") or "").strip(); entry_id=str(item.get("id") or "").strip()
        if node and entry_id and node.casefold() not in local:
            return {"node":node,"id":entry_id,"path":str(item.get("path") or ""),
                    "mtime":item.get("mtime") or row.get("mtime") or ""}

    # Last authority: use the very source resolution that already makes playback
    # work.  This is especially important for normalized queue rows where the small
    # artwork envelope may be absent/stale but Fabric streaming still resolves.
    try:
        source=_media_entry_source(row)
        parsed=urllib.parse.urlparse(source)
        if parsed.hostname in {"127.0.0.1","localhost"} and parsed.path=="/v1/media/item":
            q=urllib.parse.parse_qs(parsed.query)
            node=str((q.get("node") or [""])[0]).strip()
            entry_id=str((q.get("id") or [""])[0]).strip()
            path=str((q.get("path") or [""])[0])
            if node and entry_id and node.casefold() not in local:
                return {"node":node,"id":entry_id,"path":path,"mtime":row.get("mtime") or ""}
    except Exception:
        pass
    return None

def _media_remote_preview_key(row,width,height):
    ident=_media_remote_preview_identity(row)
    if not ident: return None,None
    raw=f"{ident['node']}|{ident['id']}|{ident['path']}|{ident['mtime']}|{int(width)}x{int(height)}"
    return hashlib.sha256(raw.encode()).hexdigest()[:32],ident

def _media_fetch_remote_preview(row,width,height):
    key,ident=_media_remote_preview_key(row,width,height)
    if not key or not ident: return []
    now=time.monotonic()
    cached=_REMOTE_MEDIA_PREVIEW_CACHE.get(key)
    if cached: return list(cached)
    if now-float(_REMOTE_MEDIA_PREVIEW_MISS.get(key) or 0)<20.0: return []
    url='http://127.0.0.1:7332/v1/preview/terminal?'+urllib.parse.urlencode({
        "node":ident["node"],"id":ident["id"],"path":ident["path"],"width":int(width),"height":int(height)})
    try:
        req=urllib.request.Request(url,headers={"User-Agent":"LOOK-terminal-preview"})
        with urllib.request.urlopen(req,timeout=4.0) as response:
            payload=json.loads(response.read(256*1024).decode("utf-8"))
        lines=payload.get("lines") if isinstance(payload,dict) else None
        if not isinstance(lines,list) or not lines:
            raise ValueError("empty terminal preview")
        clean=[str(line) for line in lines[:max(3,int(height))]]
        _REMOTE_MEDIA_PREVIEW_CACHE[key]=clean
        _REMOTE_MEDIA_PREVIEW_MISS.pop(key,None)
        # Bound memory without creating disk cache on every endpoint.
        while len(_REMOTE_MEDIA_PREVIEW_CACHE)>64:
            _REMOTE_MEDIA_PREVIEW_CACHE.pop(next(iter(_REMOTE_MEDIA_PREVIEW_CACHE)))
        return list(clean)
    except Exception:
        _REMOTE_MEDIA_PREVIEW_MISS[key]=now
        return []

def _media_remote_preview_worker_loop():
    """Resolve only the newest requested remote preview.

    Cursor motion can outrun a network round-trip. One worker prevents an arrow-key
    sweep from creating a convoy of obsolete requests; the pending slot is simply
    replaced by the most recent selection while the current request finishes.
    """
    global _REMOTE_MEDIA_PREVIEW_LATEST,_REMOTE_MEDIA_PREVIEW_WORKER
    while True:
        with _REMOTE_MEDIA_PREVIEW_LOCK:
            task=_REMOTE_MEDIA_PREVIEW_LATEST
            _REMOTE_MEDIA_PREVIEW_LATEST=None
            if task is None:
                _REMOTE_MEDIA_PREVIEW_WORKER=None
                return
        key,row,width,height=task
        _REMOTE_MEDIA_PREVIEW_LOADING.add(key)
        try:
            _media_fetch_remote_preview(row,width,height)
        finally:
            _REMOTE_MEDIA_PREVIEW_LOADING.discard(key)

def _media_queue_remote_preview(row,width,height):
    global _REMOTE_MEDIA_PREVIEW_LATEST,_REMOTE_MEDIA_PREVIEW_WORKER
    key,ident=_media_remote_preview_key(row,width,height)
    if not key or not ident: return False
    if _REMOTE_MEDIA_PREVIEW_CACHE.get(key): return False
    if time.monotonic()-float(_REMOTE_MEDIA_PREVIEW_MISS.get(key) or 0)<20.0: return False
    with _REMOTE_MEDIA_PREVIEW_LOCK:
        # Do not duplicate the in-flight request; otherwise latest selection wins.
        if key not in _REMOTE_MEDIA_PREVIEW_LOADING:
            _REMOTE_MEDIA_PREVIEW_LATEST=(key,dict(row),int(width),int(height))
        if _REMOTE_MEDIA_PREVIEW_WORKER is None or not _REMOTE_MEDIA_PREVIEW_WORKER.is_alive():
            _REMOTE_MEDIA_PREVIEW_WORKER=threading.Thread(target=_media_remote_preview_worker_loop,daemon=True,name="look-media-preview")
            _REMOTE_MEDIA_PREVIEW_WORKER.start()
    return True

def _media_remote_preview_lines(row,width,height,background=False):
    key,ident=_media_remote_preview_key(row,width,height)
    if not key or not ident: return []
    cached=_REMOTE_MEDIA_PREVIEW_CACHE.get(key)
    if cached: return list(cached)
    if not background:
        return _media_fetch_remote_preview(row,width,height)
    _media_queue_remote_preview(row,width,height)
    return []

def _media_remote_preview_state(row,width,height):
    key,ident=_media_remote_preview_key(row,width,height)
    if not key or not ident: return ("local","")
    if _REMOTE_MEDIA_PREVIEW_CACHE.get(key): return ("ready",str(ident.get("node") or "remote"))
    now=time.monotonic()
    if now-float(_REMOTE_MEDIA_PREVIEW_MISS.get(key) or 0)<20.0:
        return ("unavailable",str(ident.get("node") or "remote"))
    with _REMOTE_MEDIA_PREVIEW_LOCK:
        queued=bool(_REMOTE_MEDIA_PREVIEW_LATEST and _REMOTE_MEDIA_PREVIEW_LATEST[0]==key)
    if key in _REMOTE_MEDIA_PREVIEW_LOADING or queued:
        return ("loading",str(ident.get("node") or "remote"))
    return ("idle",str(ident.get("node") or "remote"))

def _media_remote_preview_pending(row,width,height):
    return _media_remote_preview_state(row,width,height)[0]=="loading"

def _media_remote_cover_path(row):
    """Fetch/cache a remote owner's tiny cover asset, never the whole media file."""
    if not isinstance(row,dict): return None
    candidates=[]
    # Queue entries retain this compact identity even after playback has been
    # normalized to a Fabric stream. Prefer it because it names the byte owner.
    art=row.get("art")
    if isinstance(art,dict):
        candidates.append(dict(art))
    primary={k:row.get(k) for k in ("node","id","path","mtime")}
    candidates.append(primary)
    for key in ("sources","locations"):
        for item in row.get(key) or []:
            if isinstance(item,dict):
                merged=dict(item)
                if not merged.get("node"): merged["node"]=row.get("node")
                if not merged.get("id"): merged["id"]=row.get("id")
                candidates.append(merged)
    local_names=_media_local_node_names()
    cache=Path.home()/'.cache'/'look'/'media-art'/'remote'
    try: cache.mkdir(parents=True,exist_ok=True)
    except OSError: return None
    now=time.monotonic()
    for item in candidates:
        node=str(item.get("node") or "").strip()
        entry_id=str(item.get("id") or "").strip()
        path=str(item.get("path") or "").strip()
        if not node or not entry_id or node.casefold() in local_names: continue
        stamp=str(item.get("mtime") or row.get("mtime") or "")
        token=hashlib.sha256(f"{node}|{entry_id}|{path}|{stamp}".encode()).hexdigest()[:28]
        out=cache/f'{token}.jpg'
        try:
            if out.is_file() and out.stat().st_size>0: return out
        except OSError: pass
        miss_key=f"{node}|{entry_id}|{path}"
        if now-float(_REMOTE_MEDIA_ART_MISS.get(miss_key) or 0)<20.0: continue
        url='http://127.0.0.1:7332/v1/media/cover?'+urllib.parse.urlencode({"node":node,"id":entry_id,"path":path})
        tmp=cache/f'.{token}.{os.getpid()}.jpg'
        try:
            req=urllib.request.Request(url,headers={"User-Agent":"LOOK-media-cover"})
            with urllib.request.urlopen(req,timeout=2.0) as response:
                data=response.read(2*1024*1024+1)
            if not data or len(data)>2*1024*1024:
                raise ValueError("invalid media cover size")
            tmp.write_bytes(data)
            tmp.replace(out)
            _REMOTE_MEDIA_ART_MISS.pop(miss_key,None)
            return out
        except Exception:
            _REMOTE_MEDIA_ART_MISS[miss_key]=now
        finally:
            try: tmp.unlink(missing_ok=True)
            except OSError: pass
    return None

def _media_cover_path(row):
    """8.3.18 fast path first; Fabric/source resolution is fallback only."""
    direct=str(row.get("path") or "") if isinstance(row,dict) else ""
    if direct:
        art=media_art.artwork_for(direct)
        if art: return art
    source=_media_art_source(row)
    if source and source!=direct:
        art=media_art.artwork_for(source)
        if art: return art
    return _media_remote_cover_path(row)


def _media_cover_lines(row,width,height=11,background_remote=False):
    """Render local art directly; ask the byte-owning Fabric node for remote terminal rows."""
    direct=str(row.get("path") or "") if isinstance(row,dict) else ""
    if direct:
        lines=media_art.symbol_lines(direct,width,height)
        if lines: return lines
    source=_media_art_source(row)
    if source and source!=direct:
        lines=media_art.symbol_lines(source,width,height)
        if lines: return lines
    # Prefer source-local terminal rendering: tiny text payload, no image/media copy.
    lines=_media_remote_preview_lines(row,width,height,background=background_remote)
    if lines: return lines
    if background_remote:
        # Interactive surfaces must never block navigation on cover transport.
        # Older peers can show no art until upgraded rather than freezing the UI.
        return []
    # Compatibility fallback for non-interactive callers and older peers.
    remote=_media_remote_cover_path(row)
    if remote:
        return media_art.symbol_lines(remote,width,height)
    return []

def _media_player_art_lines(row,width,height=11):
    """Render player art as strict ASCII; Media Find keeps the richer Chafa path."""
    direct=str(row.get("path") or "") if isinstance(row,dict) else ""
    if direct:
        lines=media_art.ascii_lines(direct,width,height)
        if lines: return lines
    source=_media_art_source(row)
    if source and source!=direct:
        return media_art.ascii_lines(source,width,height)
    return []

def _media_detail_lines(row, width=110):
    """Human-readable provenance for one catalog location."""
    path=str(row.get("path") or "—")
    root=str(row.get("root") or "—")
    digest=str(row.get("digest") or "unidentified")
    bits=[
        ("Title", str(row.get("title") or Path(path).name or "—")),
        ("Artist", str(row.get("artist") or "—")),
        ("Album", str(row.get("album") or "—")),
        ("Node", str(row.get("node") or "local")),
        ("Media ID", str(row.get("id") or digest)),
        ("Format", str(row.get("format") or row.get("media_type") or Path(path).suffix.lstrip(".") or "—")),
        ("Size", f"{int(row.get('bytes') or 0):,} bytes"),
        ("Root", root),
        ("Path", path),
        ("Identity", digest),
        ("Available", "yes" if (row.get("node") and row.get("id")) or Path(path).exists() else "unknown"),
    ]
    lines=[f"{name:<10} {value}"[:max(20,width-2)] for name,value in bits]
    sources=row.get("sources") or []
    if len(sources)>1:
        lines.append(f"Sources    {len(sources)} physical copies")
        for src in sources[:5]:
            lines.append((f"  {src.get('node') or 'local'} · {src.get('path') or '—'}")[:max(20,width-2)])
    if row.get("hidden"):
        rules=_media_visibility(); path=str(row.get("path") or "")
        cause=next((root for root in sorted(rules.get("hidden_trees") or [],key=len,reverse=True) if path==str(root).rstrip(os.sep) or path.startswith(str(root).rstrip(os.sep)+os.sep)),"")
        lines.append("Visibility HIDDEN")
        lines.append(("Hidden by  "+(f"directory · {cause}" if cause else "item rule"))[:max(20,width-2)])
    return lines


def _media_queue_append(rows):
    rows=[media_core.queue_entry(row) for row in rows if isinstance(row,dict)]
    if not rows:
        return 0
    session=_media_sync_session() or media_core.new_session([])
    session=media_core.normalize_session(session)
    session["queue"].extend(rows)
    # Queue mutation must be instant and side-effect free for interactive selectors.
    # Do not resolve remote streams or synchronize mpv here; playback reconciles lazily.
    _media_save_session(session)
    return len(rows)


def _media_filter_rows(rows,query):
    """Apply LOOK include/exclude terms to media catalog rows."""
    terms=str(query or "").casefold().split()
    positive=[term for term in terms if not term.startswith("\\")]
    negative=[term[1:] for term in terms if term.startswith("\\") and len(term)>1]
    visible=[]
    for row in rows:
        hay=media_core._haystack(row)
        if all(term in hay for term in positive) and not any(term in hay for term in negative):
            visible.append(row)
    return visible


def _media_visibility_path():
    return STATE_DIR/"media_visibility.json"


def _media_visibility():
    data=_media_read_json(_media_visibility_path(), {"hidden_paths":[],"hidden_trees":[],"fabric_hidden_paths":[],"fabric_hidden_trees":[]})
    # Existing endpoint-local curation stays local. Fabric-wide rules are a separate
    # namespace so a future explicit "hide everywhere" action can synchronize them
    # without silently globalizing years of local choices.
    data.setdefault("hidden_paths",[])
    data.setdefault("hidden_trees",[])
    data.setdefault("fabric_hidden_paths",[])
    data.setdefault("fabric_hidden_trees",[])
    return data


def _media_save_visibility(data):
    _atomic_json(_media_visibility_path(), data)


def _media_is_hidden(row, rules=None):
    rules=rules or _media_visibility()
    path=str(row.get("path") or "")
    if path in set(rules.get("hidden_paths") or []) or path in set(rules.get("fabric_hidden_paths") or []):
        return True
    for key in ("hidden_trees","fabric_hidden_trees"):
        for root in rules.get(key) or []:
            root=str(root).rstrip(os.sep)
            if path==root or path.startswith(root+os.sep): return True
    return False


def _media_logical_key(row):
    if row.get("digest"): return "sha:"+str(row["digest"])
    # Metadata identity deliberately ignores physical path/node. It is only a view
    # collapse; the catalog keeps every source.
    parts=[str(row.get(k) or "").casefold().strip() for k in ("artist","album","title","track","bytes")]
    return "meta:"+"|".join(parts)


def _media_collapse(rows, show_all=False, show_hidden=False):
    rules=_media_visibility(); groups={}
    for row in rows:
        r=dict(row); r["hidden"]=_media_is_hidden(r,rules)
        if r["hidden"] and not show_hidden: continue
        if show_all:
            r["source_count"]=1; r["sources"]=[r]; groups[f"src:{r.get('node')}:{r.get('id')}:{r.get('path')}"]=r; continue
        key=_media_logical_key(r); bucket=groups.setdefault(key,[]); bucket.append(r)
    if show_all: return list(groups.values())
    out=[]
    for bucket in groups.values():
        # Catalog collapse must be pure metadata work. Playback resolves reachability.
        bucket.sort(key=lambda r:(bool(r.get("hidden")), str(r.get("path") or "").casefold()))
        row=dict(bucket[0]); row["sources"]=bucket; row["source_count"]=len(bucket); out.append(row)
    return out


def _media_tree_candidates(row, rows):
    """Selectable ancestors, nearest first, with affected catalog-location counts."""
    path=str(row.get("path") or "")
    if not path: return []
    parent=Path(path).parent
    root_text=str(row.get("root") or "").rstrip(os.sep)
    root=Path(root_text) if root_text else None
    out=[]; seen=set(); current=parent
    while str(current) not in seen:
        seen.add(str(current)); prefix=str(current).rstrip(os.sep)+os.sep
        count=sum(1 for candidate in rows if (cp:=str(candidate.get("path") or ""))==str(current) or cp.startswith(prefix))
        out.append({"path":str(current),"count":count,"media_root":bool(root and current==root)})
        if root and current==root: break
        nxt=current.parent
        if nxt==current: break
        current=nxt
    return out

def _media_choose_hide_directory(row, rows, fd):
    """Let the human choose the semantic directory boundary instead of guessing it."""
    choices=_media_tree_candidates(row,rows)
    if not choices: return None
    pick=0
    while True:
        terminal=shutil.get_terminal_size((110,32)); width=max(56,terminal.columns)
        sys.stdout.write("\033[2J\033[H")
        _title("HIDE BY DIRECTORY",Path(str(row.get("path") or "")).name)
        print(_c("Hide everything under:","2")+"\n")
        for i,item in enumerate(choices):
            focus=_c("›","1;36") if i==pick else " "
            label=item["path"]
            if len(label)>max(20,width-32): label="…"+label[-max(19,width-33):]
            root=" · MEDIA ROOT" if item["media_root"] else ""
            tone="33" if item["media_root"] else "2"
            print(f"{focus} {label}  {_c(f'{item['count']:,} items{root}',tone)}")
        print("\n"+_c("↑↓ choose · Enter hide · Esc cancel","2"),end="",flush=True)
        key=_read_tty_key(fd)
        if key=="esc": return None
        if key in {"up","K"}: pick=max(0,pick-1); continue
        if key in {"down","J"}: pick=min(len(choices)-1,pick+1); continue
        if key in {"\r","\n"}:
            chosen=choices[pick]
            if chosen["media_root"]:
                sys.stdout.write("\n"+_c(f"MEDIA ROOT · hide all {chosen['count']:,} catalog items here? Y/N","1;31")+" "); sys.stdout.flush()
                if str(_read_tty_key(fd)).casefold()!="y": continue
            return chosen

def _media_hide_tree_path(path):
    rules=_media_visibility(); values=set(rules.get("hidden_trees") or [])
    value=str(path or "").rstrip(os.sep)
    if value: values.add(value)
    rules["hidden_trees"]=sorted(values,key=str.casefold); _media_save_visibility(rules)
    return bool(value)

def _media_hide(rows, tree=False):
    """Hide exact items or, for tree mode, only each item's immediate parent directory."""
    rules=_media_visibility(); key="hidden_trees" if tree else "hidden_paths"; values=set(rules.get(key) or [])
    for row in rows:
        path=str(row.get("path") or "")
        value=str(Path(path).parent) if tree and path else path
        if value: values.add(value)
    rules[key]=sorted(values,key=str.casefold); _media_save_visibility(rules)
    return len(rows)


def _media_unhide(rows):
    """Remove the exact item rule or nearest directory rule hiding each row."""
    rules=_media_visibility(); paths=set(rules.get("hidden_paths") or []); trees=set(rules.get("hidden_trees") or [])
    removed=0
    for row in rows:
        path=str(row.get("path") or "")
        if path in paths:
            paths.remove(path); removed+=1
        matches=[root for root in trees if path==str(root).rstrip(os.sep) or path.startswith(str(root).rstrip(os.sep)+os.sep)]
        if matches:
            # The most specific matching rule is the one a user looking at this item means to undo.
            root=max(matches,key=len); trees.remove(root); removed+=1
    rules["hidden_paths"]=sorted(paths,key=str.casefold); rules["hidden_trees"]=sorted(trees,key=str.casefold)
    _media_save_visibility(rules)
    return removed

def _media_selector(rows,title="FABRIC MEDIA",initial_query="",catalog_meta=None):
    """LOOK filter semantics over Fabric media rows, with media-specific actions.

    Navigation/filtering/selection belong to LOOK. Media contributes only actions.
    Display labels are never identifiers; selected rows retain their catalog identity.
    """
    rows=list(rows)
    if not rows:
        print("LOOK media · no matches")
        return ("none",None)
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        for row in rows[:100]:
            node=str(row.get("node") or "local")
            state="sha" if row.get("digest") else "scan"
            print(f"  {_media_row_label(row)}  [{node} · {state}]")
        if len(rows)>100:
            print(f"  … {len(rows)-100:,} more")
        return ("listed",None)

    def row_id(row):
        return str(row.get("digest") or f"{row.get('node','')}:{row.get('id','')}:{row.get('path','')}")

    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    query=str(initial_query or "")
    search_mode=False
    search_before=query
    idx=0
    notice=""
    selected_ids=set()
    info_mode=False
    show_all=False
    show_hidden=False
    action=("none",None)
    view_key=None; visible=[]
    try:
        tty.setcbreak(fd)
        while True:
            # A 100k-row catalog view changes on query/mode changes, not cursor moves.
            next_view_key=(query,show_all,show_hidden)
            if next_view_key != view_key:
                base_rows=_media_filter_rows(rows,query)
                visible=_media_collapse(base_rows,show_all=show_all,show_hidden=show_hidden)
                view_key=next_view_key
            idx=max(0,min(idx,max(0,len(visible)-1)))
            selected_rows=[row for row in rows if row_id(row) in selected_ids]
            terminal=shutil.get_terminal_size((110,32))
            height=max(10,terminal.lines)
            width=max(56,terminal.columns)
            info_rows=13 if info_mode else 0
            usable=max(4,height-7-info_rows-(1 if catalog_meta and (catalog_meta.get("errors") or catalog_meta.get("fallback")) else 0))
            top=max(0,min(max(0,len(visible)-usable),idx-usable+1))
            page=visible[top:top+usable]

            # Build the complete next frame away from the terminal, then swap it in
            # with one write.  Never clear to blank between arrow-key frames.
            frame_io=io.StringIO()
            with redirect_stdout(frame_io):
                mode=("ALL SOURCES" if show_all else "LOGICAL")+(" + HIDDEN" if show_hidden else "")
                suffix=f"{len(visible):,} shown · {len(rows):,} locations · {len(selected_rows)} selected · {mode}"
                _title(title,suffix)
                if catalog_meta:
                    nodes=catalog_meta.get("nodes") or []
                    errors=catalog_meta.get("errors") or []
                    if errors:
                        failed=", ".join(str(e.get("node") or "?") for e in errors)
                        print(_c(f"FABRIC PARTIAL · {len(nodes)} node(s) available · unavailable: {failed}","1;33"))
                    elif catalog_meta.get("fallback"):
                        print(_c("FABRIC LOCAL FALLBACK · Unified Node catalog unavailable","1;33"))
                for n,row in enumerate(page,start=top):
                    rid=row_id(row)
                    focus=_c("›","1;36") if n==idx else " "
                    mark=_c("✓","32") if rid in selected_ids else " "
                    node=str(row.get("node") or "local")
                    identity="◆" if row.get("digest") else "·"
                    count=int(row.get("source_count") or 1)
                    right=f"{identity} {node}"+(f" · {count} SOURCES" if count>1 else "")
                    label=_media_row_label(row)
                    max_label=max(12,width-len(right)-7)
                    if len(label)>max_label:
                        label=label[:max(1,max_label-1)]+"…"
                    print(f"{focus}{mark} {label:<{max_label}}  {_c(right,'2')}")
                if not visible:
                    print("  no matches")
                art_pending=False
                if info_mode and visible:
                    print("\n"+_c("MEDIA INFO","1;36"))
                    print("─"*min(width,110))
                    info_height=11
                    art_w=min(22,max(14,width//5)) if width>=78 else 0
                    detail_w=max(32,width-art_w-4) if art_w else width
                    details=_media_detail_lines(visible[idx],detail_w)[:info_height]
                    art=_media_cover_lines(visible[idx],art_w,info_height,background_remote=True) if art_w else []
                    art_state,art_owner=_media_remote_preview_state(visible[idx],art_w,info_height) if art_w else ("local","")
                    art_pending=bool(art_w and not art and art_state=="loading")
                    status=(f"ART… requesting {art_owner}" if art_state in {"loading","idle"} and art_owner else
                            "ART unavailable" if art_state=="unavailable" else "")
                    for line_no in range(max(len(details),len(art),1 if status else 0)):
                        left=details[line_no] if line_no<len(details) else ""
                        if art:
                            pad=max(1,detail_w-len(_strip_ansi(left)))
                            right=_ansi_clip(art[line_no] if line_no<len(art) else "",art_w)
                            print(left+" "*pad+"  "+right)
                        elif status and line_no==0:
                            print(left+" "*max(1,detail_w-len(_strip_ansi(left)))+"  "+_c(status,"2" if art_pending else "33"))
                        else:
                            print(left)

                filter_text=f"{_c('FILTER','1;36')} {query}█" if query else f"{_c('FILTER','1;36')} █"
                actions=_c("Tab select · A select all · Enter/P play · Q queue · I info · V sources · H hidden · X hide · D hide by directory · U unhide · ◆ SHA · · scanned · Esc exit","2")
                footer=f"{filter_text}  {actions}"
                if notice:
                    footer+="  "+_c(notice,"33")
                    notice=""
                print("\n"+footer,end="")
            frame=frame_io.getvalue()
            sys.stdout.write(_terminal_frame_payload(frame))
            sys.stdout.flush()

            # While remote art is resolving, poll briefly so it can appear without
            # requiring another navigation key.  Otherwise block exactly as before.
            key=_read_tty_key(fd,.08 if art_pending else None)
            if not key and art_pending:
                continue
            if key in {"\x03","q"} and not query:
                break
            if key=="esc":
                if query:
                    query=""; idx=0; continue
                break
            if key in {"up","K"} and visible:
                idx=max(0,idx-1); continue
            if key in {"down","J"} and visible:
                idx=min(len(visible)-1,idx+1); continue
            if key in {"pageup","shiftup"} and visible:
                idx=max(0,idx-usable); continue
            if key in {"pagedown","shiftdown"} and visible:
                idx=min(len(visible)-1,idx+usable); continue
            if key in {"home","shiftleft"} and visible:
                idx=0; continue
            if key in {"end","shiftright"} and visible:
                idx=len(visible)-1; continue
            if key=="\t" and visible:
                rid=row_id(visible[idx])
                if rid in selected_ids:
                    selected_ids.remove(rid); notice="unselected"
                else:
                    selected_ids.add(rid); notice="selected"
                if idx < len(visible)-1:
                    idx+=1
                continue
            if key in {"\x7f","\b"}:
                if query:
                    query=query[:-1]; idx=0
                continue

            chosen=selected_rows or ([visible[idx]] if visible else [])
            if key in {"\r","\n","P"} and chosen:
                action=("play",chosen); break
            if key=="Q" and chosen:
                count=_media_queue_append(chosen)
                notice=f"queued {count}"
                continue
            if key=="A" and visible:
                visible_ids={row_id(row) for row in visible}
                if visible_ids and visible_ids.issubset(selected_ids):
                    selected_ids.difference_update(visible_ids); notice=f"unselected {len(visible_ids)} visible"
                else:
                    selected_ids.update(visible_ids); notice=f"selected {len(visible_ids)} visible"
                continue
            if key=="C":
                selected_ids.clear(); notice="selection cleared"
                continue
            if key=="S" and chosen:
                action=("save",chosen); break
            if key=="I" and visible:
                info_mode=not info_mode
                continue
            if key=="V":
                show_all=not show_all; idx=0; notice="all physical sources" if show_all else "logical media"; continue
            if key=="H":
                show_hidden=not show_hidden; idx=0; notice="hidden shown" if show_hidden else "hidden suppressed"; continue
            if key=="X" and chosen:
                notice=f"hidden {_media_hide(chosen)} item(s)"; selected_ids.clear(); view_key=None; continue
            if key=="D" and visible:
                picked=_media_choose_hide_directory(visible[idx],rows,fd)
                if picked and _media_hide_tree_path(picked["path"]):
                    notice=f"hidden directory · {picked['count']:,} item(s)"; selected_ids.clear(); idx=0; view_key=None
                else: notice="hide directory cancelled"
                continue
            if key=="U" and chosen:
                notice=f"removed {_media_unhide(chosen)} visibility rule(s)"; selected_ids.clear(); view_key=None; continue

            # LOOK filter style: ordinary printable characters immediately refine
            # the view. Uppercase letters above are reserved for contextual actions.
            if len(key)==1 and key.isprintable() and key not in {"\t"}:
                query+=key; idx=0
                continue
    finally:
        termios.tcsetattr(fd,termios.TCSADRAIN,old)
        if sys.stdout.isatty():
            sys.stdout.write("\n")
    return action


def _media_selector_finish(action,payload):
    """Execute selector actions after terminal raw mode has been restored."""
    if action=="play":
        rows=list(payload or [])
        return _media_launch_session(media_core.new_session(rows)) if rows else 1
    if action=="save":
        rows=list(payload or [])
        if not rows:
            return 1
        try:
            name=input("playlist name › ").strip()
        except (EOFError,KeyboardInterrupt):
            print(); return 0
        if not name:
            return 0
        try:
            path=_media_playlist_path(name)
        except ValueError as exc:
            print(f"LOOK media · {exc}")
            return 1
        payload=media_core.playlist_payload(name,media_core.new_session(rows))
        _atomic_json(path,payload)
        print(f"LOOK PLAYLIST · saved {payload['name']} · {len(payload['queue'])} items")
        print(f"  {path}")
        return 0
    return None

def _media_find_command(args):
    query=" ".join(args).strip()
    if sys.stdout.isatty():
        print("LOOK MEDIA FIND · opening local + Fabric catalogs…",end="\r",flush=True)
    started=time.monotonic()
    entries,catalog_meta=_media_catalog_entries()
    if sys.stdout.isatty():
        print(f"LOOK MEDIA FIND · {len(entries):,} locations ready · {time.monotonic()-started:.1f}s"+" "*16)
    rows=media_core.search_entries({"entries":entries},query) if query else entries
    action,payload=_media_selector(rows,"FABRIC MEDIA FIND",query,catalog_meta)
    result=_media_selector_finish(action,payload)
    return result if result is not None else (0 if rows else 1)


def _media_browse_command(args):
    query=" ".join(args).strip()
    entries,catalog_meta=_media_catalog_entries()
    rows=media_core.search_entries({"entries":entries},query) if query else entries
    action,payload=_media_selector(rows,"FABRIC MEDIA",query,catalog_meta)
    result=_media_selector_finish(action,payload)
    return result if result is not None else 0


def _media_group_command(field,args):
    query=" ".join(args).casefold().strip()
    rows,_=_media_catalog_entries()
    counts={}
    for row in rows:
        value=str(row.get(field) or "").strip()
        if not value or (query and query not in value.casefold()):
            continue
        counts[value]=counts.get(value,0)+1
    label="ARTISTS" if field=="artist" else "ALBUMS"
    print(f"FABRIC MEDIA {label} · {len(counts):,}")
    for value,count in sorted(counts.items(),key=lambda item:item[0].casefold())[:200]:
        print(f"  {count:>4}  {value}")
    return 0


def _media_complete_command(args):
    query=" ".join(args).strip()
    rows,_=_media_catalog_entries()
    for value in media_core.completion_candidates(rows,query,limit=80):
        print(value)
    return 0


def _media_identify_command(args):
    all_items="--all" in args
    clean=[x for x in args if x!="--all"]
    query=" ".join(clean).strip()
    rows,_=_media_catalog_entries()
    if all_items:
        # Bulk hashing is intentionally node-local. A single typo must not launch
        # thousands of serial remote hashing requests across the Fabric.
        rows=[dict(row) for row in (_media_library().get("entries") or [])]
    if not all_items:
        if not query:
            print("usage: lk media identify QUERY|PATH|--all")
            return 2
        path=Path(query).expanduser()
        if path.exists():
            if path.is_file():
                wanted=[row for row in rows if str(row.get("path") or "")==str(path.resolve())]
                if not wanted:
                    wanted=[media_core.entry_from_path(path)]
            else:
                wanted=[]
                base=path.resolve()
                for row in rows:
                    try: Path(str(row.get("path") or "")).resolve().relative_to(base); wanted.append(row)
                    except (ValueError,OSError): pass
        else:
            wanted=media_core.search_entries({"entries":rows},query)
    else:
        wanted=rows
    pending=[row for row in wanted if not row.get("digest")]
    if not wanted:
        print("LOOK media · no matches")
        return 1
    if not pending:
        print(f"FABRIC MEDIA · {len(wanted):,} item(s) already identified")
        return 0
    print(f"FABRIC MEDIA · identifying {len(pending):,} item(s) · SHA-256 content identity")
    done=0; failed=0
    for row in pending:
        try:
            _media_identify_catalog_entry(row)
            done+=1
        except Exception as exc:
            failed+=1
            if failed<=5:
                print(f"  × {_media_row_label(row)} · {exc}")
        if len(pending)>20 and (done+failed)%25==0:
            print(f"  {done+failed:>6,}/{len(pending):,}")
    print(f"FABRIC MEDIA · identified {done:,} · failed {failed:,}")
    return 0 if failed==0 else 1


def _media_resolve_targets(args):
    shuffle=False; kind=""; selection=""; artist=""; limit=0; exact=False
    clean=[]; i=0
    while i<len(args):
        arg=args[i]
        if arg=="--shuffle": shuffle=True; i+=1; continue
        if arg in {"--exact","--literal"}: exact=True; i+=1; continue
        if arg in {"--kind","--selection","--artist","--limit"}:
            if i+1>=len(args): raise ValueError(f"{arg} requires a value")
            value=str(args[i+1]); i+=2
            if arg=="--kind": kind=value.casefold()
            elif arg=="--selection": selection=value.casefold()
            elif arg=="--artist": artist=value
            else:
                try: limit=max(0,min(100,int(value)))
                except ValueError: raise ValueError("--limit requires an integer")
            continue
        clean.append(arg); i+=1
    if not clean and (kind or selection or artist):
        catalog,_=_media_catalog_entries()
        rows=media_core.select_entries({"entries":catalog},kind=kind,artist=artist,selection=selection or "all",limit=limit)
        if not rows:
            label=artist or ("any "+kind if kind else "media")
            raise ValueError(f"no Fabric media match for {label!r}; run lk media find or lk media scan")
        return rows,shuffle
    if not clean:
        raise ValueError("play requires a file, directory, library query, artifact, or structured selector")

    if clean[0].startswith("@"):
        if len(clean)<2 or not clean[1].startswith("sha256:"):
            raise ValueError("remote playback requires @NODE sha256:DIGEST")
        payload=_media_artifact(clean[1],clean[0][1:])
        meta=payload.get("artifact") or {}
        return [{"node":clean[0][1:],"digest":clean[1],"title":meta.get("name") or clean[1]}],shuffle
    if clean[0].startswith("sha256:"):
        payload=_media_artifact(clean[0])
        meta=payload.get("artifact") or {}
        return [{"digest":clean[0],"title":meta.get("name") or clean[0]}],shuffle

    text=" ".join(clean)
    path=Path(text).expanduser()
    if path.exists():
        path=path.resolve()
        if path.is_file():
            if path.suffix.casefold() not in media_core.MEDIA_EXTENSIONS:
                raise ValueError(f"unsupported media file: {path.name}")
            return [media_core.entry_from_path(path)],shuffle
        if path.is_dir():
            rows=media_core.entries_under(_media_library(),path)
            if not rows:
                rows=media_core.scan_root(path).get("entries") or []
            if not rows:
                raise ValueError(f"no playable media under {path}")
            return rows,shuffle

    catalog,_=_media_catalog_entries()
    # Direct `lk play ...` is still human language. Normalize selectors here so
    # it cannot disagree with LO/Signal (the old "a song" literal-query bug).
    if not exact:
        try:
            normalizer=_intent_normalizer_module()
            resolution=normalizer.resolve("play "+text)
            intent=resolution.get("intent") if resolution.get("status")=="resolved" else None
        except Exception:
            intent=None
        if isinstance(intent,dict) and intent.get("action")=="media.play" and not intent.get("query"):
            rows=media_core.select_entries(
                {"entries":catalog}, kind=str(intent.get("kind") or ""),
                artist=str(intent.get("artist") or ""), selection=str(intent.get("selection") or "all"),
                limit=int(intent.get("limit") or 0),
            )
            if rows: return rows,shuffle
            label=intent.get("artist") or ("any "+str(intent.get("kind") or "media"))
            raise ValueError(f"no Fabric media match for {label!r}")

    match_kind,rows=_media_query_matches(text,match_mode="literal" if exact else "fuzzy")
    # Human playback language often uses "some X" to mean "play X". Preserve
    # exact/full-phrase matches first, then retry without the conversational
    # determiner only when the full phrase is unresolved or ambiguous.
    if not exact and text.casefold().startswith("some ") and match_kind in {"none","ambiguous"}:
        repaired=text[5:].strip()
        if repaired:
            repaired_kind,repaired_rows=_media_query_matches(repaired,match_mode="fuzzy")
            if repaired_kind!="none" and repaired_rows:
                match_kind,rows=repaired_kind,repaired_rows
    if match_kind=="none" or not rows:
        # Rank below execution threshold only as assistance; never silently guess.
        suggestions=media_core.rank_entries({"entries":catalog},text,limit=3)
        hint="; did you mean " + ", ".join(repr(_media_row_label(r)) for r,_ in suggestions) + "?" if suggestions else ""
        raise ValueError(f"no Fabric media match for {text!r}{hint}; run lk media find")
    if match_kind=="ambiguous":
        preview=", ".join(repr(_media_row_label(row)) for row in rows[:3])
        raise ValueError(f"multiple Fabric media matches for {text!r}; did you mean {preview}? use --exact for literal lookup or lk media find")
    return rows,shuffle


def _media_prepare_command(args):
    """Resolve a media request into a logical queue without touching any player.

    Browser endpoints use this to keep catalog/source work on a Fabric node while
    preserving playback ownership on the originating endpoint.
    """
    try:
        rows,shuffle=_media_resolve_targets(args)
    except (RuntimeError,ValueError,FileNotFoundError,OSError) as exc:
        print(json.dumps({"ok":False,"error":str(exc)},ensure_ascii=False,separators=(",",":")))
        return 1
    session=media_core.new_session(rows,shuffle=shuffle)
    print(json.dumps({"ok":True,"session":session},ensure_ascii=False,separators=(",",":")))
    return 0


def _media_play_command(args):
    print("LOOK media · searching…", flush=True)
    try:
        rows,shuffle=_media_resolve_targets(args)
    except (RuntimeError,ValueError,FileNotFoundError,OSError) as exc:
        print(f"LOOK media · {exc}")
        return 1
    session=media_core.new_session(rows,shuffle=shuffle)
    return _media_launch_session(session)


def _media_queue_command():
    snap=_media_status_snapshot()
    if not snap:
        print("LOOK media · queue is empty")
        return 0
    queue=snap["session"].get("queue") or []
    idx=snap["index"]
    print(f"LOOK MEDIA QUEUE · {len(queue)} items · {snap['state']} · {idx+1 if queue else 0}/{len(queue)}")
    if not queue:
        return 0
    start=max(0,idx-5)
    end=min(len(queue),start+15)
    start=max(0,end-15)
    for pos in range(start,end):
        marker="▶" if pos==idx else " "
        row=queue[pos]
        album=str(row.get("album") or "")
        suffix=f" · {album}" if album else ""
        print(f" {marker} {pos+1:>4}  {_media_entry_label(row)}{suffix}")
    if end < len(queue):
        print(f"     … {len(queue)-end} more")
    return 0


def _media_clear_command():
    if _media_mpv_alive():
        _media_mpv_request(["quit"])
        time.sleep(.05)
    _media_stop_owned_mpvs()
    for path in (MEDIA_SESSION_FILE,MEDIA_QUEUE_FILE):
        try: Path(path).unlink(missing_ok=True)
        except OSError: pass
    print("LOOK media · queue cleared")
    return 0


def _media_playlist_path(name):
    return MEDIA_PLAYLIST_DIR/(media_core.playlist_name(name)+".json")


def _media_playlist_save(name):
    session=_media_sync_session()
    if not session or not session.get("queue"):
        print("LOOK media · nothing in the queue to save")
        return 1
    try:
        path=_media_playlist_path(name)
    except ValueError as exc:
        print(f"LOOK media · {exc}")
        return 1
    payload=media_core.playlist_payload(name,session)
    _atomic_json(path,payload)
    print(f"LOOK PLAYLIST · saved {payload['name']} · {len(payload['queue'])} items")
    print(f"  {path}")
    return 0


def _media_playlist_load(name,shuffle=False):
    try:
        path=_media_playlist_path(name)
    except ValueError as exc:
        print(f"LOOK media · {exc}")
        return 1
    payload=_media_read_json(path,{})
    queue=payload.get("queue") if isinstance(payload,dict) else None
    if not isinstance(queue,list) or not queue:
        print(f"LOOK media · playlist not found or empty: {name}")
        return 1
    session=media_core.new_session(queue,shuffle=shuffle)
    return _media_launch_session(session)


def _media_playlist_list():
    MEDIA_PLAYLIST_DIR.mkdir(parents=True,exist_ok=True)
    paths=sorted(MEDIA_PLAYLIST_DIR.glob("*.json"),key=lambda p:p.stem.casefold())
    print(f"LOOK PLAYLISTS · {len(paths)}")
    for path in paths:
        payload=_media_read_json(path,{})
        queue=payload.get("queue") if isinstance(payload,dict) else []
        print(f"  {len(queue) if isinstance(queue,list) else 0:>4}  {payload.get('name') or path.stem}")
    return 0


def _media_playlist_command(args):
    if not args or args[0] in {"list","ls"}:
        return _media_playlist_list()
    sub=args[0].lower()
    rest=args[1:]
    if sub=="save":
        if not rest: print("usage: lk media playlist save NAME"); return 2
        return _media_playlist_save(" ".join(rest))
    if sub in {"load","play"}:
        shuffle="--shuffle" in rest
        name=" ".join(x for x in rest if x!="--shuffle")
        if not name: print("usage: lk media playlist load NAME [--shuffle]"); return 2
        return _media_playlist_load(name,shuffle=shuffle)
    print("usage: lk media playlist [list|save NAME|load NAME [--shuffle]]")
    return 2


def _media_control_session(action):
    session=_media_session()
    alive=_media_mpv_alive()
    if action in {"play","toggle"} and not alive:
        if session and session.get("queue"):
            return _media_launch_session(session)
        return None
    if not alive:
        if action in {"next","prev"} and session and session.get("queue"):
            step=1 if action=="next" else -1
            session["current_index"]=(int(session.get("current_index") or 0)+step)%len(session["queue"])
            return _media_launch_session(session)
        if action=="stop":
            _media_stop_owned_mpvs()
            try: MEDIA_IPC_FILE.unlink(missing_ok=True)
            except OSError: pass
            if session:
                session["state"]="stopped"
                session.pop("pid",None)
                _media_save_session(session)
            return 0 if session or not _media_owned_mpv_pids() else 1
        return None

    if action=="status":
        snap=_media_status_snapshot()
        if not snap: return None
        entry=snap["entry"]
        timing=f" · {_media_time(snap['position'])}/{_media_time(snap['duration'])}" if isinstance(snap["position"],(int,float)) else ""
        q=f" · {snap['index']+1}/{snap['count']}" if snap["count"] else ""
        print(f"LOOK media · {snap['state']} · {_media_entry_label(entry)}{timing}{q}")
        return 0
    command={
        "play":["set_property","pause",False],
        "pause":["set_property","pause",True],
        "toggle":["cycle","pause"],
        "next":["playlist-next","force"],
        "prev":["playlist-prev","force"],
        "stop":["quit"],
    }[action]
    result=_media_mpv_request(command)
    if action=="stop":
        time.sleep(.05)
        _media_stop_owned_mpvs()
        try: MEDIA_IPC_FILE.unlink(missing_ok=True)
        except OSError: pass
        if session:
            session["state"]="stopped"
            session.pop("pid",None)
            _media_save_session(session)
        return 0
    if result and result.get("error")=="success":
        time.sleep(.03)
        _media_sync_session(session)
        return 0
    return 1


def _media_jump_index(target):
    session=_media_sync_session() or _media_session()
    if not session or not session.get("queue"):
        return None
    queue=session["queue"]
    try: target=int(target)
    except (TypeError,ValueError): return 2
    if target < 0 or target >= len(queue): return 2
    runtime_map=session.get("runtime_queue_indices") or list(range(len(queue)))
    try: runtime_pos=runtime_map.index(target)
    except ValueError: return 1
    if not _media_mpv_alive():
        session["current_index"]=target
        return _media_launch_session(session)
    result=_media_mpv_request(["set_property","playlist-pos",runtime_pos])
    if not result or result.get("error")!="success": return 1
    session["current_index"]=target
    session["state"]="playing"
    _media_save_session(session)
    return 0


def _media_shuffle_command():
    """Toggle mpv's active playlist shuffle while keeping LOOK's runtime map honest."""
    session=_media_session()
    if not session:
        print("LOOK media · no active queue")
        return 1
    enabled=not bool(session.get("shuffle"))
    if _media_mpv_alive():
        command="playlist-shuffle" if enabled else "playlist-unshuffle"
        result=_media_mpv_request([command])
        if not result or result.get("error")!="success":
            return 1
        playlist=_media_mpv_property("playlist")
        queue=session.get("queue") or []
        if isinstance(playlist,list) and queue:
            by_source={}
            for idx,entry in enumerate(queue):
                try: source=_media_entry_source(entry)
                except Exception: continue
                by_source.setdefault(source,[]).append(idx)
            mapping=[]
            for item in playlist:
                filename=str(item.get("filename") or "") if isinstance(item,dict) else ""
                choices=by_source.get(filename) or []
                if choices:
                    mapping.append(choices.pop(0))
            if len(mapping)==len(playlist):
                session["runtime_queue_indices"]=mapping
    session["shuffle"]=enabled
    _media_save_session(session)
    return 0


def _media_repeat_command(args):
    session=_media_session()
    if not session:
        print("LOOK media · no active queue")
        return 1
    requested=(args[0].lower() if args else ("off" if session.get("repeat")=="all" else "all"))
    if requested not in {"off","all"}:
        print("usage: lk media repeat [off|all]")
        return 2
    session["repeat"]=requested
    _media_save_session(session)
    if _media_mpv_alive():
        _media_mpv_request(["set_property","loop-playlist","inf" if requested=="all" else "no"])
    print(f"LOOK media · repeat {requested}")
    return 0


def _media_player_line(text,width):
    text=str(text)
    if len(text)>width:
        return text[:max(0,width-1)]+"…"
    return text+" "*(width-len(text))


def _media_player_visualizer(entry,state,width):
    """Small playback activity visualizer; mpv IPC does not expose decoded PCM."""
    if _media_queue_has_video([entry]):
        return ""
    count=max(10,min(28,width-5))
    if str(state).lower() not in {"playing","play"}:
        return "EQ  "+("▁"*count)
    seed=int(hashlib.sha256(_media_entry_label(entry).encode("utf-8","ignore")).hexdigest()[:8],16)
    t=time.monotonic()
    glyphs="▁▂▃▄▅▆▇█"
    bars=[]
    for i in range(count):
        # Deliberately a playback visualizer, not fabricated spectrum telemetry.
        wave=abs(math.sin(t*(2.1+(i%5)*.17)+i*1.31+(seed%19))*math.cos(t*.83+i*.47))
        bars.append(glyphs[min(len(glyphs)-1,int(wave*len(glyphs)))])
    return "EQ  "+"".join(bars)


def _media_player_render():
    snap=_media_status_snapshot()
    width=max(42,min(88,shutil.get_terminal_size((72,24)).columns-2))
    inner=width-2
    if not snap:
        lines=["LOOK PLAYER","", "No LOOK media queue.", "", "Run: lk media play <file|directory|query>"]
        body=[_media_player_line(x,inner) for x in lines]
    else:
        entry=snap["entry"]
        artist=str(entry.get("artist") or "").strip()
        title=str(entry.get("title") or _media_entry_label(entry)).strip()
        album=str(entry.get("album") or "").strip()
        pos=snap["position"] if isinstance(snap["position"],(int,float)) else 0
        duration=snap["duration"] if isinstance(snap["duration"],(int,float)) else 0
        time_text=f"{_media_time(pos)} / {_media_time(duration)}"
        bar_width=max(4,inner-len(time_text)-2)
        ratio=max(0.0,min(1.0,(pos/duration) if duration else 0.0))
        filled=int(round(ratio*bar_width))
        bar="━"*filled+"─"*(bar_width-filled)
        state=str(snap["state"]).upper()
        queue=snap["session"].get("queue") or []
        footer=(f"Queue {snap['index']+1}/{len(queue)}  ·  "
                f"Shuffle {'on' if snap['session'].get('shuffle') else 'off'}  ·  "
                f"Repeat {snap['session'].get('repeat','off')}")
        eq=_media_player_visualizer(entry,snap["state"],inner)
        raw_body=[
            f"{artist} — {title}" if artist else title, album, eq or "",
            f"{time_text}  {bar}",
            f"{state}  ·  {footer}", "",
            "space play/pause   ←/→ seek 10s   p/n previous/next",
            "s shuffle   r repeat   x stop   q close player",
            "", "", "",
        ]
        # Use the exact same proven Chafa renderer as Media Find.  Art rows are
        # terminal payloads, not ordinary text: never slice/pad inside their ANSI
        # sequences.  We only pad *after* measuring their stripped visible width.
        art_w=min(22,max(16,inner//4)) if inner>=42 else 0
        art=_media_cover_lines(entry,art_w,11,background_remote=True) if art_w else []
        art_state,art_owner=_media_remote_preview_state(entry,art_w,11) if art_w else ("local","")
        art_pending=bool(art_w and not art and art_state=="loading")
        if art:
            text_w=inner-art_w-2
            body=[]
            for i,line in enumerate(raw_body):
                left=_media_player_line(line,text_w)
                right=_ansi_clip(art[i] if i<len(art) else "",art_w)
                visible=min(art_w,len(_strip_ansi(right)))
                right_pad=" "*max(0,art_w-visible)
                body.append(left+"  "+right+right_pad)
        else:
            if art_pending:
                raw_body[9]=f"ART… requesting {art_owner}" if art_owner else "ART… loading remote preview"
            elif art_state=="unavailable":
                raw_body[9]="ART unavailable"
            body=[_media_player_line(line,inner) for line in raw_body]
    top="┌"+"─"*(width-2)+"┐"
    bottom="└"+"─"*(width-2)+"┘"
    title=" LOOK PLAYER "
    top=top[:2]+title+top[2+len(title):]
    out=[top]+["│"+line+"│" for line in body]+[bottom]
    return "\n".join(out)


def media_player():
    """Tiny live view over MediaSession; closing it never stops playback."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print(_media_player_render())
        return 0
    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        sys.stdout.write("\033[2J")
        while True:
            sys.stdout.write("\033[H"+_media_player_render()+"\033[J")
            sys.stdout.flush()
            key=_read_tty_key(fd,.25)
            if not key:
                continue
            if key in {"q","esc"}: return 0
            if key==" ": _media_control_session("toggle")
            elif key=="n": _media_control_session("next")
            elif key=="p": _media_control_session("prev")
            elif key=="left": _media_mpv_request(["seek",-10,"relative"])
            elif key=="right": _media_mpv_request(["seek",10,"relative"])
            elif key=="s": _media_shuffle_command()
            elif key=="r": _media_repeat_command([])
            elif key=="x": _media_control_session("stop")
    except KeyboardInterrupt:
        return 0
    finally:
        try: termios.tcsetattr(fd,termios.TCSADRAIN,old)
        except Exception: pass
        sys.stdout.write("\n")
        sys.stdout.flush()




def _media_mp_rows(mode, library_rows, query):
    """Return the current MP list without manufacturing a second media model."""
    if mode == "queue":
        session=_media_sync_session() or _media_session() or {}
        rows=list(session.get("queue") or [])
    else:
        rows=list(library_rows)
    return _media_filter_rows(rows,query) if query else rows


def _media_mp_now_playing(width):
    """One-line player status for the integrated media surface."""
    snap=_media_status_snapshot()
    if not snap:
        return "STOPPED · no active LOOK media session"
    entry=snap["entry"]
    title=_media_entry_label(entry)
    pos=snap["position"] if isinstance(snap["position"],(int,float)) else 0
    duration=snap["duration"] if isinstance(snap["duration"],(int,float)) else 0
    session=snap["session"]
    text=(f"{str(snap['state']).upper()} · {title} · {_media_time(pos)} / {_media_time(duration)} · "
          f"Queue {snap['index']+1}/{len(session.get('queue') or [])} · "
          f"Shuffle {'on' if session.get('shuffle') else 'off'} · Repeat {session.get('repeat','off')}")
    return _ansi_clip(text,max(20,width))


def media_mp(initial_query=""):
    """Integrated LOOK Media Player: library, queue, art/info and transport.

    This is intentionally a presentation layer over the existing catalog,
    MediaSession, Fabric preview and mpv controls.  It does not create a second
    queue, player or artwork implementation.
    """
    if sys.stdout.isatty():
        print("LOOK MP · opening local + Fabric catalogs…",end="\r",flush=True)
    started=time.monotonic()
    library_rows,catalog_meta=_media_catalog_entries()
    if sys.stdout.isatty():
        print(f"LOOK MP · {len(library_rows):,} locations ready · {time.monotonic()-started:.1f}s"+" "*20)
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("LOOK MP · integrated media player")
        print(_media_mp_now_playing(100))
        for row in _media_filter_rows(library_rows,initial_query)[:20]:
            print("  "+_media_row_label(row))
        return 0

    fd=sys.stdin.fileno()
    old=termios.tcgetattr(fd)
    mode="library"
    query=str(initial_query or "")
    idx=0
    selected_ids=set()
    notice=""
    view_key=None
    visible=[]
    # Search state must exist before the first frame is rendered.  The initial
    # frame reads this flag before any key event has had a chance to create it.
    search_mode=False
    search_before=query

    def row_id(row):
        return str(row.get("digest") or f"{row.get('node','')}:{row.get('id','')}:{row.get('path','')}")

    try:
        tty.setcbreak(fd)
        sys.stdout.write("\033[2J\033[H")
        while True:
            next_key=(mode,query)
            if next_key != view_key:
                visible=_media_mp_rows(mode,library_rows,query)
                view_key=next_key
                idx=max(0,min(idx,max(0,len(visible)-1)))
            terminal=shutil.get_terminal_size((120,34))
            width=max(72,terminal.columns)
            height=max(20,terminal.lines)
            right_w=min(40,max(28,width//3)) if width>=96 else 0
            left_w=width-right_w-3 if right_w else width
            list_rows=max(6,height-10)
            top=max(0,min(max(0,len(visible)-list_rows),idx-list_rows+1))
            page=visible[top:top+list_rows]
            chosen=visible[idx] if visible else None
            selected=[row for row in visible if row_id(row) in selected_ids]

            info_h=list_rows
            art=[]; art_status=""
            if chosen and right_w:
                art_h=min(11,max(6,info_h//2))
                art=_media_cover_lines(chosen,right_w,art_h,background_remote=True)
                state,owner=_media_remote_preview_state(chosen,right_w,art_h)
                if not art and state in {"loading","idle"}:
                    art_status=f"ART… requesting {owner}" if owner else "ART… loading"
                elif not art and state=="unavailable":
                    art_status="ART unavailable"
                details=_media_detail_lines(chosen,right_w)[:max(0,info_h-art_h-1)]
            else:
                details=[]

            out=io.StringIO()
            with redirect_stdout(out):
                tab="LIBRARY" if mode=="library" else "QUEUE"
                node_count=len((catalog_meta or {}).get("nodes") or [])
                _title("LOOK MP",f"{tab} · {len(visible):,} shown · {node_count} node(s) · {len(selected_ids)} marked")
                print(_c("FABRIC VISION", "1;36")+"  "+_c("Fabric library + queue + transport", "2"))
                print("─"*min(width,140))
                for line_no in range(list_rows):
                    if line_no < len(page):
                        n=top+line_no; row=page[line_no]
                        rid=row_id(row)
                        focus=_c("›","1;36") if n==idx else " "
                        mark=_c("✓","32") if rid in selected_ids else " "
                        label=_media_row_label(row)
                        node=str(row.get("node") or "local")
                        suffix=f" · {node}"
                        max_label=max(12,left_w-len(suffix)-5)
                        left=f"{focus}{mark} "+(label[:max_label-1]+"…" if len(label)>max_label else label.ljust(max_label))+_c(suffix,"2")
                    else:
                        left=""
                    if right_w:
                        right=""
                        if line_no < len(art):
                            right=_ansi_clip(art[line_no],right_w)
                        elif line_no==0 and art_status:
                            right=_c(art_status,"2" if "requesting" in art_status or "loading" in art_status else "33")
                        else:
                            di=line_no-max(len(art),1 if art_status else 0)
                            if 0 <= di < len(details): right=details[di]
                        print(_ansi_clip(left,left_w)+" "*max(0,left_w-len(_strip_ansi(_ansi_clip(left,left_w))))+" │ "+_ansi_clip(right,right_w))
                    else:
                        print(_ansi_clip(left,width))
                print("─"*min(width,140))
                print(_c(_media_mp_now_playing(width),"1"))
                if search_mode:
                    filter_text=f"SEARCH /{query}█"
                else:
                    filter_text=f"FILTER {query or 'all media'} · / search"
                print(_c(filter_text,"1;36"))
                controls="↑↓ select · ⇧ arrows page/top/bottom · Tab mark · Enter play · A add queue · L library · Q queue"
                print(_c(controls,"2"))
                print(_c("space pause · ←/→ seek · p/n prev/next · s shuffle · r repeat · x stop · Esc clear/exit","2"),end="")
                if notice:
                    print("  "+_c(notice,"33"),end="")
                    notice=""
            sys.stdout.write(_terminal_frame_payload(out.getvalue()))
            sys.stdout.flush()

            pending=bool(chosen and right_w and not art and art_status.startswith("ART…"))
            key=_read_tty_key(fd,.10 if pending else .25)
            if not key:
                continue
            if search_mode:
                if key=="esc":
                    query=search_before; search_mode=False; idx=0; view_key=None; continue
                if key in {"\r","\n"}:
                    search_mode=False; idx=0; view_key=None; continue
                if key in {"\x7f","\b"}:
                    if query: query=query[:-1]; idx=0; view_key=None
                    continue
                if len(key)==1 and key.isprintable():
                    query+=key; idx=0; view_key=None
                continue
            if key=="esc":
                if query:
                    query=""; idx=0; view_key=None; continue
                return 0
            if key=="/":
                search_before=query; search_mode=True; continue
            if key in {"up","K"} and visible: idx=max(0,idx-1); continue
            if key in {"down","J"} and visible: idx=min(len(visible)-1,idx+1); continue
            if key in {"pageup","shiftup"} and visible: idx=max(0,idx-list_rows); continue
            if key in {"pagedown","shiftdown"} and visible: idx=min(len(visible)-1,idx+list_rows); continue
            if key in {"home","shiftleft"} and visible: idx=0; continue
            if key in {"end","shiftright"} and visible: idx=len(visible)-1; continue
            if key=="L": mode="library"; query=""; idx=0; selected_ids.clear(); view_key=None; continue
            if key=="Q": mode="queue"; query=""; idx=0; selected_ids.clear(); view_key=None; continue
            if key=="\t" and chosen:
                rid=row_id(chosen)
                if rid in selected_ids: selected_ids.remove(rid); notice="unmarked"
                else: selected_ids.add(rid); notice="marked"
                continue
            picked=selected or ([chosen] if chosen else [])
            if key in {"\r","\n"} and picked:
                _media_launch_session(media_core.new_session(picked)); notice=f"playing {len(picked)} item(s)"; continue
            if key=="A" and picked:
                notice=f"queued {_media_queue_append(picked)}"; view_key=None if mode=="queue" else view_key; continue
            if key==" ": _media_control_session("toggle"); continue
            if key=="n": _media_control_session("next"); continue
            if key=="p": _media_control_session("prev"); continue
            if key=="left": _media_mpv_request(["seek",-10,"relative"]); continue
            if key=="right": _media_mpv_request(["seek",10,"relative"]); continue
            if key=="s": _media_shuffle_command(); continue
            if key=="r": _media_repeat_command([]); continue
            if key=="x": _media_control_session("stop"); continue
    except KeyboardInterrupt:
        return 0
    finally:
        try: termios.tcsetattr(fd,termios.TCSADRAIN,old)
        except Exception: pass
        sys.stdout.write("\n")
        sys.stdout.flush()

