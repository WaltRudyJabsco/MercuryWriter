def _obvious_memory_candidate(user_text):
    """Deterministic fallback for explicit preferences/project-state language.

    This does not replace model extraction. It prevents the semantic system from
    becoming inert when a small local model returns NONE too aggressively.
    """
    text=" ".join(str(user_text or "").split()).strip()
    if not text:
        return None
    low=text.casefold()

    # Skip obvious command-only/mechanical turns.
    if len(text)<12:
        return None

    strong_markers=(
        "remember this","remember that","this is important",
        "i prefer ","i really prefer ","i love ","i really like ",
        "my favorite ","my favourite ","from now on ","going forward ",
    )
    medium_markers=(
        "we are using ","we're using ","we use ","we decided ",
        "we're building ","we are building ","the current version ",
        "our current ","i usually ","i always ","i don't want ","i do not want ",
        "i want to keep ","let's keep ","we should keep ",
    )
    light_markers=(
        "i like ","i tend to ","i use ","i'm using ","i am using ",
        "i'm working on ","i am working on ","for this project ","for look ",
    )

    if any(m in low for m in strong_markers):
        importance=72 if not ("remember this" in low or "remember that" in low or "this is important" in low) else 96
    elif any(m in low for m in medium_markers):
        importance=48
    elif any(m in low for m in light_markers):
        importance=28
    else:
        return None

    # Keep user wording compact; the semantic matcher will merge paraphrases later.
    compact=text[:420].rstrip()
    return importance,compact


def _high_recall_memory_candidate(user_text):
    """Cheap first-gate recall; metabolism supplies precision later."""
    text=" ".join(str(user_text or "").split()).strip()
    if len(text)<24 or _conversation_local_memory_intent(text):
        return None
    low=text.casefold()
    if len(text)<180 and any(m in low for m in (
        "run this","what command","command to ","traceback","download","unzip ",
        "git pull","git push","cd ","ls ",
    )):
        return None
    markers=(
        "we want ","we need ","we should ","we decided ","we're building ","we are building ",
        "the architecture","architecture should","should be the default","the default should","the idea is ","the point is ",
        "the rule is ","the principle is ","foundation","our memory","memory is ","our system","our brain",
        "for look","future crash","fabric","one brain","mercury writer","local-first","tailscale","3090",
        "i want ","i don't want ","i do not want ","trustworthy","fuzzy","exact execution",
        "i prefer ","i usually ","i always ","i don't want ","i do not want ",
        "i like ","i love ","my favorite ","my favourite ",
    )
    hits=sum(1 for m in markers if m in low)
    if not hits: return None
    importance=38 if hits==1 else 54 if hits==2 else 68
    if any(m in low for m in ("i prefer ","i always ","we decided ","should be the default","the rule is ","the principle is ","local-first")):
        importance=max(importance,68)
    return importance,text[:520].rstrip()

def _extract_memory_candidate(base, model, user_text, assistant_text):
    prompt=f"""Capture the compact meat of this exchange when it would help conversational
continuity later.

Store ONE candidate memory whenever the exchange contains reusable user-owned signal: a preference,
project/architecture decision, active project state, recurring workflow, naming/resolution convention,
operational lesson the user accepted, or explicit request to remember something. Memory is cheap;
attention is expensive. Prefer capturing useful signal at modest importance over returning NONE;
metabolism, merging, contradiction handling, and retrieval budgets prune what LO actually thinks with later.

Important guidance:
- "I like...", "I love...", "one of my favorites...", "I prefer...", "I usually...",
  "remember this", and "this is important" are normally memory-worthy.
- Recent conversational continuity matters even when a fact may not be permanent.
  Decay will handle forgetting later.
- "sidebar", "no need to remember this", "just for now", and similar language mean
  conversation-local context: RECENT should retain the exchange, but return NONE here so it
  does not enter candidate/durable memory unless the user separately marks it long-term.
- Memory must be grounded in what the USER said, directed, corrected, or clearly confirmed.
  An assistant suggestion alone is not user memory. But if the user explicitly adopts a design, asks to ship it,
  corrects a resolver, or validates an operational result, that confirmation is evidence about the shared project.
  Bare social acknowledgement without a referent remains NONE.
- Return NONE for mechanical turns, acknowledgements, disposable commands, or content-free chatter.
- When the exchange changes the state of an ongoing project, establishes a working convention,
  states a preference likely to affect later answers, or reveals a reusable choice/pattern,
  prefer a modest candidate over NONE. Candidate memory is intentionally noisier than durable memory.
- Do not store assistant technique here; reusable assistant craft belongs in skills.
- Do not output analysis, reasoning, headings, or commentary.

Return exactly one line:
NONE
or:
NN|compact memory text

NN is importance 1-100.

Suggested importance:
20-39  plausible reusable fact worth testing through decay
40-59  useful preference/project continuity
60-79  meaningful recurring preference/project state
80-94  strong favorite/preference or recurring workflow
95-100 explicit "remember this"/"this is important" when genuinely durable

Maximum memory text: 70 words.

USER:
{user_text[:4000]}

ASSISTANT:
{assistant_text[:5000]}"""
    try:
        raw=_local_chat_once(base,model,[
            {"role":"system","content":"You maintain compact conversational memory. Preserve substantive continuity; decay will forget weak memories later."},
            {"role":"user","content":prompt},
        ], num_ctx=4096, num_predict=128, think=False, temperature=0.15)
        final=_strip_reasoning_payload(raw).strip()
        if final.upper()=="NONE":
            return None
        if "\n" in final.strip():
            return None
        m=re.fullmatch(r"\s*(\d{1,3})\s*\|\s*(.+?)\s*", final)
        if not m:
            return None
        text=_sanitize_memory_text(m.group(2))
        if not text:
            return None
        return max(1,min(100,int(m.group(1)))), text
    except Exception:
        return None


def _rewrite_summary(base, model, old_summary, memories):
    # Long-term consolidation happens while useful candidates are alive, not when they decay away.
    # Repetition raises importance; ordinary useful continuity can consolidate after several cycles.
    strong=[m for m in memories if int(m.get("importance",0))>=55]
    if len(strong)<2:
        return old_summary
    material="\n".join(f"- [{int(m.get('importance',0))}] {m['text']}" for m in strong[:12])
    prompt=f"""Rewrite the durable user summary using only patterns that have demonstrated
continuing value.

Return ONLY the summary itself.
No analysis. No <think> tags. No heading. No word count. No explanation of exclusions.
Maximum 180 words. Do not include transient task details. Do not invent facts.

CURRENT SUMMARY:
{old_summary or "(empty)"}

STRONG MEMORIES:
{material}"""
    try:
        raw=_local_chat_once(base,model,[
            {"role":"system","content":"Maintain one compact semantic long-term user summary. Output only the clean summary."},
            {"role":"user","content":prompt},
        ], num_ctx=4096, num_predict=300, think=False, temperature=0.15)
        clean=_sanitize_summary(raw)
        return clean if clean else old_summary
    except Exception:
        return old_summary


