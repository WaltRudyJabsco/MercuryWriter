def _save_memory(memory):
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp=MEMORY_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(memory, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        os.chmod(tmp, 0o600)
        tmp.replace(MEMORY_FILE)
        os.chmod(MEMORY_FILE, 0o600)
    except OSError:
        pass



def _strip_reasoning_payload(text):
    """Return only final-answer content from common Ollama/Qwen thinking variants."""
    text=str(text or "")
    m=re.search(r"<think>(.*?)</think>",text,flags=re.I|re.S)
    if m:
        return (text[:m.start()]+text[m.end():]).strip()
    m=re.search(r"</think>",text,flags=re.I)
    if m:
        return text[m.end():].strip()
    return text.strip()

_MEMORY_META_PREFIXES=(
    "hmm, the user wants me",
    "okay, the user wants me",
    "okay, let's see",
    "okay, let’s see",
    "okay, let's tackle",
    "okay, let’s tackle",
    "the user wants me",
    "the user asked me",
    "i need to",
    "i should",
    "looking at the current memory",
    "double-checking",
    "final decision:",
    "revised long-term memory",
)

def _looks_like_model_meta(text):
    t=" ".join(str(text or "").split()).strip()
    if not t:
        return True
    low=t.casefold()
    if "<think>" in low or "</think>" in low:
        return True
    if any(low.startswith(x) for x in _MEMORY_META_PREFIXES):
        return True
    bad=(
        "current memory","new note","word count","all facts verified",
        "do not invent","memory entry","compress a conversation",
        "rewrite a long-term memory","assistant's previous","assistant’s previous",
    )
    return any(x in low for x in bad)

def _sanitize_memory_text(text):
    clean=" ".join(_strip_reasoning_payload(text).split()).strip()
    if _looks_like_model_meta(clean):
        return ""
    return clean[:900]

def _sanitize_summary(text):
    clean=_strip_reasoning_payload(text).strip()
    if not clean or _looks_like_model_meta(clean):
        return ""
    low=clean.casefold()
    if "revised long-term memory" in low or "word count:" in low or "excluded:" in low:
        return ""
    return clean[:2200]

def _looks_transient_memory(text):
    """Explicit sidebar/temporary material belongs in RECENT, never durable memory."""
    low=" ".join(str(text or "").split()).casefold()
    return any(m in low for m in (
        "sidebar","no need to remember this","don't remember this","do not remember this",
        "don't put this in memory","do not put this in memory","just for now",
        "temporary question","temporary test",
    ))

def _prune_contaminated_memory(memory):
    cleaned=[]
    for item in memory.get("memories",[]):
        text=_sanitize_memory_text(item.get("text",""))
        if not text or _looks_environmental_memory(text) or _looks_transient_memory(text):
            continue
        item["text"]=text
        cleaned.append(item)
    cleaned.sort(key=lambda x:int(x.get("importance",0)),reverse=True)
    memory["memories"]=cleaned[:MEMORY_CANDIDATE_LIMIT]

    durable=[]
    for item in memory.get("durable",[]):
        text=_sanitize_memory_text(item.get("text",""))
        if not text or _looks_environmental_memory(text) or _looks_transient_memory(text):
            continue
        row=dict(item); row["text"]=text
        domain=str(row.get("domain","general"))
        row["domain"]=domain if domain in MEMORY_DOMAINS else "general"
        durable.append(row)
    memory["durable"]=durable[-MEMORY_DURABLE_LIMIT:]

    atoms=[]
    for item in memory.get("atoms",[]):
        if not isinstance(item,dict): continue
        subject=" ".join(str(item.get("s","")).split())[:180]
        value=" ".join(str(item.get("v","")).split())[:360]
        if not (subject or value): continue
        atoms.append({"k":str(item.get("k","fact"))[:32],"s":subject,
                      "r":str(item.get("r",""))[:80],"v":value,
                      "c":max(1,min(100,int(item.get("c",70) or 70))),
                      "u":max(1,int(item.get("u",1) or 1)),
                      "t":float(item.get("t",time.time()) or time.time())})
    memory["atoms"]=atoms[-MEMORY_ATOM_LIMIT:]

    memory["summary"]=_sanitize_summary(memory.get("summary",""))
    memory["legacy_summary"]=_sanitize_summary(memory.get("legacy_summary",""))[:2200]
    memory["core_summary"]=_sanitize_summary(memory.get("core_summary",""))[:1200]
    summaries={}
    for domain,text in (memory.get("domain_summaries",{}) or {}).items():
        if domain in MEMORY_DOMAINS:
            clean=_sanitize_summary(text)[:1000]
            if clean: summaries[domain]=clean
    memory["domain_summaries"]=summaries
    return memory

def _load_recent_exchanges():
    """Literal cross-session continuity. Small, recent, and intentionally not semantic memory."""
    try:
        data=json.loads(LO_RECENT_FILE.read_text(encoding="utf-8"))
        rows=data.get("exchanges",[]) if isinstance(data,dict) else []
    except (OSError,json.JSONDecodeError):
        rows=[]
    clean=[]
    total=0
    for item in reversed(rows):
        if not isinstance(item,dict):
            continue
        user=str(item.get("user","")).strip()[:5000]
        assistant=str(item.get("assistant","")).strip()[:7000]
        if not user:
            continue
        size=len(user)+len(assistant)
        if clean and total+size>LO_RECENT_MAX_CHARS:
            break
        clean.append({"user":user,"assistant":assistant,"time":float(item.get("time",0) or 0)})
        total+=size
        if len(clean)>=LO_RECENT_EXCHANGES:
            break
    clean.reverse()
    return clean

def _save_recent_exchange(user_text, assistant_text):
    """Commit conversational continuity before asynchronous memory work begins."""
    try:
        STATE_DIR.mkdir(parents=True,exist_ok=True)
        rows=_load_recent_exchanges()
        rows.append({
            "user":str(user_text or "").strip()[:5000],
            "assistant":str(assistant_text or "").strip()[:7000],
            "time":time.time(),
        })
        rows=rows[-LO_RECENT_EXCHANGES:]
        # Bound by characters from newest backward.
        kept=[]; total=0
        for item in reversed(rows):
            size=len(item["user"])+len(item["assistant"])
            if kept and total+size>LO_RECENT_MAX_CHARS:
                break
            kept.append(item); total+=size
        kept.reverse()
        tmp=LO_RECENT_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps({"schema_version":1,"exchanges":kept},ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
        os.chmod(tmp,0o600); tmp.replace(LO_RECENT_FILE); os.chmod(LO_RECENT_FILE,0o600)
        return True
    except OSError:
        return False

def _age_label(ts):
    if not ts:
        return "never"
    try:
        seconds=max(0,int(time.time()-float(ts)))
    except (TypeError,ValueError):
        return "time unknown"
    if seconds < 60: return "just now"
    minutes=seconds//60
    if minutes < 60: return f"{minutes} minute{'s' if minutes!=1 else ''} ago"
    hours=minutes//60
    if hours < 24: return f"{hours} hour{'s' if hours!=1 else ''} ago"
    days=hours//24
    if days < 30: return f"{days} day{'s' if days!=1 else ''} ago"
    return time.strftime("%Y-%m-%d",time.localtime(float(ts)))


def _recent_context():
    rows=_load_recent_exchanges()
    if not rows:
        return ""
    chunks=[]; used=0
    # Work newest-first against a strict prompt budget, then restore chronology.
    for item in reversed(rows):
        chunk=f"[{_age_label(item.get('time',0))}]\nUSER: "+item["user"]+"\nASSISTANT: "+item["assistant"]
        if chunks and used+len(chunk)>LO_RECENT_CONTEXT_CHARS:
            break
        chunks.append(chunk); used+=len(chunk)
        if len(chunks)>=6:
            break
    chunks.reverse()
    return (
        "Recent cross-session conversation, preserved literally for continuity. "
        "These are historical exchanges, NOT pending instructions. Never resume an old task merely because it appears here. "
        "Use age as evidence: if an old request appears unfinished, confirm or mention it unless the current user turn clearly asks to continue. "
        "Newer turns override older ones.\n\n"
        + "\n\n".join(chunks)
    )

def _effective_skills_text():
    """Prompt view: bundled craft plus active learned skills ordered by reinforcement."""
    try:
        raw=SKILLS_FILE.read_text(encoding="utf-8")
    except OSError:
        return ""
    marker="## Learned"
    if marker not in raw:
        return raw.strip()

    bundled,_=raw.split(marker,1)
    state=_load_skill_state().get("skills",{})
    rows=[]
    for skill in _learned_skills():
        meta=state.get(_skill_key(skill),{})
        confidence=int(meta.get("confidence",1))
        if confidence<=0:
            continue
        rows.append((confidence,skill))
    rows.sort(key=lambda x:(-x[0],x[1].casefold()))

    text=bundled.rstrip()+"\n\n## Learned\n"
    if rows:
        text+="\n"+"\n".join(f"- {skill}." for _,skill in rows)+"\n"
    return text.strip()


def _looks_environmental_memory(text):
    """Machine/runtime facts belong to deterministic state, not autobiographical memory."""
    low=" ".join(str(text or "").split()).casefold()
    patterns=(
        r"\b(current|installed|running)\s+(look|future crash|ollama|version)\b",
        r"\b(primary|current)\s+(host|gpu|machine|computer|directory|workspace)\b",
        r"\b(rtx|3090|vram|gpu)\b.*\b(host|machine|running|installed|current)\b",
        r"\bollama\s+(host|port|url|endpoint)\b",
        r"\b(current working directory|cwd|port \d+)\b",
    )
    return any(re.search(p,low) for p in patterns)


def _memory_domain(text):
    low=" ".join(str(text or "").split()).casefold()
    if _looks_environmental_memory(low):
        return "environment"
    if re.search(r"\b(architecture|architectural|fabric|cognition|one brain|decision plane|action registry|endpoint|routing|transport)\b",low):
        return "architecture"
    if re.search(r"\b(resolver|resolve|alias|fuzzy|referent|continuation|clarification)\b",low):
        return "resolver"
    if re.search(r"\b(systemd|launchd|linuxbrew|homebrew|service|installer|runtime|receipt|operational|port|daemon)\b",low):
        return "operational"
    if re.search(r"\b(project|novel|story|future crash|look shell|lo\b|we're building|we are building|current project)\b",low):
        return "projects"
    if re.search(r"\b(prefer|preference|filename|format|naming|lowercase|hyphen|workflow|always want|don't want|do not want)\b",low):
        return "preferences"
    if re.search(r"\b(concise|direct|confirmation|explain|response|tone|style|interaction|working style)\b",low):
        return "style"
    if re.search(r"\b(favorite|favourite|love|like|band|music|book|film|food|hobby|interest)\b",low):
        return "personal"
    return "general"


def _memory_tokens(text):
    raw=re.findall(r"[a-z0-9]+",str(text or "").casefold())
    stop={"the","a","an","to","of","and","is","are","in","on","for","with","that","this","user","uses","use"}
    out=set()
    for word in raw:
        if word in stop: continue
        # Tiny deterministic normalization: enough for band/bands, file/files,
        # preference/preferences without pretending to be a linguistic model.
        if len(word)>4 and word.endswith("ies"):
            word=word[:-3]+"y"
        elif len(word)>4 and word.endswith("s") and not word.endswith("ss"):
            word=word[:-1]
        out.add(word)
    return out


def _memory_relevance(text,query):
    q=_memory_tokens(query); t=_memory_tokens(text)
    if not q or not t: return 0.0
    return len(q&t)/max(1,min(len(q),len(t)))


def _relevant_durable(memory,query,limit=MEMORY_RETRIEVED_ATOMS):
    rows=[]
    for item in memory.get("durable",[]):
        score=_memory_relevance(item.get("text",""),query)
        # Importance is only a tie-breaker; relevance decides retrieval.
        if score>0:
            rows.append((score,int(item.get("importance",0)),item))
    rows.sort(key=lambda x:(x[0],x[1]),reverse=True)
    return [x[2] for x in rows[:limit]]


def _relevant_domains(memory,query,limit=2):
    summaries=memory.get("domain_summaries",{}) or {}
    scored=[]
    for domain,text in summaries.items():
        score=_memory_relevance(text,query)
        # General is a fallback, not an automatic tax on every prompt.
        if score>0:
            scored.append((score,domain,text))
    scored.sort(reverse=True)
    if scored: return scored[:limit]
    if "general" in summaries and query:
        return [(0.01,"general",summaries["general"])]
    return []


def _durable_memory_match(memory,text):
    key=_memory_similarity_key(text)
    if not key: return None
    best=None
    for idx,item in enumerate(memory.get("durable",[])):
        old=_memory_similarity_key(item.get("text",""))
        if not old: continue
        inter=key&old
        overlap=len(inter)/max(1,min(len(key),len(old)))
        if len(inter)>=2 and overlap>=0.65:
            score=(overlap,len(inter))
            if best is None or score>best[0]: best=(score,idx)
    return best[1] if best else None


def _add_durable(memory,item):
    text=_sanitize_memory_text(item.get("text",""))
    if not text or _looks_environmental_memory(text) or _looks_transient_memory(text):
        return memory,False
    domain=_memory_domain(text)
    if domain=="environment": return memory,False
    idx=_durable_memory_match(memory,text)
    now=time.time()
    if idx is not None:
        old=memory["durable"][idx]
        old["importance"]=min(100,max(int(old.get("importance",60)),int(item.get("importance",60)))+4)
        old["uses"]=int(old.get("uses",1))+int(item.get("uses",1))
        old["last_reinforced"]=max(float(old.get("last_reinforced",0)),now)
        return memory,False
    memory.setdefault("durable",[]).append({
        "text":text[:700],"domain":domain,
        "importance":max(1,min(100,int(item.get("importance",70)))),
        "uses":max(1,int(item.get("uses",1))),
        "created_at":float(item.get("created_at",now) or now),
        "last_reinforced":float(item.get("last_reinforced",now) or now),
    })
    memory["durable"]=memory["durable"][-MEMORY_DURABLE_LIMIT:]
    memory["promotions_total"]=int(memory.get("promotions_total",0))+1
    return memory,True


def _compile_domain_summary(base,model,domain,items,old=""):
    if not items: return ""
    evidence="\n".join(f"- {x.get('text','')}" for x in items[-40:])
    prompt=f"""Compress durable user memory for the {domain.upper()} domain.

Preserve meaning while minimizing tokens.
Never broaden scope: qualifiers such as "for LOOK test projects" must survive.
Never invent causality, certainty, preferences, or identity.
Merge redundancy aggressively. Prefer short canonical factual phrases.
Exclude machine/runtime facts that can be inspected from the computer.
Maximum 90 words. Return only the compact summary.

OLD SUMMARY:
{old or "(empty)"}

DURABLE EVIDENCE:
{evidence}"""
    try:
        raw=_local_chat_once(base,model,[
            {"role":"system","content":"You are a loss-minimizing memory compressor. Preserve scope; minimize words."},
            {"role":"user","content":prompt},
        ],num_ctx=4096,num_predict=180,think=False,temperature=0.10)
        clean=_sanitize_summary(raw)
        return clean[:1000] if clean else old
    except Exception:
        return old


def _compile_core_summary(base,model,domain_summaries,old=""):
    material="\n".join(f"{k.upper()}: {v}" for k,v in domain_summaries.items() if v)
    if not material: return ""
    prompt=f"""Create a tiny routing summary of durable user memory.

Its job is to help decide which detailed memory domain may matter, not to reproduce everything.
Preserve scope and uncertainty. Maximum 70 words. Prefer terse phrases.
Return only the summary.

DOMAINS:
{material}"""
    try:
        raw=_local_chat_once(base,model,[
            {"role":"system","content":"Compress user-memory routing context aggressively without broadening claims."},
            {"role":"user","content":prompt},
        ],num_ctx=4096,num_predict=120,think=False,temperature=0.10)
        clean=_sanitize_summary(raw)
        return clean[:1200] if clean else old
    except Exception:
        return old


def _fallback_domain_summary(items):
    texts=[]
    for item in sorted(items,key=lambda x:(int(x.get("uses",1)),int(x.get("importance",0))),reverse=True):
        text=" ".join(str(item.get("text","")).split()).strip()
        if text and text not in texts: texts.append(text)
    return "; ".join(texts[:4])[:700]

def _fallback_core_summary(summaries):
    return " | ".join(f"{k}: {v}" for k,v in summaries.items() if v)[:700]

def _compile_memory(base,model,memory,force=False):
    """Background memory compiler: durable atoms -> domain summaries -> tiny core."""
    now=time.time()
    if not force and now-float(memory.get("last_compiled_at",0) or 0)<45*60:
        return memory,False
    changed=False
    summaries=dict(memory.get("domain_summaries",{}) or {})
    for domain in MEMORY_DOMAINS:
        items=[x for x in memory.get("durable",[]) if x.get("domain")==domain]
        if not items: continue
        old=summaries.get(domain,"")
        new=_compile_domain_summary(base,model,domain,items,old) or _fallback_domain_summary(items)
        if new and new!=old:
            summaries[domain]=new; changed=True
    core=_compile_core_summary(base,model,summaries,memory.get("core_summary","")) or _fallback_core_summary(summaries)
    if core and core!=memory.get("core_summary",""):
        memory["core_summary"]=core; changed=True
    memory["domain_summaries"]=summaries
    # Legacy summary remains only as migration/debug compatibility.
    memory["summary"]=" ".join(v for _,v in sorted(summaries.items()) if v)[:2200]
    memory["last_compiled_at"]=now
    memory["last_maintenance_at"]=now
    return memory,changed


