def _profile_command(args):
    if not args or args[0] in {"status","show"}:
        return _profile_status()
    cmd=args[0]
    if cmd=="backup":
        return _profile_backup(args[1:])
    if cmd=="export":
        output=" ".join(args[1:]).strip() or None
        return _profile_export(output)
    if cmd=="restore":
        if len(args)<2:
            print("usage: lk profile restore <ZIP|BACKUP_DIR> [--yes]"); return 2
        src=args[1]
        return _profile_restore(src,args[2:])
    if cmd=="path":
        print(STATE_DIR); return 0
    if cmd=="config":
        print(CONFIG_DIR); return 0
    if cmd=="files":
        _title("profile","portable files")
        for src,rel in _profile_entries():
            print(f"  {rel}  {_c(str(src),'2')}")
        return 0
    print("usage: lk profile [status|backup [DEST]|export [ZIP]|restore SOURCE|files|path|config]")
    return 2


def _lo_context_handoff(paths):
    """Launch LO with selected filesystem paths as explicit context."""
    resolved=[]
    for raw in paths:
        p=Path(raw).expanduser().resolve()
        if p.exists():
            resolved.append(p)
    if not resolved:
        print("LOOK LO · no valid selected paths")
        return 1

    anchors=[p if p.is_dir() else p.parent for p in resolved]
    try:
        workspace=Path(os.path.commonpath([str(p) for p in anchors])).resolve()
    except ValueError:
        workspace=_safe_cwd().resolve()

    # Keep the workspace a directory and ensure every selected path is reachable
    # by LOOK's bounded file tools. For a single selected directory, that directory
    # itself is the workspace; for siblings, their nearest common ancestor is used.
    return ollama_chat(
        selected_paths=resolved,
        workspace_override=workspace,
    )


def _atomic_json(path, data):
    path=Path(path)
    path.parent.mkdir(parents=True,exist_ok=True)
    tmp=path.with_suffix(path.suffix+".tmp")
    tmp.write_text(json.dumps(data,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
    try: os.chmod(tmp,0o600)
    except OSError: pass
    tmp.replace(path)

def _emit_event(kind, text, job_id=None):
    LO_EVENTS_DIR.mkdir(parents=True,exist_ok=True)
    event={
        "id":uuid.uuid4().hex[:12],
        "kind":str(kind),
        "text":str(text).strip()[:8000],
        "job_id":job_id,
        "time":time.time(),
    }
    _atomic_json(LO_EVENTS_DIR/f"{time.time_ns()}-{event['id']}.json",event)
    return event

