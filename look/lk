def _ollama_markup(text):
    """Render a restrained Markdown subset with terminal-native ANSI colors."""
    import re
    if not sys.stdout.isatty():
        return text

    reset="\033[0m"
    bold="\033[1m"
    italic="\033[3m"
    underline="\033[4m"
    cyan="\033[36m"
    magenta="\033[35m"
    yellow="\033[33m"
    green="\033[32m"
    blue="\033[34m"

    out=[]
    in_code=False
    for line in text.splitlines():
        if line.strip().startswith("```"):
            in_code=not in_code
            continue
        if in_code:
            out.append(green + line + reset)
            continue

        if line.startswith("# "):
            out.append(bold + cyan + line[2:] + reset)
            continue
        if line.startswith("## "):
            out.append(bold + magenta + line[3:] + reset)
            continue
        if line.startswith("### "):
            out.append(bold + yellow + line[4:] + reset)
            continue

        # Protect inline code while applying the other lightweight markup.
        code_spans=[]
        def hold_code(match):
            code_spans.append(match.group(1))
            return f"\x00CODE{len(code_spans)-1}\x00"
        line=re.sub(r'`([^`]+)`', hold_code, line)

        # Keep the real URL visible. Terminal URL detection is more portable
        # than hidden hyperlink metadata and remains easy to copy or right-click.
        def render_link(match):
            label, url = match.group(1), match.group(2)
            return label + " — " + blue + underline + url + reset

        line=re.sub(
            r'\[([^\]]+)\]\((https?://[^)]+)\)',
            render_link,
            line,
        )
        # Style literal URLs too, while leaving the URL itself intact.
        line=re.sub(
            r'(?<!\x1b]8;;)(?<!\()(?<!\w)(https?://[^\s<>]+)',
            lambda m: blue + underline + m.group(1) + reset,
            line,
        )
        line=re.sub(r'\*\*(.+?)\*\*', lambda m: bold+m.group(1)+reset, line)
        line=re.sub(r'(?<!\*)\*([^*\n]+)\*(?!\*)', lambda m: italic+m.group(1)+reset, line)
        line=re.sub(r'(?<!_)_([^_\n]+)_(?!_)', lambda m: italic+m.group(1)+reset, line)

        if line.startswith(('- ', '* ')):
            line=cyan+'•'+reset+' '+line[2:]

        for i, code in enumerate(code_spans):
            line=line.replace(f"\x00CODE{i}\x00", green+code+reset)
        out.append(line)
    return "\n".join(out)



def _split_ollama_thinking(message):
    """Return (thinking, final) across structured and Qwen template variants."""
    import re
    message=message or {}
    structured=str(message.get("thinking") or "").strip()
    content=str(message.get("content") or "")

    if structured:
        final=re.sub(r"^\s*<think>\s*", "", content, flags=re.I)
        final=re.sub(r"\s*</think>\s*", "", final, count=1, flags=re.I)
        return structured, final.strip()

    match=re.search(r"<think>(.*?)</think>", content, flags=re.I|re.S)
    if match:
        thinking=match.group(1).strip()
        final=(content[:match.start()] + content[match.end():]).strip()
        return thinking, final

    close=re.search(r"</think>", content, flags=re.I)
    if close:
        return content[:close.start()].strip(), content[close.end():].strip()

    return "", content.strip()


def _print_ollama_answer(message):
    """Render reasoning as process and the final response as the result."""
    thinking,final=_split_ollama_thinking(message)

    if thinking:
        if sys.stdout.isatty():
            dim="\033[2m"; italic="\033[3m"; reset="\033[0m"
            print("\n" + _ansi_label("thinking ›","2"))
            rendered=_ollama_markup(thinking)
            for line in rendered.splitlines():
                print("  " + dim + italic + line + reset)
        else:
            print("\nthinking ›")
            for line in thinking.splitlines():
                print("  "+line)
        print()

    if final:
        print(_ansi_label("lo ›","35") + " " + _ollama_markup(final) + "\n")
    else:
        print(_ansi_label("lo ›","35") + " " + _c("(no final response)","2") + "\n")



