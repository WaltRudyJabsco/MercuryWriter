def _lo_media_intent_profile(prompt,profile="workspace"):
    """Resolve exact media commands first, learned bounded ambiguity second."""
    text=" ".join(str(prompt or "").strip().split())
    if not text or _lo_explicit_web_scope(text): return None
    low=text.casefold().strip(" .!?")
    status_patterns=(r"^(?:what(?:'s| is) playing|now playing|what am i listening to)$",)
    if any(re.match(pattern,low) for pattern in status_patterns):
        return {"tool":"media_control","args":{"action":"status"}}
    ordinal_controls={
        "play first track":"first","play first song":"first","first track":"first","first song":"first",
        "play first track on album":"first_album","play first song on album":"first_album",
        "play first track on the album":"first_album","play first song on the album":"first_album",
        "start album over":"first_album","restart album":"first_album",
        "play last track":"last","play last song":"last","last track":"last","last song":"last",
    }
    if low in ordinal_controls: return {"tool":"media_control","args":{"action":ordinal_controls[low]}}
    controls={
        "pause":"pause","pause music":"pause","pause playback":"pause","resume":"play","resume music":"play","resume playback":"play",
        "next":"next","next track":"next","next song":"next",
        "next album":"next_album","go to next album":"next_album","go to the next album":"next_album",
        "play next album":"next_album","play the next album":"next_album",
        "previous":"previous","previous track":"previous","previous song":"previous",
        "prev":"previous","stop":"stop","stop music":"stop","stop playback":"stop",
    }
    if low in controls: return {"tool":"media_control","args":{"action":controls[low]}}
    try:
        normalizer=_intent_normalizer_module()
        resolution=normalizer.resolve(text)
        normalized=normalizer.media_tool(resolution.get("intent") if resolution.get("status")=="resolved" else None)
    except Exception:
        resolution={"status":"no_match"}
        normalized=None
    if normalized:
        return normalized
    if resolution.get("status")=="clarify":
        return None
    judged=_lo_media_decision_intent(text,profile)
    if judged: return judged
    if re.search(r"\b(this|that|it|these|those)\b",low): return None
    match=re.match(r"^(?:please\s+)?(play|queue|shuffle)\s+(.+?)$",text,re.I)
    if not match: return None
    verb=match.group(1).casefold(); target=match.group(2).strip(" .!?")
    if not target: return None
    if verb=="queue": return {"tool":"media_queue","args":{"query":target}}
    return {"tool":"media_play","args":{"query":target,"shuffle":verb=="shuffle"}}



def _lo_game_intent(prompt):
    """Resolve the tiny LOOK Games vocabulary before a model can misroute it."""
    raw=" ".join(str(prompt or "").strip().casefold().replace("-"," ").split())
    exact={
        "ttt":"ttt","tic tac toe":"ttt","tic tac toe game":"ttt",
        "checkers":"checkers","draughts":"checkers","chess":"chess",
        "backgammon":"backgammon","gtnw":"gtnw",
        "global thermonuclear war":"gtnw","global thermonuclear war game":"gtnw",
        "play a game":"","play game":"","games":"",
    }
    if raw in exact:
        return {"tool":"game_action","args":{"game":exact[raw]}}
    m=re.match(r"^(?:please\s+)?(?:(?:let'?s|lets)\s+)?(?:play|start|open|launch)\s+(?:a\s+)?(.+?)\s*$",raw)
    if not m:
        return None
    noun=m.group(1).strip()
    aliases={
        "game":"","games":"","ttt":"ttt","tic tac toe":"ttt",
        "checkers":"checkers","draughts":"checkers","chess":"chess",
        "backgammon":"backgammon","gtnw":"gtnw","global thermonuclear war":"gtnw",
    }
    if noun not in aliases:
        return None
    return {"tool":"game_action","args":{"game":aliases[noun]}}


