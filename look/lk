        durable=durable[-MEMORY_DURABLE_LIMIT:]
        domain_summaries=data.get("domain_summaries",{}) if isinstance(data.get("domain_summaries"),dict) else {}
        domain_summaries={str(k):_sanitize_summary(v)[:1000] for k,v in domain_summaries.items() if str(k) in MEMORY_DOMAINS and _sanitize_summary(v)}
        atoms=[]
        for item in data.get("atoms",[]):
            if not isinstance(item,dict): continue
