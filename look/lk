                "last_fabric_sync_at":float(data.get("last_fabric_sync_at",0) or 0)}
        # Schema 3 has no permanent legacy tier. Fold an old compact summary into
        # one scoped durable atom if it is not already represented, then retire it.
        legacy=str(result.get("legacy_summary","")).strip()
        if legacy and not _looks_environmental_memory(legacy):
            if _durable_memory_match(result,legacy) is None:
                result.setdefault("durable",[]).append({
