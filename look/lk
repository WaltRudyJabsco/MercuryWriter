def _local_chat_once(base, model, messages, *, num_ctx=4096, num_predict=128, think=False, temperature=0.2):
    import json
    import urllib.request
    payload=json.dumps({
        "model": model,
        "messages": messages,
        "stream": False,
        "think": think,
        "options": {
            "num_ctx": int(num_ctx),
            "num_predict": int(num_predict),
            "temperature": float(temperature),
        },
    }).encode()
    request=urllib.request.Request(
        base + "/api/chat", data=payload,
        headers={"Content-Type": "application/json"}, method="POST"
    )
    with urllib.request.urlopen(request, timeout=OLLAMA_CHAT_TIMEOUT) as response:
        result=json.load(response)
    return result.get("message", {}).get("content", "").strip()



@contextmanager
def _activity(label):
    """Show a small animated status while a synchronous Ollama step is busy."""
    interactive = sys.stdout.isatty()
    if not interactive:
        print(f"· {label}", flush=True)
        yield
        return

    stop = threading.Event()
    frames = ("◐", "◓", "◑", "◒")

    def animate():
        i = 0
        while not stop.is_set():
            frame=_c(frames[i % len(frames)], "36")
            sys.stdout.write(f"\r\033[2K{frame} {_c(label,'2')} {_c('· Ctrl-C cancel','2')}")
            sys.stdout.flush()
            i += 1
            stop.wait(0.12)

    worker = threading.Thread(target=animate, daemon=True)
    worker.start()
    try:
        yield
    finally:
        stop.set()
        worker.join(timeout=0.5)
        sys.stdout.write("\r\033[2K")
        sys.stdout.flush()

class _ActivityHandle:
    """Start/stop spinner for streaming waits; disappears on first model event."""
    def __init__(self,label):
        self.label=label; self.stop=threading.Event(); self.worker=None
    def start(self):
        if not sys.stdout.isatty(): return self
        frames=("◐","◓","◑","◒")
        started=time.monotonic()
        def animate():
            i=0
            while not self.stop.is_set():
                elapsed=time.monotonic()-started
                # A little Bear-like patience, but only while a real request is active.
                # The wording never invents a phase we have not observed.
                if elapsed < 2.0:
                    status=self.label
                elif elapsed < 5.0:
                    status="working on it…"
                elif elapsed < 9.0:
                    status="just a little longer…"
                else:
                    status=f"still working · {self.label}"
                sys.stdout.write(f"\r\033[2K{_c(frames[i%4],'36')} {_c(status,'2')} {_c('· Ctrl-C cancel','2')}")
                sys.stdout.flush(); i+=1; self.stop.wait(.12)
        self.worker=threading.Thread(target=animate,daemon=True); self.worker.start()
        return self
    def finish(self):
        if self.worker:
            self.stop.set(); self.worker.join(timeout=.4)
            sys.stdout.write("\r\033[2K"); sys.stdout.flush(); self.worker=None


