        try:
            product_release=release_path.read_text(encoding="utf-8").strip()
        except OSError:
            product_release=""
        suffix=f" · Future Crash + LOOK {product_release}" if product_release else ""
        print(f"LOOK {VERSION}{suffix}")
        return 0
    if cmd=="home": return home()
    if cmd=="undo":
        if rest and rest[0] in {"list","history"}: return _undo_list()
        if rest and rest[0]=="skip": return _undo_skip()
        if rest:
            print("usage: lk undo [list|skip]")
            return 2
        return _undo_last()
    if cmd=="_batch":
        if len(rest)<3: return 2
        kind=rest[0]
        if kind=="remove":
            paths=rest[2:] if rest[1]=="--" else rest[1:]
            return _batch_action(kind,"",paths)
        return _batch_action(kind,rest[1],rest[2:])
    if cmd=="_copy":
        if len(rest)!=2: return 2
        result=_interactive_file_action("copy",rest[0],rest[1])
        print(_action_result(result))
        return 0 if result.startswith("COPY OK") else 1
    if cmd=="_move":
        if len(rest)!=2: return 2
        result=_interactive_file_action("move",rest[0],rest[1])
        print(_action_result(result))
        return 0 if result.startswith("MOVE OK") else 1
    if cmd=="_remove":
        if len(rest)!=1: return 2
        result=_journal_remove(rest[0])
        print(_action_result(result))
        return 0 if result.startswith("REMOVE OK") else 1
    if cmd=="_mkdir":
        if len(rest)!=1: return 2
        result=_journal_mkdir(rest[0])
        print(_action_result(result))
        return 0 if result.startswith(("MKDIR OK","Directory already exists:")) else 1
    if cmd=="_touch":
        create_missing=False
        if rest and rest[0]=="--parents":
            create_missing=True
            rest=rest[1:]
        if len(rest)!=1: return 2
        result=_journal_touch(rest[0],create_missing=create_missing)
        print(_action_result(result))
        return 0 if result.startswith("FILE OK") else 1
    if cmd=="dash": return _fabric_command(["dashboard"] + rest)
    if cmd in {"fabric","nodes"}: return _fabric_command((["nodes"] if cmd=="nodes" else rest))
    if cmd=="doctor": return doctor_island() if rest and rest[0]=="island" else doctor()
    if cmd=="locator-test": return _locator_test()
    if cmd=="architecture-audit": return _architecture_audit()
    if cmd=="tooling-audit": return _tooling_audit()
    if cmd=="command-audit": return _command_audit()
    if cmd in {"receipts","receipt"}:
        return receipts(rest[0] if rest else 30)
    if cmd in {"ai-pool","aipool"}: return ai_pool(rest)
    if cmd=="settings": return settings(" ".join(rest))
    if cmd=="uninstall": return uninstall()
    if cmd=="config":
        if rest and rest[0] in {"paths","raw"}:
            print(f"LOOK {VERSION}\n  executable  {Path(__file__).resolve()}\n  renderer    {RENDERER}\n  zshrc       {HOME/'.zshrc'}\n  secrets     {HOME/'.zsh_secrets'}\n  memory      {MEMORY_FILE}\n  memory queue {MEMORY_QUEUE}\n  undo        {UNDO_FILE}\n  undo skipped {UNDO_SKIPPED_FILE}\n  active model {_active_ollama_model()}\n  ollama models {OLLAMA_MODELS_FILE}")
            return 0
        return _surface_config()
    if cmd=="secrets":
        p=HOME/".zsh_secrets"
        if not p.exists(): print("LOOK secrets: ~/.zsh_secrets is not present."); return 1
        mode=oct(p.stat().st_mode & 0o777)
        print(f"LOOK secrets: {p} exists · permissions {mode} · contents hidden")
        return 0 if mode=="0o600" else 1
    if cmd in modes: return render(["--mode", modes[cmd], "--interactive", *rest])
    if cmd in {"run","project"}: return inspect_project(rest[0] if rest else '.')
    if cmd in {"up","ports","services"}: return inspect_up()
    if cmd=="port":
        if not rest or not rest[0].isdigit(): print("usage: lk port <number>"); return 2
        port=int(rest[0]); return inspect_port(port) if 1 <= port <= 65535 else 2
    if cmd in {"processes","procs"}: return inspect_processes()
    if cmd in {"process","proc"}:
        if not rest: print("usage: lk process <name>"); return 2
        query=" ".join(rest); result=inspect_process(query)
        if result is None:
            _title(query, 'process'); print(f"  {_c('·','33')} no matching process found"); return 1
        return result
    if cmd=="pid":
        if not rest or not rest[0].isdigit(): print("usage: lk pid <number>"); return 2
        return inspect_pid(int(rest[0]))
    if cmd=="git": return inspect_git(rest[0] if rest else '.')
    if cmd in {"machine","box"}: return inspect_machine()
    if cmd=="net": return _surface_net()
    if cmd=="network": return inspect_network()
    if cmd=="tailscale": return inspect_tailscale()
    if cmd=="model" and rest and rest[0]=="current":
        payload={"model":_active_ollama_model()}
        if "--json" in rest: _print_json(payload)
        else: print(payload["model"])
        return 0
    if cmd=="inference":
        payload=_inference_config()
        try:
            running=_ollama_ps(payload["endpoint"],timeout=1.0)
            names=[(m.get("name") or m.get("model") or "").strip() for m in running]
            payload["reachable"]=True
            payload["resident"]=payload["model"] in names
            payload["running_models"]=[x for x in names if x]
        except Exception as exc:
            payload["reachable"]=False; payload["resident"]=False; payload["error"]=str(exc)
        if "--json" in rest: _print_json(payload)
        else:
            for k,v in payload.items(): print(f"{k:<15} {v}")
        return 0
    if cmd=="ollama":
        if rest and rest[0]=="endpoint":
            payload=_inference_config()
            if "--json" in rest: _print_json(payload)
            else: print(payload["endpoint"])
            return 0
        if rest and rest[0]=="key":
            return ollama_key(rest[1:])
        if rest and rest[0] in {"host","hosts"}:
            return ollama_hosts(rest[1:])
        if rest and rest[0]=="share":
            return ollama_share(rest[1:])
        if rest and rest[0]=="access":
            return lo_access(rest[1:])
        if rest and rest[0]=="models":
            return ollama_models(rest[1] if len(rest)>1 else None)
        if rest and rest[0]=="test":
            if "--resident-set" in rest[1:]:
                return ollama_test_resident_set()
            return ollama_test(all_models=("--all" in rest[1:]))
        if rest and rest[0]=="curate":
            return ollama_curate(rest[1:])
        if rest and rest[0]=="set":
            return ollama_set(rest[1:])
        if rest and rest[0]=="warm":
            return ollama_warm(rest[1:])
        return inspect_ollama()
    if cmd=="env": return inspect_env()
    if cmd=="path": return inspect_path()
    if cmd=="gpu": return inspect_gpu()
    if cmd=="disk": return inspect_disk()
    if cmd=="why":
        if not rest: print("usage: lk why <command>"); return 2
        return inspect_command(rest[0])
    if len(a)==1: return inspect_anything(cmd)
    return render(a)
if __name__=="__main__":
    try: raise SystemExit(main())
    except KeyboardInterrupt: raise SystemExit(130)
