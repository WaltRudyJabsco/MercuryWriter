def _queue_lo_background(prompt, workspace, profile):
    prompt=str(prompt or "").strip()
    if not prompt:
        print("usage: lo bg <request>")
        return 2
    LO_JOBS_DIR.mkdir(parents=True,exist_ok=True)
    job_id=uuid.uuid4().hex[:10]
    path=LO_JOBS_DIR/f"{job_id}.json"
    job={
        "id":job_id,
        "status":"queued",
        "prompt":prompt,
        "workspace":str(Path(workspace).resolve()),
        "profile":profile,
        "created_at":time.time(),
        "started_at":None,
        "finished_at":None,
    }
    _atomic_json(path,job)
    if not _ai_broker_wake("job"):
        try:
            subprocess.Popen([sys.executable,str(Path(__file__).resolve()),"_lo-job",str(path)],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True,close_fds=True)
        except OSError as exc:
            job["status"]="failed"; job["error"]=str(exc); job["finished_at"]=time.time(); _atomic_json(path,job)
            print(f"LO background · failed to start: {exc}")
            return 1
    print(f"LO background · queued {job_id}")
    return 0

def _run_lo_job(path):
    import io, contextlib
    path=Path(path)
    try:
        job=json.loads(path.read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError):
        return 1
    job["status"]="running"; job["started_at"]=time.time(); _atomic_json(path,job)
    old_cwd=_safe_cwd()
    buf=io.StringIO()
    rc=1
    try:
        workspace=Path(job.get("workspace") or old_cwd).expanduser().resolve()
        os.chdir(workspace)
        with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
            rc=ollama_chat(
                initial_prompt=job.get("prompt",""),
                access_profile=job.get("profile","workspace"),
                workspace_override=workspace,
                one_shot=True,
            )
        job["status"]="done" if rc==0 else "failed"
    except Exception as exc:
        job["status"]="failed"; job["error"]=str(exc)
    finally:
        try: os.chdir(old_cwd)
        except OSError: pass
    job["finished_at"]=time.time()
    output=re.sub(r"\x1b\[[0-9;?]*[A-Za-z]","",buf.getvalue()).strip()
    job["output"]=output[-12000:]
    _atomic_json(path,job)
    if job["status"]=="done":
        # Prefer the final LO line, but retain enough context to be useful.
        lines=[x.strip() for x in output.splitlines() if x.strip()]
        tail="\n".join(lines[-6:]) if lines else "completed"
        _emit_event("complete",tail,job.get("id"))
    else:
        _emit_event("failed",job.get("error") or output[-1000:] or "background job failed",job.get("id"))
    return 0 if job["status"]=="done" else 1


def _fabric_doctor():
    """Diagnose each Fabric layer separately: listener, advertisement, trust, peers."""
    import socket as _socket
    import urllib.parse as _urlparse

    print("LOOK FABRIC DOCTOR")
    base="http://127.0.0.1:7332"
    try:
        with urllib.request.urlopen(base+"/v1/node",timeout=2.0) as response:
            local=json.loads(response.read().decode("utf-8"))
        print(f"  local node       ✓ {local.get('name') or platform.node() or 'local'} · {local.get('version') or '?'}")
    except Exception as exc:
        print(f"  local node       × 127.0.0.1:7332 · {exc}")
        print("  diagnosis        Unified Node is not reachable locally; peer/media tests cannot run")
        return 1

    # A node must never advertise encrypted ingress unless something is actually
    # listening. This catches the Mac launchd failure that peer diagnostics alone
    # misleadingly report as an advertisement/auth problem.
    tailcat_listening=False
    try:
        sock=_socket.create_connection(("127.0.0.1",7443),timeout=1.0)
        sock.close(); tailcat_listening=True
        print("  Tailcat listen   ✓ 0.0.0.0:7443 (local probe 127.0.0.1:7443)")
    except Exception as exc:
        print(f"  Tailcat listen   × :7443 not accepting connections · {exc}")
        print("  diagnosis        encrypted Fabric ingress is not running on this machine")

    ad_path=Path.home()/".config/future-crash-look/tailcat/advertisement.json"
    endpoints=[]
    try:
        ad=json.loads(ad_path.read_text(encoding="utf-8")); endpoints=list(ad.get("endpoints") or [])
    except Exception:
        pass
    if endpoints:
        ad_version=str(ad.get("version") or "?") if isinstance(ad,dict) else "?"
        print("  advertise        " + ("✓ " if tailcat_listening else "× ") + f"Tailcat {ad_version} · " + ", ".join(endpoints[:6]))
    else:
        print("  advertise        × no Tailcat endpoints published")
    ts=(ad.get("tailscale") or {}) if isinstance(ad,dict) else {}
    if ts.get("ok"):
        detail=[]
        if ts.get("dns"): detail.append(str(ts.get("dns")))
        detail.extend(str(x) for x in (ts.get("ips") or []) if ":" not in str(x))
        print("  Tailscale route  ✓ " + (", ".join(detail) or str(ts.get("binary") or "available")))
    else:
        print(f"  Tailscale route  × {str(ts.get('error') or 'not published')}" + (f" · {ts.get('binary')}" if ts.get('binary') else ""))

    try:
        with urllib.request.urlopen(base+"/v1/media/catalog",timeout=8.0) as response:
            catalog=json.loads(response.read().decode("utf-8"))
        print(f"  local media      ✓ {int(catalog.get('count') or len(catalog.get('entries') or [])):,} locations")
    except Exception as exc:
        print(f"  local media      × {exc}")
    try:
        with urllib.request.urlopen(base+"/v1/nodes",timeout=4.0) as response:
            snap=json.loads(response.read().decode("utf-8"))
        with urllib.request.urlopen(base+"/v1/media/fabric",timeout=30.0) as response:
            fabric=json.loads(response.read().decode("utf-8"))
    except Exception as exc:
        print(f"  Fabric route     × {exc}"); return 1
    peers=list(snap.get('peers') or [])
    print(f"  peer discovery   ✓ {len(peers)} known peer{'s' if len(peers)!=1 else ''}")
    counts={str(x.get('node') or ''):int(x.get('count') or 0) for x in (fabric.get('nodes') or [])}
    errors={str(x.get('node') or ''):str(x.get('error') or '') for x in (fabric.get('errors') or [])}
    failures=0
    for peer in peers:
        ad=peer.get('node') or {}; name=str((ad.get('identity') or {}).get('name') or peer.get('name') or '?')
        endpoint=str(peer.get('url') or ((peer.get('tailcat_endpoints') or [''])[0]) or (('https://'+str(peer.get('dns'))+':7332') if peer.get('dns') else ''))
        trust='AUTH' if peer.get('trusted') else 'UNTRUSTED'
        if name in counts:
            print(f"  {name:<16} ✓ {trust} · media {counts[name]:,} · {endpoint or 'Fabric route'}")
        else:
            failures+=1
            state='advertisement unavailable' if not ad else 'media catalog unreachable'
            print(f"  {name:<16} × {trust} · {state} · {endpoint or 'no endpoint'}")
            reason=errors.get(name) or str(peer.get('node_error') or 'no successful authenticated catalog response')
            print(f"    {reason[:500]}")
    if not peers:
        print("  diagnosis        no peers are discovered/trusted on this node")

    # Route matrix: test each trusted address separately so a dead .local route
    # cannot hide a healthy LAN/Tailscale route behind one generic timeout.
    try:
        with urllib.request.urlopen(base+"/v1/fabric/routes",timeout=30.0) as response:
            routes=json.loads(response.read().decode("utf-8"))
        rows=list(routes.get("peers") or [])
        if rows:
            print("  route matrix")
        for row in rows:
            print(f"    {str(row.get('name') or '?'):<16} {'AUTH' if row.get('trusted') else 'UNTRUSTED'}")
            selected=str(row.get("selected") or "")
            for probe in row.get("probes") or []:
                endpoint=str(probe.get("endpoint") or "?")
                marker="✓" if probe.get("ok") else "×"
                chosen=" · SELECTED" if endpoint == selected else ""
                if probe.get("ok"):
                    who=str(probe.get("name") or probe.get("node_id") or "identity ok")
                    detail=f"{int(probe.get('ms') or 0)}ms · {who}"
                else:
                    detail=str(probe.get("error") or "failed")
                print(f"      {marker} {endpoint}{chosen}")
                print(f"        {detail[:500]}")
    except Exception as exc:
        print(f"  route matrix     × {exc}")
    return 1 if failures or not tailcat_listening else 0

def _fabric_command(args):
    """Human CLI over the shared Fabric. Remote actions stay capability-scoped."""
    exe=shutil.which("fcl-node") or str(HOME/".local/bin/fcl-node")
    if not Path(exe).exists():
        print("LOOK FABRIC · unified node is not installed")
        return 1
    sub=(args[0] if args else "fabric")
    aliases={"list":"nodes","node":"status","model":"models"}
    sub=aliases.get(sub,sub)
    if sub=="dash": sub="dashboard"
    if sub in {"doctor","diagnose","debug"}: return _fabric_doctor()
    if sub not in {"fabric","doctor","watch","dashboard","dash","beacon","lights","nodes","activity","pulse","models","status","qualify","services","service","jobs","job","submit","packet","cancel","events","http","decisions","decision","answer","ask","decision-shadow","decision-provider","identity","trust","untrust","pair-code","pair","transport","rendezvous","endpoints","endpoint-code","allow","revoke-endpoint","speak","alert","route"}:
        print("usage: lk fabric [doctor|identity|trust|pair-code [URL]|pair NODE CODE|untrust NODE_ID|transport|rendezvous [status|set URL|off|sync]|endpoints|endpoint-code URL [once|trust]|allow CODE [once|trust]|revoke-endpoint ENDPOINT_ID|watch|dashboard|decisions [NODE]|decision [NODE] ID|answer [NODE] ID CHOICE|ask [NODE] QUESTION [CHOICE ...]|decision-shadow [NODE] STATE QUESTION CANDIDATE...|decision-provider [NODE]|beacon|lights|nodes|status|activity|pulse|models|route reflex|balanced|deep|jobs|events|submit|packet|cancel|qualify|services|service|speak [NODE] TEXT|alert [@TARGET] MESSAGE]")
        return 2
    argv=[exe,sub]
    rest=list(args[1:])
    if sub=="alert":
        if not rest:
            print("usage: lk fabric alert [@TARGET] MESSAGE"); return 2
        if rest[0].startswith("@") and len(rest[0])>1:
            argv += ["--target",rest.pop(0)[1:]]
        argv += rest
    elif sub=="speak":
        if not rest:
            print("usage: lk fabric speak [NODE] TEXT"); return 2
        # `@node` is unambiguous; otherwise one word means local speech.
        if rest[0].startswith("@"):
            argv += ["--node",rest.pop(0)[1:]]
        argv += rest
    elif sub in {"status","activity","pulse","models","services","jobs","events","http","decisions","decision-provider"}:
        if rest and not rest[0].startswith("-"):
            argv += ["--node",rest.pop(0)]
        argv += rest
    elif sub in {"job","cancel","decision"}:
        if not rest:
            print(f"usage: lk fabric {sub} [NODE] ID"); return 2
        if len(rest)>=2:
            argv += ["--node",rest.pop(0)]
        argv += rest[:1]
    elif sub=="answer":
        if len(rest)<2:
            print("usage: lk fabric answer [NODE] ID CHOICE"); return 2
        if len(rest)>=3:
            argv += ["--node",rest.pop(0)]
        argv += rest[:2]
    elif sub in {"ask","decision-shadow"}:
        if not rest:
            print(f"usage: lk fabric {sub} [NODE] ..."); return 2
        # Explicit @node avoids guessing whether natural-language question text is a node.
        if rest[0].startswith("@"):
            argv += ["--node",rest.pop(0)[1:]]
        argv += rest
    elif sub=="submit":
        if not rest:
            print("usage: lk fabric submit [NODE] OP [key=value ...]"); return 2
        # A dotted operation is unmistakably an operation. Otherwise the first token
        # is a node and the second is the operation.
        if len(rest)>=2 and "." not in rest[0]:
            argv += ["--node",rest.pop(0)]
        argv += rest
    elif sub=="packet":
        if not rest:
            print("usage: lk fabric packet [NODE] FILE"); return 2
        if len(rest)>=2:
            argv += ["--node",rest.pop(0)]
        argv += rest[:1]
    elif sub=="qualify":
        if not rest:
            print("usage: lk fabric qualify [NODE] MODEL"); return 2
        if len(rest)>=2:
            argv += ["--node",rest.pop(0)]
        argv += rest[:1]
    elif sub=="service":
        if len(rest)<2:
            print("usage: lk fabric service [NODE] SERVICE start|stop|restart"); return 2
        if len(rest)>=3:
            argv += ["--node",rest.pop(0)]
        argv += rest
    else:
        argv += rest

    # Dashboard/watch own Ctrl-C inside the child process. Both parent and child
    # share the terminal process group, so Python may interrupt this wait at the
    # same instant the child is using Ctrl-C to leave Watch. Keep waiting for the
    # child instead of turning a normal UI action into a traceback.
    proc=subprocess.Popen(argv)
    while True:
        try:
            return proc.wait()
        except KeyboardInterrupt:
            if sub in {"dashboard","watch"}:
                continue
            raise

def _load_model_sets():
    try:
        data=json.loads(MODEL_SETS_FILE.read_text(encoding="utf-8"))
        if isinstance(data,dict):
            data.setdefault("schema",1); data.setdefault("sets",{}); data.setdefault("champion",""); data.setdefault("challenger","")
            return data
    except Exception:
        pass
    return {"schema":1,"sets":{},"champion":"","challenger":""}

def _save_model_sets(data):
    STATE_DIR.mkdir(parents=True,exist_ok=True)
    tmp=MODEL_SETS_FILE.with_suffix('.tmp')
    tmp.write_text(json.dumps(data,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
    try: os.chmod(tmp,0o600)
    except OSError: pass
    tmp.replace(MODEL_SETS_FILE)

def _model_set_snapshot(name):
    plans={}
    evidence={}
    for role in ("reflex","balanced","deep"):
        data=_curator_request({"profile":role})
        plan=data.get("plan") or data
        plans[role]=list(plan.get("target") or [])
        for row in plan.get("models") or []:
            evidence[str(row.get("name") or "")]=row
    try:
        current=[(m.get("name") or m.get("model") or "").strip() for m in _ollama_ps(LOCAL_OLLAMA_URL)]
        current=[x for x in current if x]
    except Exception:
        current=[]
    return {"name":name,"created_at":time.time(),"node":platform.node(),"resident":current,
            "roles":plans,"evidence":evidence}

def _apply_model_set(row, role="balanced"):
    roles=row.get("roles") or {}
    target=list(roles.get(role) or row.get("resident") or [])
    if not target:
        raise RuntimeError(f"model set has no {role} target")
    installed={str(m.get("name") or m.get("model") or "") for m in _ollama_tags(LOCAL_OLLAMA_URL)}
    missing=[m for m in target if m not in installed]
    if missing:
        raise RuntimeError("models not installed: "+", ".join(missing))
    current=[str(m.get("name") or m.get("model") or "") for m in _ollama_ps(LOCAL_OLLAMA_URL)]
    unloaded=[]; loaded=[]
    for name in current:
        if name and name not in target:
            _ollama_post(LOCAL_OLLAMA_URL,"/api/generate",{"model":name,"prompt":"","stream":False,"keep_alive":0},timeout=30)
            unloaded.append(name)
    for name in target:
        _ollama_post(LOCAL_OLLAMA_URL,"/api/generate",{"model":name,"prompt":"","stream":False,"keep_alive":-1,"options":{"num_ctx":4096}},timeout=180)
        loaded.append(name)
    _audit_receipt("operator","model_set_apply",row.get("name","") or role,ok=True,role=role,target=",".join(target))
    return target,unloaded,loaded

def _model_set_score(row):
    ev=row.get("evidence") or {}
    parts=[]
    for model,data in ev.items():
        r=(data or {}).get("roles") or {}
        parts.append((int(r.get("reasoning") or 0),int(r.get("tools") or 0),1 if r.get("agent") else 0,1 if r.get("exact") else 0,float(r.get("rate") or 0)))
    if not parts: return (0,0,0,0,0.0)
    return tuple(round(sum(x[i] for x in parts)/len(parts),2) for i in range(5))

def ollama_set(args):
    args=list(args or [])
    state=_load_model_sets(); sets=state.setdefault("sets",{})
    if not args or args[0]=="list":
        print("LOOK MODEL SETS")
        if not sets: print("  none")
        for name,row in sorted(sets.items()):
            marks=[]
            if state.get("champion")==name: marks.append("CHAMPION")
            if state.get("challenger")==name: marks.append("CHALLENGER")
            roles=row.get("roles") or {}
            print(f"  {name:<20} {'/'.join(marks) or 'saved':<20} balanced={','.join(roles.get('balanced') or row.get('resident') or []) or 'none'}")
        return 0
    op=args[0]
    if op=="save":
        if len(args)<2: print("usage: lk ollama set save NAME"); return 2
        name=args[1]
        try: sets[name]=_model_set_snapshot(name)
        except Exception as exc: print(f"LOOK MODEL SET · {exc}"); return 1
        _save_model_sets(state); print(f"LOOK MODEL SET · saved {name}"); return 0
    if op in {"champion","challenger"}:
        if len(args)<2 or args[1] not in sets: print(f"usage: lk ollama set {op} NAME  # NAME must already be saved"); return 2
        state[op]=args[1]; _save_model_sets(state); print(f"LOOK MODEL SET · {op} = {args[1]}"); return 0
    if op=="show":
        if len(args)<2 or args[1] not in sets: print("usage: lk ollama set show NAME"); return 2
        row=sets[args[1]]; print(f"LOOK MODEL SET · {args[1]}")
        for role in ("reflex","balanced","deep"): print(f"  {role:<9} "+(", ".join((row.get('roles') or {}).get(role) or []) or "none"))
        print("  saved     "+time.strftime("%Y-%m-%d %H:%M",time.localtime(float(row.get('created_at') or 0))))
        print("  score     reasoning/tools/agent/exact/rate avg = "+" / ".join(map(str,_model_set_score(row))))
        return 0
    if op=="apply":
        if len(args)<2 or args[1] not in sets: print("usage: lk ollama set apply NAME [reflex|balanced|deep]"); return 2
        role=args[2] if len(args)>2 and args[2] in {"reflex","balanced","deep"} else "balanced"
        try: target,unloaded,loaded=_apply_model_set(sets[args[1]],role)
        except Exception as exc: print(f"LOOK MODEL SET · {exc}"); return 1
        print(f"LOOK MODEL SET · {args[1]} · {role.upper()}")
        print("  target    "+", ".join(target)); print("  unloaded  "+(", ".join(unloaded) or "none")); print("  loaded    "+(", ".join(loaded) or "none")); return 0
    if op=="compare":
        if len(args)<3 or args[1] not in sets or args[2] not in sets: print("usage: lk ollama set compare A B"); return 2
        for name in args[1:3]:
            row=sets[name]; score=_model_set_score(row)
            print(f"{name:<20} reasoning {score[0]} · tools {score[1]} · agent {score[2]} · exact {score[3]} · rate {score[4]}")
        return 0
    if op in {"delete","remove"}:
        if len(args)<2 or args[1] not in sets: print("usage: lk ollama set delete NAME"); return 2
        name=args[1]; sets.pop(name,None)
        if state.get("champion")==name: state["champion"]=""
        if state.get("challenger")==name: state["challenger"]=""
        _save_model_sets(state); print(f"LOOK MODEL SET · deleted {name}"); return 0
    print("usage: lk ollama set [list|save NAME|show NAME|apply NAME [ROLE]|champion NAME|challenger NAME|compare A B|delete NAME]"); return 2

