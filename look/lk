class _ToolResult:
    __slots__=("ok","status","message","data")
    def __init__(self,ok,status,message,data=None):
        self.ok=bool(ok); self.status=str(status); self.message=str(message); self.data=data or {}

def _filesystem_result(name,message):
    """Translate legacy filesystem runner output into typed truth at one adapter boundary."""
    text=str(message or "")
    success_prefix={
        "write_file":("WRITE OK",),
        "create_text_files":("CREATE FILES OK","FILES OK"),
        "copy_path":("COPY OK",),
        "move_path":("MOVE OK",),
        "remove_path":("REMOVE OK",),
        "make_directory":("MKDIR OK","Directory already exists:"),
        "reveal_path":("REVEAL OK",),
        "open_path":("OPEN OK","DISPATCH OK"),
        "preview_path":("PREVIEW OK",),
    }
    observation={"list_files","inspect_directory","read_file","search_files","search_content"}
    if name in observation:
        bad=text.startswith(("File tool failed:","File tool internal error:","Not a directory:",
                             "Content search failed:","Unknown file tool:","Search query is empty."))
        return _ToolResult(not bad,"ok" if not bad else "failed",text)
    prefixes=success_prefix.get(name,())
    ok=bool(prefixes and text.startswith(prefixes))
    return _ToolResult(ok,"ok" if ok else "failed",text)

def _url_result(message):
    text=str(message or ""); ok=text.startswith("URL OPEN OK")
    return _ToolResult(ok,"dispatched" if ok else "failed",text)

def _command_result(message):
    text=str(message or "")
    if text.startswith("new terminal dispatch ok"):
        return _ToolResult(True,"dispatched",text)
    interactive=re.match(r"interactive\s+exit\s+(-?\d+)",text)
    if interactive:
        code=int(interactive.group(1))
        if code in {130,-signal.SIGINT} and "launched" in text:
            return _ToolResult(True,"interrupted",text)
        return _ToolResult(code==0,"ok" if code==0 else "failed",text)
    m=re.match(r"exit\s+(-?\d+)",text)
    ok=bool(m and int(m.group(1))==0)
    return _ToolResult(ok,"ok" if ok else "failed",text)

def _default_result(message):
    text=str(message or "")
    bad=text.startswith(("Tool internal error:","Unknown capability tool:"))
    return _ToolResult(not bad,"ok" if not bad else "failed",text)

def _normalize_tool_result(name,result):
    """Typed truth is chosen by tool family, never inferred from arbitrary English."""
    if isinstance(result,_ToolResult): return result
    if name in {"list_files","inspect_directory","read_file","search_files","search_content",
                "write_file","create_text_files","copy_path","move_path","remove_path",
                "make_directory","reveal_path","open_path","preview_path"}:
        return _filesystem_result(name,result)
    if name=="open_url": return _url_result(result)
    if name=="run_command": return _command_result(result)
    if name in {"close_object","object_action"}:
        text=str(result or ""); ok=text.startswith(("close ok","window ")) and " failed:" not in text.casefold()
        return _ToolResult(ok,"effect_ok" if ok else "failed",text)
    return _default_result(result)

def _tool_receipt_fields(name,args):
    return {k:args.get(k) for k in ("path","source","destination","url","query","cwd","intent")
            if k in args and args.get(k) not in (None,"")}

def _tool_transaction(name,args,runner,*,actor="lo",truth_name=None):
    """One edge for preflight, execution, typed receipt, and verification truth."""
    action_name=truth_name or name
    try:
        execution_policy=_world_state().begin_action(action_name,args=args)
    except Exception:
        execution_policy={"mode":"normal","preflight":False,"verify":False,"risk":"unknown"}
    started=time.monotonic()
    try:
        raw=runner()
        typed=_normalize_tool_result(truth_name or name,raw)
    except Exception as exc:
        typed=_ToolResult(False,"internal_error",f"Tool internal error: {type(exc).__name__}: {exc}")
    fields=_tool_receipt_fields(name,args)
    fields["duration_ms"]=int((time.monotonic()-started)*1000)
    fields["status"]=typed.status
    fields["execution_mode"]=execution_policy.get("mode","normal")
    fields["verify_required"]=str(bool(execution_policy.get("verify"))).lower()
    _audit_receipt(actor,name,typed.message.splitlines()[0] if typed.message else "no result",
                   ok=typed.ok,**fields)
    try:
        _world_state().record_receipt(action_name,typed.ok,typed.status,typed.message,args=args,duration_ms=fields["duration_ms"])
    except Exception:
        pass
    _live_state_after_receipt(action_name,args,typed)
    return typed.message,typed.ok,fields["duration_ms"]

def receipts(limit=30):
    """Human-readable tail of LOOK's bounded forensic action journal."""
    path=_receipt_log_path()
    try:
        n=max(1,min(200,int(limit)))
    except (TypeError,ValueError):
        n=30
    if not path.exists():
        print("LOOK RECEIPTS\n  no receipts yet")
        return 0
    _repair_receipt_log(path)
    try:
        raw=path.read_text(encoding="utf-8",errors="replace").splitlines()[-n:]
    except OSError as exc:
        print(f"LOOK receipts unavailable: {exc}")
        return 1
    rows=[]
    for line in raw:
        try:
            row=json.loads(line)
            if isinstance(row,dict) and row.get("action"):
                rows.append(row)
        except ValueError:
            continue
    print(f"LOOK RECEIPTS · last {len(rows)}")
    print("─"*min(88,_lo_width()-1))
