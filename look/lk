def generate_command(args):
    if not args:
        print("usage: lk generate <prompt>")
        return 2
    prompt=" ".join(args).strip()
    ok,_=_comfy_probe()
    if not ok:
        # Clients should discover a tailnet GPU host before ever considering a
        # redundant local Comfy install.
        host,_=_comfy_adopt_remote(quiet=True)
        if host:
            ok,_=_comfy_probe(host,timeout=.8)
    if not ok and _comfy_is_gpu_host() and str(_load_comfy_config().get("host","")).startswith(("http://127.0.0.1","http://localhost")):
        started,_=_comfy_start()
        if started:
            ok,_=_comfy_probe()
    if not ok:
        print("LOOK IMAGE · ComfyUI is not reachable")
        print("  run `lk comfy discover` to find a shared GPU host")
        if _comfy_is_gpu_host():
            print("  or run `lk comfy bootstrap` on this NVIDIA workstation")
        return 1
    print(f"{_ansi_label('image ›','35')} {prompt}")
    with _activity("generating"):
        success,result=_comfy_generate(prompt)
    print(("image › " if success else "image error › ")+result)
    return 0 if success else 1


def _agent_tool_contract():
    return """LO TOOL CONTRACT
- Conversation is part of the control loop: prefer a quick useful question over a long blind operation.
- FIND / SEARCH / LOCATE intent -> search_files. Never crawl with list_files and never substitute shell find/mdfind/fd.
- list_files inspects one already-known directory only.
- search_files returns evidence. Evaluate filenames semantically against the user's wording.
- Strong unique evidence may proceed. Plausible-but-not-exact evidence: ask "Did you mean …?" and checkpoint rather than spinning.
- Tool success is not task success. Empty/no-match output means continue, change strategy, or ask the user. Host-visible action success is receipt-gated: never claim opened/playing/launched unless open_path/preview_path/reveal_path returned its OK receipt. DISPATCH OK proves launcher handoff only; it does not prove the app is still running or media is currently playing. URL OPEN OK likewise proves browser dispatch only, not page load or playback.
- OPEN / PLAY preserves the returned path as structured data and uses open_path; do not shell-quote it.
- GENERATED IMAGES: generate_image owns its configured auto-preview. After IMAGE OK, do not call open_path or preview_path for the same generated output unless the user explicitly asks to open/preview it again.
- DOCUMENTS: PDF and DOCX are first-class readable resources through read_file. Never improvise shell/Python/zip extraction for them.
- User answers to clarification are task state, not durable preference unless they explicitly state a lasting preference.
"""

