#compdef lo
# LO completes only its command grammar; after that the input is natural language.

_look_saved_hosts_for_lo() {
  local file="$HOME/.local/share/look/ollama_hosts.json"
  [[ -r "$file" ]] || { print -l local; return; }
  python3 - "$file" 2>/dev/null <<'PY'
import json,sys
try:
    d=json.load(open(sys.argv[1]))
    print("local")
    for name in sorted((d.get("hosts") or {}).keys()):
        if name != "local":
            print(name)
except Exception:
    print("local")
PY
}

_lo() {
  if (( CURRENT == 2 )); then
    local -a opts hosts
    opts=(
      '--conservative:read/search only'
      '--workspace:bounded workspace tools'
      '--power:shell commands with confirmation'
      '--unsafe:unrestricted shell for session'
      '--no-start:do not start missing local Ollama'
      'search:web-search mode'
    )
    _describe -t options 'LO option' opts
    local h
    for h in ${(@f)$(_look_saved_hosts_for_lo)}; do
      hosts+=("@$h")
    done
    _describe -t hosts 'Ollama host' hosts
  fi
}
