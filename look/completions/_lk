#compdef lk
# LOOK context-sensitive completion.

_look_saved_hosts() {
  local file="$HOME/.local/share/look/ollama_hosts.json"
  [[ -r "$file" ]] || { print -l local; return; }
  python3 - "$file" 2>/dev/null <<'PY'
import json,sys
try:
    d=json.load(open(sys.argv[1]))
    print("local")
    for name in sorted((d.get("hosts") or {}).keys()):
        if name != "local":
            print(name)
except Exception:
    print("local")
PY
}

_lk() {
  local context state line
  typeset -A opt_args

  local -a top
  top=(
    'detail:detailed filesystem view'
    'dirs:directories only'
    'files:files only'
    'tree:tree view'
    'recent:newest first'
    'size:size-oriented view'
    'run:project/action view'
    'up:list listening services'
    'ports:list listening ports'
    'port:inspect a port'
    'process:find a process'
    'processes:browse processes'
    'pid:inspect process ID'
    'git:repository status'
    'machine:machine capabilities'
    'gpu:GPU information'
    'disk:disk usage'
    'net:network addresses'
    'tailscale:tailnet status'
    'fabric:distributed supervisor fabric'
    'dash:fabric operational dashboard'
    'beacon:synchronized Fabric beacon demo'
    'lights:synchronized Fabric light show'
    'nodes:fabric peer nodes'
    'env:environment'
    'path:PATH diagnostics'
    'why:explain command resolution'
    'ollama:Ollama models/hosts/search/access'
    'media:media library/session/transport'
    'play:play media with selector/fuzzy matching'
    'scan:refresh lightweight file catalog'
    'find:search local/Fabric file catalog'
    'catalog:inspect local file catalog'
    'player:live LOOK miniplayer'
    'games:WOPR recreation channel'
    'ttt:Tic-Tac-Toe alias'
    'gtnw:Global Thermonuclear War alias'
    'memory:LO user memory'
    'forget:forget matching user memory'
    'clear-memory:clear LO user memory'
    'skills:LO assistant craft'
    'profile:portable LOOK identity'
    'ai:Living AI broker'
    'feedback:terminal motion/sound feedback'
    'sound:toggle feedback sound'
    'voice:configure shared Fabric speech voice'
    'personality:LO personality'
    'thinking:LO thinking depth'
    'think-display:LO thinking presentation'
    'settings:unified settings panel'
    'access:manage LO filesystem grants'
    'apps:manage desktop app preferences'
    'services:inspect/configure/share local LOOK services'
    'share:share configured LOOK services over Tailscale'
    'vision:inspect an image with selected Ollama vision model'
    'generate:generate an image through configured ComfyUI'
    'comfy:discover/configure optional ComfyUI'
    'schedule:manage persistent delayed and recurring LO jobs'
    'shortcuts:inspect or set polite shell shortcut policy'
    'open:open path in preferred/default desktop app'
    'preview:preview path outside terminal'
    'reveal:show path in Finder/file manager'
    'home:LOOK home'
    'doctor:diagnose environment'
    'config:installed paths/state'
    'secrets:secret status'
    'undo:undo last safe filesystem action'
    'uninstall:remove owned files'
    'version:print version'
    'help:command glossary'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'LOOK command' top
    _files
    return
  fi

  case "$words[2]" in
    scan)
      _files
      return
      ;;
    doctor)
      (( CURRENT == 3 )) && _values 'doctor mode' 'island:audit single-node offline autonomy'
      return
      ;;
    fabric)
      (( CURRENT == 3 )) && _values 'fabric action' status nodes activity pulse models http qualify services service jobs job events submit packet cancel watch dashboard dash beacon lights decisions decision decision-provider answer ask decision-shadow identity trust untrust pair-code pair transport endpoints endpoint-code allow revoke-endpoint
      return
      ;;
    ollama)
      local -a sub
      sub=(
        'models:model panel'
        'test:benchmark model'
        'host:manage Ollama hosts'
        'share:Tailscale Ollama share'
        'key:web-search key'
        'access:LO capability profile'
      )
      if (( CURRENT == 3 )); then
        _describe -t ollama 'Ollama command' sub
        return
      fi
      case "$words[3]" in
        host)
          if (( CURRENT == 4 )); then
            local -a hosts
            hosts=("${(@f)$(_look_saved_hosts)}")
            _describe -t hosts 'saved Ollama host' hosts
            _values 'host action' forget prune reset
            return
          elif [[ "$words[4]" == "forget" && CURRENT == 5 ]]; then
            local -a hosts
            hosts=("${(@f)$(_look_saved_hosts)}")
            _describe -t hosts 'saved Ollama host' hosts
            return
          fi
          ;;
        share)
          (( CURRENT == 4 )) && _values 'share action' status off
          return
          ;;
        key)
          (( CURRENT == 4 )) && _values 'key action' status
          return
          ;;
        access)
          (( CURRENT == 4 )) && _values 'access profile' conservative workspace power unsafe
          return
          ;;
        test)
          (( CURRENT == 4 )) && _values 'test option' --all
          return
          ;;
      esac
      ;;
    personality)
      (( CURRENT == 3 )) && _values 'personality' lo robot max philosopher
      return
      ;;
    thinking)
      (( CURRENT == 3 )) && _values 'thinking depth' light adaptive deep
      return
      ;;
    think-display|thinkdisplay)
      (( CURRENT == 3 )) && _values 'think display' compact full quiet
      return
      ;;
    play)
      if [[ "$words[CURRENT]" == --* ]]; then
        _values 'play option' --exact --literal --shuffle
        return
      fi
      local -a media_candidates
      media_candidates=("${(@f)$(command lk media complete "$words[CURRENT]" 2>/dev/null)}")
      (( ${#media_candidates} )) && compadd -Q -- "${media_candidates[@]}"
      _files
      return
      ;;
    media|music)
      (( CURRENT == 3 )) && _values 'media action' status browse find fabric catalog outputs on identify play pause toggle next prev stop queue clear scan library artists albums save load playlists playlist repeat state jump add stream info
      if (( CURRENT >= 4 )) && [[ "$words[3]" == (scan|add|stream|info) ]]; then
        _files
        return
      fi
      if (( CURRENT >= 4 )) && [[ "$words[3]" == (play|find|browse|identify) ]]; then
        if [[ "$words[3]" == play && "$words[CURRENT]" == --* ]]; then
          _values 'play option' --exact --literal --shuffle --kind --selection --artist --limit
          return
        fi
        local -a media_candidates
        media_candidates=("${(@f)$(command lk media complete "$words[CURRENT]" 2>/dev/null)}")
        (( ${#media_candidates} )) && compadd -Q -- "${media_candidates[@]}"
        [[ "$words[3]" == (play|identify) ]] && _files
        return
      fi
      return
      ;;
    doctor)
      _values 'doctor mode' 'island:audit single-node offline autonomy'
      ;;
    memory)
      (( CURRENT == 3 )) && _values 'memory action' add forget compact compile clear clear-summary clear-recent prune
      return
      ;;
    skills)
      (( CURRENT == 3 )) && _values 'skills action' add forget clear-learned path state version update export
      if [[ "$words[3]" == "export" && CURRENT -ge 4 ]]; then
        _files
      fi
      return
      ;;
    ai)
      (( CURRENT == 3 )) && _values 'AI action' status stats start stop wake
      return
      ;;
    profile)
      if (( CURRENT == 3 )); then
        _values 'profile action' status backup export restore files path config
        return
      fi
      case "$words[3]" in
        backup)
          _arguments '*:backup destination:_files -d' '--keep[retained snapshot count]:count:'
          return
          ;;
        export)
          _files
          return
          ;;
        restore)
          _files
          return
          ;;
      esac
      ;;
    feedback)
      if (( CURRENT == 3 )); then
        _values 'feedback action' status sound motion demo
        return
      fi
      if [[ "$words[3]" == "sound" && CURRENT == 4 ]]; then
        _values 'sound state' on off
        return
      fi
      if [[ "$words[3]" == "motion" && CURRENT == 4 ]]; then
        _values 'motion state' off subtle normal
        return
      fi
      ;;

    voice)
      (( CURRENT == 3 )) && _values 'voice action' status set personalities preview
      ;;
    sound)
      (( CURRENT == 3 )) && _values 'sound state' on off
      return
      ;;
    port|pid)
      _message 'number'
      return
      ;;
    process|why|forget)
      _message 'text'
      return
      ;;
    access)
      if (( CURRENT == 3 )); then
        _values 'access action' list personal add remove clear
      elif [[ "$words[3]" == (add|remove) && CURRENT == 4 ]]; then
        _files
      elif [[ "$words[3]" == add && CURRENT == 5 ]]; then
        _values 'capability' read write
      fi
      return
      ;;

    undo)
      (( CURRENT == 3 )) && _values 'undo action' list skip
      ;;

    open|preview|reveal)
      _arguments '*:path:_files'
      ;;

    services)
      if (( CURRENT == 3 )); then
        _values 'services action' status discover set share unshare
      elif (( CURRENT == 4 )) && [[ "$words[3]" == (share|unshare) ]]; then
        _values 'service' all ollama comfy mercury webterm
      fi
      ;;

    share)
      if (( CURRENT == 3 )); then
        _values 'share target' status off ollama comfy mercury webterm
      fi
      ;;

    vision)
      _arguments '1:image:_files' '*:question'
      ;;

    generate)
      _message 'image prompt'
      ;;

    comfy)
      if (( CURRENT == 3 )); then
        _values 'comfy action' status repair start stop restart unload discover bootstrap host workflow output preview auto-unload
      elif [[ "$words[3]" == (workflow|output) && CURRENT == 4 ]]; then
        _files
      fi
      ;;

    schedule)
      if (( CURRENT == 3 )); then
        _values 'schedule action' list in every daily pause resume remove run
      fi
      ;;

    apps)
      if (( CURRENT == 3 )); then
        _values 'app category' browser editor image pdf video audio
      elif (( CURRENT == 4 )); then
        _message 'application name or system'
      fi
      ;;

    shortcuts)
      (( CURRENT == 3 )) && _values 'shortcut policy' polite force reset
      ;;

    detail|dirs|files|tree|recent|size|run|git)
      _files
      return
      ;;
  esac
}
