[Unit]
Description=Albert Fabric Surface
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/albert/server.py
Restart=on-failure
RestartSec=2
Environment="PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=default.target
