#!/usr/bin/env python3
from pathlib import Path
import json,os,subprocess,sys,urllib.request,urllib.error,shutil
BASE=os.environ.get("MERCURY_URL","http://127.0.0.1:8765").rstrip("/")
def request(path,payload=None):
 data=None if payload is None else json.dumps(payload).encode(); req=urllib.request.Request(BASE+path,data=data,headers={"Content-Type":"application/json"})
 try:
  with urllib.request.urlopen(req,timeout=10) as r:return json.loads(r.read().decode())
 except urllib.error.HTTPError as e:
  data=json.loads(e.read().decode() or "{}")
  if e.code==409:return data
  raise
def workspace():
 p=request("/api/project/current").get("project")
 if not p:raise SystemExit("No server project yet. Open Mercury and save a recovery snapshot first.")
 return Path(request("/api/workspace/export",{"project":p})["path"])
def main():
 a=sys.argv[1:]
 if not a or a[0] in ("edit","e"):
  root=workspace(); target=root/"manuscript"; q=" ".join(a[1:] if a else []).lower()
  if q:
   m=[p for p in target.rglob("*.md") if q in p.stem.lower()]
   if len(m)==1:target=m[0]
   elif len(m)>1:print("Multiple matches:\n"+"\n".join("  "+str(p.relative_to(root)) for p in m));raise SystemExit(2)
   else:print(f"No scene matched {q!r}; opening manuscript workspace.")
  editor=os.environ.get("EDITOR") or ("nvim" if shutil.which("nvim") else "vi"); subprocess.run([editor,str(target)]); d=request("/api/workspace/import",{})
  if d.get("conflict"):
   print("Mercury: CONFLICT — both versions preserved. Browser/server manuscript was not overwritten.")
   print("Conflict copy:",d.get("conflict_path") or "state/conflicts")
   raise SystemExit(3)
  print(f"Mercury: imported {d.get('changed',0)} changed scene(s).")
 elif a[0]=="sync":
  d=request("/api/workspace/import",{})
  if d.get("conflict"):
   print("Mercury: CONFLICT — both versions preserved. Conflict copy:",d.get("conflict_path") or "state/conflicts");raise SystemExit(3)
  print(f"Mercury: imported {d.get('changed',0)} changed scene(s).")
 elif a[0]=="workspace":print(workspace())
 elif a[0]=="status":
  d=request("/api/workspace/status");print("Mercury server:",BASE);print("Workspace:",d.get("path") or "not created");print("Ready:","yes" if d.get("ready") else "no")
 else:print("Usage: mercury [edit [scene]] | sync | workspace | status");raise SystemExit(2)
if __name__=="__main__":main()
