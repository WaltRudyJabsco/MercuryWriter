 root=Path.home()/".cache/mercury/workspaces"/pid;shutil.rmtree(root,ignore_errors=True);man=root/"manuscript";man.mkdir(parents=True);files=[]
 for s in x["scenes"]:
  d=man/f"{s['chapter_index']+1:02d}-{slug(s['chapter_title'])}";d.mkdir(exist_ok=True);f=d/f"{s['scene_index']+1:02d}-{slug(s['scene_title'])}.md";f.write_text(f"---\nmercury_scene_id: {s['scene_id']}\ntitle: {s['scene_title']}\n---\n"+s["text"]);files.append(f)
 target=man;h=[f for f in files if scene and scene.lower() in f.stem.lower()]
 if len(h)==1:target=h[0]
 ed=os.environ.get("EDITOR") or ("nvim" if shutil.which("nvim") else "vi");print(f"MERCURY · {p['title']} · {b}");subprocess.run([ed,str(target)])
