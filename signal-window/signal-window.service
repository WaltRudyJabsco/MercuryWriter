[Unit]
Description=Signal Window
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:%h/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 %h/.local/share/signal-window/server.py
WorkingDirectory=%h/.local/share/signal-window
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
